#!/usr/bin/env bash
set -o errexit
set -o pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Usage: $0 <dir1> [dir2 ... dirN]" >&2
  echo "  Eligible dirs (no .!qB / .part in progress) are classified:" >&2
  echo "  • _MP4 — has .mp4 or .m4v, and no .mkv, .avi, or .ogm (MP4 bucket wins over _DONE)." >&2
  echo "  • _DONE — has .m4v, .mp4, .avi, .mkv, or .ogm, but not eligible for _MP4." >&2
  echo "  Prints mkdir/mv commands: _MP4 block first, then _DONE." >&2
  exit 0
fi

if [ $# -eq 0 ]; then
  echo "Usage: $0 <dir1> [dir2 ... dirN]" >&2
  echo "  Eligible dirs (no .!qB / .part in progress) are classified:" >&2
  echo "  • _MP4 — has .mp4 or .m4v, and no .mkv, .avi, or .ogm (MP4 bucket wins over _DONE)." >&2
  echo "  • _DONE — has .m4v, .mp4, .avi, .mkv, or .ogm, but not eligible for _MP4." >&2
  echo "  Prints mkdir/mv commands: _MP4 block first, then _DONE." >&2
  exit 1
fi

QB_TEMP_DIR=temp
DONE_DIR=_DONE
MP4_DIR=_MP4

is_a_dest_dir() {
  local dir="$1"
  if [[ "$dir" == "@eaDir" || "$dir" == "$QB_TEMP_DIR" || "$dir" == "$DONE_DIR" || "$dir" == "$MP4_DIR" ]]; then
    return 0
  fi
  return 1
}

# Shell-quote a string for safe pasting:
#   • only safe chars       -> no quoting
#   • no '                  -> wrap in single quotes
#   • has ' but no "        -> wrap in double quotes
#   • has both ' and "      -> wrap in double quotes, backslash-escaping " (and \ $ `)
shquote() {
  local s=$1
  if [[ -n "$s" && "$s" =~ ^[A-Za-z0-9._/+=:@%,-]+$ ]]; then
    printf '%s' "$s"
  elif [[ "$s" != *\'* ]]; then
    printf "'%s'" "$s"
  elif [[ "$s" != *\"* ]]; then
    printf '"%s"' "$s"
  else
    s=${s//\\/\\\\}
    s=${s//\$/\\\$}
    s=${s//\`/\\\`}
    s=${s//\"/\\\"}
    printf '"%s"' "$s"
  fi
}

# True if find prints any path (excluding Synology AppleDouble).
has_match() {
  local dir=$1
  shift
  [[ -n "$(find "$dir" -type f \( "$@" \) 2>/dev/null | grep -v '/._')" ]]
}

mp4_list=()
done_list=()

for DIR in "$@"; do
  if [ ! -d "$DIR" ]; then
    continue
  fi
  if is_a_dest_dir "$DIR"; then
    continue
  fi

  # In-progress downloads — skip entirely
  if has_match "$DIR" -iname '*.!qB' -o -iname '*.part'; then
    continue
  fi

  has_mkv_avi=false
  if has_match "$DIR" -iname '*.mkv' -o -iname '*.avi' -o -iname '*.ogm'; then
    has_mkv_avi=true
  fi

  has_mp4_m4v=false
  if has_match "$DIR" -iname '*.mp4' -o -iname '*.m4v'; then
    has_mp4_m4v=true
  fi

  has_any_video=false
  if has_match "$DIR" -iname '*.m4v' -o -iname '*.mp4' -o -iname '*.avi' -o -iname '*.mkv' -o -iname '*.ogm'; then
    has_any_video=true
  fi

  if [[ "$has_mp4_m4v" == true && "$has_mkv_avi" == false ]]; then
    mp4_list+=("$DIR")
  elif [[ "$has_any_video" == true ]]; then
    done_list+=("$DIR")
  else
    [[ -n "${VERBOSE:-}" ]] && echo "# No video files in '$DIR'" >&2
  fi
done

if ((${#mp4_list[@]} > 0)); then
  echo "mkdir -p '$MP4_DIR'"
  for d in "${mp4_list[@]}"; do
    printf "[[ -d '%s' ]] && mv %s '%s'\n" "$MP4_DIR" "$(shquote "$d")" "$MP4_DIR"
  done
fi

if ((${#done_list[@]} > 0)); then
  echo "mkdir -p '$DONE_DIR'"
  for d in "${done_list[@]}"; do
    printf "[[ -d '%s' ]] && mv %s '%s'\n" "$DONE_DIR" "$(shquote "$d")" "$DONE_DIR"
  done
fi
