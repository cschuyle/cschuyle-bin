tap "gdubw/gng"  # https://github.com/gdubw/gng

brew "awscli"
brew "csvkit"
brew "direnv"
brew "findutils"
brew "gng"
brew "gnu-sed"
brew "jq"
brew "the_silver_searcher"
brew "vim"
brew "watch"
brew "zoxide"
