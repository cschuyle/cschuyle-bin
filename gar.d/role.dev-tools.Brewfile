# Homebrew formulae added by the dev-tools role.
# Note: python3 is NOT brew-required here. The requirement is "a python3 >=3.11 on PATH" (any
# install method), enforced by the command-versions manifest, not "the Homebrew python3".
brew "awscli"
# Note: claude (Claude Code CLI) is NOT brew-required — it's the native installer build at
# ~/.local/bin/claude. Presence on PATH is checked via role.dev-tools.commands instead.
brew "poppler"
# keg-only (versioned formula); link it so `ffmpeg` lands on PATH.
brew "ffmpeg-full", link: true
brew "uv"
brew "espeak-ng"
brew "nmap"
brew "iproute2mac"
brew "fd"
brew "tig"
brew "lazygit"
