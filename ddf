#!/usr/bin/env bash
set -o errexit # set -e
set -o pipefail
script_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
script_file=$(basename "$0")

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
Usage: $script_file

Show disk availability for each configured data directory. The space-separated
directory list resolves via config-get (key data_dirs): env DDF_DATA_DIRS, then
ddf.{yaml,json}/config.{yaml,json} in this dir or ~/.config. Without config-get
on PATH, DDF_DATA_DIRS is used directly.

With no data dirs configured, ddf reports the machine's physical local
volume(s) instead of erroring: on macOS, / and any /Volumes/* disks; on
Linux/WSL/Synology, local filesystems excluding tmpfs/overlay/etc.
EOF
  exit 0
fi

# Resolve config via config-get (expected on PATH). If config-get is not on
# PATH, fall back to the DDF_DATA_DIRS environment variable directly.
cfg() {
  local key="$1" default="${2:-}"
  if command -v config-get >/dev/null 2>&1; then
    config-get -s "${BASH_SOURCE[0]}" --default "$default" "$key"
  else
    printf '%s\n' "$default"
  fi
}

detect_platform() {
    if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then printf '%s\n' wsl
    elif [[ "$(uname -s)" == "Darwin" ]]; then printf '%s\n' mac
    elif [[ "$(uname -a)" == *[Ss]ynology* ]]; then printf '%s\n' synology
    elif [[ "$(uname -s)" == "Linux" ]]; then printf '%s\n' linux
    else printf '%s\n' unknown
    fi
}

DATA_DIRS="$(cfg data_dirs "${DDF_DATA_DIRS:-}")"

# Colors for terminals
#if [ -t 1 ] && command -v tput >/dev/null 2>&1; then 
if [ -t 1 ]; then 
    # stdout is open to a terminal and tput is available

    # txtblk=$(tput setaf 0) # Black - Regular
    # txtred=$(tput setaf 1) # Red
    # txtgrn=$(tput setaf 2) # Green
    # txtylw=$(tput setaf 3) # Yellow
    # txtblu=$(tput setaf 4) # Blue
    # txtpur=$(tput setaf 5) # Purple
    # txtcyn=$(tput setaf 6) # Cyan
    # txtwht=$(tput setaf 7) # White
    # txtreset=$(tput sgr0) # Reset to default

    # Do it without tput
    txtreset="\033[0m"
    txtblk='\e[0;30m' # Black - Regular
    txtred='\e[0;31m' # Red
    txtgrn='\e[0;32m' # Green
    txtylw='\e[0;33m' # Yellow
    txtblu='\e[1;34m' # Blue (bright, legible on black backgrounds)
    txtpur='\e[0;35m' # Purple
    txtcyn='\e[0;36m' # Cyan
    txtwht='\e[0;37m' # White

    # txtreset='\e[0;30m' # Black - Regular
    # txtred='\e[0;31m' # Red
    # txtgrn='\e[0;32m' # Green
    # txtylw='\e[0;33m' # Yellow
    # txtblu='\e[0;34m' # Blue
    # txtpur='\e[0;35m' # Purple
    # txtcyn='\e[0;36m' # Cyan
    # txtwht='\e[0;37m' # White

fi

# report_dir LABEL PATH -> print one availability line, or a WARNING to stderr.
# Passing PATH as a df argument yields exactly one data row for the filesystem
# containing it, so no grep is needed. Columns $2/$4/$5 (Size/Avail/Capacity)
# sit in identical positions on macOS `df -H` and GNU `df -H`.
report_dir() {
    local label="$1" path="$2" row total avail percent
    row="$(df -H "$path" 2>/dev/null | awk 'NR==2')" || true
    if [[ -z "$row" ]]; then
        echo "WARNING: No match for $label" 1>&2
        return
    fi
    total="$(awk '{print $2}' <<<"$row")"
    avail="$(awk '{print $4}' <<<"$row")"
    percent="$(awk '{print $5}' <<<"$row")"
    avail="$txtgrn$avail$txtreset"
    echo -e "[$txtblu$label$txtreset] Disk Avail $avail of $total, $percent used"
}

# mac_volume_label MOUNT -> "Name (MOUNT)" if diskutil resolves a volume name,
# else just MOUNT (also the graceful path when diskutil is absent).
mac_volume_label() {
    local mount="$1" name
    name="$(diskutil info "$mount" 2>/dev/null | awk -F': *' '/Volume Name/{print $2; exit}')"
    if [[ -n "$name" ]]; then
        printf '%s (%s)\n' "$name" "$mount"
    else
        printf '%s\n' "$mount"
    fi
}

# report_physical_volumes -> fallback when no data dirs are configured: report
# the machine's physical local hard-drive volume(s), skipping synthetic/network
# /pseudo filesystems.
report_physical_volumes() {
    local mnt
    echo "note: no data dirs configured; reporting physical local volume(s)." 1>&2
    if [[ "$(detect_platform)" == "mac" ]]; then
        # macOS exposes one physical disk as many APFS volumes; keep just the
        # root volume and any external/user disks under /Volumes.
        while IFS= read -r mnt; do
            report_dir "$(mac_volume_label "$mnt")" "$mnt"
        done < <(df -H -l | awk 'NR>1 && ($NF=="/" || $NF ~ "^/Volumes/") {print $NF}')
    else
        # Always report / (guarantees output even on busybox df without -x),
        # then any other local filesystem that isn't tmpfs/overlay/etc.
        report_dir "/" "/"
        while IFS= read -r mnt; do
            report_dir "$mnt" "$mnt"
        done < <(df -H -l -x tmpfs -x devtmpfs -x overlay -x squashfs -x efivarfs 2>/dev/null \
                 | awk 'NR>1 && $NF!="/" && $NF ~ "^/" {print $NF}')
    fi
}

if [[ -n "$DATA_DIRS" ]]; then
    for dir in $DATA_DIRS; do
        report_dir "$dir" "$dir"
    done
else
    report_physical_volumes
fi