#!/usr/bin/env bash
set -o errexit # set -e
set -o pipefail
script_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
script_file=$(basename "$0")

source "$script_dir/config.sh"

if [[ -z "$CS_DF_DATA_DIRS" ]] ; then
    echo "ERROR: CS_DF_DATA_DIRS is not set."
    exit 1
fi

# Colors for terminals
if [ -t 1 ] && command -v tput >/dev/null 2>&1; then 
    # stdout is open to a terminal and tput is available

    txtblk=$(tput setaf 0) # Black - Regular
    txtred=$(tput setaf 1) # Red
    txtgrn=$(tput setaf 2) # Green
    txtylw=$(tput setaf 3) # Yellow
    txtblu=$(tput setaf 4) # Blue
    txtpur=$(tput setaf 5) # Purple
    txtcyn=$(tput setaf 6) # Cyan
    txtwht=$(tput setaf 7) # White
    txtreset=$(tput sgr0) # Reset to default

    # This doesn't work - TODO figure out how to do it without tput
    # txtreset='\e[0;30m' # Black - Regular
    # txtred='\e[0;31m' # Red
    # txtgrn='\e[0;32m' # Green
    # txtylw='\e[0;33m' # Yellow
    # txtblu='\e[0;34m' # Blue
    # txtpur='\e[0;35m' # Purple
    # txtcyn='\e[0;36m' # Cyan
    # txtwht='\e[0;37m' # White

fi

# echo CS_DF_DATA_DIRS [$CS_DF_DATA_DIRS]
dirs=($CS_DF_DATA_DIRS)
# echo dirs ${dirs[@]}

for dir in ${dirs[@]}; do
    # echo DIR $dir
    set +e
    a=( $(df -H|grep "$dir"\$) )
    set -e
    # echo A [$a]
    if [[ -z "$a" ]]; then
        echo WARNING: No match for $dir 1>&2
        continue
    fi
    total=${a[1]}
    used=${a[2]}
    avail=${a[3]}
    percent_used=${a[4]}

    if [[ "$avail" =~ ^\d\d?\d?M$ ]]; then
        color="$txtgrn"
    else
        color="$txtgrn"
    fi
    avail="$color$avail$txtreset"
    echo "[$txtblu$dir$txtreset] Disk Avail $avail of $total, $percent_used used"
done