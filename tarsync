#!/usr/bin/env bash
set -euo pipefail
# Copyright (C) 2006 Carlton Schuyler

USAGE="Usage: tarsync [OPTIONS] SOURCE... DEST

Synchronize files using tar with various options

OPTIONS:
  -n, --dry-run           Perform a trial run with no changes made
  -p, --port PORT         Specify port number for connection
  -U, --overwrite-newer   Use size-only comparison to overwrite newer files
  -z                      Enable compression (z flag)
  -h, --help              Show this help message

ARGUMENTS:
  SOURCE                  One or more source fuiles/directories to synchronize (copy)
  DEST                    Destination directory (can be local or remote in the form user@host:/path)

EXAMPLES:
  tarsync /path/to/source /dest-dir
  tarsync --dry-run --port 2222 /path/to/source1 /path/to/source2 user@desthost:/path/to/destination
  tarsync -U -z path/to/source dest/dir

AUTHOR: Carlton Schuyler
VERSION: Jan 10 2026
"

# Parse command line arguments
DRY_RUN=false
PORT_ARG=""
SOURCES=()
# Do not compress by default.
Z=
# Do not overwrite newer files by default. You might want to use --overwrite-newer if a previous attempt created a partial file at the destination.
# You can alsop set the env var TARSYNC_OVERWRITE_NEWER
UPDATE_PARAM=" --update"

while [[ $# -gt 0 ]]; do
    case $1 in
        --dry-run|-n)
            DRY_RUN=true
            shift
            ;;
        --port|-p)
            PORT=$1
            PORT_ARG="-p $PORT"
            shift
            ;;
        --overwrite-newer|-U)
            UPDATE_PARAM=" --size-only"
            shift
            ;;
        -z)
            Z="z"
            shift
            ;;
        -*)
            echo "Unknown option $1" >&2
            exit 1
            ;;
        *)
            SOURCES+=("$1")
            shift
            ;;
    esac
done

# Check environment variable for overwrite-newer setting
if [[ -n "${TARSYNC_OVERWRITE_NEWER:-}" ]]; then
  UPDATE_PARAM=" --size-only"
fi

# Last argument is destination, rest are sources
if [[ ${#SOURCES[@]} -lt 2 ]]; then
    echo "$USAGE" >&2
    exit 1
fi
DESTINATION="${SOURCES[$((${#SOURCES[@]}-1))]}"
unset "SOURCES[$((${#SOURCES[@]}-1))]"
echo SOURCES: "${SOURCES[@]}"
echo DESTINATION: $DESTINATION

# rsync prints each file with --out-format='%n' relative to the transfer root,
# i.e. relative to the parent of each source (or to the source itself if it was
# given with a trailing slash). The create-side tar must therefore run from that
# same base directory, otherwise the relative names cannot be stat'd. Compute a
# single base directory shared by all sources.
tar_base_of() {
    local src="$1"
    if [[ "$src" == */ ]]; then
        # Trailing slash: names are relative to the source directory itself.
        printf '%s' "${src%/}"
    else
        dirname "$src"
    fi
}
TAR_BASE=$(tar_base_of "${SOURCES[0]}")
for src in "${SOURCES[@]}"; do
    if [[ "$(tar_base_of "$src")" != "$TAR_BASE" ]]; then
        echo "Error: all SOURCE arguments must live in the same parent directory (got base '$TAR_BASE' and '$(tar_base_of "$src")')." >&2
        exit 1
    fi
done
# Parse destination into host and directory
if [[ "$DESTINATION" == *:* ]]; then
    DEST_HOST="${DESTINATION%%:*}"
    DEST_DIR="${DESTINATION#*:}"
else
    DEST_HOST=""
    DEST_DIR="$DESTINATION"
fi

# Generate list of files that need to be copied using rsync
# Create temporary file for file list
if [[ "$DRY_RUN" == true ]]; then
  TEMP_FILE="./tarsync_files_$$.txt"
else
  TEMP_FILE=$(mktemp)
  trap "rm -f '$TEMP_FILE'" EXIT
fi

# Generate list of files that need to be copied using rsync
if [[ -n "$DEST_HOST" ]]; then
  
  rsync --dry-run --archive --verbose${UPDATE_PARAM} --out-format='%n' "${SOURCES[@]}" "$DEST_HOST:$DEST_DIR/" | \
    # Filter out summary lines and directories
    grep -v '^Transfer starting\|sen\|^total\|^$' | \
    grep -v '\._' | \
    grep -v '/$' > "$TEMP_FILE"
  
else
  
  rsync --dry-run --archive --verbose${UPDATE_PARAM} --out-format='%n' "${SOURCES[@]}" "$DEST_DIR/" | \
    # Filter out summary lines and directories
    grep -v '^Transfer starting\|sen\|^total\|^$' | \
    grep -v '\._' | \
    grep -v '/$' > "$TEMP_FILE"
  
fi

# If dry-run, output the temp file name and its contents
if [[ "$DRY_RUN" == true ]]; then
  echo "List of files to be transferred written to: $TEMP_FILE"
fi
cat "$TEMP_FILE"

# tar flags:
# -S maintain sparse files
# -c create
# -z compress
# -v verbose
# -f specify filename

# Create tar archive and pipe to destination
if [[ -n "$DEST_HOST" ]]; then
  if [[ "$DRY_RUN" == true ]]; then
    echo "tar -C \"$TAR_BASE\" -Sc${Z}vf - -T \"$TEMP_FILE\" | ssh $PORT_ARG \"$DEST_HOST\" \"cd \\\"$DEST_DIR\\\" && tar -x${Z}f -\""
  else
    set -x
    tar -C "$TAR_BASE" -Sc${Z}vf - -T "$TEMP_FILE" | ssh $PORT_ARG "$DEST_HOST" "cd \"$DEST_DIR\" && tar -x${Z}f -"
    set +x
  fi
else
  if [[ "$DRY_RUN" == true ]]; then
    echo "tar -C \"$TAR_BASE\" -Sc${Z}vf - -T \"$TEMP_FILE\" | (cd \"$DEST_DIR\" && tar -x${Z}f -)"
  else
    set -x
    tar -C "$TAR_BASE" -Sc${Z}vf - -T "$TEMP_FILE" | (cd "$DEST_DIR" && tar -x${Z}f -)
    set +x
  fi
fi
