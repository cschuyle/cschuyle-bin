#!/usr/bin/env bash
set -e

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
Usage: ssh-synology

SSH to the Synology NAS (port 4546) using DRAGNON_SYNOLOGY_IP. Switches iTerm to
the Caution profile for the session.
EOF
  exit 0
fi

[[ -z "$DRAGNON_SYNOLOGY_IP" ]] && { echo "DRAGNON_SYNOLOGY_IP is not set. Try 
On mac         set-secret DRAGNON_SYNOLOGY_IP 192.168.1.XXX
Or on non-mac  export DRAGNON_SYNOLOGY_IP=192.168.1.XXX"; exit 1; }

# SetProfile changes iTerm’s session profile but does not update $ITERM_PROFILE in the shell.
iterm_set_profile() {
  [[ "$TERM_PROGRAM" != "iTerm.app" ]] && return
  export INITIAL_PROFILE="$ITERM_PROFILE"
  printf '\033]50;SetProfile=%s\a' "$1"
  export ITERM_PROFILE="$1"
}

reset_profile() {
  iterm_set_profile "$INITIAL_PROFILE"
}

# Ensure the terminal profile title is reset even if the script is interrupted.
trap reset_profile EXIT INT TERM

iterm_set_profile "Caution"
ssh -p 4546 cschuyle@$DRAGNON_SYNOLOGY_IP
