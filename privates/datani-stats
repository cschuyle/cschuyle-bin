#!/usr/bin/env python3
"""
DEPRECATED: the video workflow now lives in `vids-handle`. This reporting tool
is kept for now but will be removed.

Report file lists by category for Download / HandBrake workflows.

Categories:
  downloading — all partial downloads (*.!qB, *.part), including under temp/
  downloaded but part of a downloading set — completed (non-partial) files
      directly under …/temp/<file>; partials are never placed here
  downloaded — other completed files (not partial, not directly under temp/)
  to-be-transcoded — files under HANDBREAK but not inside TRASHCAN/ or KRACK/
  transcoding — files under HANDBREAK/TRASHCAN and HANDBREAK/KRACK

Default roots (override with env or flags):
  DOWNLOAD=/volume1/cschuyle/Noncloud-Data/Downloads/_Torrents
  HANDBREAK=/volume1/cschuyle/Noncloud-Data/video/_Handbreakme
  Transcoding dirs: HANDBREAK/TRASHCAN, HANDBREAK/KRACK

Each section lists paths sorted by file size descending (bytes + tab + path).

Synology / AppleDouble noise is skipped: no descent into @eaDir, and any path
with a component starting with ._ is ignored.
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path
from typing import Iterable, List, Tuple

DEFAULT_DOWNLOAD = Path("/volume1/cschuyle/Noncloud-Data/Downloads/_Torrents")
DEFAULT_HANDBREAK = Path("/volume1/cschuyle/Noncloud-Data/video/_Handbreakme")
HANDBREAKING_SUBDIRS = ("TRASHCAN", "KRACK")

# qBittorrent (and similar) often stash multi-file payload under a temp subdir.
DOWNLOAD_TEMP_DIRNAME = "temp"

# Synology metadata dir; do not traverse.
_SYNO_SKIP_DIRNAMES = frozenset({"@eaDir"})


def _is_synology_hidden_path(p: Path) -> bool:
    """True if path touches Synology @eaDir or AppleDouble-style ._ segments."""
    for part in p.parts:
        if part in _SYNO_SKIP_DIRNAMES or part.startswith("._"):
            return True
    return False


def _is_partial_path(p: Path) -> bool:
    n = p.name.lower()
    if n.endswith(".part"):
        return True
    if n.endswith(".!qb"):
        return True
    return False


def _is_directly_under_temp_dir(p: Path) -> bool:
    """True if the file's immediate parent directory is named temp."""
    return p.parent.name == DOWNLOAD_TEMP_DIRNAME


def walk_files(root: Path) -> Iterable[Path]:
    if not root.is_dir():
        return
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames[:] = [d for d in dirnames if d not in _SYNO_SKIP_DIRNAMES]
        for name in filenames:
            if name.startswith("._"):
                continue
            fp = Path(dirpath) / name
            if _is_synology_hidden_path(fp):
                continue
            try:
                if fp.is_file():
                    yield fp
            except OSError:
                continue


def file_size(p: Path) -> int:
    try:
        return p.stat().st_size
    except OSError:
        return -1


def sort_by_size_desc(paths: Iterable[Path]) -> List[Tuple[int, Path]]:
    rows: List[Tuple[int, Path]] = []
    for p in paths:
        sz = file_size(p)
        if sz < 0:
            continue
        rows.append((sz, p))
    rows.sort(key=lambda t: t[0], reverse=True)
    return rows


def emit_section(title: str, rows: List[Tuple[int, Path]]) -> None:
    print(title)
    print("-" * len(title))
    if not rows:
        print("  (none)")
    else:
        for sz, p in rows:
            print(f"{sz}\t{p}")
    print()


def collect_downloading(download_root: Path) -> List[Tuple[int, Path]]:
    return sort_by_size_desc(p for p in walk_files(download_root) if _is_partial_path(p))


def collect_downloaded_part_of_downloading_set(download_root: Path) -> List[Tuple[int, Path]]:
    return sort_by_size_desc(
        p
        for p in walk_files(download_root)
        if not _is_partial_path(p) and _is_directly_under_temp_dir(p)
    )


def collect_downloaded(download_root: Path) -> List[Tuple[int, Path]]:
    return sort_by_size_desc(
        p
        for p in walk_files(download_root)
        if not _is_partial_path(p) and not _is_directly_under_temp_dir(p)
    )


def collect_to_be_transcoded(handbreak: Path, breaking_roots: List[Path]) -> List[Tuple[int, Path]]:
    try:
        hb = handbreak.resolve()
    except OSError:
        return []

    breaking_resolved = set()
    for br in breaking_roots:
        try:
            breaking_resolved.add(br.resolve())
        except OSError:
            pass

    def under_breaking(p: Path) -> bool:
        try:
            pr = p.resolve()
        except OSError:
            return False
        for br in breaking_resolved:
            try:
                pr.relative_to(br)
                return True
            except ValueError:
                continue
        return False

    return sort_by_size_desc(
        p for p in walk_files(handbreak) if not under_breaking(p)
    )


def collect_transcoding(breaking_roots: List[Path]) -> List[Tuple[int, Path]]:
    out: List[Path] = []
    for br in breaking_roots:
        out.extend(walk_files(br))
    return sort_by_size_desc(out)


def parse_args(argv: List[str] | None = None) -> argparse.Namespace:
    env_dl = os.environ.get("DATANI_DOWNLOAD")
    env_hb = os.environ.get("DATANI_HANDBREAK")
    p = argparse.ArgumentParser(description="List files by download / HandBrake category, by size desc.")
    p.add_argument(
        "--download",
        type=Path,
        default=Path(env_dl) if env_dl else DEFAULT_DOWNLOAD,
        help="DOWNLOAD root (default or DATANI_DOWNLOAD)",
    )
    p.add_argument(
        "--handbreak",
        type=Path,
        default=Path(env_hb) if env_hb else DEFAULT_HANDBREAK,
        help="HANDBREAK root (default or DATANI_HANDBREAK)",
    )
    p.add_argument(
        "--handbreaking",
        type=Path,
        nargs="*",
        default=None,
        metavar="DIR",
        help="Transcoding dirs (default: HANDBREAK/TRASHCAN and HANDBREAK/KRACK)",
    )
    return p.parse_args(argv)


def main(argv: List[str] | None = None) -> int:
    print(
        "WARNING: datani-stats is DEPRECATED; the video workflow now lives in 'vids-handle'.",
        file=sys.stderr,
    )
    args = parse_args(argv)
    download_root: Path = args.download
    handbreak: Path = args.handbreak
    if args.handbreaking is not None and len(args.handbreaking) > 0:
        breaking_roots = list(args.handbreaking)
    else:
        breaking_roots = [handbreak / name for name in HANDBREAKING_SUBDIRS]

    emit_section("Downloading (partial: .!qB, .part)", collect_downloading(download_root))
    emit_section(
        "Downloaded but part of a downloading set",
        collect_downloaded_part_of_downloading_set(download_root),
    )
    emit_section("Downloaded", collect_downloaded(download_root))
    emit_section("To be transcoded (under Handbreak, excluding TRASHCAN/KRACK)", collect_to_be_transcoded(handbreak, breaking_roots))
    emit_section("Transcoding (TRASHCAN / KRACK)", collect_transcoding(breaking_roots))
    return 0


if __name__ == "__main__":
    sys.exit(main())
