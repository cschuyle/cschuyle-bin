#!/usr/bin/env python3
"""Classify paths as movie, series, album, or ebook using filesystem heuristics.

Usage: dg-whatis [--json] [-v|--verbose] [-m|--media] [-e|--equivalence]
                     [-c CLASS|--classification CLASS] <path> [path ...]
    dg-whatis [--json] -d|--diff <path_a> <path_b>

    -v / --verbose  Plain text only: full multi-line report (sizes, video by extension,
                    cross-type equivalence, ffprobe visual lines). Without -v, default
                    plain output is a path line plus one tab-separated summary line and
                    skips ffprobe and cross-type equivalence work.
    -m / --media  Output only the media: line per path (no ffprobe, no equivalence analysis).
    -e / --equivalence  Print only each path and cross-type equivalence as one of:
                         verified, N/A, or not equivalent (tab-separated plain text;
                         with --json: {"path", "equivalence"} per line).
    -c / --classification  Only paths classified as CLASS. Valid CLASS values: movie, series, album, ebook, unknown. Plain output: one resolved path per matching line. With --json: only matching NDJSON rows.
    -d / --diff  Compare two paths and report which analysis fields are equal vs different.
                 If PATH_B is a directory containing an entry named like PATH_A's
                 basename, PATH_A is compared against PATH_B/<basename> (so you can
                 pass the parent directory of the counterpart instead of retyping it).
                 Each top-video-by-size line is suffixed with a brief of that
                 file's embedded subtitle tracks (subs language/codec); in --json
                 the subtitles are on each top_videos_* entry.

Content types (one primary kind per path):
  movie, series, album, ebook, unknown

Media formats listed when present (by extension). Canonical labels include
mp4, avi, flac, mp3, mobi, pdf; other extensions in the same families appear
as their suffix (e.g. mkv, epub, m4a).

Non-media / download state (other_types when present):
  qb-partial — qBittorrent incomplete file (.!qB suffix, e.g. video.mkv.!qB)
  part — generic partial download (.part suffix)

Heuristics: video present -> movie vs series from filenames/paths (S01E02,
season N, 1x02, etc.) and file counts; else audio -> album; else ebooks only
-> ebook. Mixed ebook+audio/video is reported as unknown.

Each path also has type: file | directory | symlink to directory (or missing
if the path does not exist).

Detected media file sizes (video / audio / ebook buckets and total) are reported
in human-readable binary units (K, M, G, T from 1024).

Directory scans recurse at most SCAN_MAX_DEPTH path components below the root
(e.g. depth 3: root/a/b/file.ext — not root/a/b/c/file.ext).

Video and image files under the same scan rules get optional stream metadata
(resolution, duration, codec; embedded subtitle tracks with language and codec)
via ffprobe when it is on PATH; see visual_metadata in JSON output and the
visual: lines in plain text when -v/--verbose is set.

For directories that contain video files, output also groups videos by file
extension and, when two or more extensions are present, reports whether
cross-type equivalence was verified (same count per pair and a perfect
duration+title matching between buckets) or NOT verified; see
video_cross_type_equivalence in JSON and plain-text lines under video by
extension when -v/--verbose is set. When equivalence is not verified, verbose
plain text includes a mismatch table: for each extension, a file column and a
separate duration column, one inferred equivalence group per row (NONE / — when
no file in that column); that table is omitted from --json output.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from difflib import SequenceMatcher
from typing import Any, Dict, Iterable, List, Optional, Set, Tuple

VIDEO_EXTENSIONS = {
    '.mp4', '.m4v', '.mkv', '.avi', '.mov', '.webm', '.wmv', '.mpg', '.mpeg', '.ogm',
}
AUDIO_EXTENSIONS = {
    '.mp3', '.flac', '.wav', '.aac', '.m4a', '.ogg', '.opus', '.wma', '.alac',
}
EBOOK_EXTENSIONS = {
    '.mobi', '.azw', '.azw3', '.epub', '.pdf', '.fb2', '.djvu',
}
IMAGE_EXTENSIONS = {
    '.jpg', '.jpeg', '.png', '.gif', '.webp', '.bmp', '.tif', '.tiff',
    '.heic', '.heif', '.avif', '.jxl', '.ico',
}

CANONICAL_MEDIA_LABELS = {
    '.mp4': 'mp4',
    '.avi': 'avi',
    '.flac': 'flac',
    '.mp3': 'mp3',
    '.mobi': 'mobi',
    '.pdf': 'pdf',
}

_EPISODE_RE = re.compile(
    r'(?i)(\bs\d{1,2}\s*e\d{1,3}\b|\bseason\s*\d{1,2}\b|\bep(?:isode)?\s*\d{1,3}\b|\b\d{1,2}x\d{1,3}\b)'
)

# qBittorrent uses a trailing ".!qB" on the incomplete file (suffix may be ".!qB").
_QB_PARTIAL_SUFFIX = '.!qb'  # lowercase for comparison

# Max path segments under a directory root (including filename) when scanning.
SCAN_MAX_DEPTH = 3


def human_size(n: int) -> str:
    """Format byte count using binary K/M/G/T (1024-based)."""
    if n < 0:
        n = 0
    if n < 1024:
        return f'{n} B'
    labels = ('K', 'M', 'G', 'T', 'P')
    v = float(n)
    i = -1
    while v >= 1024 and i + 1 < len(labels):
        v /= 1024
        i += 1
    s = f'{v:.1f}'.rstrip('0').rstrip('.')
    return f'{s}{labels[i]}'


def file_size_bytes(p: Path) -> int:
    try:
        return int(p.stat().st_size)
    except OSError:
        return 0

def file_timestamp(p: Path) -> int:
    try:
        return int(p.stat().st_mtime)
    except OSError:
        return -1


def human_date(ts: int) -> str:
    """Format Unix mtime as YYYY-MM-DD (local time)."""
    if ts < 0:
        return '—'
    return datetime.fromtimestamp(ts).strftime('%Y-%m-%d')


def human_duration(seconds: Optional[float]) -> str:
    """Format duration for display; empty input -> em dash."""
    if seconds is None:
        return '—'
    try:
        sec_f = float(seconds)
    except (TypeError, ValueError):
        return '—'
    if sec_f < 0 or sec_f != sec_f:  # NaN
        return '—'
    s = int(round(sec_f))
    h, r = divmod(s, 3600)
    m, sec = divmod(r, 60)
    if h:
        return f'{h}:{m:02d}:{sec:02d}'
    return f'{m}:{sec:02d}'


def subtitle_tracks_from_probe(data: Dict[str, Any]) -> List[Dict[str, Any]]:
    """Embedded subtitle streams from ffprobe -show_streams JSON."""
    out: List[Dict[str, Any]] = []
    for st in data.get('streams') or []:
        if st.get('codec_type') != 'subtitle':
            continue
        tags = st.get('tags') or {}
        raw = tags.get('language') or tags.get('LANG')
        lang: Optional[str] = None
        if isinstance(raw, str):
            lang = raw.strip() or None
        codec = st.get('codec_name')
        title_raw = tags.get('title')
        entry: Dict[str, Any] = {'codec': codec, 'language': lang}
        if isinstance(title_raw, str) and title_raw.strip() and len(title_raw) <= 120:
            entry['title'] = title_raw.strip()
        out.append(entry)
    return out


def format_subtitles_brief(subs: List[Dict[str, Any]], max_tracks: int = 6) -> str:
    """Compact text for subtitle track list."""
    if not subs:
        return '—'
    parts: List[str] = []
    for s in subs[:max_tracks]:
        lang = s.get('language') or 'und'
        c = s.get('codec') or '?'
        parts.append(f'{lang}/{c}')
    extra = len(subs) - max_tracks
    tail = f' (+{extra})' if extra > 0 else ''
    return ', '.join(parts) + tail


def probe_visual_file(path: Path) -> Dict[str, Any]:
    """Width, height, duration (seconds), codec via ffprobe; values may be null."""
    base: Dict[str, Any] = {
        'path': str(path),
        'size_bytes': file_size_bytes(path),
        'width': None,
        'height': None,
        'duration': None,
        'codec': None,
        'subtitles': [],
        'format_title': None,
    }
    ffprobe = shutil.which('ffprobe')
    if not ffprobe:
        base['probe_error'] = 'ffprobe not in PATH'
        return base
    try:
        out = subprocess.run(
            [
                ffprobe,
                '-v',
                'error',
                '-print_format',
                'json',
                '-show_format',
                '-show_streams',
                str(path),
            ],
            capture_output=True,
            text=True,
            timeout=120,
        )
        if out.returncode != 0:
            err = (out.stderr or out.stdout or 'ffprobe failed').strip()
            base['probe_error'] = err[:240] if err else 'ffprobe failed'
            return base
        data = json.loads(out.stdout)
    except subprocess.TimeoutExpired:
        base['probe_error'] = 'ffprobe timeout'
        return base
    except (json.JSONDecodeError, OSError) as e:
        base['probe_error'] = str(e)[:240]
        return base

    width: Optional[int] = None
    height: Optional[int] = None
    codec: Optional[str] = None
    duration: Optional[float] = None

    for st in data.get('streams') or []:
        if st.get('codec_type') != 'video':
            continue
        w, h = st.get('width'), st.get('height')
        if w is not None and h is not None:
            try:
                width, height = int(w), int(h)
            except (TypeError, ValueError):
                pass
        codec = st.get('codec_name') or codec
        if duration is None and st.get('duration') is not None:
            try:
                duration = float(st['duration'])
            except (TypeError, ValueError):
                pass
        if width is not None:
            break

    if duration is None:
        d = (data.get('format') or {}).get('duration')
        if d is not None:
            try:
                duration = float(d)
            except (TypeError, ValueError):
                pass

    fmt_tags = (data.get('format') or {}).get('tags') or {}
    raw_title = fmt_tags.get('title') or fmt_tags.get('TITLE')
    if isinstance(raw_title, str) and raw_title.strip():
        t = raw_title.strip()
        base['format_title'] = t[:200] if len(t) > 200 else t

    base['width'] = width
    base['height'] = height
    base['duration'] = duration
    base['codec'] = codec
    base['subtitles'] = subtitle_tracks_from_probe(data)
    return base


def visual_metadata_for_paths(
    video_files: List[Path],
    image_files: List[Path],
) -> List[Dict[str, Any]]:
    """Probe each path (videos first, then images); skips duplicates."""
    seen: Set[str] = set()
    out: List[Dict[str, Any]] = []
    for label, paths in (('video', video_files), ('image', image_files)):
        for p in paths:
            try:
                key = str(p.resolve())
            except OSError:
                key = str(p)
            if key in seen:
                continue
            seen.add(key)
            meta = probe_visual_file(p)
            meta['media'] = label
            out.append(meta)
    return out


def resolution_brief(meta: Dict[str, Any]) -> str:
    """WxH for display, or em dash when unknown."""
    w, h = meta.get('width'), meta.get('height')
    if w is not None and h is not None:
        return f'{w}×{h}'
    return '—'


def format_visual_line(meta: Dict[str, Any]) -> str:
    """One-line summary for text mode."""
    label = meta.get('media', '?')
    res = resolution_brief(meta)
    dur = human_duration(meta.get('duration'))
    codec = meta.get('codec') or '—'
    rel = Path(str(meta['path'])).name
    err = meta.get('probe_error')
    if err:
        return f'{rel} ({label}): {err}'
    if label == 'video':
        sub_brief = format_subtitles_brief(meta.get('subtitles') or [])
        return f'{rel} ({label}): {res}, {dur}, {codec}; subs {sub_brief}'
    return f'{rel} ({label}): {res}, {dur}, {codec}'


def top_videos_by_size(
    visual_rows: List[Dict[str, Any]], limit: int = 5
) -> List[Dict[str, Any]]:
    """Return up to `limit` video entries sorted by size_bytes descending.

    Returns an empty list when there are 25 or more video files (caller suppresses
    the section in that case) or when there are no video files at all.
    """
    videos = [r for r in visual_rows if r.get('media') == 'video']
    if not videos or len(videos) >= 25:
        return []
    return sorted(videos, key=lambda r: r.get('size_bytes', 0), reverse=True)[:limit]


def sum_file_sizes(files: List[Path]) -> int:
    return sum(file_size_bytes(f) for f in files)


def path_entry_type(p: Path) -> str:
    """How the path exists on disk: file, directory, or symlink to directory."""
    if p.is_symlink():
        try:
            target = p.resolve()
        except OSError:
            return 'file'
        if target.is_dir():
            return 'symlink to directory'
        return 'file'
    if p.is_dir():
        return 'directory'
    if p.is_file():
        return 'file'
    return 'file'


def other_file_tags(f: Path) -> Set[str]:
    """Tags for partial / downloader artifacts (not primary media kind)."""
    tags: Set[str] = set()
    suf = f.suffix.lower()
    if suf == _QB_PARTIAL_SUFFIX or f.name.lower().endswith('.!qb'):
        tags.add('qb-partial')
    if suf == '.part':
        tags.add('part')
    return tags


def iter_files(root: Path) -> Iterable[Path]:
    if root.is_file():
        yield root
        return
    if not root.is_dir():
        return
    try:
        root_r = root.resolve()
    except OSError:
        return
    for dirpath, dirnames, filenames in os.walk(root_r, topdown=True, followlinks=False):
        cur = Path(dirpath)
        try:
            rel = cur.relative_to(root_r)
        except ValueError:
            dirnames[:] = []
            continue
        if len(rel.parts) >= SCAN_MAX_DEPTH:
            dirnames[:] = []
        for name in filenames:
            fp = cur / name
            try:
                frel = fp.relative_to(root_r)
            except ValueError:
                continue
            if len(frel.parts) > SCAN_MAX_DEPTH:
                continue
            try:
                if fp.is_file():
                    yield fp
            except OSError:
                continue


def looks_like_episode(name: str) -> bool:
    return bool(_EPISODE_RE.search(name))


def names_from_file_up_to_root(f: Path, root: Path) -> List[str]:
    out = [f.name]
    root_r = root.resolve()
    cur = f.parent.resolve()
    while cur != root_r and cur != cur.parent:
        out.append(cur.name)
        cur = cur.parent
    return out


def gather_media(
    root: Path,
) -> Tuple[Set[str], List[Path], List[Path], List[Path], List[Path], List[str]]:
    exts: Set[str] = set()
    video_files: List[Path] = []
    audio_files: List[Path] = []
    ebook_files: List[Path] = []
    image_files: List[Path] = []
    other_types: Set[str] = set()
    for f in iter_files(root):
        other_types |= other_file_tags(f)
        suf = f.suffix.lower()
        # Skip qB partial / .part for media buckets (not finished media)
        if suf == _QB_PARTIAL_SUFFIX or f.name.lower().endswith('.!qb') or suf == '.part':
            continue
        if suf in VIDEO_EXTENSIONS:
            video_files.append(f)
            exts.add(suf)
        elif suf in AUDIO_EXTENSIONS:
            audio_files.append(f)
            exts.add(suf)
        elif suf in EBOOK_EXTENSIONS:
            ebook_files.append(f)
            exts.add(suf)
        elif suf in IMAGE_EXTENSIONS:
            image_files.append(f)
            exts.add(suf)
    return exts, video_files, audio_files, ebook_files, image_files, sorted(other_types)


def formats_for_output(exts: Set[str]) -> List[str]:
    return [CANONICAL_MEDIA_LABELS.get(s, s.lstrip('.')) for s in sorted(exts)]


def video_file_looks_episodic(f: Path, root: Path) -> bool:
    return any(looks_like_episode(n) for n in names_from_file_up_to_root(f, root))


_TITLE_JUNK_RE = re.compile(
    r'(?i)\b('
    r'720p|1080p|1440p|2160p|4320p|4k|uhd|hdr|hdtv|webrip|web[- ]?dl|bluray|bdrip|'
    r'dvdrip|brrip|remux|x264|x265|h\.?264|h\.?265|hevc|av1|vp9|'
    r'aac\d*|ac3|eac3|dts|truehd|atmos|flac|opus|'
    r'repack|proper|internal|limited|extended|unrated|directors?\s*cut'
    r')\b'
)


def normalize_video_title_label(stem: str) -> str:
    """Strip release noise so two encodes of the same content compare similarly."""
    s = stem.lower()
    s = re.sub(r'\[[^\]]*\]', ' ', s)
    s = re.sub(r'\([^)]*\)', ' ', s)
    s = _TITLE_JUNK_RE.sub(' ', s)
    s = re.sub(r'[._-]+', ' ', s)
    s = re.sub(r'\s+', ' ', s).strip()
    return s


def title_similarity(a: str, b: str) -> float:
    if not a and not b:
        return 1.0
    if not a or not b:
        return 0.0
    if a == b:
        return 1.0
    return SequenceMatcher(None, a, b).ratio()


def duration_close_enough(sec_a: Optional[float], sec_b: Optional[float]) -> bool:
    if sec_a is None or sec_b is None:
        return False
    try:
        da, db = float(sec_a), float(sec_b)
    except (TypeError, ValueError):
        return False
    if da < 0 or db < 0 or da != da or db != db:
        return False
    diff = abs(da - db)
    tol = max(5.0, 0.005 * max(da, db))
    return diff <= tol


def best_title_for_compare(path: Path, meta: Optional[Dict[str, Any]]) -> str:
    stem = path.stem
    labels: List[str] = [normalize_video_title_label(stem)]
    if meta and meta.get('format_title'):
        ft = meta.get('format_title')
        if isinstance(ft, str) and ft.strip():
            labels.append(normalize_video_title_label(ft.strip()))
    # Prefer the longest normalized label (often more specific than a short stem).
    return max(labels, key=len) if labels else ''


def meta_for_path(path_to_meta: Dict[str, Dict[str, Any]], p: Path) -> Dict[str, Any]:
    for k in (str(p),):
        m = path_to_meta.get(k)
        if m:
            return m
    try:
        m = path_to_meta.get(str(p.resolve()))
    except OSError:
        m = None
    return m if m else {}


def paths_match_cross_type_equivalence(
    p: Path,
    q: Path,
    path_to_meta: Dict[str, Dict[str, Any]],
    title_min: float = 0.72,
) -> bool:
    mp, mq = meta_for_path(path_to_meta, p), meta_for_path(path_to_meta, q)
    da, db = mp.get('duration'), mq.get('duration')
    ta = best_title_for_compare(p, mp or None)
    tb = best_title_for_compare(q, mq or None)
    return duration_close_enough(da, db) and title_similarity(ta, tb) >= title_min


def ext_column_label(ext: str) -> str:
    return ext.lstrip('.') or ext


def group_videos_by_extension(video_files: List[Path]) -> Dict[str, List[Path]]:
    groups: Dict[str, List[Path]] = {}
    for f in video_files:
        ext = f.suffix.lower() or '(no extension)'
        groups.setdefault(ext, []).append(f)
    for ext in groups:
        groups[ext].sort(key=lambda p: p.name.lower())
    return dict(sorted(groups.items(), key=lambda kv: kv[0]))


def _try_match_extension_pair(
    paths_a: List[Path],
    paths_b: List[Path],
    path_to_meta: Dict[str, Dict[str, Any]],
    title_min: float = 0.72,
) -> Tuple[bool, str]:
    """One-to-one match by duration + title between two extension buckets."""
    if not paths_a and not paths_b:
        return True, 'both empty'
    if not paths_a or not paths_b:
        return False, f'count mismatch ({len(paths_a)} vs {len(paths_b)})'

    items_a = [
        (
            p,
            meta_for_path(path_to_meta, p).get('duration'),
            best_title_for_compare(p, meta_for_path(path_to_meta, p) or None),
        )
        for p in paths_a
    ]
    items_b = [
        (
            p,
            meta_for_path(path_to_meta, p).get('duration'),
            best_title_for_compare(p, meta_for_path(path_to_meta, p) or None),
        )
        for p in paths_b
    ]

    if len(items_a) != len(items_b):
        return False, f'count mismatch ({len(items_a)} vs {len(items_b)})'

    n = len(items_a)
    adj: List[List[int]] = [[] for _ in range(n)]
    for i, (_pa, da, ta) in enumerate(items_a):
        for j, (_pb, db, tb) in enumerate(items_b):
            if duration_close_enough(da, db) and title_similarity(ta, tb) >= title_min:
                adj[i].append(j)

    # Kuhn augmenting-path bipartite matching (left size n, right size n).
    match_r = [-1] * n

    def aug(u: int, seen: List[bool]) -> bool:
        for v in adj[u]:
            if seen[v]:
                continue
            seen[v] = True
            pu = match_r[v]
            if pu < 0 or aug(pu, seen):
                match_r[v] = u
                return True
        return False

    for u in range(n):
        seen = [False] * n
        aug(u, seen)

    pair_count = sum(1 for v in range(n) if match_r[v] >= 0)
    ok = pair_count == n
    if ok:
        return True, f'matched {n} file(s) by duration and title'
    return (
        False,
        f'no perfect matching ({pair_count}/{n} pairs): duration and/or title mismatch '
        f'(title similarity ≥ {title_min:.2f}, duration tolerance max(5s, 0.5% of longer))',
    )


_EQUIV_TITLE_MIN = 0.72


def mismatch_duration_header(file_label: str) -> str:
    """Second column header for a file-type column (paired name + duration)."""
    return f'{file_label} time'


def mismatch_table_duration_cell(p: Path, path_to_meta: Dict[str, Dict[str, Any]]) -> str:
    return human_duration(meta_for_path(path_to_meta, p).get('duration'))


def _blank_mismatch_row(labels: List[str]) -> Dict[str, str]:
    row: Dict[str, str] = {}
    for lab in labels:
        row[lab] = 'NONE'
        row[mismatch_duration_header(lab)] = '—'
    return row


def _set_mismatch_file_cell(
    row: Dict[str, str],
    lab: str,
    path: Path,
    path_to_meta: Dict[str, Dict[str, Any]],
) -> None:
    row[lab] = path.name
    row[mismatch_duration_header(lab)] = mismatch_table_duration_cell(path, path_to_meta)


def build_equivalence_mismatch_table(
    groups: Dict[str, List[Path]],
    path_to_meta: Dict[str, Dict[str, Any]],
    title_min: float = _EQUIV_TITLE_MIN,
) -> Dict[str, Any]:
    """Rows = equivalence groups; per extension: basename column + duration column (NONE / — if empty)."""
    column_exts = sorted(groups.keys())
    labels = [ext_column_label(e) for e in column_exts]
    flat_columns: List[str] = []
    for lab in labels:
        flat_columns.append(lab)
        flat_columns.append(mismatch_duration_header(lab))
    used: Dict[str, Set[Path]] = {e: set() for e in column_exts}
    rows_out: List[Dict[str, str]] = []

    def pick_best_match(seed: Path, col: str) -> Optional[Path]:
        mp = meta_for_path(path_to_meta, seed)
        ta = best_title_for_compare(seed, mp or None)
        best: Optional[Path] = None
        best_sc = -1.0
        for cand in sorted(groups[col], key=lambda x: x.name.lower()):
            if cand in used[col]:
                continue
            if not paths_match_cross_type_equivalence(seed, cand, path_to_meta, title_min):
                continue
            mq = meta_for_path(path_to_meta, cand)
            tb = best_title_for_compare(cand, mq or None)
            sc = title_similarity(ta, tb)
            if sc > best_sc:
                best_sc, best = sc, cand
        return best

    anchor = max(column_exts, key=lambda e: (len(groups[e]), e))
    for p in sorted(groups[anchor], key=lambda x: x.name.lower()):
        row = _blank_mismatch_row(labels)
        _set_mismatch_file_cell(row, ext_column_label(anchor), p, path_to_meta)
        used[anchor].add(p)
        for col in column_exts:
            if col == anchor:
                continue
            lab = ext_column_label(col)
            best = pick_best_match(p, col)
            if best is not None:
                _set_mismatch_file_cell(row, lab, best, path_to_meta)
                used[col].add(best)
        rows_out.append(row)

    while True:
        seed_col: Optional[str] = None
        seed_path: Optional[Path] = None
        for col in column_exts:
            for cand in sorted(groups[col], key=lambda x: x.name.lower()):
                if cand not in used[col]:
                    seed_col, seed_path = col, cand
                    break
            if seed_path is not None:
                break
        if seed_path is None:
            break
        row = _blank_mismatch_row(labels)
        assert seed_col is not None
        _set_mismatch_file_cell(row, ext_column_label(seed_col), seed_path, path_to_meta)
        used[seed_col].add(seed_path)
        for col in column_exts:
            if col == seed_col:
                continue
            lab = ext_column_label(col)
            best = pick_best_match(seed_path, col)
            if best is not None:
                _set_mismatch_file_cell(row, lab, best, path_to_meta)
                used[col].add(best)
        rows_out.append(row)

    return {'columns': flat_columns, 'rows': rows_out}


def format_equivalence_mismatch_table_plain(columns: List[str], rows: List[Dict[str, str]]) -> List[str]:
    """Aligned plain-text table lines (no leading path indent)."""
    if not columns or not rows:
        return []
    widths = [
        max(len(c), max(len(r.get(c, '')) for r in rows)) for c in columns
    ]
    lines: List[str] = []
    lines.append(' | '.join(columns[i].ljust(widths[i]) for i in range(len(columns))))
    lines.append('-+-'.join('-' * widths[i] for i in range(len(columns))))
    for r in rows:
        lines.append(' | '.join(r.get(c, '').ljust(widths[i]) for i, c in enumerate(columns)))
    return lines


def video_cross_type_equivalence_report(
    video_files: List[Path],
    visual_rows: List[Dict[str, Any]],
    root_is_dir: bool,
) -> Dict[str, Any]:
    """Group videos by extension; pairwise verify equivalent content across types."""
    groups = group_videos_by_extension(video_files)
    path_to_meta: Dict[str, Dict[str, Any]] = {}
    for row in visual_rows:
        if row.get('media') != 'video':
            continue
        p = row.get('path')
        if not isinstance(p, str):
            continue
        path_to_meta[p] = row
        try:
            path_to_meta[str(Path(p).resolve())] = row
        except OSError:
            pass

    exts = list(groups.keys())
    summary_groups = {ext.lstrip('.') or ext: [str(p) for p in paths] for ext, paths in groups.items()}

    if not root_is_dir or not video_files:
        return {
            'applicable': False,
            'verified': None,
            'message': 'Cross-type equivalence: not applicable (not a directory or no video files).',
            'groups_by_extension': summary_groups,
            'pairs': [],
            'mismatch_table': None,
        }

    if len(exts) < 2:
        only = exts[0].lstrip('.') if exts else '?'
        return {
            'applicable': False,
            'verified': None,
            'message': f'Cross-type equivalence: not applicable (single video extension: {only}).',
            'groups_by_extension': summary_groups,
            'pairs': [],
            'mismatch_table': None,
        }

    pairs_out: List[Dict[str, Any]] = []
    all_ok = True
    for i in range(len(exts)):
        for j in range(i + 1, len(exts)):
            e1, e2 = exts[i], exts[j]
            ok, reason = _try_match_extension_pair(groups[e1], groups[e2], path_to_meta)
            all_ok = all_ok and ok
            pairs_out.append(
                {
                    'a': e1.lstrip('.'),
                    'b': e2.lstrip('.'),
                    'verified': ok,
                    'detail': reason,
                }
            )

    if all_ok:
        msg = (
            'Cross-type equivalence: verified — for every distinct extension pair, '
            'file counts match and files pair one-to-one by duration and title '
            '(filename or embedded format title).'
        )
    else:
        bad = [f"{p['a']}↔{p['b']}" for p in pairs_out if not p['verified']]
        if len(bad) <= 6:
            bad_txt = ', '.join(bad)
            tail = ' See pair details in JSON (--json).'
        else:
            bad_txt = f'{len(bad)} extension pair(s)'
            tail = ' Per-pair reasons are in video_cross_type_equivalence.pairs (--json).'
        msg = (
            'Cross-type equivalence: NOT verified — one or more extension pairs '
            f'failed ({bad_txt}).{tail}'
        )

    mismatch_table: Optional[Dict[str, Any]] = None
    if not all_ok:
        mismatch_table = build_equivalence_mismatch_table(groups, path_to_meta)

    return {
        'applicable': True,
        'verified': all_ok,
        'message': msg,
        'groups_by_extension': summary_groups,
        'pairs': pairs_out,
        'mismatch_table': mismatch_table,
    }


def classify(
    root: Path,
    video_files: List[Path],
    audio_files: List[Path],
    ebook_files: List[Path],
    image_files: List[Path],
) -> Tuple[str, str]:
    n_v, n_a, n_e, n_i = len(video_files), len(audio_files), len(ebook_files), len(image_files)

    if n_v:
        if root.is_file():
            if looks_like_episode(root.name):
                return 'series', 'episode pattern in video filename'
            return 'movie', 'single video file'

        episodic = sum(1 for f in video_files if video_file_looks_episodic(f, root))
        if n_v >= 2 and (episodic >= 1 or n_v >= 3):
            return 'series', f'{n_v} video files ({episodic} with episode/season naming)'
        if n_v >= 2:
            return 'movie', f'{n_v} video files, no episode/season naming'
        if episodic:
            return 'series', 'episode pattern in path'
        return 'movie', 'single video file in directory'

    if n_a and not n_v:
        return 'album', f'{n_a} audio file(s)'

    if n_e and not n_v and not n_a:
        return 'ebook', f'{n_e} ebook file(s)'

    if n_i and not n_v and not n_a and not n_e:
        return 'unknown', f'{n_i} image file(s) only'

    if n_e and (n_a or n_v):
        return 'unknown', 'mixed ebook with video/audio'
    if n_a and n_e:
        return 'unknown', 'mixed audio and ebook'
    if n_i and (n_v or n_a or n_e):
        return 'unknown', 'images mixed with other media'

    return 'unknown', 'no recognized media files'


def _equivalence_report_skipped() -> Dict[str, Any]:
    """Stub when cross-type equivalence was not computed (plain non-verbose)."""
    return {
        'applicable': False,
        'verified': None,
        'message': '',
        'groups_by_extension': {},
        'pairs': [],
        'mismatch_table': None,
    }


def analyze_path(path: Path, *, full: bool = True) -> Dict[str, object]:
    path = path.expanduser()
    if not path.exists():
        veq = (
            video_cross_type_equivalence_report([], [], False)
            if full
            else _equivalence_report_skipped()
        )
        return {
            'path': str(path),
            'type': 'missing',
            'kind': 'unknown',
            'detail': 'does not exist',
            'media_types': [],
            'other_types': [],
            'sizes': {
                'video_bytes': 0,
                'audio_bytes': 0,
                'ebook_bytes': 0,
                'image_bytes': 0,
                'total_bytes': 0,
                'video_human': '0 B',
                'audio_human': '0 B',
                'ebook_human': '0 B',
                'image_human': '0 B',
                'total_human': '0 B',
            },
            'visual_metadata': [],
            'video_cross_type_equivalence': veq,
        }

    exts, v, a, e, imgs, other = gather_media(path)
    kind, detail = classify(path, v, a, e, imgs)
    sv, sa, se, si = sum_file_sizes(v), sum_file_sizes(a), sum_file_sizes(e), sum_file_sizes(imgs)
    st = sv + sa + se + si
    if full:
        vis = visual_metadata_for_paths(v, imgs)
        v_equiv = video_cross_type_equivalence_report(v, vis, path.is_dir())
    else:
        # Probe only the top-5 video files by size so compact output can show
        # size + duration without running ffprobe on every file.
        if v and len(v) < 25:
            top_v = sorted(v, key=file_size_bytes, reverse=True)[:5]
            vis = visual_metadata_for_paths(top_v, [])
        else:
            vis = []
        v_equiv = _equivalence_report_skipped()
    return {
        'path': str(path.resolve()),
        'type': path_entry_type(path),
        'kind': kind,
        'detail': detail,
        'media_types': formats_for_output(exts),
        'other_types': other,
        'sizes': {
            'video_bytes': sv,
            'audio_bytes': sa,
            'ebook_bytes': se,
            'image_bytes': si,
            'total_bytes': st,
            'video_human': human_size(sv),
            'audio_human': human_size(sa),
            'ebook_human': human_size(se),
            'image_human': human_size(si),
            'total_human': human_size(st),
        },
        'visual_metadata': vis,
        'video_cross_type_equivalence': v_equiv,
    }


def diff_projection(row: Dict[str, Any]) -> Dict[str, Any]:
    eq = row.get('video_cross_type_equivalence')
    eq_applicable = None
    eq_verified = None
    eq_message = None
    if isinstance(eq, dict):
        eq_applicable = eq.get('applicable')
        eq_verified = eq.get('verified')
        eq_message = eq.get('message')
    sizes = row.get('sizes') if isinstance(row.get('sizes'), dict) else {}
    return {
        'type': row.get('type'),
        'kind': row.get('kind'),
        'detail': row.get('detail'),
        'media_types': row.get('media_types') or [],
        'other_types': row.get('other_types') or [],
        'video_bytes': sizes.get('video_bytes', 0),
        'audio_bytes': sizes.get('audio_bytes', 0),
        'ebook_bytes': sizes.get('ebook_bytes', 0),
        'image_bytes': sizes.get('image_bytes', 0),
        'total_bytes': sizes.get('total_bytes', 0),
        'visual_metadata_count': len(row.get('visual_metadata') or []),
        'video_cross_type_equivalence_applicable': eq_applicable,
        'video_cross_type_equivalence_verified': eq_verified,
        'video_cross_type_equivalence_message': eq_message,
    }


def jsonable_value(v: Any) -> Any:
    if isinstance(v, Path):
        return str(v)
    if isinstance(v, list):
        return [jsonable_value(x) for x in v]
    if isinstance(v, dict):
        return {str(k): jsonable_value(x) for k, x in v.items()}
    return v


def format_diff_value(v: Any) -> str:
    if isinstance(v, list):
        return ', '.join(str(x) for x in v) if v else '—'
    if v in (None, ''):
        return '—'
    return str(v)


def maybe_quote_path_for_display(path_text: str) -> str:
    """Quote path text only when needed for clear terminal display."""
    if not path_text:
        return "''"
    if re.search(r"[\s\"'\\$`!&|;<>()[\]{}]", path_text):
        return shlex.quote(path_text)
    return path_text


def diff_suppress_equal_field(field: str, value: Any) -> bool:
    """Hide redundant equal lines in --diff output (plain and JSON equal_fields)."""
    if field == 'video_cross_type_equivalence_verified' and value is None:
        return True
    if field == 'other_types' and value == []:
        return True
    if field == 'audio_bytes' and value == 0:
        return True
    if field == 'ebook_bytes' and value == 0:
        return True
    if field == 'video_cross_type_equivalence_message':
        if isinstance(value, str) and 'not applicable' in value.lower():
            return True
    return False


def emit_diff_output(path_a: str, path_b: str, row_a: Dict[str, Any], row_b: Dict[str, Any], as_json: bool) -> None:
    shown_a = maybe_quote_path_for_display(path_a)
    shown_b = maybe_quote_path_for_display(path_b)
    proj_a = diff_projection(row_a)
    proj_b = diff_projection(row_b)
    fields = list(proj_a.keys())
    diffs: Dict[str, Dict[str, Any]] = {}
    equals: Dict[str, Any] = {}
    for field in fields:
        va = proj_a.get(field)
        vb = proj_b.get(field)
        if va == vb:
            equals[field] = jsonable_value(va)
        else:
            diffs[field] = {
                'left': jsonable_value(va),
                'right': jsonable_value(vb),
            }

    def _top_videos_json(row: Dict[str, Any]) -> List[Dict[str, Any]]:
        vis = row.get('visual_metadata') or []
        out: List[Dict[str, Any]] = []
        for r in top_videos_by_size(vis):
            rb = resolution_brief(r)
            entry: Dict[str, Any] = {
                'path': r['path'],
                'size_bytes': r.get('size_bytes', 0),
                'size_human': human_size(r.get('size_bytes', 0)),
                'width': r.get('width'),
                'height': r.get('height'),
                'resolution': rb if rb != '—' else None,
                'duration': r.get('duration'),
                'duration_human': human_duration(r.get('duration')),
                'subtitles': r.get('subtitles') or [],
                'subtitles_brief': format_subtitles_brief(r.get('subtitles') or []),
            }
            out.append(entry)
        return out

    if as_json:
        equals_filtered = {
            k: v
            for k, v in equals.items()
            if not diff_suppress_equal_field(k, proj_a.get(k))
        }
        out = {
            'left_path': str(Path(path_a).expanduser()),
            'right_path': str(Path(path_b).expanduser()),
            'same': len(diffs) == 0,
            'different_field_count': len(diffs),
            'total_compared_fields': len(fields),
            'differences': diffs,
            'equal_fields': equals_filtered,
            'top_videos_left': _top_videos_json(row_a),
            'top_videos_right': _top_videos_json(row_b),
        }
        print(json.dumps(out, ensure_ascii=False), flush=True)
        return

    print(f'compare: {shown_a} <> {shown_b}', flush=True)
    print(f'  < {shown_a}', flush=True)
    print(f'  > {shown_b}', flush=True)
    print('  ------------------------------------------------------------', flush=True)
    equal_fields = []
    different_fields = []
    for field in fields:
        va = proj_a.get(field)
        vb = proj_b.get(field)
        if va == vb:
            equal_fields.append((field, va))
        else:
            different_fields.append((field, va, vb))

    suppressed_equal = 0
    for field, va in equal_fields:
        if diff_suppress_equal_field(field, va):
            suppressed_equal += 1
            continue
        print(f'  = {field}: {format_diff_value(va)}', flush=True)
    for field, va, vb in different_fields:
        print(f'  ! {field}', flush=True)
        print(f'    < {format_diff_value(va)}', flush=True)
        print(f'    > {format_diff_value(vb)}', flush=True)
    print('  ------------------------------------------------------------', flush=True)
    shown_equal = len(equal_fields) - suppressed_equal
    print(
        f'  summary: {len(diffs)} different field(s), {shown_equal} equal field(s)',
        flush=True,
    )
    for side_label, side_shown, side_row in (('<', shown_a, row_a), ('>', shown_b, row_b)):
        top = top_videos_by_size(side_row.get('visual_metadata') or [])
        if top:
            print(f'  {side_label} {side_shown} — top video files by size:', flush=True)
            for r in top:
                name = Path(str(r['path'])).name
                sz = human_size(r.get('size_bytes', 0))
                res = resolution_brief(r)
                dur = human_duration(r.get('duration'))
                subs = format_subtitles_brief(r.get('subtitles') or [])
                print(f'      {sz:<8}  {res:<12}  {dur}  {name}  subs {subs}', flush=True)


def equivalence_status_label(eq: Optional[Dict[str, Any]]) -> str:
    """Short label for video_cross_type_equivalence: verified | N/A | not equivalent."""
    if not eq:
        return 'N/A'
    if not eq.get('applicable'):
        return 'N/A'
    if eq.get('verified') is True:
        return 'verified'
    return 'not equivalent'


def plain_type_kind_labels(row: Dict[str, Any]) -> str:
    """Type and classification for compact plain output, e.g. 'Directory, Series'."""
    t = str(row.get('type') or 'unknown')
    k = str(row.get('kind') or 'unknown')

    def cap_words(s: str) -> str:
        return ' '.join(p.capitalize() for p in s.split())

    return f'{cap_words(t)}, {cap_words(k)}'


def compact_detail_with_extensions(row: Dict[str, Any]) -> str:
    """Classification detail plus (extensions: …) when media_types are known."""
    detail = str(row.get('detail') or '')
    media_raw = row.get('media_types') or []
    media: List[str] = (
        [str(m) for m in media_raw] if isinstance(media_raw, list) else []
    )
    if not media:
        return detail

    dots = ', '.join(m if m.startswith('.') else f'.{m}' for m in media)
    ext_seg = f' (extensions: {dots})'

    m = re.match(r'^(\d+\s+video\s+files)\s+(\([^)]*\))$', detail)
    if m:
        return f'{m.group(1)}{ext_seg} {m.group(2)}'

    return f'{detail}{ext_seg}' if detail else ext_seg.strip()


def main(argv: Optional[List[str]] = None) -> int:
    p = argparse.ArgumentParser(description='Classify media paths (movie/series/album/ebook).')
    p.add_argument('paths', nargs='*', help='Files or directories')
    p.add_argument('--json', action='store_true', help='NDJSON output')
    p.add_argument(
        '-v',
        '--verbose',
        action='store_true',
        help=(
            'Plain default mode only: print the full multi-line report per path '
            '(ffprobe visual lines and cross-type equivalence). '
            'Ignored with --json. Without -v, default plain output skips that work '
            'and prints one tab-separated summary line per path after the path.'
        ),
    )
    p.add_argument(
        '-m',
        '--media',
        dest='media_only',
        action='store_true',
        help='Output only the media: line per path; skips ffprobe and equivalence analysis',
    )
    p.add_argument(
        '-e',
        '--equivalence',
        dest='equivalence_only',
        action='store_true',
        help=(
            'One line per path: equivalence is verified, N/A, or not equivalent (tab-separated). '
            'With --json: {"path", "equivalence"} per line. '
            'With -c/--classification, only matching classifications are processed.'
        ),
    )
    p.add_argument(
        '-c',
        '--classification',
        dest='kind_filter',
        choices=['movie', 'series', 'album', 'ebook', 'unknown'],
        metavar='CLASS',
        help=(
            'Only emit paths classified as CLASS. '
            'Valid CLASS values: movie|series|album|ebook|unknown. Plain text: one path per line. '
            'With --json: only matching rows (NDJSON).'
        ),
    )
    p.add_argument(
        '-d',
        '--diff',
        dest='diff_paths',
        nargs=2,
        metavar=('PATH_A', 'PATH_B'),
        help=(
            'Compare two paths and report equal/different analysis fields. '
            'If PATH_B is a directory containing an entry named like PATH_A basename, '
            'PATH_A is compared against PATH_B/<basename>.'
        ),
    )
    args = p.parse_args(argv)

    if args.diff_paths:
        if args.media_only:
            p.error('--diff cannot be combined with --media')
        if args.equivalence_only:
            p.error('--diff cannot be combined with --equivalence')
        if args.kind_filter:
            p.error('--diff cannot be combined with --classification')
        if args.paths:
            p.error('positional paths are not allowed with --diff; pass exactly two paths to --diff')
        left, right = args.diff_paths
        left_path = Path(left).expanduser()
        right_path = Path(right).expanduser()
        # Convenience: if PATH_B is a directory that contains an entry with the
        # same name as PATH_A's basename, compare against that entry. This lets
        # you pass the parent directory of the counterpart instead of retyping
        # the name (e.g. `--diff /media/The.Matrix /backup` compares against
        # /backup/The.Matrix when it exists).
        if left_path.name and right_path.is_dir():
            candidate = right_path / left_path.name
            if candidate.exists():
                right_path = candidate
                right = str(candidate)
        missing = []
        if not left_path.exists():
            missing.append(left)
        if not right_path.exists():
            missing.append(right)
        if missing:
            shown_missing = [maybe_quote_path_for_display(m) for m in missing]
            print(
                'dg-whatis: error: --diff path does not exist: ' + ', '.join(shown_missing),
                file=sys.stderr,
                flush=True,
            )
            return 2
        row_left = analyze_path(left_path)
        row_right = analyze_path(right_path)
        emit_diff_output(left, right, row_left, row_right, args.json)
        return 0

    if not args.paths:
        p.error('at least one path is required')

    need_full_analysis = args.json or args.verbose or args.equivalence_only

    if args.media_only:
        rows_m: List[Tuple[str, str]] = []
        for x in args.paths:
            path = Path(x).expanduser()
            if path.exists():
                exts, _v, _a, _e, _imgs, _other = gather_media(path)
                media = ', '.join(formats_for_output(exts)) if exts else '—'
            else:
                media = '—'
            rows_m.append((media, x))
        col_w = max(len(m) for m, _ in rows_m)
        for media, x in rows_m:
            print(f'{media.ljust(col_w)}  {x}', flush=True)
        return 0

    for x in args.paths:
        row = analyze_path(Path(x), full=need_full_analysis)
        if args.kind_filter and row['kind'] != args.kind_filter:
            continue
        if args.equivalence_only:
            lab = equivalence_status_label(row.get('video_cross_type_equivalence'))
            if args.json:
                print(
                    json.dumps(
                        {'path': row['path'], 'equivalence': lab},
                        ensure_ascii=False,
                    ),
                    flush=True,
                )
            else:
                w = len('not equivalent')
                print(f'{lab.ljust(w)}\t{row["path"]}', flush=True)
            continue
        if args.json:
            row_out = dict(row)
            veq = row_out.get('video_cross_type_equivalence')
            if isinstance(veq, dict):
                row_out['video_cross_type_equivalence'] = {
                    k: v for k, v in veq.items() if k != 'mismatch_table'
                }
            print(json.dumps(row_out, ensure_ascii=False), flush=True)
            continue
        if args.kind_filter:
            print(row['path'], flush=True)
            continue
        media = ', '.join(row['media_types']) if row['media_types'] else '—'
        sz = row['sizes']
        ts = file_timestamp(Path(row['path']))
        if not args.verbose:
            print(row['path'], flush=True)
            detail_col = compact_detail_with_extensions(row)
            print(
                f'  {sz["total_human"]}\t{human_date(ts)}\t{plain_type_kind_labels(row)}\t{detail_col}',
                flush=True,
            )
            top = top_videos_by_size(row.get('visual_metadata') or [])
            if top:
                print('  top video files by size:', flush=True)
                for r in top:
                    name = Path(str(r['path'])).name
                    sv = human_size(r.get('size_bytes', 0))
                    res = resolution_brief(r)
                    dur = human_duration(r.get('duration'))
                    print(f'    {sv:<8}  {res:<12}  {dur}  {name}', flush=True)
            continue
        print(row['path'], flush=True)
        print(f"  type: {row['type']}", flush=True)
        print(f"  classification: {row['kind']} — {row['detail']}", flush=True)
        print(f"  media: {media}", flush=True)
        size_parts: List[str] = []
        if sz['video_bytes']:
            size_parts.append(f"{sz['video_human']} video")
        if sz['audio_bytes']:
            size_parts.append(f"{sz['audio_human']} audio")
        if sz['ebook_bytes']:
            size_parts.append(f"{sz['ebook_human']} ebook")
        if sz.get('image_bytes'):
            size_parts.append(f"{sz['image_human']} image")
        if size_parts:
            print(
                f"  sizes: {', '.join(size_parts)} ({sz['total_human']} total)",
                flush=True,
            )
        else:
            print('  sizes: —', flush=True)
        if row['other_types']:
            print(f"  other: {', '.join(row['other_types'])}", flush=True)
        print(f"  timestamp: {human_date(ts)}", flush=True)
        eq = row.get('video_cross_type_equivalence')
        if eq and (eq.get('groups_by_extension') or {}):
            g = eq.get('groups_by_extension') or {}
            if g:
                print('  video by extension:', flush=True)
                for ext_label in sorted(g.keys()):
                    plist = g[ext_label] or []
                    names = [Path(s).name for s in plist]
                    cap = 8
                    shown = ', '.join(names[:cap])
                    extra = len(names) - cap
                    tail = f', … (+{extra} more)' if extra > 0 else ''
                    print(
                        f'    {ext_label} ({len(names)}): {shown}{tail}',
                        flush=True,
                    )
            print(f"  {eq.get('message', '')}", flush=True)
            mt = eq.get('mismatch_table')
            if (
                eq.get('applicable')
                and eq.get('verified') is False
                and isinstance(mt, dict)
                and mt.get('rows')
            ):
                print('  cross-type mismatch table:', flush=True)
                cols = mt.get('columns') or []
                for ln in format_equivalence_mismatch_table_plain(cols, mt['rows']):
                    print(f'    {ln}', flush=True)
        vis = row.get('visual_metadata') or []
        top = top_videos_by_size(vis)
        if top:
            print('  top video files by size:', flush=True)
            for r in top:
                name = Path(str(r['path'])).name
                sz = human_size(r.get('size_bytes', 0))
                res = resolution_brief(r)
                dur = human_duration(r.get('duration'))
                print(f'    {sz:<8}  {res:<12}  {dur}  {name}', flush=True)
        if vis:
            cap = 20
            for meta in vis[:cap]:
                print(f"  visual: {format_visual_line(meta)}", flush=True)
            rest = len(vis) - cap
            if rest > 0:
                print(f"  visual: … and {rest} more file(s) (use --json for full list)", flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
