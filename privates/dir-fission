#!/usr/bin/env bash
set -euo pipefail

dry_run_flag=''
prog="$(basename "$0")"
dest_override=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run|-n)
            dry_run_flag="--dry-run"
            shift
            ;;
        -o)
            dest_override="$2"
            shift 2
            ;;
        -*)
            echo "Error: unknown option: $1" >&2
            echo "Usage: $prog [--dry-run|-n] [-o <dest>] <source> [source ...]" >&2
            echo "  --dry-run|-n: show what would be done without actually doing it" >&2
            echo "  -o <dest>: destination directory (overrides \$DIR_FISSION_DEST_DIR)" >&2
            echo "  source: source directory to move video files from" >&2
            echo "" >&2
            echo "  What this does: Move files with certain extensions to dest dir, preserving dir structure." >&2
            echo "    file types moved: .mkv .avi .mov .webm .ogm (and uppercase variants)" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

aparams=("$@")
if [[ ${#aparams[@]} -eq 0 ]]; then
    echo "Usage: $prog [--dry-run|-n] [-o <dest>] <source> [source ...]"
    echo "  moved: .mkv .avi .mov .webm .ogm (and uppercase variants)"
    echo "  left alone: .mp4 .m4v and all other file types"
    exit 1
fi

if [[ -n "$dest_override" ]]; then
    dst="$dest_override"
elif [[ -z "${DIR_FISSION_DEST_DIR:-}" ]]; then
    echo "Error: DIR_FISSION_DEST_DIR is not set and -o was not provided" >&2
    exit 1
else
    dst="$DIR_FISSION_DEST_DIR"
fi

# This is slow and uses lots of space, but necessary if you are crossing filesystems. Don't Cross Filesystems.
# rsync $dry_run_flag -ar -vv \
#   --include='*/' \
#   --include='*.mkv' \
#   --include='*.avi' \
#   --include='*.mov' \
#   --include='*.MKV' \
#   --include='*.AVI' \
#   --include='*.MOV' \
#   --exclude='*' \
#   --remove-source-files \
#   "$src"/ "$dst"/


for src in "${aparams[@]}"; do
    # Strip trailing slash so dirname works correctly.
    src="${src%/}"
    src_parent="$(dirname "$src")"
    find "$src" -type f \( -name '*.mkv' -o -name '*.MKV' -o -name '*.avi' -o -name '*.AVI' -o -name '*.mov' -o -name '*.MOV' -o -name '*.webm' -o -name '*.WEBM' -o -name '*.ogm' -o -name '*.OGM' \) -print0 |
        while IFS= read -r -d '' f; do
            rel_path="${f#$src_parent/}"
            if [[ -n "$dry_run_flag" ]]; then
                echo "[dry-run] mv $f $dst/$rel_path"
            else
                mkdir -p "$dst/$(dirname "$rel_path")"
                set -x
                mv "$f" "$dst/$rel_path"
                { set +x; } 2>/dev/null
            fi
        done
done
if [[ -z "$dry_run_flag" ]]; then
    echo ""
    echo "Moved all non-mp4/non-m4v video files to $dst"
fi