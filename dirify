#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
Usage: dirify FILE [FILE ...]

For each file, create a directory in the current working directory named
after that file (basename, extension removed), then move the file into it.
EOF
  exit 0
fi

if [[ $# -eq 0 ]]; then
  echo "Usage: dirify FILE [FILE ...]" >&2
  exit 1
fi

for f in "$@"; do
  if [[ ! -e "$f" ]]; then
    echo "dirify: not found: $f" >&2
    exit 1
  fi
done

for f in "$@"; do
  base=$(basename -- "$f")
  name="${base%.*}"
  if [[ -z "$name" || "$name" == "$base" ]]; then
    name="$base"
  fi
  mkdir -p -- "$name"
  mv -- "$f" "$name/"
done
