#!/usr/bin/env bash
set -o errexit # set -e
set -o pipefail
script_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
script_file=$(basename "$0")

get-secret() {
    varname=$1
    secret_keyname=$2
    secret_valname=$3
    
    val="$(eval echo \$$varname)"

    set +e

    if [[ -z "$val" ]]; then
        eval $varname="$(secret-tool lookup $secret_keyname $secret_valname)"
        val="$(eval echo \$$varname)"
    fi

    if [[ -z "$val" ]]; then
        echo "ERROR: Either export $varname=/the/mount/dir (but don't!),
        OR: Use secrets:

        secret-tool store --label='blah blah' $secret_keyname $secret_valname
        "
        exit 1
    fi

    set -e

}

get-secret SYNOLOGY_USERNAME synology username
get-secret SYNOLOGY_PASSWORD synology password
get-secret SYNOLOGY_IP synology ip
get-secret SYNOLOGY_MOUNT_DIR synology mount-dir
    
sudo mount -t cifs -o username=$SYNOLOGY_USERNAME,password="$SYNOLOGY_PASSWORD",uid=$UID,gid=$GID "//$SYNOLOGY_IP/cschuyle" "$SYNOLOGY_MOUNT_DIR"
cat <<EOF 1>&2
Mounted Synology dir at $SYNOLOGY_MOUNT_DIR
To unmount:
sudo umount $SYNOLOGY_MOUNT_DIR
EOF