#!/usr/bin/env bash
set -euo pipefail

dry_run_flag=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run|-n)
            dry_run_flag="--dry-run"
            shift
            ;;
        -*)
            echo "Usage: $0 [--dry-run|-n] <source> [source ...]"
            echo "  --dry-run|-n: show what would be done without actually doing it"
            echo "  source: source directory to move video files from"
            echo "  destination is always: \$DRAGNON_MYDATA_ROOT/_Originals"

            exit 1
            ;;
        *)
            break
            ;;
    esac
done

aparams=("$@")
if [[ ${#aparams[@]} -eq 0 ]]; then
    echo "Usage: $0 [--dry-run|-n] <source> [source ...]"
    exit 1
fi

dst="$DRAGNON_MYDATA_ROOT/_Originals"

# This is slow and uses lots of space, but necessary if you are crossing filesystems. Don't Cross Filesystems.
# rsync $dry_run_flag -ar -vv \
#   --include='*/' \
#   --include='*.mkv' \
#   --include='*.avi' \
#   --include='*.mov' \
#   --include='*.MKV' \
#   --include='*.AVI' \
#   --include='*.MOV' \
#   --exclude='*' \
#   --remove-source-files \
#   "$src"/ "$dst"/


for src in "${aparams[@]}"; do
    find "$src"/ -type f \( -name '*.mkv' -o -name '*.MKV' -o -name '*.avi' -o -name '*.AVI' -o -name '*.mov' -o -name '*.MOV' \) -print0 |
        while IFS= read -r -d '' f; do
            rel_path="${f#$src/}"
            mkdir -p "$dst/$(dirname "$rel_path")"
            set -x
            mv "$f" "$dst/$rel_path"
            { set +x; } 2>/dev/null
        done
done

echo ""
echo "Moved all non-mp4 video files to $dst"