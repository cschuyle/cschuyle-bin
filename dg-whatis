#!/usr/bin/env python3
"""Classify paths as movie, series, album, or ebook using filesystem heuristics.

Usage: dg-whatis [--json] [-media|--media] <path> [path ...]

  -media / --media  Only print paths that have at least one identified
                     video, audio, or ebook extension (under scan rules).

Content types (one primary kind per path):
  movie, series, album, ebook, unknown

Media formats listed when present (by extension). Canonical labels include
mp4, avi, flac, mp3, mobi, pdf; other extensions in the same families appear
as their suffix (e.g. mkv, epub, m4a).

Non-media / download state (other_types when present):
  qb-partial — qBittorrent incomplete file (.!qB suffix, e.g. video.mkv.!qB)
  part — generic partial download (.part suffix)

Heuristics: video present -> movie vs series from filenames/paths (S01E02,
season N, 1x02, etc.) and file counts; else audio -> album; else ebooks only
-> ebook. Mixed ebook+audio/video is reported as unknown.

Each path also has type: file | directory | symlink to directory (or missing
if the path does not exist).

Detected media file sizes (video / audio / ebook buckets and total) are reported
in human-readable binary units (K, M, G, T from 1024).

Directory scans recurse at most SCAN_MAX_DEPTH path components below the root
(e.g. depth 3: root/a/b/file.ext — not root/a/b/c/file.ext).

Video and image files under the same scan rules get optional stream metadata
(resolution, duration, codec; embedded subtitle tracks with language and codec)
via ffprobe when it is on PATH; see visual_metadata in JSON output and the
visual: section in plain text.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Set, Tuple

VIDEO_EXTENSIONS = {
    '.mp4', '.m4v', '.mkv', '.avi', '.mov', '.webm', '.wmv', '.mpg', '.mpeg',
}
AUDIO_EXTENSIONS = {
    '.mp3', '.flac', '.wav', '.aac', '.m4a', '.ogg', '.opus', '.wma', '.alac',
}
EBOOK_EXTENSIONS = {
    '.mobi', '.azw', '.azw3', '.epub', '.pdf', '.fb2', '.djvu',
}
IMAGE_EXTENSIONS = {
    '.jpg', '.jpeg', '.png', '.gif', '.webp', '.bmp', '.tif', '.tiff',
    '.heic', '.heif', '.avif', '.jxl', '.ico',
}

CANONICAL_MEDIA_LABELS = {
    '.mp4': 'mp4',
    '.avi': 'avi',
    '.flac': 'flac',
    '.mp3': 'mp3',
    '.mobi': 'mobi',
    '.pdf': 'pdf',
}

_EPISODE_RE = re.compile(
    r'(?i)(\bs\d{1,2}\s*e\d{1,3}\b|\bseason\s*\d{1,2}\b|\bep(?:isode)?\s*\d{1,3}\b|\b\d{1,2}x\d{1,3}\b)'
)

# qBittorrent uses a trailing ".!qB" on the incomplete file (suffix may be ".!qB").
_QB_PARTIAL_SUFFIX = '.!qb'  # lowercase for comparison

# Max path segments under a directory root (including filename) when scanning.
SCAN_MAX_DEPTH = 3


def human_size(n: int) -> str:
    """Format byte count using binary K/M/G/T (1024-based)."""
    if n < 0:
        n = 0
    if n < 1024:
        return f'{n} B'
    labels = ('K', 'M', 'G', 'T', 'P')
    v = float(n)
    i = -1
    while v >= 1024 and i + 1 < len(labels):
        v /= 1024
        i += 1
    s = f'{v:.1f}'.rstrip('0').rstrip('.')
    return f'{s}{labels[i]}'


def file_size_bytes(p: Path) -> int:
    try:
        return int(p.stat().st_size)
    except OSError:
        return 0

def file_timestamp(p: Path) -> int:
    try:
        return int(p.stat().st_mtime)
    except OSError:
        return -1


def human_date(ts: int) -> str:
    """Format Unix mtime as YYYY-MM-DD (local time)."""
    if ts < 0:
        return '—'
    return datetime.fromtimestamp(ts).strftime('%Y-%m-%d')


def human_duration(seconds: Optional[float]) -> str:
    """Format duration for display; empty input -> em dash."""
    if seconds is None:
        return '—'
    try:
        sec_f = float(seconds)
    except (TypeError, ValueError):
        return '—'
    if sec_f < 0 or sec_f != sec_f:  # NaN
        return '—'
    s = int(round(sec_f))
    h, r = divmod(s, 3600)
    m, sec = divmod(r, 60)
    if h:
        return f'{h}:{m:02d}:{sec:02d}'
    return f'{m}:{sec:02d}'


def subtitle_tracks_from_probe(data: Dict[str, Any]) -> List[Dict[str, Any]]:
    """Embedded subtitle streams from ffprobe -show_streams JSON."""
    out: List[Dict[str, Any]] = []
    for st in data.get('streams') or []:
        if st.get('codec_type') != 'subtitle':
            continue
        tags = st.get('tags') or {}
        raw = tags.get('language') or tags.get('LANG')
        lang: Optional[str] = None
        if isinstance(raw, str):
            lang = raw.strip() or None
        codec = st.get('codec_name')
        title_raw = tags.get('title')
        entry: Dict[str, Any] = {'codec': codec, 'language': lang}
        if isinstance(title_raw, str) and title_raw.strip() and len(title_raw) <= 120:
            entry['title'] = title_raw.strip()
        out.append(entry)
    return out


def format_subtitles_brief(subs: List[Dict[str, Any]], max_tracks: int = 6) -> str:
    """Compact text for subtitle track list."""
    if not subs:
        return '—'
    parts: List[str] = []
    for s in subs[:max_tracks]:
        lang = s.get('language') or 'und'
        c = s.get('codec') or '?'
        parts.append(f'{lang}/{c}')
    extra = len(subs) - max_tracks
    tail = f' (+{extra})' if extra > 0 else ''
    return ', '.join(parts) + tail


def probe_visual_file(path: Path) -> Dict[str, Any]:
    """Width, height, duration (seconds), codec via ffprobe; values may be null."""
    base: Dict[str, Any] = {
        'path': str(path),
        'width': None,
        'height': None,
        'duration': None,
        'codec': None,
        'subtitles': [],
    }
    ffprobe = shutil.which('ffprobe')
    if not ffprobe:
        base['probe_error'] = 'ffprobe not in PATH'
        return base
    try:
        out = subprocess.run(
            [
                ffprobe,
                '-v',
                'error',
                '-print_format',
                'json',
                '-show_format',
                '-show_streams',
                str(path),
            ],
            capture_output=True,
            text=True,
            timeout=120,
        )
        if out.returncode != 0:
            err = (out.stderr or out.stdout or 'ffprobe failed').strip()
            base['probe_error'] = err[:240] if err else 'ffprobe failed'
            return base
        data = json.loads(out.stdout)
    except subprocess.TimeoutExpired:
        base['probe_error'] = 'ffprobe timeout'
        return base
    except (json.JSONDecodeError, OSError) as e:
        base['probe_error'] = str(e)[:240]
        return base

    width: Optional[int] = None
    height: Optional[int] = None
    codec: Optional[str] = None
    duration: Optional[float] = None

    for st in data.get('streams') or []:
        if st.get('codec_type') != 'video':
            continue
        w, h = st.get('width'), st.get('height')
        if w is not None and h is not None:
            try:
                width, height = int(w), int(h)
            except (TypeError, ValueError):
                pass
        codec = st.get('codec_name') or codec
        if duration is None and st.get('duration') is not None:
            try:
                duration = float(st['duration'])
            except (TypeError, ValueError):
                pass
        if width is not None:
            break

    if duration is None:
        d = (data.get('format') or {}).get('duration')
        if d is not None:
            try:
                duration = float(d)
            except (TypeError, ValueError):
                pass

    base['width'] = width
    base['height'] = height
    base['duration'] = duration
    base['codec'] = codec
    base['subtitles'] = subtitle_tracks_from_probe(data)
    return base


def visual_metadata_for_paths(
    video_files: List[Path],
    image_files: List[Path],
) -> List[Dict[str, Any]]:
    """Probe each path (videos first, then images); skips duplicates."""
    seen: Set[str] = set()
    out: List[Dict[str, Any]] = []
    for label, paths in (('video', video_files), ('image', image_files)):
        for p in paths:
            try:
                key = str(p.resolve())
            except OSError:
                key = str(p)
            if key in seen:
                continue
            seen.add(key)
            meta = probe_visual_file(p)
            meta['media'] = label
            out.append(meta)
    return out


def format_visual_line(meta: Dict[str, Any]) -> str:
    """One-line summary for text mode."""
    label = meta.get('media', '?')
    w, h = meta.get('width'), meta.get('height')
    res = f'{w}×{h}' if w is not None and h is not None else '—'
    dur = human_duration(meta.get('duration'))
    codec = meta.get('codec') or '—'
    rel = Path(str(meta['path'])).name
    err = meta.get('probe_error')
    if err:
        return f'{rel} ({label}): {err}'
    if label == 'video':
        sub_brief = format_subtitles_brief(meta.get('subtitles') or [])
        return f'{rel} ({label}): {res}, {dur}, {codec}; subs {sub_brief}'
    return f'{rel} ({label}): {res}, {dur}, {codec}'


def sum_file_sizes(files: List[Path]) -> int:
    return sum(file_size_bytes(f) for f in files)


def path_entry_type(p: Path) -> str:
    """How the path exists on disk: file, directory, or symlink to directory."""
    if p.is_symlink():
        try:
            target = p.resolve()
        except OSError:
            return 'file'
        if target.is_dir():
            return 'symlink to directory'
        return 'file'
    if p.is_dir():
        return 'directory'
    if p.is_file():
        return 'file'
    return 'file'


def other_file_tags(f: Path) -> Set[str]:
    """Tags for partial / downloader artifacts (not primary media kind)."""
    tags: Set[str] = set()
    suf = f.suffix.lower()
    if suf == _QB_PARTIAL_SUFFIX or f.name.lower().endswith('.!qb'):
        tags.add('qb-partial')
    if suf == '.part':
        tags.add('part')
    return tags


def iter_files(root: Path) -> Iterable[Path]:
    if root.is_file():
        yield root
        return
    if not root.is_dir():
        return
    try:
        root_r = root.resolve()
    except OSError:
        return
    for dirpath, dirnames, filenames in os.walk(root_r, topdown=True, followlinks=False):
        cur = Path(dirpath)
        try:
            rel = cur.relative_to(root_r)
        except ValueError:
            dirnames[:] = []
            continue
        if len(rel.parts) >= SCAN_MAX_DEPTH:
            dirnames[:] = []
        for name in filenames:
            fp = cur / name
            try:
                frel = fp.relative_to(root_r)
            except ValueError:
                continue
            if len(frel.parts) > SCAN_MAX_DEPTH:
                continue
            try:
                if fp.is_file():
                    yield fp
            except OSError:
                continue


def looks_like_episode(name: str) -> bool:
    return bool(_EPISODE_RE.search(name))


def names_from_file_up_to_root(f: Path, root: Path) -> List[str]:
    out = [f.name]
    root_r = root.resolve()
    cur = f.parent.resolve()
    while cur != root_r and cur != cur.parent:
        out.append(cur.name)
        cur = cur.parent
    return out


def gather_media(
    root: Path,
) -> Tuple[Set[str], List[Path], List[Path], List[Path], List[Path], List[str]]:
    exts: Set[str] = set()
    video_files: List[Path] = []
    audio_files: List[Path] = []
    ebook_files: List[Path] = []
    image_files: List[Path] = []
    other_types: Set[str] = set()
    for f in iter_files(root):
        other_types |= other_file_tags(f)
        suf = f.suffix.lower()
        # Skip qB partial / .part for media buckets (not finished media)
        if suf == _QB_PARTIAL_SUFFIX or f.name.lower().endswith('.!qb') or suf == '.part':
            continue
        if suf in VIDEO_EXTENSIONS:
            video_files.append(f)
            exts.add(suf)
        elif suf in AUDIO_EXTENSIONS:
            audio_files.append(f)
            exts.add(suf)
        elif suf in EBOOK_EXTENSIONS:
            ebook_files.append(f)
            exts.add(suf)
        elif suf in IMAGE_EXTENSIONS:
            image_files.append(f)
            exts.add(suf)
    return exts, video_files, audio_files, ebook_files, image_files, sorted(other_types)


def formats_for_output(exts: Set[str]) -> List[str]:
    return [CANONICAL_MEDIA_LABELS.get(s, s.lstrip('.')) for s in sorted(exts)]


def video_file_looks_episodic(f: Path, root: Path) -> bool:
    return any(looks_like_episode(n) for n in names_from_file_up_to_root(f, root))


def classify(
    root: Path,
    video_files: List[Path],
    audio_files: List[Path],
    ebook_files: List[Path],
    image_files: List[Path],
) -> Tuple[str, str]:
    n_v, n_a, n_e, n_i = len(video_files), len(audio_files), len(ebook_files), len(image_files)

    if n_v:
        if root.is_file():
            if looks_like_episode(root.name):
                return 'series', 'episode pattern in video filename'
            return 'movie', 'single video file'

        episodic = sum(1 for f in video_files if video_file_looks_episodic(f, root))
        if n_v >= 2 and (episodic >= 1 or n_v >= 3):
            return 'series', f'{n_v} video files ({episodic} with episode/season naming)'
        if n_v >= 2:
            return 'movie', f'{n_v} video files, no episode/season naming'
        if episodic:
            return 'series', 'episode pattern in path'
        return 'movie', 'single video file in directory'

    if n_a and not n_v:
        return 'album', f'{n_a} audio file(s)'

    if n_e and not n_v and not n_a:
        return 'ebook', f'{n_e} ebook file(s)'

    if n_i and not n_v and not n_a and not n_e:
        return 'unknown', f'{n_i} image file(s) only'

    if n_e and (n_a or n_v):
        return 'unknown', 'mixed ebook with video/audio'
    if n_a and n_e:
        return 'unknown', 'mixed audio and ebook'
    if n_i and (n_v or n_a or n_e):
        return 'unknown', 'images mixed with other media'

    return 'unknown', 'no recognized media files'


def analyze_path(path: Path) -> Dict[str, object]:
    path = path.expanduser()
    if not path.exists():
        return {
            'path': str(path),
            'type': 'missing',
            'kind': 'unknown',
            'detail': 'does not exist',
            'media_types': [],
            'other_types': [],
            'sizes': {
                'video_bytes': 0,
                'audio_bytes': 0,
                'ebook_bytes': 0,
                'image_bytes': 0,
                'total_bytes': 0,
                'video_human': '0 B',
                'audio_human': '0 B',
                'ebook_human': '0 B',
                'image_human': '0 B',
                'total_human': '0 B',
            },
            'visual_metadata': [],
        }

    exts, v, a, e, imgs, other = gather_media(path)
    kind, detail = classify(path, v, a, e, imgs)
    sv, sa, se, si = sum_file_sizes(v), sum_file_sizes(a), sum_file_sizes(e), sum_file_sizes(imgs)
    st = sv + sa + se + si
    vis = visual_metadata_for_paths(v, imgs)
    return {
        'path': str(path.resolve()),
        'type': path_entry_type(path),
        'kind': kind,
        'detail': detail,
        'media_types': formats_for_output(exts),
        'other_types': other,
        'sizes': {
            'video_bytes': sv,
            'audio_bytes': sa,
            'ebook_bytes': se,
            'image_bytes': si,
            'total_bytes': st,
            'video_human': human_size(sv),
            'audio_human': human_size(sa),
            'ebook_human': human_size(se),
            'image_human': human_size(si),
            'total_human': human_size(st),
        },
        'visual_metadata': vis,
    }


def main(argv: Optional[List[str]] = None) -> int:
    p = argparse.ArgumentParser(description='Classify media paths (movie/series/album/ebook).')
    p.add_argument('paths', nargs='+', help='Files or directories')
    p.add_argument('--json', action='store_true', help='NDJSON output')
    p.add_argument(
        '-media',
        '--media',
        dest='media_only',
        action='store_true',
        help='Only output paths with at least one identified video/audio/ebook file',
    )
    args = p.parse_args(argv)

    for x in args.paths:
        row = analyze_path(Path(x))
        if args.media_only and not row['media_types']:
            continue
        if args.json:
            print(json.dumps(row, ensure_ascii=False), flush=True)
            continue
        media = ', '.join(row['media_types']) if row['media_types'] else '—'
        sz = row['sizes']
        print(row['path'], flush=True)
        print(f"  type: {row['type']}", flush=True)
        print(f"  classification: {row['kind']} — {row['detail']}", flush=True)
        print(f"  media: {media}", flush=True)
        size_parts: List[str] = []
        if sz['video_bytes']:
            size_parts.append(f"{sz['video_human']} video")
        if sz['audio_bytes']:
            size_parts.append(f"{sz['audio_human']} audio")
        if sz['ebook_bytes']:
            size_parts.append(f"{sz['ebook_human']} ebook")
        if sz.get('image_bytes'):
            size_parts.append(f"{sz['image_human']} image")
        if size_parts:
            print(
                f"  sizes: {', '.join(size_parts)} ({sz['total_human']} total)",
                flush=True,
            )
        else:
            print('  sizes: —', flush=True)
        if row['other_types']:
            print(f"  other: {', '.join(row['other_types'])}", flush=True)
        ts = file_timestamp(Path(row['path']))
        print(f"  timestamp: {human_date(ts)}", flush=True)
        vis = row.get('visual_metadata') or []
        if vis:
            cap = 20
            for meta in vis[:cap]:
                print(f"  visual: {format_visual_line(meta)}", flush=True)
            rest = len(vis) - cap
            if rest > 0:
                print(f"  visual: … and {rest} more file(s) (use --json for full list)", flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
