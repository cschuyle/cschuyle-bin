#!/usr/bin/env bash

# Parse command line arguments
show_all=false
human_readable=false
all_files_param=

while [[ $# -gt 0 ]]; do
case $1 in
    --help)
    echo "Usage: space [-h] [-a] [files/directories...]"
    echo "  -h: human readable size output"
    echo "  -a: include hidden (dot) files"
    echo "  files/directories: specific paths to analyze (default: current directory contents)"
    exit 0
    ;;
    -h)
    human_readable=true
    shift
    ;;
    -a)
    all_files_param='-a'
    shift
    ;;
    -ah|-ha)
    human_readable=true
    all_files_param='-a'
    shift
    ;;
    -*)
    echo "Unknown argument: $1" >&2
    exit 1
    ;;
    *)
    break
    ;;
esac
done

output_line() {
    local size="$1"
    local path="$2"

    local val=$size
    local unit=' '
    if [[ "$human_readable" != true ]]; then
        printf "%9s  %q\n" "$val" "$path"
        return
    fi
    human=$(awk -v v="$val" 'BEGIN{
        f=v; u="K";
        if (f>=1024){f/=1024; u="M"}
        if (f>=1024){f/=1024; u="G"}
        if (f>=1024){f/=1024; u="T"}
        printf "%.1f%s", f, u
    }')
    printf "%7s  %q\n" "$human" "$path"
}

if [[ $# -gt 0 ]]
then
    du -sk "$@" |
    sort -n |
    while IFS= read -r line; do
        read -r size path <<< "$line"
        output_line "$size" "$path"
    done
elif [[ "$all_files_param" == "-a" ]]
then
    du -sk * .??* |
    sort -n |
     while IFS= read -r line; do
        read -r size path <<< "$line"
        output_line "$size" "$path"
    done
else
    du -sk * |
    sort -n |
    while IFS= read -r line; do
        read -r size path <<< "$line"
        output_line "$size" "$path"
    done
fi
