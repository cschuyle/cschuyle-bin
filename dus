#!/usr/bin/env python3
# dus — disk usage for paths; postorder tree (children before parents), siblings by size ascending.
# Scans minimal roots with du; caches in SQLite (~/.dus/dus.db). Stdlib only.
from __future__ import annotations

import argparse
import fnmatch
import os
import shutil
import sqlite3
import subprocess
import sys
import time
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Dict, Iterable, List, Optional, Sequence, Tuple

PROG = Path(sys.argv[0]).name or "dus"
BATCH = 8000


def _scaled(b: int, unit: str) -> str:
    # One decimal place, but drop a trailing ".0" (864.0K -> 864K, 1.5M stays).
    whole = b // 1024
    tenth = (b % 1024) * 10 // 1024
    return f"{whole}{unit}" if tenth == 0 else f"{whole}.{tenth}{unit}"


def hr_size(kb: int) -> str:
    kb = kb or 0
    b = kb * 1024
    if b < 1024:
        return f"{b}B"
    if b < 1048576:
        return _scaled(b, "K")
    if b < 1073741824:
        return _scaled(b // 1024, "M")
    if b < 1099511627776:
        return _scaled(b // 1048576, "G")
    return _scaled(b // 1073741824, "T")


def normalize_path(p: str) -> str:
    p = p.rstrip("/") or "."
    path = Path(p)
    if p == ".":
        return str(path.resolve())
    try:
        parent = path.parent.resolve()
        return str(parent / path.name)
    except OSError:
        return str(path.parent / path.name)


def is_proper_prefix(parent: str, child: str) -> bool:
    return child.startswith(parent + "/")


def du_bin() -> str:
    return "gdu" if shutil.which("gdu") else "du"


def dev_id(path: str) -> Optional[int]:
    try:
        return os.stat(path).st_dev
    except OSError:
        return None


def progress_label(path: str) -> str:
    p = path.rstrip("/")
    if not p:
        return ""
    name = p.split("/")[-1]
    return name if len(p) <= 48 else f"…/{name}"


class DusDB:
    SCHEMA = """
    CREATE TABLE IF NOT EXISTS scans (
        root_path   TEXT PRIMARY KEY,
        scanned_at  TEXT NOT NULL,
        rootsize_kb INTEGER NOT NULL,
        dircount    INTEGER NOT NULL
    );
    CREATE TABLE IF NOT EXISTS entries (
        path        TEXT PRIMARY KEY,
        parent_path TEXT NOT NULL,
        scan_root   TEXT NOT NULL,
        size_kb     INTEGER NOT NULL
    );
    CREATE INDEX IF NOT EXISTS idx_entries_parent ON entries(parent_path);
    CREATE INDEX IF NOT EXISTS idx_entries_scan_root ON entries(scan_root);
    CREATE INDEX IF NOT EXISTS idx_entries_parent_size ON entries(parent_path, size_kb);
    """

    def __init__(self, db_path: Path) -> None:
        self.path = db_path
        db_path.parent.mkdir(parents=True, exist_ok=True)
        self.conn = sqlite3.connect(db_path)
        self.conn.execute("PRAGMA journal_mode=WAL")
        self.conn.execute("PRAGMA synchronous=NORMAL")
        self.conn.executescript(self.SCHEMA)

    def close(self) -> None:
        self.conn.close()

    def clear(self) -> None:
        self.conn.execute("DELETE FROM entries")
        self.conn.execute("DELETE FROM scans")
        self.conn.commit()

    def has_scan(self, root: str) -> bool:
        row = self.conn.execute(
            "SELECT 1 FROM scans WHERE root_path = ?", (root,)
        ).fetchone()
        return row is not None

    def scan_meta(self, root: str) -> Optional[Tuple[str, int, int]]:
        row = self.conn.execute(
            "SELECT scanned_at, rootsize_kb, dircount FROM scans WHERE root_path = ?",
            (root,),
        ).fetchone()
        return row if row else None

    def get_size(self, path: str) -> Optional[int]:
        row = self.conn.execute(
            "SELECT size_kb FROM entries WHERE path = ?", (path,)
        ).fetchone()
        return int(row[0]) if row else None

    def get_children(self, parent: str) -> List[Tuple[str, int]]:
        rows = self.conn.execute(
            "SELECT path, size_kb FROM entries WHERE parent_path = ? ORDER BY size_kb",
            (parent,),
        ).fetchall()
        return [(r[0], int(r[1])) for r in rows]

    def dircount(self, path: str) -> int:
        meta = self.scan_meta(path)
        if meta is not None:
            return meta[2]
        # Sargable prefix range instead of `path LIKE ?`: SQLite's default
        # LIKE is case-insensitive, so it can't use the path index for a
        # prefix scan and falls back to a full table scan of entries per
        # call. '/' (0x2F) sorts just below '0' (0x30), so [path+"/",
        # path+"0") covers exactly the rows whose path starts with
        # "<path>/", and — being a plain range comparison — uses the index.
        lo = path + "/"
        hi = path + "0"
        row = self.conn.execute(
            "SELECT COUNT(*) FROM entries WHERE path = ? OR (path >= ? AND path < ?)",
            (path, lo, hi),
        ).fetchone()
        return int(row[0]) if row else 0

    def delete_scan(self, root: str) -> None:
        self.conn.execute("DELETE FROM entries WHERE scan_root = ?", (root,))
        self.conn.execute("DELETE FROM scans WHERE root_path = ?", (root,))
        self.conn.commit()

    def store_scan(
        self,
        root: str,
        scanned_at: str,
        rootsize_kb: int,
        dircount: int,
        rows: Sequence[Tuple[str, str, str, int]],
    ) -> None:
        self.delete_scan(root)
        self.conn.execute(
            "INSERT INTO scans (root_path, scanned_at, rootsize_kb, dircount) VALUES (?,?,?,?)",
            (root, scanned_at, rootsize_kb, dircount),
        )
        for i in range(0, len(rows), BATCH):
            # du can emit the same directory path twice in one scan (e.g. a file
            # changed size mid-scan, or a hardlinked/bind-mounted subtree), so
            # last-value-wins instead of erroring on the path PRIMARY KEY.
            self.conn.executemany(
                "INSERT OR REPLACE INTO entries (path, parent_path, scan_root, size_kb) VALUES (?,?,?,?)",
                rows[i : i + BATCH],
            )
        self.conn.commit()


@dataclass
class MemoryCache:
    """In-memory sizes when --no-cache."""

    sizes: Dict[str, int] = field(default_factory=dict)

    def get_size(self, path: str) -> Optional[int]:
        return self.sizes.get(path)

    def get_children(self, parent: str) -> List[Tuple[str, int]]:
        kids = [
            (p, s)
            for p, s in self.sizes.items()
            if p != parent and p.startswith(parent + "/") and "/" not in p[len(parent) + 1 :]
        ]
        kids.sort(key=lambda x: x[1])
        return kids

    def dircount(self, path: str) -> int:
        n = 1 if path in self.sizes else 0
        prefix = path + "/"
        for p in self.sizes:
            if p.startswith(prefix):
                n += 1
        return n


@dataclass
class Config:
    human: bool = False
    verbose: bool = False
    total: bool = False
    no_cache: bool = False
    refresh: bool = False
    excludes: List[str] = field(default_factory=list)
    cache_dir: Path = field(default_factory=lambda: Path.home() / ".dus")
    db_path: Optional[Path] = None
    t0: float = field(default_factory=time.monotonic)

    @property
    def db_file(self) -> Path:
        return self.db_path or (self.cache_dir / "dus.db")

    def elapsed(self) -> int:
        return int(time.monotonic() - self.t0)

    def vlog(self, msg: str) -> None:
        if self.verbose:
            ts = datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
            print(f"{PROG}: {ts} +{self.elapsed()}s {msg}", file=sys.stderr)

    def vstage(self, msg: str) -> None:
        self.vlog(msg)

    def status(self, msg: str) -> None:
        if self.verbose:
            print(f"{PROG}: {msg} +{self.elapsed()}s", file=sys.stderr)


def rebase_path(canonical_root: str, rawp: str, du_root_path: str) -> str:
    rawp = rawp.rstrip("/")
    if du_root_path and (
        rawp == du_root_path or rawp.startswith(du_root_path + "/")
    ):
        return canonical_root + rawp[len(du_root_path) :]
    return rawp


def scan_progress(
    cfg: Config,
    n: int,
    est: int,
    root_name: str,
    cur_path: str = "",
) -> None:
    if not cfg.verbose:
        return
    elapsed = cfg.elapsed()
    cur = progress_label(cur_path) if cur_path else ""
    if est > 0:
        pct = min(100, n * 100 // est)
        filled = min(20, n * 20 // est)
        bar = "=" * filled + (">" if filled < 20 else "") + " " * (19 - filled)
        if root_name and cur:
            msg = f"{PROG}: {root_name} [{bar}] {n}/{est} dirs ({pct}%) at {cur} +{elapsed}s"
        elif root_name:
            msg = f"{PROG}: {root_name} [{bar}] {n}/{est} dirs ({pct}%) +{elapsed}s"
        else:
            msg = f"{PROG}: [{bar}] {n}/{est} dirs ({pct}%) +{elapsed}s"
    else:
        if root_name and cur:
            msg = f"{PROG}: {root_name} scanned {n} directories at {cur} +{elapsed}s"
        elif root_name:
            msg = f"{PROG}: {root_name} scanned {n} directories +{elapsed}s"
        else:
            msg = f"{PROG}: scanned {n} directories +{elapsed}s"
    if sys.stderr.isatty():
        print(f"\r{msg}", file=sys.stderr, end="", flush=True)
    elif n == 1 or n % 5000 == 0:
        print(msg, file=sys.stderr)


def run_du_scan(
    cfg: Config,
    root: str,
    du: str,
    extra_args: Sequence[str],
) -> Tuple[int, int, List[Tuple[str, str, str, int]]]:
    """Run du -k, return (rootsize_kb, dircount, entry rows)."""
    est = 0
    if not cfg.no_cache:
        db_tmp = DusDB(cfg.db_file)
        meta = db_tmp.scan_meta(root)
        db_tmp.close()
        if meta:
            est = meta[2]
    progress_every = max(1, est // 80 + 1) if est > 0 else 250
    label = progress_label(root)
    cfg.vlog(f"scanning {root}...")
    cmd = [du, "-k", *extra_args, root]
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    lines: List[Tuple[int, str]] = []
    assert proc.stdout is not None
    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue
        parts = line.split(None, 1)
        if len(parts) != 2:
            continue
        try:
            sz = int(parts[0])
        except ValueError:
            continue
        rawp = parts[1].rstrip("/")
        if rawp:
            lines.append((sz, rawp))
    proc.wait()
    if proc.returncode not in (0, None):
        cfg.vstage(f"du exited {proc.returncode} for {root}")

    du_root_path = lines[-1][1] if lines else ""
    rows: List[Tuple[str, str, str, int]] = []
    rootsize_kb = 0
    n = 0
    for sz, rawp in lines:
        rebased = rebase_path(root, rawp, du_root_path)
        if not rebased:
            continue
        parent = str(Path(rebased).parent)
        if rebased == parent and rebased != root:
            parent = str(Path(rebased).parent)
        rows.append((rebased, parent, root, sz))
        if rebased == root:
            rootsize_kb = sz
        n += 1
        if n == 1 or n % progress_every == 0:
            scan_progress(cfg, n, est, label, rebased)
    scan_progress(cfg, n, est, label, root)
    if cfg.verbose:
        if sys.stderr.isatty():
            print(file=sys.stderr)
        if est > 0:
            print(
                f"{PROG}: {label} scanned {n} directories (est. was {est}) +{cfg.elapsed()}s",
                file=sys.stderr,
            )
        else:
            print(
                f"{PROG}: {label} scanned {n} directories +{cfg.elapsed()}s",
                file=sys.stderr,
            )
    cfg.vlog(f"scanned {n} directories")
    return rootsize_kb, n, rows


def stale_vs_child_scans(
    cfg: Config,
    db: DusDB,
    np: str,
    parent_scanned: str,
) -> bool:
    if not parent_scanned or not os.path.isdir(np):
        return False
    cfg.vstage(f"stale check: scanning child caches under {progress_label(np)}")
    n = 0
    try:
        names = os.listdir(np)
    except OSError:
        return False
    for name in names:
        child = os.path.join(np, name)
        if not os.path.isdir(child):
            continue
        n += 1
        nchild = normalize_path(child)
        meta = db.scan_meta(nchild)
        if not meta:
            continue
        cscanned, csize, _ = meta
        if cscanned <= parent_scanned:
            continue
        psize = db.get_size(nchild)
        if psize is None or psize != csize:
            cfg.vstage(
                f"stale: newer child scan {progress_label(nchild)} "
                f"(child={csize} parent_map={psize})"
            )
            return True
    cfg.vstage(f"stale check: {n} dirs, no newer child scan")
    return False


def is_scan_stale(cfg: Config, db: DusDB, np: str, header_only: bool = False) -> bool:
    meta = db.scan_meta(np)
    if not meta:
        return True
    scanned_at, rootsize_kb, _ = meta
    if stale_vs_child_scans(cfg, db, np, scanned_at):
        return True
    if header_only:
        return False
    pdev = dev_id(np)
    if pdev is None:
        return False
    rsz = db.get_size(np) or rootsize_kb
    for cpath, csz in db.get_children(np):
        if csz <= rsz:
            continue
        if not os.path.isdir(cpath):
            continue
        cdev = dev_id(cpath)
        if cdev is not None and cdev == pdev:
            cfg.vstage(f"stale: same-fs child larger than root for {progress_label(np)}")
            return True
    return False


def reconcile_size(
    store: object,
    np: str,
    sz: int,
) -> int:
    if not os.path.isdir(np):
        return sz

    def children() -> List[Tuple[str, int]]:
        if isinstance(store, DusDB):
            return store.get_children(np)
        return store.get_children(np)  # type: ignore[union-attr]

    kids = children()
    if not kids:
        return sz
    max_child = max(s for _, s in kids)
    sum_child = sum(s for _, s in kids)
    if max_child <= sz:
        return sz
    pdev = dev_id(np)
    if pdev is None:
        return sz
    for cpath, csz in kids:
        if csz <= sz:
            continue
        if not os.path.isdir(cpath):
            continue
        cdev = dev_id(cpath)
        if cdev is not None and cdev != pdev:
            return sum_child
    return sz


def minimal_scan_roots(norm_paths: Sequence[str]) -> List[str]:
    roots: List[str] = []
    seen: set[str] = set()
    for i, np in enumerate(norm_paths):
        covered = False
        for j, nq in enumerate(norm_paths):
            if i == j:
                continue
            if is_proper_prefix(nq, np):
                covered = True
                break
        if not covered and np not in seen:
            roots.append(np)
            seen.add(np)
    return roots


def get_size_from_store(store: object, path: str) -> Optional[int]:
    if isinstance(store, DusDB):
        return store.get_size(path)
    return store.get_size(path)  # type: ignore[union-attr]


def resolve_size(
    cfg: Config,
    store: object,
    np: str,
    sibling_parent: Optional[str],
    skip_reconcile: bool,
) -> int:
    sz = get_size_from_store(store, np)
    if sz is None:
        du = du_bin()
        args: List[str] = []
        if cfg.excludes and du == "gdu":
            args = [f"--exclude={p}" for p in cfg.excludes]
        cfg.vlog(f"+ {du} -sk {' '.join(args)} {np}")
        try:
            out = subprocess.run(
                [du, "-sk", *args, np],
                capture_output=True,
                text=True,
                check=False,
            )
            line = out.stdout.strip().split()
            sz = int(line[0]) if line else 0
        except (OSError, ValueError):
            sz = 0
        if os.path.isdir(np):
            print(
                f"{PROG}: WARNING: {np} not found in cache; ran du directly",
                file=sys.stderr,
            )
        return sz or 0

    if not skip_reconcile:
        sz = reconcile_size(store, np, sz)
    return sz


def dircount_from_store(store: object, np: str) -> int:
    if not os.path.isdir(np):
        return 0
    if isinstance(store, DusDB):
        return store.dircount(np)
    return store.dircount(np)  # type: ignore[union-attr]


def forest_roots(norm_paths: Dict[str, str], norm_inputs: List[str]) -> List[str]:
    roots: List[str] = []
    nps = [norm_paths[p] for p in norm_inputs]
    for i, np in enumerate(nps):
        is_root = True
        for j, nq in enumerate(nps):
            if i == j:
                continue
            if is_proper_prefix(nq, np):
                is_root = False
                break
        if is_root:
            roots.append(np)
    return roots


def _inputs_under(np: str, norm_paths: Dict[str, str], norm_inputs: List[str]) -> List[str]:
    return [
        norm_paths[orig]
        for orig in norm_inputs
        if norm_paths[orig] != np and is_proper_prefix(np, norm_paths[orig])
    ]


def _collect_fs_postorder(
    np: str,
    allowed: set[str],
    sizes: Dict[str, int],
    order: List[str],
) -> None:
    """Postorder within allowed set: children (size-sorted) first, then np."""
    p_np = Path(np)
    kids = sorted(
        (k for k in allowed if Path(k).parent == p_np),
        key=lambda k: sizes.get(k, -1),
    )
    for k in kids:
        _collect_fs_postorder(k, allowed, sizes, order)
    order.append(np)


def _collect_segment_bucket(
    np: str,
    seg: str,
    bucket: List[str],
    sizes: Dict[str, int],
    order: List[str],
) -> None:
    """Postorder under np/<segment>/; segment dir (e.g. video) last in its group."""
    allowed = set(bucket)
    parent_path = f"{np}/{seg}"
    if parent_path in allowed:
        _collect_fs_postorder(parent_path, allowed, sizes, order)
        return
    roots: List[str] = []
    for k in bucket:
        if any(k != o and is_proper_prefix(o, k) for o in bucket):
            continue
        roots.append(k)
    for k in sorted(roots, key=lambda x: sizes.get(x, -1)):
        _collect_fs_postorder(k, allowed, sizes, order)


def collect_postorder(
    np: str,
    norm_paths: Dict[str, str],
    norm_inputs: List[str],
    sizes: Dict[str, int],
    order: List[str],
) -> None:
    """Postorder under np: descendants first (grouped), parent np last."""
    p_np = Path(np)
    under = _inputs_under(np, norm_paths, norm_inputs)
    under_set = set(under)

    direct = sorted(
        (k for k in under if Path(k).parent == p_np),
        key=lambda k: sizes.get(k, -1),
    )
    covered: set[str] = set()
    for k in direct:
        _collect_fs_postorder(k, under_set, sizes, order)
        covered.add(k)
        for o in under:
            if is_proper_prefix(k, o):
                covered.add(o)

    remaining = [k for k in under if k not in covered]
    prefix = np + "/"
    segments: Dict[str, List[str]] = {}
    for k in remaining:
        rest = k[len(prefix) :]
        seg = rest.split("/")[0]
        segments.setdefault(seg, []).append(k)

    for seg in sorted(
        segments.keys(),
        key=lambda s: min(sizes.get(k, -1) for k in segments[s]),
    ):
        _collect_segment_bucket(np, seg, segments[seg], sizes, order)

    order.append(np)


def excluded_basename(path: str, patterns: Sequence[str]) -> bool:
    base = path.split("/")[-1]
    return any(fnmatch.fnmatchcase(base, pat) for pat in patterns)


def parse_args(argv: Sequence[str]) -> Tuple[Config, List[str]]:
    parser = argparse.ArgumentParser(prog=PROG, add_help=False)
    parser.add_argument("--help", action="store_true")
    parser.add_argument("-h", "--human-readable", action="store_true")
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("--no-cache", action="store_true")
    parser.add_argument("--refresh", action="store_true")
    parser.add_argument("-c", "--clearcache", "--clear", action="store_true")
    parser.add_argument("-t", "--total", action="store_true")
    parser.add_argument("--exclude", action="append", default=[])
    parser.add_argument("--db", metavar="PATH", default=None)
    parser.add_argument("paths", nargs="*")
    ns = parser.parse_args(list(argv))
    paths = ns.paths
    if ns.clearcache:
        cfg = Config()
        if ns.db:
            cfg.db_path = Path(ns.db)
        if os.environ.get("DUS_CACHE_DIR"):
            cfg.cache_dir = Path(os.environ["DUS_CACHE_DIR"])
        dbf = cfg.db_file
        # SQLite WAL mode leaves -wal/-shm sidecar files alongside the main db;
        # deleting only the main file orphans them, and a later run opened in
        # WAL mode against the mismatched leftovers hits "disk I/O error".
        sidecars = [dbf, Path(f"{dbf}-wal"), Path(f"{dbf}-shm")]
        removed = [p for p in sidecars if p.exists()]
        if removed:
            for p in removed:
                p.unlink()
            print(f"{PROG}: cleared cache: {dbf}", file=sys.stderr)
        else:
            print(f"{PROG}: no cache to clear: {dbf}", file=sys.stderr)
        return Config(), []
    if ns.help:
        print(
            f"Usage: {PROG} [-h] [-v] [-t] [--no-cache] [--refresh] [-c] "
            f"[--exclude <pattern>]... [--db PATH] <path> [path ...]",
            file=sys.stderr,
        )
        print("  -h                  Human-readable sizes (B, K, M, G, T)", file=sys.stderr)
        print(
            "  -v                  Verbose: du commands, cache decisions, timing on stderr",
            file=sys.stderr,
        )
        print("  -t, --total         Print a grand total line after the per-path sizes", file=sys.stderr)
        print("  --no-cache          Skip reading and writing the cache for this run", file=sys.stderr)
        print("  --refresh           Ignore cache and rescan (still updates cache)", file=sys.stderr)
        print("  -c/--clearcache      Delete cached database and exit", file=sys.stderr)
        print("  --exclude <pat>     Exclude by basename glob (repeatable)", file=sys.stderr)
        print("  --db PATH           SQLite cache file (default: ~/.dus/dus.db)", file=sys.stderr)
        sys.exit(0)
    if not paths:
        print(f"{PROG}: at least one path required", file=sys.stderr)
        sys.exit(1)
    cfg = Config(
        human=ns.human_readable,
        verbose=ns.verbose,
        total=ns.total,
        no_cache=ns.no_cache,
        refresh=ns.refresh,
        excludes=list(ns.exclude or []),
    )
    if ns.db:
        cfg.db_path = Path(ns.db)
    if os.environ.get("DUS_CACHE_DIR"):
        cfg.cache_dir = Path(os.environ["DUS_CACHE_DIR"])
    return cfg, paths


def main(argv: Optional[Sequence[str]] = None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    cfg, paths = parse_args(argv)

    if not paths:
        return 0

    norm_paths = {p: normalize_path(p) for p in paths}
    norm_inputs = list(paths)

    if cfg.no_cache or cfg.refresh:
        if cfg.verbose:
            print(f"{PROG}: HOLD ON, SCANNING DIRECTORIES", file=sys.stderr)
        status_printed = True
    else:
        if cfg.verbose:
            print(f"{PROG}: READING CACHE...", file=sys.stderr)
        status_printed = False

    cfg.vstage("start")
    cfg.vstage(f"normalized {len(paths)} input path(s)")

    roots = minimal_scan_roots(list(norm_paths.values()))
    cfg.vstage(f"{len(roots)} scan root(s)")

    db: Optional[DusDB] = None
    mem = MemoryCache()
    store: object

    if not cfg.no_cache:
        db = DusDB(cfg.db_file)
        store = db
    else:
        store = mem

    sibling_parent: Optional[str] = None
    sibling_listing = False
    if len(paths) > 1 and not cfg.no_cache and not cfg.refresh:
        parents = {str(Path(norm_paths[p]).parent) for p in paths}
        if len(parents) == 1:
            sibling_parent = next(iter(parents))
            sibling_listing = True
            cfg.vstage(f"sibling prefetch from {progress_label(sibling_parent)}")

    du = du_bin()
    du_scan_args: List[str] = []
    if cfg.excludes and du == "gdu":
        du_scan_args = [f"--exclude={p}" for p in cfg.excludes]
    elif cfg.excludes and du != "gdu":
        print(
            f"{PROG}: WARNING: GNU du (gdu) not available; --exclude filters by "
            "basename at output (sizes of excluded dirs still counted in parents)",
            file=sys.stderr,
        )
    use_postfilter = bool(cfg.excludes)

    to_scan: List[str] = []
    for root in roots:
        if cfg.no_cache:
            to_scan.append(root)
        elif not os.path.isdir(root):
            continue
        elif cfg.refresh:
            to_scan.append(root)
        elif isinstance(store, DusDB) and store.get_size(root) is not None:
            if not sibling_listing:
                maybe_upgrade_child(cfg, store, root)
            cfg.vstage(f"cache HIT: {root}")
        elif isinstance(store, DusDB) and store.has_scan(root):
            if is_scan_stale(cfg, store, root, header_only=True):
                store.delete_scan(root)
                to_scan.append(root)
            else:
                cfg.vstage(f"cache HIT (metadata): {progress_label(root)}")
        else:
            to_scan.append(root)

    # Collapse sibling scans to parent when all roots share a parent
    if len(to_scan) > 1 and len(to_scan) == len(roots):
        common_parent = str(Path(to_scan[0]).parent)
        if all(str(Path(r).parent) == common_parent for r in to_scan):
            if cfg.refresh or cfg.no_cache:
                cfg.vstage(
                    f"refresh: scanning parent {progress_label(common_parent)} "
                    f"for {len(to_scan)} sibling(s)"
                )
                to_scan = [common_parent]
            else:
                still_missing: List[str] = []
                for r in to_scan:
                    if isinstance(store, DusDB) and store.get_size(r) is not None:
                        continue
                    still_missing.append(r)
                if not still_missing:
                    to_scan = []
                elif isinstance(store, DusDB) and store.has_scan(common_parent):
                    cfg.vstage(
                        f"retry parent scan for {len(still_missing)} missing sibling(s)"
                    )
                    to_scan = []
                    for r in still_missing:
                        if store.get_size(r) is None:
                            to_scan.append(r)
                elif len(to_scan) == len(roots):
                    to_scan = [common_parent]

    if cfg.verbose and not status_printed:
        if not to_scan:
            print(f"{PROG}: ALL DATA IS CACHED", file=sys.stderr)
        else:
            print(f"{PROG}: HOLD ON, SCANNING DIRECTORIES", file=sys.stderr)

    if to_scan:
        cfg.vstage(f"scanning {len(to_scan)} root(s)")

    for root in to_scan:
        if cfg.no_cache:
            cfg.vlog(f"+ {du} -k {' '.join(du_scan_args)} {root}")
            rootsize, dircount, rows = run_du_scan(cfg, root, du, du_scan_args)
            for path, _parent, _root, sz in rows:
                mem.sizes[path] = sz
        else:
            assert db is not None
            cfg.vlog(f"cache MISS: {root}")
            rootsize, dircount, rows = run_du_scan(cfg, root, du, du_scan_args)
            if dircount >= 500:
                cfg.status(f"{progress_label(root)} processing {dircount} entries...")
            scanned_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
            db.store_scan(root, scanned_at, rootsize, dircount, rows)
            if dircount >= 500:
                cfg.status(f"{progress_label(root)} cache saved")

    if db:
        store = db

    out_sz: Dict[str, int] = {}
    out_dc: Dict[str, int] = {}
    out_orig: Dict[str, str] = {}

    cfg.vstage(f"preparing output ({len(paths)} path(s))...")
    for i, p in enumerate(paths, 1):
        np = norm_paths[p]
        cfg.vstage(f"output {i}/{len(paths)}: {progress_label(p)}...")
        skip_reconcile = sibling_listing and sibling_parent and (
            str(Path(np).parent) == sibling_parent
        )
        sz = resolve_size(cfg, store, np, sibling_parent, skip_reconcile)
        if skip_reconcile:
            cfg.vstage(f"output: using parent cache size for {progress_label(np)}")
        out_sz[np] = sz
        out_dc[np] = dircount_from_store(store, np)
        out_orig[np] = p

    froots = forest_roots(norm_paths, norm_inputs)
    froots.sort(key=lambda k: out_sz.get(k, -1))
    print_order: List[str] = []
    for np in froots:
        has_descendants = any(
            is_proper_prefix(np, norm_paths[p]) for p in paths
        )
        if has_descendants:
            collect_postorder(np, norm_paths, norm_inputs, out_sz, print_order)
        else:
            print_order.append(np)
    printed = set(print_order)
    orphans = [norm_paths[p] for p in paths if norm_paths[p] not in printed]
    orphans.sort(key=lambda k: out_sz.get(k, -1))
    print_order.extend(orphans)
    if not print_order:
        print_order = [norm_paths[p] for p in paths]

    for np in print_order:
        if use_postfilter and excluded_basename(np, cfg.excludes):
            continue
        orig = out_orig[np]
        sz = out_sz[np]
        dc = out_dc[np]
        if cfg.human:
            print(f"{hr_size(sz)}\t{dc}\t{orig}")
        else:
            print(f"{sz}\t{dc}\t{orig}")

    if cfg.total:
        total_sz = sum(out_sz[norm_paths[p]] for p in paths)
        if cfg.human:
            print(f"{hr_size(total_sz)}\ttotal")
        else:
            print(f"{total_sz}\ttotal")

    cfg.vstage(f"done: {len(paths)} output")
    if db:
        db.close()
    return 0


def maybe_upgrade_child(cfg: Config, db: DusDB, np: str) -> None:
    if not os.path.isdir(np):
        return
    parent = str(Path(np).parent)
    pmeta = db.scan_meta(parent)
    cmeta = db.scan_meta(np)
    if not pmeta or not cmeta:
        return
    pscanned, _, _ = pmeta
    cscanned, csize, _ = cmeta
    if cscanned > pscanned:
        old = db.get_size(np)
        if old != csize:
            # update entry from child scan root metadata
            row = db.conn.execute(
                "SELECT size_kb FROM entries WHERE path = ?", (np,)
            ).fetchone()
            if row:
                db.conn.execute(
                    "UPDATE entries SET size_kb = ? WHERE path = ?", (csize, np)
                )
                db.conn.commit()
            cfg.vstage(
                f"upgraded {progress_label(np)} from child scan: {old} -> {csize}"
            )


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print(f"\n{PROG}: interrupted", file=sys.stderr, flush=True)
        import signal
        # Die by SIGINT (not exit status) so a calling shell script aborts too.
        signal.signal(signal.SIGINT, signal.SIG_DFL)
        os.kill(os.getpid(), signal.SIGINT)
