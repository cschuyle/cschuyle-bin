#!/usr/bin/env bash
# dus — disk usage for a list of paths, sorted by size ascending within each parent group.
# Scans only the minimal set of root paths needed, then extracts sizes for each requested path.
# Results are cached in ~/.dus/ and reused on subsequent runs (use --refresh to rescan).
set -euo pipefail

prog="$(basename "$0")"
human_readable=false
verbose=false
no_cache=false
refresh_cache=false
clear_cache=false
excludes=()

DUS_CACHE_DIR="${DUS_CACHE_DIR:-$HOME/.dus}"

print_usage() {
    echo "Usage: $prog [-h] [-v] [--no-cache] [--refresh] [-c] [--exclude <pattern>]... <path> [path ...]" >&2
    echo "  -h                  Human-readable sizes (B, K, M, G, T)" >&2
    echo "  -v                  Print each du command to stderr before running it" >&2
    echo "  --no-cache          Skip reading and writing the cache for this run" >&2
    echo "  --refresh           Ignore cache and rescan (still updates cache)" >&2
    echo "  -c/--clearcache/--clear  Delete all cached data and exit" >&2
    echo "  --exclude <pat>     Exclude files/dirs matching glob pattern (repeatable)" >&2
}
usage() { print_usage; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help) print_usage; exit 0 ;;
        -h) human_readable=true; shift ;;
        -v) verbose=true; shift ;;
        --no-cache) no_cache=true; shift ;;
        --refresh) refresh_cache=true; shift ;;
        -c|--clearcache|--clear) clear_cache=true; shift ;;
        --exclude)
            [[ $# -ge 2 ]] || { echo "$prog: --exclude requires a value" >&2; exit 1; }
            excludes+=("$2"); shift 2 ;;
        --exclude=*) excludes+=("${1#*=}"); shift ;;
        --) shift; break ;;
        -*) echo "$prog: unknown option: $1" >&2; usage ;;
        *) break ;;
    esac
done

if $clear_cache; then
    if [[ -d "$DUS_CACHE_DIR" ]]; then
        rm -rf "$DUS_CACHE_DIR"
        echo "$prog: cleared cache: $DUS_CACHE_DIR" >&2
    else
        echo "$prog: no cache to clear: $DUS_CACHE_DIR" >&2
    fi
    exit 0
fi

[[ $# -eq 0 ]] && { echo "$prog: at least one path required" >&2; usage; }

# Resolve to absolute path, no trailing slash.
normalize_path() {
    local p="${1%/}"
    local dir base
    base="$(basename -- "$p")"
    if dir="$(cd "$(dirname -- "$p")" 2>/dev/null && pwd -P)"; then
        printf '%s/%s' "$dir" "$base"
    else
        # Parent doesn't exist; best-effort: keep dirname as-is
        printf '%s/%s' "$(dirname -- "$p")" "$base"
    fi
}

# True if $1 is a strict path prefix of $2 (i.e. $2 is inside $1).
is_proper_prefix() { [[ "$2" == "$1/"* ]]; }

# Print command to stderr if -v is set.
vlog() { $verbose && printf '+ %s\n' "$(printf '%q ' "$@")" >&2 || true; }

# Prefer GNU du (gdu from homebrew) for --exclude support on macOS.
DU_BIN="du"
command -v gdu >/dev/null 2>&1 && DU_BIN="gdu"

# Cache file path for a given root directory.
_cache_path_for_root() {
    local root="$1" hash
    if command -v md5 >/dev/null 2>&1; then
        hash="$(md5 -q -s "$root")"
    else
        hash="$(printf '%s' "$root" | md5sum | cut -c1-32)"
    fi
    printf '%s/%s.cache' "$DUS_CACHE_DIR" "$hash"
}

# Load cache file into size_map. Returns 1 if missing/unreadable.
# Trusts cached data when the root still exists; use --refresh to rescan.
_load_cache() {
    local cache_file="$1" root="" sz path
    [[ -f "$cache_file" ]] || return 1

    declare -a _entries=()
    while IFS= read -r line; do
        case "$line" in
            '# root:'*) root="${line#*: }" ;;
            '# '*)       ;;
            '')
                ;;
            *)
                IFS=$'\t' read -r sz path <<< "$line"
                [[ -z "$path" ]] && return 1
                _entries+=("$sz"$'\t'"$path")
                ;;
        esac
    done < "$cache_file"

    [[ -n "$root" && -d "$root" ]] || return 1
    [[ ${#_entries[@]} -gt 0 ]] || return 1

    for entry in "${_entries[@]+"${_entries[@]}"}"; do
        IFS=$'\t' read -r sz path <<< "$entry"
        size_map["$path"]="$sz"
    done
    return 0
}

# Try to load a cache covering np (self or nearest ancestor). Returns 0 on success.
_try_load_ancestor_cache() {
    local np="$1"
    [[ -n "${size_map[$np]+x}" ]] && return 0

    local dir="$np"
    while true; do
        if ! $refresh_cache; then
            local cf="$(_cache_path_for_root "$dir")"
            if _load_cache "$cf"; then
                $verbose && printf '%s: cache HIT:  %s\n' "$prog" "$dir" >&2 || true
                [[ -n "${size_map[$np]+x}" ]] && return 0
                [[ "$np" == "$dir" || "$np" == "$dir/"* ]] && return 0
            fi
        fi
        [[ "$dir" == "/" ]] && break
        dir="$(dirname "$dir")"
    done
    return 1
}

# Collect raw du output. Strips trailing slashes; skips blank lines.
# Sets globals _DU_RAW and _DU_ROOT_PATH (du's path for the root, from last line).
_du_collect() {
    local _root="$1"
    shift
    local _sz _rawp _n=0
    local -a _buf=()
    $verbose && printf '%s: scanning %s...\n' "$prog" "$_root" >&2 || true
    while read -r _sz _rawp; do
        [[ -z "$_rawp" ]] && continue
        _rawp="${_rawp%/}"
        [[ -z "$_rawp" ]] && continue
        _buf+=("$_sz"$'\t'"$_rawp")
        (( ++_n )) || true
        if $verbose && ((_n % 500 == 0)); then
            printf '\r%s: scanned %d directories...' "$prog" "$_n" >&2
        fi
    done < <("$DU_BIN" -k "$@" "$_root" 2>/dev/null)
    $verbose && printf '\r%s: scanned %d directories\n' "$prog" "$_n" >&2 || true
    _DU_RAW=("${_buf[@]+"${_buf[@]}"}")
    _DU_ROOT_PATH=""
    if [[ ${#_buf[@]} -gt 0 ]]; then
        IFS=$'\t' read -r _ _DU_ROOT_PATH <<< "${_buf[$(( ${#_buf[@]} - 1 ))]}"
    fi
}

# Rebase a single du path to the canonical root path.
# Result stored in global _DU_REBASED_PATH.
_du_rebase() {
    local canonical_root="$1" rawp="$2" du_root_path="$3"
    if [[ -n "$du_root_path" && \
          ( "$rawp" == "$du_root_path" || "$rawp" == "$du_root_path/"* ) ]]; then
        _DU_REBASED_PATH="${canonical_root}${rawp#$du_root_path}"
    else
        _DU_REBASED_PATH="$rawp"
    fi
}

# Scan root with du (no --exclude, so cache is exclude-agnostic), write cache,
# then load results into size_map.
_scan_and_cache() {
    local root="$1" cache_file="$2"
    local tmp_file="${cache_file}.tmp.$$"

    mkdir -p "$DUS_CACHE_DIR"
    vlog "$DU_BIN" -k "$root"
    _du_collect "$root"   # fills _DU_RAW and _DU_ROOT_PATH

    local _entry _sz _rawp _rootsize="" _dircount=0
    declare -a _rebased=()
    for _entry in "${_DU_RAW[@]+"${_DU_RAW[@]}"}"; do
        IFS=$'\t' read -r _sz _rawp <<< "$_entry"
        _du_rebase "$root" "$_rawp" "$_DU_ROOT_PATH"
        [[ -z "$_DU_REBASED_PATH" ]] && continue
        _rebased+=("$_sz"$'\t'"$_DU_REBASED_PATH")
        size_map["$_DU_REBASED_PATH"]="$_sz"
        if [[ "$_DU_REBASED_PATH" == "$root" ]]; then
            _rootsize="$_sz"
        fi
    done
    _dircount=${#_rebased[@]}

    {
        printf '# root: %s\n' "$root"
        printf '# scanned: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')"
        printf '# dircount: %s\n' "$_dircount"
        printf '# rootsize: %s\n' "$_rootsize"
        local _line
        for _line in "${_rebased[@]+"${_rebased[@]}"}"; do
            printf '%s\n' "$_line"
        done
    } > "$tmp_file"
    mv -- "$tmp_file" "$cache_file"
}

# When caching is active we always scan without --exclude so the cache is
# exclude-agnostic; exclusions are applied as a post-filter after loading.
# Only use gdu --exclude when --no-cache is set (proper size exclusion, no cache).
du_exclude_args=()
use_postfilter=false
if [[ ${#excludes[@]} -gt 0 ]]; then
    if ! $no_cache; then
        use_postfilter=true
    elif [[ "$DU_BIN" == "gdu" ]]; then
        for pat in "${excludes[@]}"; do du_exclude_args+=("--exclude=$pat"); done
    else
        echo "$prog: WARNING: GNU du (gdu) not available; --exclude filters by basename after scanning (sizes of excluded dirs still counted in parent totals)" >&2
        use_postfilter=true
    fi
fi

# Normalize all input paths.
declare -a inputs=()
declare -A norm_of=()
for p in "$@"; do
    inputs+=("$p")
    norm_of["$p"]="$(normalize_path "$p")"
done

# Find the minimal set of root paths to scan: a path is a root if no other
# input is a proper prefix of it (so we don't scan any subtree more than once).
declare -a roots=()
declare -A root_seen=()
for p in "${inputs[@]}"; do
    np="${norm_of[$p]}"
    covered=false
    for q in "${inputs[@]}"; do
        [[ "$p" == "$q" ]] && continue
        if is_proper_prefix "${norm_of[$q]}" "$np"; then
            covered=true; break
        fi
    done
    if ! $covered && [[ -z "${root_seen[$np]+x}" ]]; then
        roots+=("$np")
        root_seen[$np]=1
    fi
done

# Resolve what still needs scanning. Use cached subtrees when available; only
# collapse siblings to their parent when every sibling missed cache (e.g. video/*).
declare -A size_map=()
declare -a to_scan=()
for root in "${roots[@]}"; do
    if $no_cache; then
        to_scan+=("$root")
    elif _try_load_ancestor_cache "$root"; then
        :
    else
        to_scan+=("$root")
    fi
done

if [[ ${#to_scan[@]} -gt 1 && ${#to_scan[@]} -eq ${#roots[@]} ]]; then
    _common_parent="$(dirname "${to_scan[0]}")"
    _all_same_parent=true
    for r in "${to_scan[@]}"; do
        if [[ "$(dirname "$r")" != "$_common_parent" ]]; then
            _all_same_parent=false
            break
        fi
    done
    if $_all_same_parent; then
        to_scan=("$_common_parent")
    fi
fi

for root in "${to_scan[@]}"; do
    if $no_cache; then
        vlog "$DU_BIN" -k "${du_exclude_args[@]+"${du_exclude_args[@]}"}" "$root"
        _du_collect "$root" "${du_exclude_args[@]+"${du_exclude_args[@]}"}"
        for _nc_entry in "${_DU_RAW[@]+"${_DU_RAW[@]}"}"; do
            IFS=$'\t' read -r _nc_sz _nc_rawp <<< "$_nc_entry"
            _du_rebase "$root" "$_nc_rawp" "$_DU_ROOT_PATH"
            [[ -n "$_DU_REBASED_PATH" ]] && size_map["$_DU_REBASED_PATH"]="$_nc_sz"
        done
    else
        $verbose && printf '%s: cache MISS: %s\n' "$prog" "$root" >&2 || true
        cache_file="$(_cache_path_for_root "$root")"
        _scan_and_cache "$root" "$cache_file"
    fi
done

# Apply post-filter: remove excluded entries from size_map by basename.
if $use_postfilter; then
    for path in "${!size_map[@]}"; do
        bname="$(basename "$path")"
        for pat in "${excludes[@]}"; do
            # shellcheck disable=SC2254
            case "$bname" in $pat) unset "size_map[$path]"; break ;; esac
        done
    done
fi

# Format 1K-block count as human-readable (B, K, M, G, T).
hr_size() {
    awk -v kb="$1" 'BEGIN {
        b = kb * 1024
        if (b < 1024)           { printf "%dB",   b;                      exit }
        if (b < 1048576)        { printf "%.1fK",  b / 1024;               exit }
        if (b < 1073741824)     { printf "%.1fM",  b / 1048576;            exit }
        if (b < 1099511627776)  { printf "%.1fG",  b / 1073741824;         exit }
                                  printf "%.1fT",  b / 1099511627776
    }'
}

# Group inputs by the parent dir of their normalized path.
# Groups are ordered deepest-first (most path components first) so that children
# are printed before their parent directories. Ties in depth preserve first-seen order.
declare -a group_order=()
declare -A group_seen=()
_group_idx=0
declare -a _group_sort_keys=()
for p in "${inputs[@]}"; do
    parent="$(dirname "${norm_of[$p]}")"
    if [[ -z "${group_seen[$parent]+x}" ]]; then
        group_seen[$parent]=1
        local_depth="${parent//[^\/]/}"
        # Sort key: depth descending (negated), then insertion index ascending for stability.
        _group_sort_keys+=("$(printf '%010d\t%010d\t%s' "$((1000000 - ${#local_depth}))" "$_group_idx" "$parent")")
        (( _group_idx++ )) || true
    fi
done
while IFS=$'\t' read -r _ _ parent; do
    group_order+=("$parent")
done < <(printf '%s\n' "${_group_sort_keys[@]}" | sort -t$'\t' -k1,1n -k2,2n)

# For each group: collect (size, original_path) pairs, sort by size ascending, print.
for parent in "${group_order[@]}"; do
    pair_lines=()
    for p in "${inputs[@]}"; do
        np="${norm_of[$p]}"
        [[ "$(dirname "$np")" == "$parent" ]] || continue
        sz="${size_map[$np]:-}"
        if [[ -z "$sz" ]]; then
            # Path not in scan (e.g. a file, or outside every scanned root); run du directly.
            vlog "$DU_BIN" -sk "${du_exclude_args[@]+"${du_exclude_args[@]}"}" "$np"
            sz="$("$DU_BIN" -sk "${du_exclude_args[@]+"${du_exclude_args[@]}"}" "$np" 2>/dev/null | cut -f1)" || true
            [[ -z "$sz" ]] && sz=0
            echo "$prog: WARNING: $p not found in scan; ran du directly" >&2
        fi
        pair_lines+=("${sz}"$'\t'"${p}")
    done

    [[ ${#pair_lines[@]} -eq 0 ]] && continue

    printf '%s\n' "${pair_lines[@]}" | sort -n -t$'\t' -k1 | \
    while IFS=$'\t' read -r sz p; do
        if $human_readable; then
            printf '%s\t%s\n' "$(hr_size "$sz")" "$p"
        else
            printf '%s\t%s\n' "$sz" "$p"
        fi
    done
done
