#!/usr/bin/env bash
set -euo pipefail

scriptname=$(basename "$0")
N=2

usage() {
    echo "Usage: $scriptname [-nth N] [file ...]"
    echo
    echo "Split input into two files: ~1/N of the lines (NR % N == 1) and the rest."
    echo "Default N is 2 (odd vs even lines when N=2)."
    echo
    echo "  -nth N   Denominator N (integer >= 2)."
    echo
    echo "Outputs: for N=2 (default), <stem>-{odd,even}.txt; for N>2, <stem>.1-of-N.txt and <stem>.(N-1)-of-N.txt."
    echo "With file arguments, paths are next to each input file."
    echo "With no files, reads stdin; same naming under ./<scriptname>-<timestamp>..."
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h | --help)
            usage
            ;;
        -nth)
            N="${2:?missing value for -nth}"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            echo "Usage: $scriptname [-nth N] [file ...]" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

if ! [[ "$N" =~ ^[0-9]+$ ]] || [[ "$N" -lt 2 ]]; then
    echo "Error: -nth must be an integer >= 2 (got: $N)" >&2
    exit 1
fi

split_stream() {
    local input=$1
    local filedir=$2
    local small large
    
    if [[ "$N" -eq 2 ]]; then
        small="${filedir}-odd.txt"
        large="${filedir}-even.txt"
    else
        small="${filedir}.1-of-${N}.txt"
        therest=$((N - 1))
        large="${filedir}.${therest}-of-${N}.txt"
    fi
    awk -v n="$N" \
        -v small="$small" \
        -v large="$large" \
        'NR % n == 1 { print > small; next }
         { print > large }' "$input"
}

if [[ $# -eq 0 ]]; then
    timestamp=$(date +%Y-%m-%d,%H.%M.%S)
    filedir="./$scriptname-$timestamp"
    split_stream /dev/stdin "$filedir"
else
    for file in "$@"; do
        if [[ ! -f "$file" ]]; then
            echo "Error: $file is not a regular file" >&2
            continue
        fi
        stem="$(dirname "$file")/$(basename "$file" | sed 's/\.[^.]*$//')"
        split_stream "$file" "$stem"
    done
fi
