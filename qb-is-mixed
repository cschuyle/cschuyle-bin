#!/usr/bin/env bash
set -o errexit # set -e
set -o pipefail
script_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
script_file=$(basename "$0")

# Done, but only non-MP4 video files

# Check if at least one directory was provided
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
Usage: qb-is-mixed <dir1> [dir2 ...]

For finished torrent folders containing both MP4/M4V and MKV/AVI, print shell commands
to move them into _MIXED.
EOF
  exit 0
fi

if [ $# -eq 0 ]; then
  echo "Usage: $0 <dir1> [dir2 ... dirN]"
  exit 1
fi

QB_TEMP_DIR=temp
DONE_DIR=_DONE
MP4_DIR=_MP4
MIXED_DIR=_MIXED

is_a_dest_dir() {
    local dir="$1"
    if [[ "$dir" == "@eaDir" || "$dir" == "$QB_TEMP_DIR" || "$dir" == "$DONE_DIR" || "$dir" == "$MP4_DIR" || "$dir" == "$MIXED_DIR" ]]; then
		return 0  # true
    else
        return 1  # false
    fi
}

# Remind the user the FIRST time
echo "mkdir -p '$MIXED_DIR'"

# Loop through all provided directories

for DIR in "$@"; do
  has_mp4=
  has_non_mp4=

  # Check if it's a valid directory
  if [ ! -d "$DIR" ]; then
#    echo "Warning: '$DIR' is not a directory" >&2
    continue
  fi

  if is_a_dest_dir "$DIR"; then continue; fi

  if [[ ! -z "$(find "$DIR" -type f -iname '*.!qB' | grep -v '/._')" ]]; then
	  continue
  else
    if [[ ! -z "$(find "$DIR" -type f \( -iname '*.mkv' -o -iname '*.avi' \) | grep -v '/._')" ]]; then
      has_non_mp4=1
    fi
    if [[ ! -z "$(find "$DIR" -type f \( -iname '*.mp4' -o -iname '*.m4v' \) | grep -v '/._')" ]]; then
      has_mp4=1
    fi
    if [[ ! -z "$has_non_mp4" && ! -z "$has_mp4" ]]; then
      echo "[[ -d $MIXED_DIR ]] && mv '$DIR' $MIXED_DIR"
    elif [[ -z "$has_non_mp4" && -z "$has_mp4" ]]; then
      [[ ! -z "$VERBOSE" ]] && echo "# No video files in '$DIR'" >&2
    fi
  fi
done
