#!/usr/bin/env python3
"""Lint video directories for common "dirty" states.

Usage: vids-lint [--json] [-a|--all] [-i|--interactive] [PATH ...]

Walks each PATH and, for every directory that directly contains video and/or
subtitle files, reports two problems. With no PATH, vids-lint lints the first
eligible item in the current directory: the first non-hidden entry (sorted by
name, so the choice is deterministic) whose tree contains a video or subtitle
file. With no PATH and -i, vids-lint processes every non-hidden entry in the
current directory (as if the argument were *), streaming feedback per item:
clean items are skipped silently, dirty items with no automatic fix are noted
(on stderr) and skipped, and fixable items are reported and offered — advancing
to the next item even after you fix the current one.

The two problems reported:

  1. Unaligned subtitles. A subtitle should be named
     <video-stem>.<suffix>.srt and live in the same folder as its video
     (e.g. The.Matrix.1999.mp4 -> The.Matrix.1999.en.srt), where the suffix
     carries a language segment (an ISO code or language name, e.g. .en /
     .eng / .2_English). A .srt is flagged when it:
       - does not start with any video stem in the folder (orphan-subtitle), or
       - is tied to a video but carries no language segment
         (non-identifiable-language-subtitle-file), e.g. The.Matrix.1999.srt or
         The.Matrix.1999.forced.srt next to The.Matrix.1999.mp4.
     Only the part of the name past the video stem is inspected for a language,
     so a title word (e.g. The.English.Patient.srt) is not read as a language.
     non-identifiable-language-subtitle-file is a quiet violation, reported
     only with -a/--all.

Each reported subtitle carries a violation code: orphan-subtitle or
non-identifiable-language-subtitle-file. The code is shown in brackets in
plain output and as a "code" field in --json output.

  2. Multiple video files in one directory. A movie folder should hold a single
     video file; two or more real videos directly in the same directory is
     flagged (sample clips — a delimited "sample" token, e.g. Sample_1.mp4 — do
     not count). This also flags multi-episode folders, which are legitimately
     not single movies — point vids-lint at movie folders.

Video extensions: mp4, m4v, mkv, avi, mov, webm, wmv, mpg, mpeg, ogm.
Subtitle extension: srt.

With -i/--interactive, vids-lint offers to fix each fixable subtitle by moving
it into its main video's folder and prepending the video's basename to the
original subtitle name (e.g. Subs/2_English.srt ->
Dollars.1971.1080p.WEBRip.x265-RARBG.2_English.srt). A subtitle that already
carries the video stem is only relocated. The main video is the single
non-sample video in the subtitle's folder or the nearest ancestor folder within
the scanned path (sample clips are ignored); a subtitle is skipped when there is
no single main video (zero or several remain), the target already exists, or the
name equals the video stem with no
suffix (nothing to move or rename — add a language segment manually). One Y/n
prompt is asked per directory. Prompts read from the terminal, or from stdin
when it is piped or redirected, so `yes | vids-lint -i` auto-confirms every fix.
-i cannot be combined with --json.

Output: one block per dirty directory (plain text), or one JSON object per
dirty directory with --json. Exit status 0 if everything is clean, 1 if any
directory is dirty (after fixes, in -i mode).
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sys
from pathlib import Path
from typing import Dict, List, Optional, TextIO, Tuple

VIDEO_EXTENSIONS = {
    '.mp4', '.m4v', '.mkv', '.avi', '.mov', '.webm', '.wmv', '.mpg', '.mpeg', '.ogm',
}
SUBTITLE_EXTENSIONS = {'.srt'}
MEDIA_EXTENSIONS = VIDEO_EXTENSIONS | SUBTITLE_EXTENSIONS


def video_stem(name: str) -> str:
    """Filename without its (single) extension, e.g. 'A.B.mp4' -> 'A.B'."""
    return name[: -len(Path(name).suffix)] if Path(name).suffix else name


def is_sample_video_name(name: str) -> bool:
    """True when the filename has a delimited 'sample' token (e.g. Sample_1.mp4)."""
    return 'sample' in re.split(r'[\W_]+', Path(name).stem.lower())


# Heuristic set of tokens that look like a language: ISO 639-1/2 codes plus
# common English language names. Not exhaustive (a canonical-language feature
# will come later); it only decides whether a lone subtitle carries any
# language-ish hint at all.
LANGUAGE_TOKENS = frozenset({
    'en', 'eng', 'english',
    'es', 'spa', 'spanish', 'esp',
    'fr', 'fra', 'fre', 'french',
    'de', 'deu', 'ger', 'german',
    'it', 'ita', 'italian',
    'pt', 'por', 'portuguese', 'brazilian',
    'ru', 'rus', 'russian',
    'ja', 'jpn', 'japanese',
    'zh', 'zho', 'chi', 'chinese', 'mandarin', 'cantonese',
    'ko', 'kor', 'korean',
    'ar', 'ara', 'arabic',
    'nl', 'nld', 'dut', 'dutch',
    'sv', 'swe', 'swedish',
    'no', 'nor', 'norwegian',
    'da', 'dan', 'danish',
    'fi', 'fin', 'finnish',
    'pl', 'pol', 'polish',
    'tr', 'tur', 'turkish',
    'cs', 'ces', 'cze', 'czech',
    'el', 'ell', 'gre', 'greek',
    'he', 'heb', 'hebrew',
    'hi', 'hin', 'hindi',
    'th', 'tha', 'thai',
    'vi', 'vie', 'vietnamese',
    'id', 'ind', 'indonesian',
    'uk', 'ukr', 'ukrainian',
    'ro', 'ron', 'rum', 'romanian',
    'hu', 'hun', 'hungarian',
    'bg', 'bul', 'bulgarian',
    'hr', 'hrv', 'croatian',
    'sr', 'srp', 'serbian',
    'sk', 'slo', 'slk', 'slovak',
    'sl', 'slv', 'slovenian',
    'et', 'est', 'estonian',
    'lv', 'lav', 'latvian',
    'lt', 'lit', 'lithuanian',
    'fa', 'per', 'fas', 'persian', 'farsi',
})


def has_language_like_segment(text: str) -> bool:
    """True when any alphabetic token in text looks like a language code/name."""
    return any(
        tok.lower() in LANGUAGE_TOKENS
        for tok in re.split(r'[^A-Za-z]+', text)
        if tok
    )


def choose_main_video(videos: List[Path]) -> Optional[Path]:
    """The feature among a folder's videos, or None if it is ambiguous.

    Sample clips are ignored. Returns the video only when exactly one non-sample
    video remains; with zero or several, returns None (no assumption is made
    about which is the feature).
    """
    candidates = [v for v in videos if not is_sample_video_name(v.name)]
    return candidates[0] if len(candidates) == 1 else None


def lint_subtitles(video_names: List[str], srt_names: List[str]) -> List[Tuple[str, str, str]]:
    """Return (srt_name, reason, code) for each misaligned subtitle in a directory.

    A subtitle is aligned when it lives beside a video, is named
    <video-stem>.<suffix>.srt, and the suffix carries a language segment (an
    ISO code or language name, e.g. .en / .eng / .2_English). Flagged cases and
    their violation codes:
      - orphan-subtitle: name matches no video stem in the folder.
      - non-identifiable-language-subtitle-file: name is tied to a video but
        carries no language segment (e.g. Movie.srt or Movie.forced.srt beside
        Movie.mp4). Only the part of the name past the video stem is inspected,
        so a title word (The.English.Patient.srt) is not read as a language.
    """
    stems = {video_stem(v) for v in video_names}
    issues: List[Tuple[str, str, str]] = []
    for srt in sorted(srt_names, key=str.lower):
        stem = srt[: -len('.srt')]  # srt_names are already known to end in .srt
        if stem in stems:
            annotation = ''
        else:
            prefixes = [vs for vs in stems if stem.startswith(vs + '.')]
            if not prefixes:
                issues.append((srt, 'no matching video file in this folder', 'orphan-subtitle'))
                continue
            annotation = stem[len(max(prefixes, key=len)) + 1:]
        if not has_language_like_segment(annotation):
            issues.append((
                srt,
                'no identifiable language segment in name',
                'non-identifiable-language-subtitle-file',
            ))
    return issues


def lint_directory(
    dirpath: str, filenames: List[str], show_all: bool = False
) -> Optional[Dict[str, object]]:
    """Return a findings dict for one directory, or None when it is clean."""
    videos = sorted(
        (n for n in filenames if Path(n).suffix.lower() in VIDEO_EXTENSIONS),
        key=str.lower,
    )
    srts = [n for n in filenames if Path(n).suffix.lower() in SUBTITLE_EXTENSIONS]

    if not videos and not srts:
        return None

    # non-identifiable-language-subtitle-file is a quiet violation: there is no
    # language to key off, so it is suppressed unless -a/--all.
    unaligned = [
        (f, r, c)
        for (f, r, c) in lint_subtitles(videos, srts)
        if show_all or c != 'non-identifiable-language-subtitle-file'
    ]

    real_videos = [v for v in videos if not is_sample_video_name(v)]
    multiple = real_videos if len(real_videos) > 1 else []

    if not unaligned and not multiple:
        return None

    return {
        'dir': dirpath,
        'multiple_videos': multiple,
        'unaligned_subtitles': [
            {'file': f, 'reason': r, 'code': c} for f, r, c in unaligned
        ],
    }


def path_has_media(path: Path) -> bool:
    """True when path is a video/subtitle file or a tree containing one."""
    if path.is_file():
        return path.suffix.lower() in MEDIA_EXTENSIONS
    if path.is_dir():
        for _dirpath, _dirnames, filenames in os.walk(path):
            if any(Path(n).suffix.lower() in MEDIA_EXTENSIONS for n in filenames):
                return True
    return False


def select_first_eligible(root: Path) -> Optional[Path]:
    """First non-hidden entry of root (sorted by name) that has media, or None."""
    try:
        names = sorted(n for n in os.listdir(root) if not n.startswith('.'))
    except OSError:
        return None
    for n in names:
        candidate = root / n
        if path_has_media(candidate):
            return candidate
    return None


def list_current_dir_entries() -> List[str]:
    """Non-hidden entries of the current directory, sorted (like a glob '*')."""
    try:
        return sorted(n for n in os.listdir('.') if not n.startswith('.'))
    except OSError:
        return []


def iter_directories(root: Path) -> List[Tuple[str, List[str]]]:
    """Yield (dirpath, filenames) for root's tree; a file root yields its parent."""
    if root.is_file():
        return [(str(root.parent), [root.name])]
    if not root.is_dir():
        return []
    out: List[Tuple[str, List[str]]] = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames.sort()
        out.append((dirpath, filenames))
    return out


def find_main_video(sub_path: Path, scan_root: Path) -> Optional[Path]:
    """The feature video for a subtitle: in its folder, else up to scan_root.

    Sample clips are ignored (see choose_main_video). Returns None when no
    single non-sample video is found in that chain.
    """
    try:
        root_r = scan_root.resolve()
        cur = sub_path.parent.resolve()
    except OSError:
        return None
    while cur == root_r or root_r in cur.parents:
        try:
            vids = [
                p for p in cur.iterdir()
                if p.is_file() and p.suffix.lower() in VIDEO_EXTENSIONS
            ]
        except OSError:
            vids = []
        main = choose_main_video(vids)
        if main is not None:
            return main
        if cur == root_r:
            break
        cur = cur.parent
    return None


def open_prompt_input() -> Optional[TextIO]:
    """Where to read Y/n answers from.

    Prefers stdin when it is piped or redirected, so `yes | vids-lint -i` works;
    otherwise uses the controlling terminal (/dev/tty), falling back to a TTY
    stdin. Returns None only when no input source is available.
    """
    if sys.stdin is not None and not sys.stdin.isatty():
        return sys.stdin
    try:
        return open('/dev/tty', 'r', encoding='utf-8', errors='replace')
    except OSError:
        if sys.stdin is not None and sys.stdin.isatty():
            return sys.stdin
        return None


def read_yes_no(question: str, tty_in: TextIO) -> bool:
    """Prompt on stderr; default is yes. EOF counts as no."""
    while True:
        print(f'{question} [Y/n] ', end='', file=sys.stderr, flush=True)
        line = tty_in.readline()
        if not line:
            print(file=sys.stderr, flush=True)
            return False
        ans = line.strip().lower()
        if ans in ('', 'y', 'yes'):
            return True
        if ans in ('n', 'no'):
            return False
        print('Please answer y or n.', file=sys.stderr, flush=True)


def subtitle_target_name(video_name: str, sub_name: str) -> str:
    """Name the subtitle should have next to its video.

    Prepends the video stem to the original subtitle name so descriptors are
    kept verbatim (2_English.srt -> <video-stem>.2_English.srt). If the subtitle
    already carries the video stem, its name is left as-is (relocate only).
    """
    stem = video_stem(video_name)
    sub_stem = sub_name[: -len('.srt')] if sub_name.lower().endswith('.srt') else Path(sub_name).stem
    if sub_stem == stem or sub_stem.startswith(stem + '.'):
        return sub_name
    return f'{stem}.{sub_name}'


def plan_subtitle_fix(sub_path: Path, scan_root: Path) -> Tuple[bool, object]:
    """Dry run. Returns (True, target Path) if a move/rename is available,
    else (False, reason str)."""
    main_video = find_main_video(sub_path, scan_root)
    if main_video is None:
        return (False, 'no single main video found')
    target = main_video.parent / subtitle_target_name(main_video.name, sub_path.name)
    try:
        same = target.resolve() == sub_path.resolve()
    except OSError:
        same = str(target) == str(sub_path)
    if same:
        return (False, 'no identifiable language segment; rename manually')
    if target.exists():
        return (False, f'target already exists: {target}')
    return (True, target)


def run_interactive(paths: List[str], tty_in: TextIO, show_all: bool = False) -> int:
    """Process each top-level item in order with live feedback.

    Clean items are skipped silently; dirty items with no automatic fix are
    noted and skipped; fixable items are reported and their subtitles offered.
    """
    total_issues = 0
    fixed_count = 0
    dirty_items = 0
    for entry in paths:
        root = Path(entry).expanduser()
        if not root.exists():
            print(f'vids-lint: no such path: {entry}', file=sys.stderr, flush=True)
            continue
        scan_root = root if root.is_dir() else root.parent
        findings: List[Dict[str, object]] = []
        for dirpath, filenames in iter_directories(root):
            result = lint_directory(dirpath, filenames, show_all)
            if result is not None:
                findings.append(result)
        if not findings:
            continue  # clean; skip silently
        findings.sort(key=lambda r: str(r['dir']))
        dirty_items += 1
        total_issues += sum(
            (1 if r['multiple_videos'] else 0) + len(r['unaligned_subtitles'])
            for r in findings
        )
        fixable = any(
            plan_subtitle_fix(Path(str(r['dir'])) / str(sub['file']), scan_root)[0]
            for r in findings
            for sub in r['unaligned_subtitles']
        )
        if not fixable:
            print(
                f'vids-lint: {entry} needs correction but has no automatic fix; skipping',
                file=sys.stderr,
                flush=True,
            )
            continue
        print(f'vids-lint: fixing {entry}', file=sys.stderr, flush=True)
        for r in findings:
            print(str(r['dir']), flush=True)
            mv = r['multiple_videos']
            if mv:
                print(f'  multiple video files ({len(mv)}): {", ".join(mv)}', flush=True)
            planned: List[Tuple[Path, Path]] = []
            for sub in r['unaligned_subtitles']:
                print(
                    f'  unaligned subtitle [{sub["code"]}]: {sub["file"]} — {sub["reason"]}',
                    flush=True,
                )
                sub_path = Path(str(r['dir'])) / str(sub['file'])
                available, info = plan_subtitle_fix(sub_path, scan_root)
                if available:
                    print(f'    -> {info}', flush=True)
                    planned.append((sub_path, info))  # type: ignore[arg-type]
                else:
                    print(f'    (not fixable: {info})', flush=True)
            if not planned:
                continue
            noun = 'fix' if len(planned) == 1 else 'fixes'
            if not read_yes_no(f'  apply {len(planned)} {noun} in this directory?', tty_in):
                print('    (left unchanged)', flush=True)
                continue
            for sub_path, target in planned:
                if target.exists():
                    print(f'    (not fixed: target already exists: {target})', flush=True)
                    continue
                try:
                    target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.move(str(sub_path), str(target))
                except OSError as e:
                    print(f'    (not fixed: move failed: {e})', flush=True)
                    continue
                print(f'    fixed -> {target}', flush=True)
                fixed_count += 1

    if dirty_items == 0:
        print('vids-lint: no issues found', flush=True)
        return 0
    remaining = total_issues - fixed_count
    summary = f'\n{dirty_items} dirty item(s), {total_issues} issue(s)'
    if fixed_count:
        summary += f'; fixed {fixed_count}, {remaining} remaining'
    print(summary, flush=True)
    return 1 if remaining > 0 else 0


def main(argv: Optional[List[str]] = None) -> int:
    p = argparse.ArgumentParser(
        description='Lint video directories for unaligned subtitles and multiple videos.'
    )
    p.add_argument(
        'paths',
        nargs='*',
        help='Directories or files to scan. With none, the first eligible item '
        '(sorted by name) in the current directory is used; with -i, every '
        'non-hidden entry in the current directory (as if the argument were *).',
    )
    p.add_argument('--json', action='store_true', help='Emit one JSON object per dirty directory')
    p.add_argument(
        '-a',
        '--all',
        action='store_true',
        help='Also report non-identifiable-language-subtitle-file violations: a '
        'subtitle tied to a video but carrying no language segment (e.g. '
        'Movie.srt next to Movie.mp4). Suppressed by default.',
    )
    p.add_argument(
        '-i',
        '--interactive',
        action='store_true',
        help='Interactive fix mode: offer to move/rename each fixable subtitle '
        'next to its main video with the video basename (keeps the language).',
    )
    args = p.parse_args(argv)

    if args.interactive and args.json:
        p.error('-i/--interactive cannot be combined with --json')

    if args.paths:
        paths = args.paths
    elif args.interactive:
        paths = list_current_dir_entries()
        if not paths:
            print(
                'vids-lint: nothing in the current directory',
                file=sys.stderr,
                flush=True,
            )
            return 0
    else:
        selected = select_first_eligible(Path('.'))
        if selected is None:
            print(
                'vids-lint: no eligible video items in the current directory',
                file=sys.stderr,
                flush=True,
            )
            return 0
        print(f'vids-lint: linting {selected}', file=sys.stderr, flush=True)
        paths = [str(selected)]

    if args.interactive:
        prompt_input = open_prompt_input()
        if prompt_input is not None:
            return run_interactive(paths, prompt_input, args.all)
        print(
            'vids-lint: -i needs a terminal or piped input; reporting without fixing',
            file=sys.stderr,
            flush=True,
        )

    findings: List[Dict[str, object]] = []
    for x in paths:
        root = Path(x).expanduser()
        if not root.exists():
            print(f'vids-lint: no such path: {x}', file=sys.stderr, flush=True)
            continue
        for dirpath, filenames in iter_directories(root):
            result = lint_directory(dirpath, filenames, args.all)
            if result is not None:
                findings.append(result)

    findings.sort(key=lambda r: str(r['dir']))

    total_issues = 0
    for r in findings:
        if r['multiple_videos']:
            total_issues += 1
        total_issues += len(r['unaligned_subtitles'])

    if args.json:
        for r in findings:
            print(json.dumps(r, ensure_ascii=False), flush=True)
        return 1 if findings else 0

    for r in findings:
        print(str(r['dir']), flush=True)
        mv = r['multiple_videos']
        if mv:
            print(f'  multiple video files ({len(mv)}): {", ".join(mv)}', flush=True)
        for sub in r['unaligned_subtitles']:
            print(
                f'  unaligned subtitle [{sub["code"]}]: {sub["file"]} — {sub["reason"]}',
                flush=True,
            )

    if findings:
        print(
            f'\n{len(findings)} dirty director{"y" if len(findings) == 1 else "ies"}, '
            f'{total_issues} issue(s)',
            flush=True,
        )
        return 1
    print('vids-lint: no issues found', flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
