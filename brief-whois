#!/usr/bin/env bash

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
Usage: brief-whois [-v] [domain ...]

Look up domains via RDAP (rdap.org). Default output is one tab-separated line per
domain; -v prints a multi-line report. With no arguments, reads domains from stdin.
EOF
  exit 0
fi

verbose=0
if [ "$1" = "-v" ]; then
  verbose=1
  shift
fi

is_valid_domain() {
  local d=$1
  # Overall length limit per DNS.
  [ ${#d} -le 253 ] || return 1
  # Must look like label(.label)+ with a final alphabetic TLD.
  # Labels: 1-63 chars, alphanumerics/hyphen, no leading/trailing hyphen.
  # This rejects empty labels (e.g. "a..b"), leading/trailing dots, and
  # bare hostnames without a dot.
  [[ $d =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]] || return 1
  return 0
}

brief_error_detail() {
  local data=$1
  local http_code=$2
  local curl_status=$3

  if [ "$curl_status" -ne 0 ]; then
    echo "fetch failed (curl exit $curl_status)"
    return
  fi
  if [ -z "$data" ]; then
    echo "empty response (HTTP ${http_code:-unknown})"
    return
  fi
  if echo "$data" | grep -q "error code: 1015"; then
    echo "rate limited"
    return
  fi
  local detail
  detail=$(echo "$data" | jq -r '
    if .errorCode then
      "RDAP \(.errorCode)\(if .title then ": " + .title else "" end)\(if .description then " — " + .description else "" end)"
    else
      empty
    end
  ' 2>/dev/null)
  if [ -n "$detail" ] && [ "$detail" != "null" ]; then
    echo "$detail"
    return
  fi
  local snippet
  snippet=$(printf '%s' "$data" | tr '\n' ' ' | head -c 100)
  echo "unparseable response (HTTP ${http_code:-?}): ${snippet}"
}

# Collect domains from positional args; if none, read them from stdin
# (one per line, ignoring blank lines and surrounding whitespace) so the
# script can be fed a list via a pipe or file redirection.
domains=("$@")
if [ ${#domains[@]} -eq 0 ] && [ ! -t 0 ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] && domains+=("$line")
  done
fi

for d in "${domains[@]}"; do
  user_agent="brief-whois/1.0 (+https://github.com/cschuyle/cschuyle-bin)"

  if ! is_valid_domain "$d"; then
    if [ $verbose -eq 1 ]; then
      echo "=== $d ==="
      echo "Error: '$d' is not a valid domain name"
      echo
    else
      echo -e "$d\tError: malformed domain name"
    fi
    continue
  fi

  # Sleep for a random interval between 100 and 666 ms before the request
  sleep_ms=$((RANDOM % 567 + 100))
  sleep $(awk "BEGIN {print $sleep_ms/1000}")
  tmp=$(mktemp)
  http_code=$(curl -A "$user_agent" -sL -w "%{http_code}" -o "$tmp" "https://rdap.org/domain/$d")
  curl_status=$?
  data=$(cat "$tmp")
  rm -f "$tmp"
  if [ "$curl_status" -ne 0 ] || [ -z "$data" ]; then
    if [ "$curl_status" -eq 0 ] && [ -z "$data" ] && [ "$http_code" = "404" ]; then
      if [ $verbose -eq 1 ]; then
        echo "=== $d ==="
        echo "Not Registered (HTTP 404, empty body)"
        echo
      else
        echo -e "$d\tNot Registered"
      fi
    elif [ $verbose -eq 1 ]; then
      echo "=== $d ==="
      echo "Error: Failed to fetch data for $d ($(brief_error_detail "$data" "$http_code" "$curl_status"))"
      echo
    else
      echo -e "$d\tError: $(brief_error_detail "$data" "$http_code" "$curl_status")"
    fi
    continue
  fi

  # Try parsing with jq, catch parse errors
  parse_and_print() {
    echo "$1" | jq -e -r '
      def get_event($type):
        [.events[]? | select(.eventAction == $type) | .eventDate] | first;

      "Registrar: " + (.entities[]?.vcardArray[1][] | select(.[0]=="fn") | .[3] // "N/A"),
      "Created:   " + (get_event("registration") // "N/A"),
      "Updated:   " + (get_event("last changed") // "N/A"),
      "Expires:   " + (get_event("expiration") // "N/A"),
      "Nameservers:",
      (.nameservers[]?.ldhName // empty | "  - " + .)
    ' 2>/dev/null
    return $?
  }

  if [ $verbose -eq 1 ]; then
    echo "=== $d ==="
    parse_and_print "$data"
    jq_status=$?
    if [ $jq_status -ne 0 ]; then
      if echo "$data" | grep -q "error code: 1015"; then
        echo "Rate-limit - sleeping and trying again"
        sleep 1
        sleep_ms=$((RANDOM % 567 + 100))
        sleep $(awk "BEGIN {print $sleep_ms/1000}")
        tmp2=$(mktemp)
        http_code2=$(curl -A "$user_agent" -sL -w "%{http_code}" -o "$tmp2" "https://rdap.org/domain/$d")
        data2=$(cat "$tmp2")
        rm -f "$tmp2"
        parse_and_print "$data2"
        jq_status2=$?
        if [ $jq_status2 -ne 0 ]; then
          if echo "$data2" | grep -q "error code: 1015"; then
            echo "Rate-limit - giving up after sleeping"
          else
            echo "Error: Failed to parse data for $d (invalid domain or parse error)"
            echo "Offending string:"
            echo "$data2"
          fi
        fi
      else
        echo "Error: Failed to parse data for $d (invalid domain or parse error)"
        echo "Offending string:"
        echo "$data"
      fi
    fi
    echo
  else
    # Not verbose: just print <domain>\t<status>
    # Try to determine registration status
    echo "$data" | jq -e '.objectClassName == "domain"' >/dev/null 2>&1
    if [ $? -eq 0 ]; then
      echo -e "$d\tRegistered"
    else
      # Try to detect not registered (rdap.org returns 404 JSON with errorCode 404)
      echo "$data" | jq -e '.errorCode == 404' >/dev/null 2>&1
      if [ $? -eq 0 ]; then
        echo -e "$d\tNot Registered"
      else
        echo -e "$d\tError: $(brief_error_detail "$data" "$http_code" 0)"
      fi
    fi
  fi
done
