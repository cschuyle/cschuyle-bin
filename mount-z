#!/usr/bin/env bash
set -e

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
Usage: mount-z

Mount the Synology cschuyle share at /mnt/z on WSL (requires DRAGNON_SYNOLOGY_IP).
EOF
  exit 0
fi

[[ -z "$DRAGNON_SYNOLOGY_IP" ]] && echo "DRAGNON_SYNOLOGY_IP is not set" && exit 1
[[ -z "$WSL_DISTRO_NAME" ]] && echo "This scsript is meant for WSL, and WSL_DISTRO_NAME is not set, so ... good luck" 1>&2
sudo mount -t drvfs '\\DRAGNON_SYNOLOGY_IP\cschuyle' /mnt/z
