        else:
            report_warn(f"Setting {label} (could not update {settings_path})")
    elif kind == "chrome-json":
        if mac_chrome_is_running():
            out("Quit Google Chrome before applying this fix (prefs are overwritten while it runs).")
            if not gar_prompt_yn(f"Chrome still running — fix {label} anyway (set {key} to {expected})?",
                                 "", "N"):
