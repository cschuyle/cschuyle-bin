def gar_section_begin(name):
    global gar_section_name, gar_section_header_printed
    gar_section_name = name
    gar_section_header_printed = False


def gar_section_emit_header():
    global gar_section_lead, gar_section_header_printed
    if not gar_section_header_printed:
        out(gar_section_lead + gar_section_name)
        gar_section_lead = "\n"
        gar_section_header_printed = True


def report_ok(msg):
    if gar_show_all:
        gar_section_emit_header()
        out(f"OK   {msg}")


def report_miss(msg):
    global issues
    gar_section_emit_header()
    out(f"MISS {msg}")
    issues += 1


def report_warn(msg):
    global warnings
    gar_section_emit_header()
    out(f"WARN {msg}")
    warnings += 1


# gar_note_fixed issue|warning — record a successfully applied interactive fix.
def gar_note_fixed(kind):
    global gar_fixed_issues, gar_fixed_warnings
    if kind == "issue":
        gar_fixed_issues += 1
    else:
        gar_fixed_warnings += 1


# "N thing" / "N things"
def gar_plural(n, word):
    return f"{n} {word}" if n == 1 else f"{n} {word}s"


# Emit a single line with the status prefix padded to a common column width, so
# WARN / MISS / EXPECTED MODS / OK all align. Used by the machine-env-repo
# section (which pre-aligns the rest of the line into columns of its own); the
# plain report_* helpers above are still used everywhere else. report_line does
# NOT touch `issues` — callers that need the exit-status bump (MISS) must do it
# themselves.
GAR_STATUS_WIDTH = 13  # width of the longest prefix, "EXPECTED MODS"


def report_line(status, msg):
    global warnings
    gar_section_emit_header()
    out(f"{status:<{GAR_STATUS_WIDTH}}  {msg}")
    if status == "WARN":
        warnings += 1


def report_ok_preformatted(msg):
    if gar_show_all:
        report_line("OK", msg)


# --- Machine-env repos ------------------------------------------------------

def gar_expand_home(path):
    return path.replace("$HOME", HOME)


def _is_git_repo(repo):
    return os.path.isdir(os.path.join(repo, ".git"))


# "Dirty" = tracked files with genuine local edits. Untracked files are ignored
# (--untracked-files=no) so a stray untracked file doesn't warn, and
# skip-worktree'd files are already excluded by git status by design (their
# expected mods are surfaced separately via gar_repo_skip_worktree_modified).
def gar_repo_dirty(repo):
    if not _is_git_repo(repo):
        return False
    return bool(git(repo, "status", "--porcelain", "--untracked-files=no")[1])


# The skip-worktree'd tracked files whose working-tree content differs from
# their committed (HEAD) blob. These are intentional local edits hidden from
# `git status` via the skip-worktree bit (e.g. log4j2.properties tweaks); they
# are "expected mods", not a problem. git's diff plumbing honors the skip bit at
# every level (status/diff/diff-files/diff-index all ignore these files), so we
# compare the working-tree content hash to the HEAD blob directly, per file.
# Same technique as git-better-skip-worktree, but by repo path (git -C) since
# gar audits arbitrary repos.
def gar_repo_skip_worktree_modified_files(repo):
    if not _is_git_repo(repo):
        return []
    files = []
    _, listing = git(repo, "ls-files", "-v")
    for line in listing.split("\n"):
        if not line.startswith("S"):
            continue
        f = line[2:]
        if not f:
            continue
        rc, wt = git(repo, "hash-object", "--", f)
        if rc != 0:
            continue
        rc, head = git(repo, "rev-parse", "HEAD:" + f)
        if rc != 0:
            continue
        if wt != head:
            files.append(f)
    return files


def gar_repo_skip_worktree_modified(repo):
    return bool(gar_repo_skip_worktree_modified_files(repo))


# Count of tracked files with genuine (non-skip-worktree, non-untracked) local
# edits — the same set gar_repo_dirty tests for, but counted.
def gar_repo_local_mod_count(repo):
    if not _is_git_repo(repo):
        return 0
    _, status = git(repo, "status", "--porcelain", "--untracked-files=no")
    return sum(1 for l in status.split("\n") if l)


def gar_repo_current_branch(repo):
    if not _is_git_repo(repo):
        return None
    rc, b = git(repo, "symbolic-ref", "--quiet", "--short", "HEAD")
    return b if rc == 0 else None


# Remote's default branch (origin/HEAD), with the "origin/" prefix stripped.
# None when origin/HEAD is unset locally — callers treat that as "unknown" and
# skip the configured-vs-default warning.
def gar_repo_remote_default_branch(repo):
    if not _is_git_repo(repo):
        return None
    rc, ref = git(repo, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD")
    if rc != 0 or not ref:
        return None
    return ref[len("origin/"):] if ref.startswith("origin/") else ref


def gar_repo_pull(repo, branch="main"):
    return run_tty(["git"] + GAR_GIT_NET_OPTS + ["-C", repo, "pull", "-r", "origin", branch]) == 0


# --- Catch-up repos --------------------------------------------------------
# A "catch-up" repo (named in a machine-env-catchup manifest) is updated by
# rebasing the *current* branch onto a configured "mainline" ref — `git fetch
# <remote>` + `git rebase <mainline>` — rather than pulling config_branch from
# origin. This suits repos where you sit on a feature branch and periodically
# rebase it onto mainline (e.g. origin/main). The mainline is deliberately NOT
# the branch's own upstream @{u}: the feature branch keeps its own upstream
# (e.g. origin/FEATURE) so `git push` still goes to the feature branch, while
# catch-up rebases from a different branch. These helpers take the resolved
# mainline ref as an argument and never read @{u}.

# Resolve a catch-up repo's mainline ref (the branch to rebase onto). An
# explicit manifest value wins; otherwise default to origin/<repo's remote
# default branch>. None when no mainline is configured and the remote default
# can't be determined.
def gar_repo_catchup_mainline_ref(repo, configured):
    if configured:
        return configured
    default = gar_repo_remote_default_branch(repo)
    return f"origin/{default}" if default else None


def _rev_count(repo, rng):
    rc, n = git(repo, "rev-list", "--count", rng)
    if rc != 0:
        return 0
    try:
        return int(n)
    except ValueError:
        return 0


def _verify(repo, ref, quiet=False):
    args = ["rev-parse", "--verify"] + (["--quiet"] if quiet else []) + [ref]
    return git(repo, *args)[0] == 0


# How many commits the current branch is behind the mainline ref
# (HEAD..<mainline>). 0 when the mainline doesn't resolve.
def gar_repo_catchup_behind_count(repo, mainline):
    if not _is_git_repo(repo) or not mainline or not _verify(repo, mainline, quiet=True):
        return 0
    return _rev_count(repo, "HEAD.." + mainline)


# Fetch the mainline ref's remote (so the mainline is current). The mainline is
# a remote-tracking ref like "origin/main"; the remote is the part before the
# first "/". False when there's no mainline, the fetch fails, or the mainline
# still doesn't resolve afterward.
def gar_repo_catchup_fetch(repo, mainline):
    if not _is_git_repo(repo) or not mainline:
        return False
    remote = mainline.split("/", 1)[0]
    if not remote:
        return False
    if gar_run_with_timeout(15, ["git"] + GAR_GIT_NET_OPTS + ["-C", repo, "fetch", "--quiet", remote]) != 0:
        return False
    return _verify(repo, mainline, quiet=True)


# Catch up the current branch: rebase it onto the mainline ref. This does not
# touch the branch's own upstream (@{u}), so the push target is preserved.
def gar_repo_rebase_onto_mainline(repo, mainline):
    return run_tty(["git", "-C", repo, "rebase", mainline]) == 0


def gar_can_prompt():
    if gar_recheck:
        return False
    return os.access("/dev/tty", os.R_OK) or sys.stdin.isatty()


# Prompt Y/n (default Y) or y/N (default N). Optional help text is printed when
# the user answers "?"; when set, the prompt suffix includes ?-Print install
# command. Optional default reply Y or N (default Y).
def gar_prompt_yn(prompt, help_text="", default="Y"):
    if gar_recheck:
        return False
    sys.stdout.flush()
    stream = None
    if os.access("/dev/tty", os.R_OK):
        try:
            stream = open("/dev/tty")
        except OSError:
            return False
    elif sys.stdin.isatty():
        stream = sys.stdin
    else:
        return False

    default = "N" if default.lower() in ("n", "no") else "Y"
    opts = "y/N" if default == "N" else "Y/n"
    suffix = f"[{opts}/?-Print install command]" if help_text else f"[{opts}]"

    try:
        while True:
            sys.stderr.write(f"{prompt} {suffix} ")
            sys.stderr.flush()
            reply = stream.readline()
            if not reply:
                return False
            reply = reply.replace("\r", "").strip() or default
            if reply.lower() in ("y", "yes"):
                return True
            if reply.lower() in ("n", "no"):
                return False
            if reply == "?":
                err(help_text if help_text else "Please answer Y or n.")
            else:
                err("Please answer Y, n, or ?." if help_text else "Please answer Y or n.")
    finally:
        if stream is not sys.stdin:
            stream.close()


def gar_repo_unpushed_count(repo, branch="main"):
    if not _is_git_repo(repo):
        return 0
    if not _verify(repo, branch) or not _verify(repo, "origin/" + branch):
        return 0
    return _rev_count(repo, f"origin/{branch}..{branch}")


def gar_repo_behind_count(repo, branch="main"):
    if not _is_git_repo(repo):
        return 0
    if not _verify(repo, branch) or not _verify(repo, "origin/" + branch):
        return 0
    return _rev_count(repo, f"{branch}..origin/{branch}")


def gar_repo_try_fetch(repo, branch="main"):
    if not _is_git_repo(repo) or not _verify(repo, branch):
        return False
    if git(repo, "remote", "get-url", "origin")[0] != 0:
        return False
    if gar_run_with_timeout(15, ["git"] + GAR_GIT_NET_OPTS + ["-C", repo, "fetch", "--quiet", "origin", branch]) != 0:
        return False
    return _verify(repo, "origin/" + branch)


def gar_machine_env_skip_name(skip_manifest, want):
    return want in read_manifest(skip_manifest)


# Is <name> in the catch-up manifest? Manifest lines are `name|mainline`
# (pipe-delimited, like machine-env-repos); a bare `name` is also valid. Being
# listed switches the repo to catch-up mode (rebase current branch onto the
# mainline ref) instead of the config_branch pull. Returns the configured
# mainline (the 2nd field, whitespace-trimmed; "" for a bare name — the caller
# then defaults it via gar_repo_catchup_mainline_ref), or None when the name
# isn't listed.
def gar_machine_env_catchup_mainline(catchup_manifest, want):
    for line in read_manifest(catchup_manifest):
        name, mainline = split_fields(line, 2)
        if name == want:
            return mainline.strip()
    return None


# (name, path, branch) for each machine-env repo: the manifest entries, then any
# auto-discovered ~/Yew/*-setup repos; skip-listed names and duplicate paths
# are dropped.
def gar_machine_env_list_repos(repos_lines, skip_manifest=""):
    repos = []
    seen = set()
    skip = set(read_manifest(skip_manifest))
    for line in repos_lines:
        name, path, branch = split_fields(line, 3)
        if name in skip:
            continue
        path = gar_expand_home(path)
        # Optional 3rd field is the branch to track; trim whitespace and default to main.
        branch = branch.strip() or "main"
        if path in seen:
            continue
        seen.add(path)
        repos.append((name, path, branch))

    for setup_dir in sorted(glob.glob(os.path.join(glob.escape(HOME), "Yew", "*-setup"))):
        if not os.path.isdir(setup_dir) or not _is_git_repo(setup_dir):
            continue
        setup_name = os.path.basename(setup_dir)
        if setup_name in skip or setup_dir in seen:
            continue
        seen.add(setup_dir)
        repos.append((setup_name, setup_dir, "main"))
    return repos


# Find a machine-env repo by name for the current platform/roles. Returns the
# resolved (name, path, branch) entry, or None if no repo matches.
def lookup_machine_env_repo_entry(query):
    platform = detect_platform()
    repos = gar_combined_lines(platform, "machine-env-repos")
    skip_manifest = gar_resolve_manifest(platform, "machine-env-skip")
    for entry in gar_machine_env_list_repos(repos, skip_manifest):
        if gar_name_eq(query, entry[0]):
            return entry
    return None


def gar_machine_env_prefetch_repo(name, path, branch="main", catchup_manifest=""):
    configured = gar_machine_env_catchup_mainline(catchup_manifest, name)
    catchup = configured is not None
    # config_branch is the branch this repo is configured to track (manifest
    # 3rd field, default main); branch (below) is the current checked-out branch.
    # catchup is set when the repo is named in the catch-up manifest: behind/
    # fetch are measured against the mainline ref, and the update action is a
    # rebase onto that mainline rather than a config_branch pull.
    r = {"name": name, "path": path, "config_branch": branch, "catchup": catchup}
    if not os.path.isdir(path):
        r["status"] = "missing"
        return r
    if not _is_git_repo(path):
        r["status"] = "not-git"
        return r
    r["status"] = "ok"
    r["branch"] = gar_repo_current_branch(path) or ""
    remote_default = gar_repo_remote_default_branch(path) or ""
    r["remote_default"] = remote_default
    # mainline is the catch-up rebase-onto ref: the manifest's explicit value,
    # else origin/<remote_default>. Empty when catch-up but no mainline could be
    # resolved (no explicit value and no remote default).
    mainline = ""
    if catchup:
        if configured:
            mainline = configured
        elif remote_default:
            mainline = "origin/" + remote_default
    r["mainline"] = mainline
    r["dirty"] = gar_repo_dirty(path)
    r["expected_mods"] = gar_repo_skip_worktree_modified(path)
    if catchup:
        # Catch-up: fetch/behind keyed off the mainline ref (e.g. origin/main).
        r["fetched"] = bool(mainline) and gar_repo_catchup_fetch(path, mainline)
        # ahead stays measured against origin/config_branch (unpushed work is
        # still worth flagging); behind switches to HEAD..<mainline>.
        r["ahead"] = gar_repo_unpushed_count(path, branch)
        r["behind"] = gar_repo_catchup_behind_count(path, mainline) if r["fetched"] else 0
    else:
        r["fetched"] = gar_repo_try_fetch(path, branch)
        r["ahead"] = gar_repo_unpushed_count(path, branch)
        r["behind"] = gar_repo_behind_count(path, branch) if r["fetched"] else 0
    return r


def gar_machine_env_prefetch_all(repos, catchup_manifest=""):
    """Prefetch every repo in parallel; returns {path: result}."""
    if not repos:
        return {}
    with ThreadPoolExecutor(max_workers=len(repos)) as pool:
        futures = {
            path: pool.submit(gar_timed, f"repo prefetch: {name}",
                              gar_machine_env_prefetch_repo, name, path, branch, catchup_manifest)
            for name, path, branch in repos
        }
        return {path: f.result() for path, f in futures.items()}


# Machine-env-repo report rows are buffered rather than printed immediately, so
# the section can measure name / (path) column widths across every row before
# emitting an aligned table. Each row is (status, name, path, message): status is
# OK | MISS | WARN | EXPECTED MODS, path is bare (the surrounding "(...)" is added
# at emit time), and message is "" for an OK row.
gar_mer_rows = []


# Buffer one report line. A MISS still bumps the global issues counter here (the
# emit pass uses report_line, which does not), preserving exit-status semantics.
def gar_mer_row(status, name, path, msg):
    global issues
    if status == "MISS":
        issues += 1
    gar_mer_rows.append((status, name, path, msg))


# Sort rank for grouping the emitted rows best-to-worst: OK, then the advisory
# EXPECTED MODS, then WARN, then the real problems (MISS) at the bottom, so the
# eye travels down toward what needs attention.
GAR_MER_RANK = {"OK": 0, "EXPECTED MODS": 1, "WARN": 2, "MISS": 3}


# Measure column widths across the buffered rows, then emit each as an aligned
# "STATUS  name  (path)  message" line, grouped by status (see GAR_MER_RANK) and
# alphabetical by repo name within a group (original order as tiebreaker, so a
# repo's multiple rows stay in emission order). OK rows only count/print under
# --all.
def gar_mer_flush():
    shown = [r for r in gar_mer_rows if r[0] != "OK" or gar_show_all]
    wname = max([len(r[1]) for r in shown] + [0])
    wpath = max([len(r[2]) + 2 for r in shown] + [0])  # +2 for the surrounding ()
    order = sorted(range(len(gar_mer_rows)),
                   key=lambda i: (GAR_MER_RANK.get(gar_mer_rows[i][0], 9), gar_mer_rows[i][1].lower(), i))
    for i in order:
        status, name, path, msg = gar_mer_rows[i]
        line = f"{name:<{wname}}  {'(' + path + ')':<{wpath}}  {msg}".rstrip()
        if status == "OK":
            report_ok_preformatted(line)
        else:
            report_line(status, line)


def report_machine_env_repo(name, path, r):
    # reported tracks whether any line was recorded for this repo (WARN or the
    # EXPECTED MODS / default-mismatch advisories) so the trailing OK is emitted
    # only when the repo was otherwise silent. Exit status is driven separately
    # by MISS rows (missing / not-git), which increment the global issues counter.
    if r["status"] == "missing":
        gar_mer_row("MISS", name, path, "missing")
        return
    if r["status"] == "not-git":
        gar_mer_row("MISS", name, path, "not a git repo")
        return
    reported = False
    config_branch = r["config_branch"] or "main"
    mainline = r["mainline"]
    branch = r["branch"]
    remote_default = r["remote_default"]
    if r["dirty"]:
        # Genuine tracked edits win over expected mods: still an issue.
        gar_mer_row("WARN", name, path, "uncommitted changes")
        reported = True
    elif r["expected_mods"]:
        # Only skip-worktree'd edits present — expected, advisory, not an issue.
        gar_mer_row("EXPECTED MODS", name, path, "expected local mods (skip-worktree)")
        reported = True
    ahead = r["ahead"]
    if ahead > 0:
        gar_mer_row("WARN", name, path, f"{gar_plural(ahead, 'unpushed commit')} on {config_branch}")
        reported = True
    behind = r["behind"]
    if r["catchup"]:
        # Catch-up repo: behind is measured against the mainline ref, and the
        # fix is a rebase onto that mainline, not a pull. A catch-up repo whose
        # mainline couldn't be resolved is flagged so it isn't silently ignored.
        if not mainline:
            gar_mer_row("WARN", name, path,
                        "catch-up repo but rebase mainline could not be resolved (no origin default)")
            reported = True
        elif r["fetched"] and behind > 0:
            gar_mer_row("WARN", name, path,
                        f"catch-up: rebase {branch or 'HEAD'} onto {mainline}; {gar_plural(behind, 'commit')} behind")
            reported = True
    elif r["fetched"] and behind > 0:
        gar_mer_row("WARN", name, path, f"pull would update {config_branch}; "
                                        f"{gar_plural(behind, 'commit')} behind origin/{config_branch}")
        reported = True
    # Advisory only (does not count as an issue): the configured branch isn't the
    # repo's remote default. Skipped when the remote default is unknown, and for
    # catch-up repos (which don't track config_branch — they rebase onto a
    # mainline ref).
    if not r["catchup"] and remote_default and remote_default != config_branch:
        gar_mer_row("WARN", name, path,
                    f"configured to track {config_branch} but origin default is {remote_default}")
        reported = True
    if not reported:
        gar_mer_row("OK", name, path, "")


def offer_machine_env_repo_pull(name, path, r):
    if not gar_can_prompt():
        return
    if r["status"] != "ok":
        return
    # dirty excludes skip-worktree'd edits, so a repo with only expected mods
    # passes this guard and is offered a pull/rebase — safe, since both `git
    # pull -r` and `git rebase <mainline>` leave skip-worktree'd files untouched.
    if r["dirty"]:
        return

    config_branch = r["config_branch"] or "main"
    branch = r["branch"]
    mainline = r["mainline"]

    if r["catchup"]:
        # Catch-up: rebase the *current* branch onto the mainline ref, regardless
        # of which branch is checked out (that's the point). The branch's own
        # upstream (@{u}, the push target) is left untouched. Requires a
        # resolved mainline.
        if not mainline:
            return
        behind = r["behind"]
        if not r["fetched"]:
            if not gar_timed(f"repo fetch (retry): {name}", gar_repo_catchup_fetch, path, mainline):
                return
            behind = gar_repo_catchup_behind_count(path, mainline)
        if behind <= 0:
            return
        prompt = (f"Catch up {name} ({path}; rebase {branch or 'HEAD'} onto {mainline}, "
                  f"{gar_plural(behind, 'commit')} behind)?")
        if gar_prompt_yn(prompt):
            if gar_timed(f"repo rebase: {name}", gar_repo_rebase_onto_mainline, path, mainline):
                out(f"Updated {name} ({path})")
                gar_note_fixed("warning")
            else:
                report_warn(f"Machine env repo {name} ({path} — rebase failed)")
        return

    # Only offer a pull when the repo is currently checked out on the branch we
    # track — don't pull it while the user sits on a feature branch.
    if branch != config_branch:
        return

    behind = r["behind"]
    if not r["fetched"]:
        if not gar_timed(f"repo fetch (retry): {name}", gar_repo_try_fetch, path, config_branch):
            return
        behind = gar_repo_behind_count(path, config_branch)
    if behind <= 0:
        return

    ahead = r["ahead"]
    prompt = f"Pull {name} ({path}; {gar_plural(behind, 'commit')} behind origin/{config_branch}"
    if ahead > 0:
        prompt += f", {gar_plural(ahead, 'unpushed commit')}"
    prompt += ")?"

    if gar_prompt_yn(prompt):
        if gar_timed(f"repo pull: {name}", gar_repo_pull, path, config_branch):
            out(f"Updated {name} ({path})")
            gar_note_fixed("warning")
        else:
            report_warn(f"Machine env repo {name} ({path} — pull failed)")


def check_machine_env_repos(repos_lines, skip_manifest="", catchup_manifest=""):
    repos = gar_machine_env_list_repos(repos_lines, skip_manifest)
    results = gar_machine_env_prefetch_all(repos, catchup_manifest)
    del gar_mer_rows[:]

    # Pass 1: buffer every repo's report rows so column widths can be measured.
    for name, path, _ in repos:
        report_machine_env_repo(name, path, results[path])

    gar_mer_flush()  # measure widths + emit the aligned table

    # Pass 2: interactive pull offers, printed after the table.
    for name, path, _ in repos:
        offer_machine_env_repo_pull(name, path, results[path])


