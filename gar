def mac_fix_next_window_angle():
    # Symbolic hotkey 27 = "Move focus to next window". Bind to Command-<
    # (keycap label; stored as ASCII 92 with keycode 50, Command 1048576) —
    # same physical key as Command-`, differing only by character. Matches
    # toggle-switch-key / System Settings on this layout.
    value = """
<dict>
  <key>enabled</key><true/>
  <key>value</key>
  <dict>
    <key>type</key><string>standard</string>
    <key>parameters</key>
    <array>
      <integer>92</integer>
      <integer>50</integer>
      <integer>1048576</integer>
    </array>
  </dict>
</dict>
"""
    if run_tty(["defaults", "write", "com.apple.symbolichotkeys", "AppleSymbolicHotKeys", "-dict-add", "27", value]) != 0:
        return False
    run(["defaults", "read", "com.apple.symbolichotkeys"])
    run(["/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings", "-u"])
    return True


# True if hotkey 27 is Command-< (ASCII 92, keycode 50, Command) — the expected
# binding under Czech-QWERTY + Karabiner. Command-` is the other
# toggle-switch-key value but is not the desired state for this check.
def mac_next_window_is_switch_key_binding():
    hk = mac_read_symbolic_hotkey("27")
    if hk is None:
        return False
    char, key, mod, enabled = hk
    return enabled == 1 and str(mod) == "1048576" and str(key) == "50" and str(char) == "92"


# --- Chrome preferences -----------------------------------------------------

def mac_chrome_user_data_dir():
    return os.path.join(HOME, "Library", "Application Support", "Google", "Chrome")


CHROME_SKIP_DIRS = {
    "System Profile", "Guest Profile", "Snap", "Snapshot", "Crashpad",
    "GrShaderCache", "GraphiteDawnCache", "ShaderCache", "Safe Browsing",
    "component_crx_cache", "extensions_crx_cache", "optimization_guide_model_store",
}


def _chrome_load(path):
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text())
    except ValueError:
        return None


def _chrome_info_cache(root):
    data = _chrome_load(root / "Local State") or {}
    cache = (data.get("profile") or {}).get("info_cache") or {}
    return data, cache if isinstance(cache, dict) else {}


# Profile directory names selected by location: "*", "@last", or "" → last-used
# profile; "@all" → every user profile; otherwise a profile directory name or
# display name / email.
def _chrome_profiles(root, location):
    if location in ("*", "@last", ""):
        data, _ = _chrome_info_cache(root)
        name = (data.get("profile") or {}).get("last_used")
        return [name if isinstance(name, str) and name else "Default"]
    if location == "@all":
        if not root.is_dir():
            return []
        return [p.name for p in sorted(root.iterdir())
                if p.is_dir() and p.name not in CHROME_SKIP_DIRS
                and ((p / "Preferences").is_file() or (p / "Secure Preferences").is_file())]
    # Exact profile directory name.
    if (root / location).is_dir():
        return [location]
    # Match Local State display name or signed-in email (case-insensitive).
    _, cache = _chrome_info_cache(root)
    needle = location.casefold()
    for dirname, info in cache.items():
        if not isinstance(info, dict):
            continue
        for field in ("name", "user_name", "gaia_name", "gaia_id"):
            val = info.get(field)
            if isinstance(val, str) and val.casefold() == needle:
                return [dirname]
    # Fall back to treating location as a directory name even if missing.
    return [location]


def _nested_get(data, parts):
    cur = data
    for part in parts:
        if not isinstance(cur, dict) or part not in cur:
            return None, False
        cur = cur[part]
    return cur, True


def _chrome_current_value(root, name, parts):
    for fname in ("Secure Preferences", "Preferences"):
        data = _chrome_load(root / name / fname)
        if not isinstance(data, dict):
            continue
        value, found = _nested_get(data, parts)
        if found:
            return value, True
    return None, False


# [(profile label, value text)] for each selected profile, reading Secure
# Preferences first, then Preferences (dotted nested keys). The value text is
# "" when the key is absent.
def mac_chrome_read_pref(location, key):
    root = Path(mac_chrome_user_data_dir())
    parts = key.split(".")
    results = []
    try:
        _, cache = _chrome_info_cache(root)
        for name in _chrome_profiles(root, location):
            value, _ = _chrome_current_value(root, name, parts)
            info = cache.get(name) or {}
            label = info.get("name") or info.get("user_name")
            label = f"{name} ({label})" if isinstance(label, str) and label and label != name else name
            if value is None:
                text = ""
            elif isinstance(value, bool):
                text = "true" if value else "false"
            else:
                text = str(value)
            results.append((label, text))
    except Exception:
        return []
    return results


def _chrome_clear_macs(data, parts):
    prot = data.get("protection")
    if not isinstance(prot, dict):
        return
    macs = prot.get("macs")
    if not isinstance(macs, dict):
        return
    leaf = parts[-1]
    candidates = []
    if len(parts) >= 2:
        candidates.append(parts[0])
        candidates.append("account_values." + parts[0])
        candidates.append(".".join(parts[:-1]))
        candidates.append("account_values." + ".".join(parts[:-1]))
    for section in candidates:
        node, found = _nested_get(macs, section.split("."))
        if not found or not isinstance(node, dict):
            continue
        node.pop(leaf, None)
        node.pop(leaf + "_encrypted_hash", None)


# Set a dotted nested key in Chrome Preferences and/or Secure Preferences for
# each selected profile. Clears integrity MACs for that key so Chrome re-seals.
# location semantics match mac_chrome_read_pref.
def mac_chrome_write_pref(location, key, raw):
    root = Path(mac_chrome_user_data_dir())
    parts = key.split(".")
    if raw in ("true", "false"):
        value = raw == "true"
    elif re.fullmatch(r"-?\d+", raw):
        value = int(raw)
    else:
        value = raw

    def nested_set(data):
        cur = data
        for part in parts[:-1]:
            nxt = cur.get(part)
            if not isinstance(nxt, dict):
                nxt = {}
                cur[part] = nxt
            cur = nxt
        cur[parts[-1]] = value

    try:
        for name in _chrome_profiles(root, location):
            cur, found = _chrome_current_value(root, name, parts)
            if found and cur == value:
                continue
            # Resolve write target using the directory name (not a display label).
            prof = root / name
            secure_path = prof / "Secure Preferences"
            prefs_path = prof / "Preferences"
            secure = _chrome_load(secure_path)
            prefs = _chrome_load(prefs_path)
            in_secure = isinstance(secure, dict) and _nested_get(secure, parts)[1]
            targets = []
            if in_secure:
                targets.append((secure_path, secure))
            if isinstance(prefs, dict):
                targets.append((prefs_path, prefs))
            elif not targets:
                targets.append((prefs_path, {}))
            for path, data in targets:
                nested_set(data)
                if path.name == "Secure Preferences":
                    _chrome_clear_macs(data, parts)
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(json.dumps(data, separators=(",", ":"), ensure_ascii=False))
    except Exception:
        return False
    return True


