def _strip_jsonc(text):
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    text = re.sub(r"//.*?$", "", text, flags=re.M)
    return re.sub(r",\s*([}\]])", r"\1", text)


def mac_read_json_setting(path, key):
    """(status, value): status 0 found, 1 unreadable, 2 key absent, 3 unparseable."""
    if not os.path.isfile(path):
        return 1, ""
    try:
        text = Path(path).read_text()
    except Exception:
        return 1, ""
    try:
        data = json.loads(_strip_jsonc(text))
    except ValueError:
        return 3, ""
    try:
        if key in data:
            value = data[key]
        else:
            value = data
            for part in key.split("."):
                if not isinstance(value, dict) or part not in value:
                    return 2, ""
                value = value[part]
    except TypeError:
        return 1, ""
    if isinstance(value, bool):
        return 0, "true" if value else "false"
    if value is None:
        return 0, ""
    return 0, str(value)


def mac_read_defaults_setting(domain, key):
    if domain == "global":
        rc, value = run(["defaults", "read", "-g", key])
    else:
        rc, value = run(["defaults", "read", gar_expand_home(domain), key])
    return value if rc == 0 else None


def _macos_major():
    _, v = run(["sw_vers", "-productVersion"])
    major = v.split(".", 1)[0]
    return int(major) if major.isdigit() else None


def mac_controlcenter_sound_always():
    _, sound = run(["defaults", "-currentHost", "read", "com.apple.controlcenter", "Sound"])
    if sound:
        major = _macos_major()
        if major is not None and major >= 26:
            return sound == "16"
        return sound == "18"
    truthy = ("1", "true", "TRUE", "YES", "yes")
    _, visible_cc = run(["defaults", "read", "com.apple.controlcenter", "NSStatusItem VisibleCC Sound"])
    if visible_cc in truthy:
        return True
    _, visible_legacy = run(["defaults", "read", "com.apple.controlcenter", "NSStatusItem Visible Sound"])
    return visible_legacy in truthy


def mac_karabiner_installed():
