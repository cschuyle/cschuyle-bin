def _version_key(v):
    """A sort key approximating `sort -V`: digit runs compare numerically."""
    return [(0, int(p), "") if p.isdigit() else (1, 0, p) for p in re.findall(r"\d+|\D+", v)]


# Test whether a dotted version satisfies a constraint. Pure (no SDKMAN
# coupling), so it is unit-testable on its own. Constraint forms (comma-
# separated clauses, each independently required):
#   >=MIN   inclusive floor      <MAX   exclusive ceiling
#   >MIN    exclusive floor      <=MAX  inclusive ceiling
#   =EXACT  exact match          (empty) always satisfied (presence only)
def gar_version_in_constraint(version, constraint):
    if not constraint:
        return True
    for clause in constraint.split(","):
        clause = clause.strip()
        if not clause:
            continue
        for op in (">=", "<=", ">", "<", "="):
            if clause.startswith(op):
                want = clause[len(op):]
                break
        else:
            op, want = "=", clause
        c = (_version_key(version) > _version_key(want)) - (_version_key(version) < _version_key(want))
        if op == ">=" and c < 0:
            return False
        if op == ">" and (c <= 0 or version == want):
            return False
        if op == "<=" and c > 0:
            return False
        if op == "<" and (c >= 0 or version == want):
            return False
        if op == "=" and version != want:
            return False
    return True


# Audit SDKMAN candidates declared in the combined `sdkman-tools` manifest
# (<platform|shared>.sdkman-tools plus active-role overlays). Each line is
# `candidate|constraint`; the constraint syntax is gar_version_in_constraint's.
# The script carries only the mechanism — which candidates and which versions
# are required is pure manifest policy (e.g. the natera role pins maven 3.8.x).
def check_mac_sdkman_tools():
    lines = gar_combined_lines("mac", "sdkman-tools")
    # Nothing declared (e.g. no active role requires any) -> silent no-op.
    if not lines:
        return

    sdkman_ready = os.path.isfile(SDKMAN_INIT) and os.path.getsize(SDKMAN_INIT) > 0
    if sdkman_ready:
        sdkman_source()

    for line in lines:
        candidate, _, constraint = line.partition("|")
        candidate = candidate.strip()
        constraint = constraint.strip()
        if not candidate:
            continue
        label = candidate[:1].upper() + candidate[1:]
        rng = f" matching {constraint}" if constraint else ""

        if not sdkman_ready:
            report_miss(f"{label} (SDKMAN not installed; see https://sdkman.io, then: sdk install {candidate})")
            continue

        m = re.search(r"[0-9]+(\.[0-9]+)+", sdk("current", candidate)[1])
        current = m.group(0) if m else ""
        if not current:
            report_miss(f"{label} (no SDKMAN candidate; run: sdk install {candidate})")
        elif gar_version_in_constraint(current, constraint):
            report_ok(f"{label} ({current}, SDKMAN)")
        else:
            report_miss(f"{label} ({current} out of range{rng}; run: sdk install {candidate} && sdk default {candidate} <version>)")


