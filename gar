# Clone iTerm profile $1 (by Name, looked up in "New Bookmarks") into the
# gar-managed Dynamic Profiles file under the name $2, upserting by a
# deterministic Guid so re-running is idempotent rather than piling up
# duplicates. Returns non-zero if the source profile doesn't exist or a
# profile value can't round-trip through JSON.
mac_iterm_create_profile() {
    local source_name="$1" new_name="$2" out_file
    out_file=$(mac_iterm_gar_profiles_file)
    defaults read com.googlecode.iterm2 "New Bookmarks" 2>/dev/null \
        | plutil -convert xml1 -o - - 2>/dev/null \
        | python3 -c '
import json
import plistlib
import sys
from pathlib import Path

source_name, new_name, out_path = sys.argv[1], sys.argv[2], Path(sys.argv[3])

try:
    profiles = plistlib.loads(sys.stdin.buffer.read())
except Exception:
    sys.exit(1)

source = next(
    (p for p in profiles if isinstance(p, dict) and p.get("Name") == source_name),
    None,
)
if source is None:
    sys.exit(1)

clone = dict(source)
clone["Name"] = new_name
clone["Guid"] = "gar-" + new_name.lower()

existing = {"Profiles": []}
if out_path.is_file():
    try:
        existing = json.loads(out_path.read_text())
    except Exception:
        existing = {"Profiles": []}
existing.setdefault("Profiles", [])
existing["Profiles"] = [
    p for p in existing["Profiles"]
    if isinstance(p, dict) and p.get("Guid") != clone["Guid"]
]
existing["Profiles"].append(clone)

out_path.parent.mkdir(parents=True, exist_ok=True)
try:
    text = json.dumps(existing, indent=2, sort_keys=True) + "\n"
except TypeError as exc:
    print("could not serialize profile: %s" % exc, file=sys.stderr)
    sys.exit(1)
out_path.write_text(text)
' "$source_name" "$new_name" "$out_file"
}

