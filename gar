# Render `gar info <repo>` for a machine-env repo entry (name, path, branch).
# Reports status; when not OK, says why. Local (tracked, non-skip-worktree) mods
# are reported as a count only; expected (skip-worktree'd) mods are listed one
# file per line, indented and shell-quoted.
def cmd_info_repo(entry):
    name, path, config_branch = entry
    config_branch = config_branch or "main"

    catchup_manifest = gar_resolve_manifest(detect_platform(), "machine-env-catchup")
    configured = gar_machine_env_catchup_mainline(catchup_manifest, name)
    catchup = configured is not None
    configured = configured or ""

    out(f"{name} (machine-env repo)")
    out(f"Path: {path}")
    out(f"Tracks: {config_branch}")

    if not os.path.isdir(path):
        if catchup:
            out(f"Catch-up: yes (rebase onto {configured or 'origin default'})")
        out(f"Status: MISSING (no checkout at {path})")
        sys.exit(0)
    if not os.path.isdir(os.path.join(path, ".git")):
        if catchup:
            out(f"Catch-up: yes (rebase onto {configured or 'origin default'})")
        out("Status: NOT A GIT REPO")
        sys.exit(0)

    current_branch = gar_repo_current_branch(path) or ""
    mainline = ""
    if catchup:
        mainline = gar_repo_catchup_mainline_ref(path, configured) or ""
        if mainline:
            out(f"Catch-up: yes (rebase onto {mainline})")
        else:
            out("Catch-up: yes (rebase mainline could not be resolved — no origin default)")

    # Collect reasons in report order; if none, status is OK.
    reasons = []
    mod_count = gar_repo_local_mod_count(path)
    if mod_count > 0:
        reasons.append(f"{gar_plural(mod_count, 'file')} with uncommitted local changes")
    # For catch-up repos, sitting on a feature branch is expected — don't flag
    # the branch mismatch, and report behind/action against the mainline ref.
    if catchup:
        if not mainline:
            reasons.append("catch-up repo but rebase mainline could not be resolved (no origin default)")
        else:
            ahead = gar_repo_unpushed_count(path, config_branch)
            if ahead:
                reasons.append(f"{gar_plural(ahead, 'unpushed commit')} on {config_branch}")
            if gar_repo_catchup_fetch(path, mainline):
                behind = gar_repo_catchup_behind_count(path, mainline)
                if behind:
                    reasons.append(f"{gar_plural(behind, 'commit')} behind {mainline} (rebase would catch up)")
    else:
        if current_branch and current_branch != config_branch:
            reasons.append(f"on branch {current_branch}, not tracked branch {config_branch}")
        ahead = gar_repo_unpushed_count(path, config_branch)
        if ahead:
            reasons.append(f"{gar_plural(ahead, 'unpushed commit')} on {config_branch}")
        if gar_repo_try_fetch(path, config_branch):
            behind = gar_repo_behind_count(path, config_branch)
            if behind:
                reasons.append(f"{gar_plural(behind, 'commit')} behind origin/{config_branch} (pull would update)")
        remote_default = gar_repo_remote_default_branch(path) or ""
        if remote_default and remote_default != config_branch:
            reasons.append(f"configured to track {config_branch} but origin default is {remote_default}")

    if not reasons:
        out("Status: OK")
    else:
        out("Status: not OK")
        for r in reasons:
            out(f"  - {r}")

    # Expected (skip-worktree'd) mods: list each differing file, indented and
    # shell-quoted.
    expected = gar_repo_skip_worktree_modified_files(path)
    if expected:
        if len(expected) == 1:
            out("Expected local mods (skip-worktree), 1 file:")
        else:
            out(f"Expected local mods (skip-worktree), {len(expected)} files:")
        for f in expected:
            out(f"  {shell_q(f)}")
    sys.exit(0)


def cmd_info(query):
    global gar_show_all
    if not query:
        info = lookup_platform_info()
        if info is not None:
            sys.stdout.write(info if info.endswith("\n") else info + "\n")
        sys.exit(0)

    detect_roles()
    gar_init_workdir()

    # `gar info brew` (literal) shows the full Homebrew audit section — the same
    # output as `gar -a`'s Homebrew section — so you can see what's installed
    # and what's out of date.
    if gar_name_eq(query, "brew") or gar_name_eq(query, "homebrew"):
        if detect_platform() != "mac":
            err("Homebrew checks are only implemented on mac.")
            sys.exit(1)
        gar_show_all = True
        gar_section_begin("Homebrew")
        check_mac_homebrew()
        sys.exit(0)

    repo_entry = lookup_machine_env_repo_entry(query)
    if repo_entry:
        cmd_info_repo(repo_entry)

    app_entry = lookup_app_entry(query)
    if app_entry:
        canonical, path = app_entry
        out(f"{canonical} (app)")
        out(f"Expected path: {gar_app_format_paths(path)}")
        app_found = gar_app_first_existing_path(path)
        if app_found:
            out(f"Status: installed ({app_found})")
        else:
            out("Status: not installed")
        hint = lookup_install_hint(query)
        if hint is None:
            hint = lookup_install_hint(canonical)
        if hint is not None:
            gar_print_install_hint("Install: ", hint)
        else:
            out("Install: download from the vendor or App Store")
        info = lookup_general_info(query)
        if info is None:
            info = lookup_general_info(canonical)
        if info is not None:
            gar_print_general_info(info)
        if gar_name_eq(canonical, "Docker"):
            gar_print_docker_configured()
        sys.exit(0)

    ext_entry = lookup_browser_extension_entry(query)
    if ext_entry:
        browser, ext_id, label = ext_entry
        out(f"{label} ({browser} extension)")
        out(f"Extension ID: {ext_id}")
        app_path = mac_browser_app_path(browser)
        if not app_path or not os.path.exists(app_path):
            out("Status: browser not installed" + (f" ({app_path})" if app_path else ""))
        elif mac_browser_extension_installed(browser, ext_id):
            out("Status: installed")
        else:
            out("Status: not installed")
        hint = lookup_install_hint(label)
        if hint is not None:
            gar_print_install_hint("Install: ", hint)
        else:
            out("Install: install from the browser extension store")
        info = lookup_general_info(query)
        if info is not None:
            gar_print_general_info(info)
        sys.exit(0)

    hint = lookup_install_hint(query)
    if hint is not None:
        # If the install hint is itself a Homebrew command, report brew status —
        # many tracked CLIs (gh, awscli, …) install via "brew install <name>".
        kn = gar_brew_parse_hint(hint)
        if kn:
            out(f"{query} (brew {kn[0]})")
            gar_print_brew_status(kn[0], kn[1])
        else:
            out(query)
        gar_print_install_hint("Install: ", hint)
        info = lookup_general_info(query)
        if info is not None:
            gar_print_general_info(info)
        sys.exit(0)

    hint = lookup_brew_hint(query)
    if hint is not None:
        # hint is "brew install <name>" or "brew install --cask <name>".
        kind, name = gar_brew_parse_hint(hint)
        out(f"{query} (brew {kind})")
        gar_print_brew_status(kind, name)
        out(f"Install: {hint}")
        info = lookup_general_info(query)
        if info is not None:
            gar_print_general_info(info)
        sys.exit(0)

    info = lookup_general_info(query)
    if info is not None:
        out(query)
        gar_print_general_info(info)
        sys.exit(0)

    err(f"No gar entry for: {query}")
    sys.exit(1)


# --- Platform & roles -------------------------------------------------------

def detect_platform():
    if os.environ.get("WSL_DISTRO_NAME"):
        return "wsl"
    u = os.uname()
    if u.sysname == "Darwin":
        return "mac"
    if re.search(r"[Ss]ynology", " ".join(u)):
        return "synology"
    if u.sysname == "Linux":
        return "linux"
    return "unknown"


def _roles_file_line_role(line):
    return line.split("#", 1)[0].strip()


# Enable a role by appending it to ~/.config/gar/roles (creating the file/dir if
# needed). No-op if already present. Prints a status line. Returns False on
# write failure. The caller validates that the role is known.
def gar_roles_add(role):
    f = gar_roles_file()
    if os.path.isfile(f):
        for line in read_text(f).split("\n"):
            if _roles_file_line_role(line) == role:
                out(f"Role {role} is already enabled ({gar_tilde_path(f)}).")
                return True
    try:
        os.makedirs(os.path.dirname(f), exist_ok=True)
        # Don't glue the role onto a last line that lacks its newline.
        sep = "\n" if os.path.isfile(f) and read_text(f)[-1:] not in ("", "\n") else ""
        with open(f, "a") as fh:
            fh.write(sep + role + "\n")
    except OSError:
        return False
    out(f"Enabled role {role} ({gar_tilde_path(f)}).")
    return True


# Disable a role by removing its line(s) from ~/.config/gar/roles. Preserves
# comments and other roles. Prints a status line. Returns False on write failure.
def gar_roles_remove(role):
    f = gar_roles_file()
    if not os.path.isfile(f):
        out(f"Role {role} is not enabled (no roles file).")
        return True
    text = read_text(f)
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    kept = [l for l in lines if _roles_file_line_role(l) != role]
    if len(kept) == len(lines):
        out(f"Role {role} is not enabled ({gar_tilde_path(f)}).")
        return True
    tmp = f"{f}.gar.{os.getpid()}"
    try:
        with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as fh:
            fh.write("".join(l + "\n" for l in kept))
        os.replace(tmp, f)
    except OSError:
        try:
            os.remove(tmp)
        except OSError:
            pass
        return False
    out(f"Disabled role {role} ({gar_tilde_path(f)}).")
    return True


def gar_role_is_known(role):
    prefix = f"role.{role}."
    for d in gar_manifest_dirs():
        for name in _sorted_listdir(d):
            if name.startswith(prefix) and os.path.isfile(os.path.join(d, name)):
                return True
    return False


# Known role ids (unique, sorted) from role.<id>.* under all manifest roots.
def gar_known_roles():
    roles = set()
    for d in gar_manifest_dirs():
        for name in _sorted_listdir(d):
            if not name.startswith("role.") or not os.path.isfile(os.path.join(d, name)):
                continue
            rest = name[len("role."):]
            if "." not in rest:
                continue
            role = rest.rsplit(".", 1)[0]
            if role:
                roles.add(role)
    return sorted(roles)


def gar_role_is_active(role):
    return role in gar_active_roles


# Capability suffixes for role.<role>.* under all manifest roots (unique, sorted).
def gar_role_capabilities(role):
    prefix = f"role.{role}."
    caps = set()
    for d in gar_manifest_dirs():
        for name in _sorted_listdir(d):
            if name.startswith(prefix) and os.path.isfile(os.path.join(d, name)):
                cap = name[len(prefix):]
                if cap:
                    caps.add(cap)
    return sorted(caps)


ROLE_CAP_ORDER = ["apps", "Brewfile", "commands", "login-items", "env", "secrets", "machine-env-repos"]
ROLE_CAP_LABELS = {
    "apps": "Apps",
    "Brewfile": "Homebrew",
    "commands": "Commands",
    "login-items": "Login items",
    "env": "Env",
    "secrets": "Secrets",
    "machine-env-repos": "Machine env repos",
}


# Preferred display order for role capability sections; unknown caps follow A–Z.
def gar_role_capabilities_ordered(role):
    caps = gar_role_capabilities(role)
    return [c for c in ROLE_CAP_ORDER if c in caps] + [c for c in caps if c not in ROLE_CAP_ORDER]


def gar_role_capability_label(cap):
    return ROLE_CAP_LABELS.get(cap, cap)


# Print human-readable items for one role capability manifest.
def gar_print_role_capability_items(capability, lines):
    for line in lines:
        if capability in ("apps", "machine-env-repos"):
            out(f"    {line.split('|', 1)[0]}")
        elif capability == "Brewfile":
            m = BREW_LINE_RE.match(line)
            if not m:
                out(f"    {line}")
            elif m.group(1) == "brew":
                out(f"    {m.group(2)}")
            else:
                out(f"    {m.group(1)} {m.group(2)}")
        elif capability == "login-items":
            label, names = split_entry(line)
            if "|" in names:
                out(f"    {label} (exactly one of: {gar_app_format_paths(names)})")
            else:
                out(f"    {label}")
        else:
            out(f"    {line}")


def gar_print_role_details(role):
    for cap in gar_role_capabilities_ordered(role):
        lines = parse_manifest(gar_collect_role_manifest_for_role(role, cap))
        if not lines:
            continue
        out(f"  {gar_role_capability_label(cap)}")
        gar_print_role_capability_items(cap, lines)


def cmd_roles(args):
    show_all = False
    action = target = ""
    while args:
        a = args[0]
        if a in ("-a", "--all"):
            show_all = True
            args = args[1:]
        elif a in ("--add", "--remove"):
            action = a[2:]
            target = args[1] if len(args) > 1 else ""
            if not target:
                err(f"roles {a} requires a role id")
                usage(sys.stderr)
                sys.exit(2)
            args = args[2:]
        elif a in ("-h", "--help"):
            usage()
            sys.exit(0)
        else:
            err(f"Unknown option for roles: {a}")
            usage(sys.stderr)
            sys.exit(2)

    if action:
        if not gar_role_is_known(target):
            err(f"Unknown role: {target}\n\nKnown roles:")
            for r in gar_known_roles():
                err("  " + r)
            sys.exit(2)
        ok = gar_roles_add(target) if action == "add" else gar_roles_remove(target)
        if not ok:
            err("Failed to update roles file")
            sys.exit(1)
        detect_roles()
        out(f"Active roles: {gar_format_roles()}")
        sys.exit(0)

    detect_roles()
    if show_all:
        gar_init_workdir()
    first = True
    for role in gar_known_roles():
        if show_all and not first:
            out()
        first = False
        out(f"{'✓' if gar_role_is_active(role) else ' '} {role}")
        if show_all:
            gar_print_role_details(role)


def detect_roles():
    global gar_active_roles
    gar_active_roles = []
    f = gar_roles_file()
    if os.path.isfile(f):
        gar_active_roles = parse_manifest(read_text(f))


def gar_format_roles():
    return ",".join(gar_active_roles) if gar_active_roles else "(none)"


def gar_warn_unknown_roles():
    for role in gar_active_roles:
        if not gar_role_is_known(role):
            out(f"WARN Unknown role: {role} (no role.{role}.* in gar.d/ or ~/.config/gar/d/)")


