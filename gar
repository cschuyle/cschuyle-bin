main() {
    local platform
    issues=0

    if [[ "${1:-}" == "info" ]]; then
        shift
        cmd_info "${1:-}"
        return
    fi

    if [[ "${1:-}" == "apps" ]]; then
        cmd_apps
        return
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                usage
                exit 0
                ;;
            -a|--all)
                gar_show_all=1
                shift
                ;;
            *)
                echo "Unknown option: $1" >&2
                usage >&2
                exit 2
                ;;
        esac
    done

    platform=$(detect_platform)
    printf 'gar: platform %s\n' "$platform"

    case "$platform" in
        mac)
            run_mac_checks
            ;;
        synology)
            run_synology_checks
            ;;
        wsl)
            run_wsl_checks
            ;;
        linux)
            printf '\nOnly mac, synology, and wsl checks are implemented so far.\n'
            issues=$((issues + 1))
            ;;
        *)
            report_miss "Unknown platform"
            ;;
    esac

    printf '\n'
    if (( issues > 0 )); then
        printf '%s issue(s)\n' "$issues"
        exit 1
    fi
    printf 'All checks passed\n'
}

main "$@"
