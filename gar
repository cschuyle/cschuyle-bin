#!/usr/bin/env bash
# gar (garage): check this machine's configuration against desired state.
set -o pipefail

GAR_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/gar.d" && pwd)"
gar_show_all=0
gar_section_name=""
gar_section_header_printed=0
gar_tmpdir=""

gar_init_workdir() {
    gar_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/gar.XXXXXX")
    trap '[[ -n "$gar_tmpdir" ]] && rm -rf "$gar_tmpdir"' EXIT
}

gar_path_slug() {
    printf '%s' "$1" | shasum | awk '{print $1}'
}

gar_result_get() {
    local file="$1" key="$2"
    [[ -f "$file" ]] || return 1
    awk -F= -v k="$key" '$1 == k { print $2; exit }' "$file"
}

usage() {
    cat <<'EOF'
Usage: gar [-ah]
       gar apps
       gar info <name>

Check the current machine's configuration against the desired state in gar.d/.
Reports missing or out-of-date elements. Mac, Synology, and WSL checks are
implemented; plain Linux is detected but not yet audited.

  -a, --all     Show all checks, including OK (default: only MISS and WARN)
  apps          List GUI apps tracked in gar.d/mac.apps (App Store or vendor site)
  info <name>   Show how to install a tracked item (name match is case-insensitive)

Exit status: 0 if everything looks good, 1 if anything is missing.
EOF
}

cmd_apps() {
    local entry name path hint
    printf 'Tracked apps (installed outside Homebrew):\n\n'
    while IFS= read -r entry; do
        name="${entry%%|*}"
        path="${entry#*|}"
        printf '%s\n' "$name"
        printf '  Path: %s\n' "$path"
        if hint=$(lookup_install_hint "$name" 2>/dev/null); then
            printf '  Install: %s\n' "$hint"
        else
            printf '  Install: App Store or vendor site\n'
        fi
        printf '\n'
    done < <(read_manifest "$GAR_DIR/mac.apps")
}

gar_name_eq() {
    [[ "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" == \
       "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" ]]
}

lookup_install_hint() {
    local query="$1" hints_file="${2:-$(gar_hints_file)}" name hint
    while IFS='|' read -r name hint; do
        if gar_name_eq "$query" "$name"; then
            printf '%s\n' "$hint"
            return 0
        fi
    done < <(read_manifest "$hints_file")
    return 1
}

gar_resolve_manifest() {
    local platform="$1" name="$2"
    if [[ -f "$GAR_DIR/$platform.$name" ]]; then
        printf '%s\n' "$GAR_DIR/$platform.$name"
    elif [[ -f "$GAR_DIR/shared.$name" ]]; then
        printf '%s\n' "$GAR_DIR/shared.$name"
    fi
}

gar_hints_file() {
    local platform manifest
    platform=$(detect_platform)
    manifest=$(gar_resolve_manifest "$platform" install-hints)
    if [[ -n "$manifest" && -f "$manifest" ]]; then
        printf '%s\n' "$manifest"
    else
        printf '%s\n' "$GAR_DIR/mac.install-hints"
    fi
}

gar_hint_is_multiline() {
    [[ "$1" == *'\n'* ]]
}

gar_print_install_hint() {
    local label="$1" hint="$2"
    if gar_hint_is_multiline "$hint"; then
        printf '%s\n' "${label% }"
        printf '%b\n' "$hint"
    else
        printf '%s%s\n' "$label" "$hint"
    fi
}

lookup_app_entry() {
    local query="$1" entry name path
    while IFS= read -r entry; do
        name="${entry%%|*}"
        path="${entry#*|}"
        if gar_name_eq "$query" "$name"; then
            printf '%s|%s\n' "$name" "$path"
            return 0
        fi
    done < <(read_manifest "$GAR_DIR/mac.apps")
    return 1
}

gar_normalize_ext_id() {
    local id="$1"
    id="${id#\{}"
    id="${id%\}}"
    printf '%s\n' "$id"
}

lookup_browser_extension_entry() {
    local query="$1" browser ext_id label query_id ext_id_norm
    query_id=$(gar_normalize_ext_id "$query")
    while IFS='|' read -r browser ext_id label; do
        if gar_name_eq "$query" "$label" || gar_name_eq "$query" "$browser/$label"; then
            printf '%s|%s|%s\n' "$browser" "$ext_id" "$label"
            return 0
        fi
        ext_id_norm=$(gar_normalize_ext_id "$ext_id")
        if gar_name_eq "$query" "$ext_id" || gar_name_eq "$query_id" "$ext_id_norm"; then
            printf '%s|%s|%s\n' "$browser" "$ext_id" "$label"
            return 0
        fi
    done < <(read_manifest "$GAR_DIR/mac.browser-extensions")
    return 1
}

lookup_brew_hint() {
    local query="$1" line name
    while IFS= read -r line; do
        if [[ "$line" =~ ^brew[[:space:]]+\"([^\"]+)\" ]]; then
            name="${BASH_REMATCH[1]}"
            if gar_name_eq "$query" "$name"; then
                printf 'brew install %s\n' "$name"
                return 0
            fi
        elif [[ "$line" =~ ^cask[[:space:]]+\"([^\"]+)\" ]]; then
            name="${BASH_REMATCH[1]}"
            if gar_name_eq "$query" "$name"; then
                printf 'brew install --cask %s\n' "$name"
                return 0
            fi
        fi
    done < <(read_manifest "$GAR_DIR/mac.Brewfile")
    return 1
}

brew_miss_hint() {
    local item="$1"
    if [[ "$item" == *gdubw/gng* || "$item" == *"Formula gng"* ]]; then
        printf 'https://github.com/gdubw/gng — brew trust --formula gdubw/gng/gng && brew install gng\n'
        return 0
    fi
    return 1
}

cmd_info() {
    local query="$1" app_entry canonical path hint ext_entry browser ext_id label app_path

    if [[ -z "$query" ]]; then
        echo "Usage: gar info <name>" >&2
        exit 2
    fi

    if app_entry=$(lookup_app_entry "$query"); then
        canonical="${app_entry%%|*}"
        path="${app_entry#*|}"
        printf '%s (app)\n' "$canonical"
        printf 'Expected path: %s\n' "$path"
        if [[ -e "$path" ]]; then
            printf 'Status: installed\n'
        else
            printf 'Status: not installed\n'
        fi
        if hint=$(lookup_install_hint "$query"); then
            gar_print_install_hint 'Install: ' "$hint"
        else
            printf 'Install: download from the vendor or App Store\n'
        fi
        exit 0
    fi

    if ext_entry=$(lookup_browser_extension_entry "$query"); then
        browser="${ext_entry%%|*}"
        ext_id="${ext_entry#*|}"
        ext_id="${ext_id%%|*}"
        label="${ext_entry##*|}"
        printf '%s (%s extension)\n' "$label" "$browser"
        printf 'Extension ID: %s\n' "$ext_id"
        app_path=$(mac_browser_app_path "$browser")
        if [[ -z "$app_path" || ! -e "$app_path" ]]; then
            printf 'Status: browser not installed'
            [[ -n "$app_path" ]] && printf ' (%s)' "$app_path"
            printf '\n'
        elif mac_browser_extension_installed "$browser" "$ext_id"; then
            printf 'Status: installed\n'
        else
            printf 'Status: not installed\n'
        fi
        if hint=$(lookup_install_hint "$label"); then
            gar_print_install_hint 'Install: ' "$hint"
        else
            printf 'Install: install from the browser extension store\n'
        fi
        exit 0
    fi

    if hint=$(lookup_install_hint "$query"); then
        printf '%s\n' "$query"
        gar_print_install_hint 'Install: ' "$hint"
        exit 0
    fi

    if hint=$(lookup_brew_hint "$query"); then
        printf '%s (brew)\n' "$query"
        printf 'Install: %s\n' "$hint"
        exit 0
    fi

    echo "No gar entry for: $query" >&2
    exit 1
}

detect_platform() {
    if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
        printf '%s\n' wsl
    elif [[ "$(uname -s)" == "Darwin" ]]; then
        printf '%s\n' mac
    elif [[ "$(uname -a)" == *[Ss]ynology* ]]; then
        printf '%s\n' synology
    elif [[ "$(uname -s)" == "Linux" ]]; then
        printf '%s\n' linux
    else
        printf '%s\n' unknown
    fi
}

read_manifest() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -n "$line" ]] || continue
        printf '%s\n' "$line"
    done <"$file"
}

gar_section_begin() {
    gar_section_name="$1"
    gar_section_header_printed=0
}

gar_section_emit_header() {
    if (( gar_section_header_printed == 0 )); then
        printf '\n%s\n' "$gar_section_name"
        gar_section_header_printed=1
    fi
}

report_ok() {
    if (( gar_show_all )); then
        gar_section_emit_header
        printf 'OK   %s\n' "$1"
    fi
}

report_miss() {
    gar_section_emit_header
    printf 'MISS %s\n' "$1"
    issues=$((issues + 1))
}

report_warn() {
    gar_section_emit_header
    printf 'WARN %s\n' "$1"
}

gar_expand_home() {
    local path="$1"
    path="${path//\$HOME/$HOME}"
    printf '%s\n' "$path"
}

gar_path_seen() {
    local needle="$1" seen
    for seen in "${@:2}"; do
        [[ "$seen" == "$needle" ]] && return 0
    done
    return 1
}

gar_repo_dirty() {
    local repo="$1"
    [[ -d "$repo/.git" ]] || return 1
    [[ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]]
}

gar_repo_current_branch() {
    local repo="$1"
    [[ -d "$repo/.git" ]] || return 1
    git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null
}

gar_repo_pull_main() {
    local repo="$1"
    git -C "$repo" pull -r origin main
}

gar_can_prompt() {
    [[ -r /dev/tty ]] || [[ -t 0 ]]
}

gar_prompt_yn() {
    local prompt="$1" reply input
    if [[ -r /dev/tty ]]; then
        input=/dev/tty
    elif [[ -t 0 ]]; then
        input=/dev/stdin
    else
        return 1
    fi

    while true; do
        printf '%s [Y/n] ' "$prompt" >&2
        if ! IFS= read -r reply <"$input"; then
            return 1
        fi
        reply="${reply//$'\r'/}"
        reply="${reply#"${reply%%[![:space:]]*}"}"
        reply="${reply%"${reply##*[![:space:]]}"}"
        [[ -n "$reply" ]] || reply=Y
        case "$reply" in
            [Yy]|[Yy][Ee][Ss]) return 0 ;;
            [Nn]|[Nn][Oo]) return 1 ;;
            *) printf 'Please answer Y or n.\n' >&2 ;;
        esac
    done
}

gar_repo_main_unpushed_count() {
    local repo="$1" ahead
    [[ -d "$repo/.git" ]] || return 1
    git -C "$repo" rev-parse --verify main >/dev/null 2>&1 || return 1
    git -C "$repo" rev-parse --verify origin/main >/dev/null 2>&1 || return 1
    ahead=$(git -C "$repo" rev-list --count origin/main..main 2>/dev/null) || return 1
    (( ahead > 0 )) || return 1
    printf '%s\n' "$ahead"
}

gar_repo_main_behind_count() {
    local repo="$1" behind
    [[ -d "$repo/.git" ]] || return 1
    git -C "$repo" rev-parse --verify main >/dev/null 2>&1 || return 1
    git -C "$repo" rev-parse --verify origin/main >/dev/null 2>&1 || return 1
    behind=$(git -C "$repo" rev-list --count main..origin/main 2>/dev/null) || return 1
    (( behind > 0 )) || return 1
    printf '%s\n' "$behind"
}

gar_repo_try_fetch_main() {
    local repo="$1"
    [[ -d "$repo/.git" ]] || return 1
    git -C "$repo" rev-parse --verify main >/dev/null 2>&1 || return 1
    git -C "$repo" remote get-url origin >/dev/null 2>&1 || return 1
    git -C "$repo" fetch --quiet origin main 2>/dev/null || return 1
    git -C "$repo" rev-parse --verify origin/main >/dev/null 2>&1
}

gar_machine_env_skip_name() {
    local skip_manifest="$1" want="$2" name
    [[ -n "$skip_manifest" && -f "$skip_manifest" ]] || return 1
    while IFS= read -r name; do
        [[ "$name" == "$want" ]] && return 0
    done < <(read_manifest "$skip_manifest")
    return 1
}

gar_machine_env_list_repos() {
    local repos_manifest="$1" skip_manifest="${2:-}" entry name path setup_dir setup_name seen=()
    while IFS='|' read -r name path; do
        path=$(gar_expand_home "$path")
        if gar_path_seen "$path" "${seen[@]}"; then
            continue
        fi
        seen+=("$path")
        printf '%s|%s\n' "$name" "$path"
    done < <(read_manifest "$repos_manifest")

    for setup_dir in "$HOME"/Yew/*-setup; do
        [[ -d "$setup_dir" ]] || continue
        [[ -d "$setup_dir/.git" ]] || continue
        setup_name=$(basename "$setup_dir")
        if gar_machine_env_skip_name "$skip_manifest" "$setup_name"; then
            continue
        fi
        if gar_path_seen "$setup_dir" "${seen[@]}"; then
            continue
        fi
        seen+=("$setup_dir")
        printf '%s|%s\n' "$setup_name" "$setup_dir"
    done
}

gar_machine_env_prefetch_repo() {
    local name="$1" path="$2" result_file="$3" ahead behind fetched=0
    {
        printf 'name=%s\npath=%s\n' "$name" "$path"
        if [[ ! -d "$path" ]]; then
            printf 'status=missing\n'
            exit 0
        fi
        if [[ ! -d "$path/.git" ]]; then
            printf 'status=not-git\n'
            exit 0
        fi
        printf 'status=ok\n'
        branch=$(gar_repo_current_branch "$path" 2>/dev/null) || branch=""
        printf 'branch=%s\n' "$branch"
        if gar_repo_dirty "$path"; then
            printf 'dirty=1\n'
        else
            printf 'dirty=0\n'
        fi
        if gar_repo_try_fetch_main "$path"; then
            fetched=1
            printf 'fetched=1\n'
        else
            printf 'fetched=0\n'
        fi
        if ahead=$(gar_repo_main_unpushed_count "$path" 2>/dev/null); then
            printf 'ahead=%s\n' "$ahead"
        else
            printf 'ahead=0\n'
        fi
        behind=0
        if (( fetched )) && behind=$(gar_repo_main_behind_count "$path" 2>/dev/null); then
            printf 'behind=%s\n' "$behind"
        else
            printf 'behind=0\n'
        fi
    } >"$result_file"
}

gar_machine_env_prefetch_all() {
    local repos_manifest="$1" skip_manifest="${2:-}" name path slug result_file
    mkdir -p "$gar_tmpdir/repos"
    while IFS='|' read -r name path; do
        slug=$(gar_path_slug "$path")
        result_file="$gar_tmpdir/repos/$slug"
        gar_machine_env_prefetch_repo "$name" "$path" "$result_file" &
    done < <(gar_machine_env_list_repos "$repos_manifest" "$skip_manifest")
    wait
}

report_machine_env_repo() {
    local name="$1" path="$2" result_file="$3"
    local status dirty ahead behind fetched issues_found=0
    status=$(gar_result_get "$result_file" status)
    case "$status" in
        missing)
            report_miss "Machine env repo $name ($path — missing)"
            return
            ;;
        not-git)
            report_miss "Machine env repo $name ($path — not a git repo)"
            return
            ;;
    esac
    dirty=$(gar_result_get "$result_file" dirty)
    if [[ "$dirty" == 1 ]]; then
        report_warn "Machine env repo $name ($path — uncommitted changes)"
        issues_found=1
    fi
    ahead=$(gar_result_get "$result_file" ahead)
    if [[ "$ahead" =~ ^[0-9]+$ && "$ahead" -gt 0 ]]; then
        if (( ahead == 1 )); then
            report_warn "Machine env repo $name ($path — 1 unpushed commit on main)"
        else
            report_warn "Machine env repo $name ($path — $ahead unpushed commits on main)"
        fi
        issues_found=1
    fi
    fetched=$(gar_result_get "$result_file" fetched)
    behind=$(gar_result_get "$result_file" behind)
    if [[ "$fetched" == 1 && "$behind" =~ ^[0-9]+$ && "$behind" -gt 0 ]]; then
        if (( behind == 1 )); then
            report_warn "Machine env repo $name ($path — pull would update main; 1 commit behind origin/main)"
        else
            report_warn "Machine env repo $name ($path — pull would update main; $behind commits behind origin/main)"
        fi
        issues_found=1
    fi
    if (( issues_found == 0 )); then
        report_ok "Machine env repo $name ($path)"
    fi
}

offer_machine_env_repo_pull() {
    local name="$1" path="$2" result_file="$3"
    local status dirty branch fetched behind ahead prompt

    gar_can_prompt || return 0

    status=$(gar_result_get "$result_file" status)
    [[ "$status" == ok ]] || return 0

    dirty=$(gar_result_get "$result_file" dirty)
    [[ "$dirty" == 0 ]] || return 0

    branch=$(gar_result_get "$result_file" branch)
    [[ "$branch" == main ]] || return 0

    fetched=$(gar_result_get "$result_file" fetched)
    behind=$(gar_result_get "$result_file" behind)
    if [[ "$fetched" != 1 ]]; then
        if ! gar_repo_try_fetch_main "$path"; then
            return 0
        fi
        behind=0
        behind=$(gar_repo_main_behind_count "$path" 2>/dev/null) || behind=0
    fi
    [[ "$behind" =~ ^[0-9]+$ && "$behind" -gt 0 ]] || return 0

    ahead=$(gar_result_get "$result_file" ahead)
    [[ "$ahead" =~ ^[0-9]+$ ]] || ahead=0

    if (( behind == 1 )); then
        prompt="Pull $name ($path; 1 commit behind origin/main"
    else
        prompt="Pull $name ($path; $behind commits behind origin/main"
    fi
    if (( ahead > 0 )); then
        if (( ahead == 1 )); then
            prompt+=", 1 unpushed commit"
        else
            prompt+=", $ahead unpushed commits"
        fi
    fi
    prompt+=")?"

    if gar_prompt_yn "$prompt"; then
        if gar_repo_pull_main "$path"; then
            printf 'Updated %s (%s)\n' "$name" "$path"
        else
            report_warn "Machine env repo $name ($path — pull failed)"
        fi
    fi
}

check_machine_env_repos() {
    local repos_manifest="$1" skip_manifest="${2:-}" name path slug result_file
    gar_machine_env_prefetch_all "$repos_manifest" "$skip_manifest"
    while IFS='|' read -r name path; do
        slug=$(gar_path_slug "$path")
        result_file="$gar_tmpdir/repos/$slug"
        report_machine_env_repo "$name" "$path" "$result_file"
        offer_machine_env_repo_pull "$name" "$path" "$result_file"
    done < <(gar_machine_env_list_repos "$repos_manifest" "$skip_manifest")
}

check_git_config() {
    local config_manifest="$1" hints_file="$2" key val hint
    if ! command -v git >/dev/null 2>&1; then
        report_miss "Git (not on PATH)"
        return
    fi
    while IFS= read -r key; do
        val=$(git config --global --get "$key" 2>/dev/null || true)
        if [[ -n "$val" ]]; then
            report_ok "Git config $key ($val)"
        else
            hint=$(lookup_install_hint "$key" "$hints_file" 2>/dev/null || true)
            if [[ -n "$hint" ]]; then
                report_miss "Git config $key ($hint)"
            else
                report_miss "Git config $key (not set; run: git config --global $key VALUE)"
            fi
        fi
    done < <(read_manifest "$config_manifest")
}

mac_editor_settings_path() {
    case "$1" in
        cursor) printf '%s\n' "$HOME/Library/Application Support/Cursor/User/settings.json" ;;
        code) printf '%s\n' "$HOME/Library/Application Support/Code/User/settings.json" ;;
    esac
}

mac_editor_app_path() {
    case "$1" in
        cursor) printf '%s\n' /Applications/Cursor.app ;;
        code) printf '%s\n' "/Applications/Visual Studio Code.app" ;;
    esac
}

mac_read_json_setting() {
    local file="$1" key="$2"
    [[ -f "$file" ]] || return 1
    python3 - "$file" "$key" <<'PY'
import json
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
key = sys.argv[2]
text = path.read_text()
text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
text = re.sub(r"//.*?$", "", text, flags=re.M)
text = re.sub(r",\s*([}\]])", r"\1", text)
try:
    data = json.loads(text)
except json.JSONDecodeError:
    raise SystemExit(3)
if key in data:
    value = data[key]
else:
    value = data
    for part in key.split("."):
        if not isinstance(value, dict) or part not in value:
            raise SystemExit(2)
        value = value[part]
if isinstance(value, bool):
    print("true" if value else "false")
elif value is None:
    print("")
else:
    print(value)
PY
}

mac_read_defaults_setting() {
    local domain="$1" key="$2" value
    if [[ "$domain" == global ]]; then
        value=$(defaults read -g "$key" 2>/dev/null) || return 1
    else
        domain=$(gar_expand_home "$domain")
        value=$(defaults read "$domain" "$key" 2>/dev/null) || return 1
    fi
    printf '%s\n' "$value"
}

mac_controlcenter_sound_always() {
    local sound visible_cc visible_legacy major

    sound=$(defaults -currentHost read com.apple.controlcenter Sound 2>/dev/null || true)
    if [[ -n "$sound" ]]; then
        major=$(sw_vers -productVersion 2>/dev/null | cut -d. -f1)
        if [[ "$major" =~ ^[0-9]+$ ]] && (( major >= 26 )); then
            [[ "$sound" == 16 ]]
            return
        fi
        [[ "$sound" == 18 ]]
        return
    fi

    visible_cc=$(defaults read com.apple.controlcenter "NSStatusItem VisibleCC Sound" 2>/dev/null || true)
    case "$visible_cc" in
        1|true|TRUE|YES|yes) return 0 ;;
    esac

    visible_legacy=$(defaults read com.apple.controlcenter "NSStatusItem Visible Sound" 2>/dev/null || true)
    case "$visible_legacy" in
        1|true|TRUE|YES|yes) return 0 ;;
    esac
    return 1
}

mac_name_strip_local_suffix() {
    local name="$1"
    name="${name%.local}"
    printf '%s\n' "$name"
}

mac_name_normalize_apostrophes() {
    local name="$1"
    name="${name//$'\342\200\231'/\'}"
    printf '%s\n' "$name"
}

mac_name_looks_system_assigned() {
    local name="$1"
    [[ -n "$name" ]] || return 1

    name=$(mac_name_strip_local_suffix "$name")

    if [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9-]*s-(MacBook-Air|MacBook-Pro|Mac-mini|Mac-Studio|Mac-Pro|iMac|MacBook)$ ]]; then
        return 0
    fi
    if [[ "$name" =~ ^(MacBook-Air|MacBook-Pro|Mac-mini|Mac-Studio|Mac-Pro|iMac|MacBook)$ ]]; then
        return 0
    fi

    name=$(mac_name_normalize_apostrophes "$name")
    local model
    for model in \
        "'s MacBook Air" \
        "'s MacBook Pro" \
        "'s Mac mini" \
        "'s Mac Studio" \
        "'s Mac Pro" \
        "'s iMac" \
        "'s MacBook"; do
        if [[ "$name" == *"$model" ]]; then
            return 0
        fi
    done
    return 1
}

mac_machine_name_primary() {
    local lh cn host
    lh=$(scutil --get LocalHostName 2>/dev/null) || lh=""
    cn=$(scutil --get ComputerName 2>/dev/null) || cn=""
    host=$(hostname 2>/dev/null) || host=""
    if [[ -n "$lh" ]]; then
        printf '%s\n' "$lh"
    elif [[ -n "$cn" ]]; then
        printf '%s\n' "$cn"
    elif [[ -n "$host" ]]; then
        mac_name_strip_local_suffix "$host"
    fi
}

mac_machine_name_is_system_assigned() {
    local cn lh hn host val
    cn=$(scutil --get ComputerName 2>/dev/null) || cn=""
    lh=$(scutil --get LocalHostName 2>/dev/null) || lh=""
    hn=$(scutil --get HostName 2>/dev/null) || hn=""
    host=$(hostname 2>/dev/null) || host=""
    for val in "$cn" "$lh" "$hn" "$host"; do
        if mac_name_looks_system_assigned "$val"; then
            return 0
        fi
    done
    return 1
}

gar_setting_matches() {
    local actual="$1" expected="$2" compare="${3:-eq}"
    case "$compare" in
        eq)
            [[ "$actual" == "$expected" ]]
            ;;
        at_most)
            [[ "$actual" =~ ^[0-9]+$ && "$expected" =~ ^[0-9]+$ && "$actual" -le "$expected" ]]
            ;;
        *)
            return 1
            ;;
    esac
}

gar_defaults_write() {
    local location="$1" key="$2" value="$3" flag
    if [[ "$value" =~ ^-?[0-9]+$ ]]; then
        flag=-int
    elif [[ "$value" == true || "$value" == false ]]; then
        flag=-bool
    else
        flag=-string
    fi
    if [[ "$location" == global ]]; then
        defaults write -g "$key" "$flag" "$value"
    else
        defaults write "$(gar_expand_home "$location")" "$key" "$flag" "$value"
    fi
}

mac_write_json_setting() {
    local file="$1" key="$2" value="$3"
    python3 - "$file" "$key" "$value" <<'PY'
import json
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
key = sys.argv[2]
raw = sys.argv[3]

if raw in ("true", "false") or re.fullmatch(r"-?\d+", raw):
    literal = raw
else:
    literal = json.dumps(raw)

text = path.read_text() if path.exists() else ""

if text.strip() == "" or re.fullmatch(r"\s*\{\s*\}\s*", text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("{\n    %s: %s\n}\n" % (json.dumps(key), literal))
    raise SystemExit(0)

# Replace the existing value in place, preserving comments/formatting.
pattern = re.compile(
    r'("' + re.escape(key) + r'"\s*:\s*)'
    r'("(?:[^"\\]|\\.)*"|true|false|null|-?\d+(?:\.\d+)?)'
)
new_text, n = pattern.subn(lambda m: m.group(1) + literal, text, count=1)
if n:
    path.write_text(new_text)
    raise SystemExit(0)

# Key absent: insert it right after the opening brace.
idx = text.find("{")
if idx == -1:
    raise SystemExit(1)
path.write_text(
    "%s\n    %s: %s,%s" % (text[:idx + 1], json.dumps(key), literal, text[idx + 1:])
)
raise SystemExit(0)
PY
}

mac_fix_sound_menu_bar() {
    local major want
    major=$(sw_vers -productVersion 2>/dev/null | cut -d. -f1)
    if [[ "$major" =~ ^[0-9]+$ ]] && (( major >= 26 )); then
        want=16
    else
        want=18
    fi
    defaults -currentHost write com.apple.controlcenter Sound -int "$want" || return 1
    killall ControlCenter 2>/dev/null || true
    return 0
}

offer_fix_mac_setting() {
    local kind="$1" location="$2" key="$3" expected="$4" label="$5" settings_path

    gar_can_prompt || return 0

    case "$kind" in
        defaults)
            gar_prompt_yn "Fix $label: set $key to $expected?" || return 0
            if gar_defaults_write "$location" "$key" "$expected" >/dev/null 2>&1; then
                printf 'Set %s to %s (may take effect after logout).\n' "$key" "$expected"
            else
                report_warn "Setting $label (could not write $key)"
            fi
            ;;
        json-editor)
            settings_path=$(mac_editor_settings_path "$location")
            [[ -n "$settings_path" ]] || return 0
            gar_prompt_yn "Fix $label: set $key to $expected in $settings_path?" || return 0
            if mac_write_json_setting "$settings_path" "$key" "$expected"; then
                printf 'Set %s to %s in %s.\n' "$key" "$expected" "$settings_path"
            else
                report_warn "Setting $label (could not update $settings_path)"
            fi
            ;;
        sound-menu-bar-always)
            gar_prompt_yn "Fix $label: always show volume in the menu bar?" || return 0
            if mac_fix_sound_menu_bar; then
                printf 'Enabled always-on volume in the menu bar.\n'
            else
                report_warn "Setting $label (could not update Control Center)"
            fi
            ;;
    esac
}

check_mac_settings() {
    local label kind location key expected compare actual settings_path app_path read_status=0
    while IFS='|' read -r label kind location key expected compare; do
        compare="${compare:-eq}"
        actual=""

        case "$kind" in
            sound-menu-bar-always)
                if mac_controlcenter_sound_always; then
                    report_ok "Setting $label"
                else
                    report_warn "Setting $label (enable in System Settings → Control Center → Sound → Show in Menu Bar → Always)"
                    offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
                fi
                continue
                ;;
            machine-name-not-default)
                actual=$(mac_machine_name_primary 2>/dev/null || true)
                if mac_machine_name_is_system_assigned; then
                    if [[ -n "$actual" ]]; then
                        report_warn "Setting $label (is $actual; rename in System Settings → General → About → Name)"
                    else
                        report_warn "Setting $label (rename in System Settings → General → About → Name)"
                    fi
                else
                    report_ok "Setting $label${actual:+ ($actual)}"
                fi
                continue
                ;;
            json-editor)
                app_path=$(mac_editor_app_path "$location")
                if [[ -z "$app_path" || ! -e "$app_path" ]]; then
                    continue
                fi
                settings_path=$(mac_editor_settings_path "$location")
                if [[ ! -f "$settings_path" ]]; then
                    report_warn "Setting $label (not set; want $expected)"
                    offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
                    continue
                fi
                read_status=0
                actual=$(mac_read_json_setting "$settings_path" "$key" 2>/dev/null) || read_status=$?
                if (( read_status != 0 )); then
                    if (( read_status == 2 )); then
                        report_warn "Setting $label (not set; want $expected)"
                        offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
                    elif (( read_status == 3 )); then
                        report_warn "Setting $label (could not parse $settings_path)"
                    else
                        report_warn "Setting $label (could not read $settings_path)"
                    fi
                    continue
                fi
                ;;
            defaults)
                if ! actual=$(mac_read_defaults_setting "$location" "$key" 2>/dev/null); then
                    report_warn "Setting $label (could not read $location $key)"
                    offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
                    continue
                fi
                ;;
            *)
                report_warn "Setting $label (unknown kind: $kind)"
                continue
                ;;
        esac

        if gar_setting_matches "$actual" "$expected" "$compare"; then
            report_ok "Setting $label ($actual)"
        else
            report_warn "Setting $label (is $actual; want $expected)"
            offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
        fi
    done < <(read_manifest "$GAR_DIR/mac.settings")
}

mac_secret_exists() {
    security find-generic-password -a "$USER" -s "$1" >/dev/null 2>&1
}

check_mac_homebrew() {
    local brew_bin=""
    if command -v brew >/dev/null 2>&1; then
        brew_bin=$(command -v brew)
    elif [[ -x /opt/homebrew/bin/brew ]]; then
        brew_bin=/opt/homebrew/bin/brew
    elif [[ -x /usr/local/bin/brew ]]; then
        brew_bin=/usr/local/bin/brew
    fi

    if [[ -z "$brew_bin" ]]; then
        report_miss "Homebrew (not installed)"
        return
    fi
    report_ok "Homebrew ($brew_bin)"

    local brewfile="$GAR_DIR/mac.Brewfile"
    if [[ ! -f "$brewfile" ]]; then
        report_miss "Homebrew manifest ($brewfile missing)"
        return
    fi

    local missing=()
    while IFS= read -r line; do
        [[ "$line" == →* ]] || continue
        missing+=("${line#→ }")
    done < <("$brew_bin" bundle check --file="$brewfile" --verbose 2>&1 || true)

    if ((${#missing[@]} == 0)); then
        report_ok "Homebrew taps/formulae/casks (Brewfile satisfied)"
        return
    fi

    local item hint
    for item in "${missing[@]}"; do
        if hint=$(brew_miss_hint "$item"); then
            report_miss "Homebrew: $item ($hint)"
        else
            report_miss "Homebrew: $item"
        fi
    done
}

check_mac_secrets() {
    local key keys=() i=0 result status
    mkdir -p "$gar_tmpdir/secrets"
    while IFS= read -r key; do
        keys+=("$key")
        (
            if mac_secret_exists "$key"; then
                printf 'ok\n' >"$gar_tmpdir/secrets/$i"
            else
                printf 'miss\n' >"$gar_tmpdir/secrets/$i"
            fi
        ) &
        i=$((i + 1))
    done < <(read_manifest "$GAR_DIR/mac.secrets")
    wait
    for i in "${!keys[@]}"; do
        key="${keys[$i]}"
        status=$(<"$gar_tmpdir/secrets/$i")
        if [[ "$status" == ok ]]; then
            report_ok "Secret $key"
        else
            report_miss "Secret $key (set with: set-secret $key VALUE)"
        fi
    done
}

check_env() {
    local env_manifest="$1" name val
    while IFS= read -r name; do
        val="${!name-}"
        if [[ -n "$val" ]]; then
            report_ok "Env $name"
        else
            report_miss "Env $name (not set in this shell)"
        fi
    done < <(read_manifest "$env_manifest")
}

check_mac_env() {
    check_env "$GAR_DIR/mac.env"
}

check_mac_java() {
    local sdkman_init="$HOME/.sdkman/bin/sdkman-init.sh"
    local has_sdkman=0
    local has_java=0

    if [[ -s "$sdkman_init" ]]; then
        has_sdkman=1
        report_ok "SDKMAN"
        # shellcheck disable=SC1090
        source "$sdkman_init"
        if sdk current java >/dev/null 2>&1; then
            has_java=1
            report_ok "Java ($(sdk current java 2>/dev/null | tr -d '\r'))"
        fi
    else
        report_miss "SDKMAN (install from https://sdkman.io, then: sdk install java)"
    fi

    if java -version >/dev/null 2>&1; then
        has_java=1
        if (( has_sdkman == 0 )); then
            report_ok "Java ($(java -version 2>&1 | head -n1))"
        fi
    elif (( has_java == 0 )); then
        if (( has_sdkman == 1 )); then
            report_miss "Java (no SDKMAN candidate; run: sdk install java)"
        else
            report_miss "Java (no runtime; prefer SDKMAN: sdk install java)"
        fi
    fi
}

check_commands() {
    local commands_manifest="$1" hints_file="$2" cmd hint
    while IFS= read -r cmd; do
        if command -v "$cmd" >/dev/null 2>&1; then
            report_ok "Command $cmd"
        else
            hint=$(lookup_install_hint "$cmd" "$hints_file" 2>/dev/null || true)
            if [[ -n "$hint" ]]; then
                report_miss "Command $cmd ($hint)"
            else
                report_miss "Command $cmd (not on PATH)"
            fi
        fi
    done < <(read_manifest "$commands_manifest")
}

mac_perl_module_installed() {
    perl -M"$1" -e1 2>/dev/null
}

check_mac_perl_modules() {
    local module hint
    while IFS= read -r module; do
        if mac_perl_module_installed "$module"; then
            report_ok "Perl module $module"
        else
            hint=$(lookup_install_hint "$module" 2>/dev/null || true)
            if [[ -n "$hint" ]]; then
                if gar_hint_is_multiline "$hint"; then
                    report_miss "Perl module $module:"
                    printf '%b\n' "$hint"
                else
                    report_miss "Perl module $module ($hint)"
                fi
            else
                report_miss "Perl module $module (not installed)"
            fi
        fi
    done < <(read_manifest "$GAR_DIR/mac.perl-modules")
}

check_mac_apps() {
    local entry name path
    while IFS= read -r entry; do
        name="${entry%%|*}"
        path="${entry#*|}"
        if [[ "$name" == "$entry" || -z "$path" ]]; then
            report_miss "App manifest line (expected name|path): $entry"
            continue
        fi
        if [[ -e "$path" ]]; then
            report_ok "App $name"
        else
            report_miss "App $name ($path)"
        fi
    done < <(read_manifest "$GAR_DIR/mac.apps")
}

mac_login_items_raw() {
    osascript -e 'tell application "System Events" to get the name of every login item' 2>/dev/null
}

mac_login_item_listed() {
    local want="$1" items_raw="$2" item
    while IFS= read -r item || [[ -n "${item:-}" ]]; do
        item="${item#"${item%%[![:space:]]*}"}"
        item="${item%"${item##*[![:space:]]}"}"
        [[ -n "$item" && "$item" == "$want" ]] && return 0
    done < <(printf '%s' "$items_raw" | tr ',' '\n')
    return 1
}

check_mac_login_items() {
    local entry label login_name items_raw read_status=0
    read_status=0
    items_raw=$(mac_login_items_raw) || read_status=$?
    if (( read_status != 0 )); then
        report_warn "Login items (could not read; allow Terminal or gar to control System Events)"
        return
    fi

    while IFS='|' read -r label login_name; do
        if [[ -z "$label" || -z "$login_name" ]]; then
            report_miss "Login item manifest line (expected label|name): ${label}|${login_name}"
            continue
        fi
        if mac_login_item_listed "$login_name" "$items_raw"; then
            report_ok "Login item $label"
        else
            report_miss "Login item $label (add $login_name in System Settings → General → Login Items)"
        fi
    done < <(read_manifest "$GAR_DIR/mac.login-items")
}

mac_browser_app_path() {
    case "$1" in
        opera) printf '%s\n' /Applications/Opera.app ;;
        waterfox) printf '%s\n' /Applications/Waterfox.app ;;
    esac
}

mac_chromium_extension_installed() {
    local support_dir="$1" ext_id="$2" profile_dir
    for profile_dir in "$support_dir"/*/Extensions/"$ext_id"; do
        [[ -d "$profile_dir" ]] && return 0
    done
    return 1
}

mac_gecko_extension_installed() {
    local support_dir="$1" ext_id="$2"
    python3 - "$support_dir" "$ext_id" <<'PY'
import configparser
import json
import sys
from pathlib import Path

base = Path(sys.argv[1]).expanduser()
addon_id = sys.argv[2]
profile_dirs = []

profiles_ini = base / "profiles.ini"
if profiles_ini.exists():
    cp = configparser.RawConfigParser()
    cp.read(profiles_ini)
    for section in cp.sections():
        if not cp.has_option(section, "Path"):
            continue
        rel = cp.get(section, "Path")
        is_relative = cp.get(section, "IsRelative", fallback="1") == "1"
        profile = (base / rel) if is_relative else Path(rel)
        if profile.is_dir():
            profile_dirs.append(profile)
else:
    profiles = base / "Profiles"
    if profiles.is_dir():
        profile_dirs = [p for p in profiles.iterdir() if p.is_dir()]

for profile in profile_dirs:
    ext_json = profile / "extensions.json"
    if not ext_json.exists():
        continue
    data = json.loads(ext_json.read_text())
    for addon in data.get("addons", []):
        if addon.get("id") == addon_id and addon.get("type") == "extension":
            raise SystemExit(0)

raise SystemExit(1)
PY
}

mac_browser_extension_installed() {
    local browser="$1" ext_id="$2"
    case "$browser" in
        opera)
            mac_chromium_extension_installed \
                "$HOME/Library/Application Support/com.operasoftware.Opera" \
                "$ext_id"
            ;;
        waterfox)
            mac_gecko_extension_installed \
                "$HOME/Library/Application Support/Waterfox" \
                "$ext_id"
            ;;
        *)
            return 1
            ;;
    esac
}

check_mac_browser_extensions() {
    local entry browser ext_id label app_path i=0 status
    local browsers=() ext_ids=() labels=()
    mkdir -p "$gar_tmpdir/extensions"
    while IFS='|' read -r browser ext_id label; do
        if [[ -z "$browser" || -z "$ext_id" || -z "$label" ]]; then
            browsers+=("$browser")
            ext_ids+=("$ext_id")
            labels+=("$label")
            printf 'bad\n' >"$gar_tmpdir/extensions/$i"
            i=$((i + 1))
            continue
        fi

        app_path=$(mac_browser_app_path "$browser")
        if [[ -z "$app_path" || ! -e "$app_path" ]]; then
            browsers+=("$browser")
            ext_ids+=("$ext_id")
            labels+=("$label")
            printf 'skip\n' >"$gar_tmpdir/extensions/$i"
            i=$((i + 1))
            continue
        fi

        browsers+=("$browser")
        ext_ids+=("$ext_id")
        labels+=("$label")
        (
            if mac_browser_extension_installed "$browser" "$ext_id"; then
                printf 'ok\n' >"$gar_tmpdir/extensions/$i"
            else
                printf 'miss\n' >"$gar_tmpdir/extensions/$i"
            fi
        ) &
        i=$((i + 1))
    done < <(read_manifest "$GAR_DIR/mac.browser-extensions")
    wait
    for i in "${!browsers[@]}"; do
        browser="${browsers[$i]}"
        ext_id="${ext_ids[$i]}"
        label="${labels[$i]}"
        status=$(<"$gar_tmpdir/extensions/$i")
        case "$status" in
            skip) continue ;;
            bad)
                report_miss "Browser extension manifest line (expected browser|id|name): $browser|$ext_id|$label"
                ;;
            ok)
                report_ok "Extension $browser/$label"
                ;;
            miss)
                report_miss "Extension $browser/$label ($ext_id)"
                ;;
        esac
    done
}

run_mac_checks() {
    local repos_manifest hints_file git_config_manifest
    repos_manifest=$(gar_resolve_manifest mac machine-env-repos)
    git_config_manifest=$(gar_resolve_manifest mac git-config)
    hints_file="$GAR_DIR/mac.install-hints"

    gar_init_workdir

    gar_section_begin "Homebrew"
    check_mac_homebrew

    gar_section_begin "Secrets"
    check_mac_secrets

    gar_section_begin "Environment"
    check_mac_env

    gar_section_begin "Java"
    check_mac_java

    gar_section_begin "Commands"
    check_commands "$GAR_DIR/mac.commands" "$hints_file"

    gar_section_begin "Perl modules"
    check_mac_perl_modules

    gar_section_begin "Applications"
    check_mac_apps

    gar_section_begin "Login items"
    check_mac_login_items

    gar_section_begin "Browser extensions"
    check_mac_browser_extensions

    gar_section_begin "Machine environment repos"
    check_machine_env_repos "$repos_manifest"

    gar_section_begin "Git config"
    check_git_config "$git_config_manifest" "$hints_file"

    gar_section_begin "Settings"
    check_mac_settings
}

