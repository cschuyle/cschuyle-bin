# --- Manifests --------------------------------------------------------------

def parse_manifest(text):
    """Manifest lines with # comments stripped, trimmed, blanks dropped."""
    lines = []
    for line in text.split("\n"):
        line = line.split("#", 1)[0].strip()
        if line:
            lines.append(line)
    return lines


def read_manifest(path):
    if not path or not os.path.isfile(path):
        return []
    return parse_manifest(read_text(path))


def gar_resolve_manifest(platform, name):
    for prefix in (platform, "shared"):
        for d in gar_manifest_dirs():
            f = os.path.join(d, f"{prefix}.{name}")
            if os.path.isfile(f):
                return f
    return ""


def gar_hints_file():
    manifest = gar_resolve_manifest(detect_platform(), "install-hints")
    if manifest and os.path.isfile(manifest):
        return manifest
    return os.path.join(GAR_DIR, "mac.install-hints")


def _sorted_listdir(d):
    try:
        return sorted(os.listdir(d))
    except OSError:
        return []


# Concatenate role.<role>.<capability> from all manifest roots (as text).
def gar_collect_role_manifest_for_role(role, capability):
    parts = []
    for d in gar_manifest_dirs():
        f = os.path.join(d, f"role.{role}.{capability}")
        if os.path.isfile(f):
            parts.append(read_text(f) + "\n")
    return "".join(parts)


# Concatenate role.<role>.<capability> for each active role (as text).
def gar_collect_role_manifest(capability):
    return "".join(gar_collect_role_manifest_for_role(r, capability) for r in gar_active_roles)


# Platform/shared base plus active role overlays for one capability name (text).
def gar_combined_capability_manifest(platform, capability):
    text = ""
    base = gar_resolve_manifest(platform, capability)
    if base and os.path.isfile(base):
        text += read_text(base) + "\n"
    return text + gar_collect_role_manifest(capability)


def gar_combined_lines(platform, capability):
    return parse_manifest(gar_combined_capability_manifest(platform, capability))


# List platform + all role.* manifests for a capability (for lookups / info).
def gar_all_capability_manifests(platform, capability):
    files = []
    base = gar_resolve_manifest(platform, capability)
    if base and os.path.isfile(base):
        files.append(base)
    suffix = "." + capability
    for d in gar_manifest_dirs():
        for name in _sorted_listdir(d):
            if name.startswith("role.") and name.endswith(suffix) and len(name) > len("role.") + len(suffix):
                f = os.path.join(d, name)
                if os.path.isfile(f):
                    files.append(f)
    return files


def gar_name_eq(a, b):
    return a.lower() == b.lower()


def lookup_install_hint(query, hints_file=None):
    """The hint for query (case-insensitive name match), or None."""
    for line in read_manifest(hints_file or gar_hints_file()):
        name, hint = split_fields(line, 2)
        if gar_name_eq(query, name):
            return hint
    return None


def gar_info_dirs(platform):
    # Platform-specific info first, then shared info (inherited), per manifest
    # root (repo then local). A platform file with the same name shadows shared.
    dirs = []
    for prefix in (platform, "shared"):
        for d in gar_manifest_dirs():
            p = os.path.join(d, prefix + ".info.d")
            if os.path.isdir(p):
                dirs.append(p)
    return dirs


# Platform default page for `gar info` with no name: <platform>.info under a
# manifest root (first match; missing or empty = no content).
def gar_platform_info_file(platform=None):
    platform = platform or detect_platform()
    for d in gar_manifest_dirs():
        f = os.path.join(d, platform + ".info")
        if os.path.isfile(f):
            return f
    return os.path.join(GAR_DIR, platform + ".info")


def lookup_platform_info():
    f = gar_platform_info_file()
    if not os.path.isfile(f):
        return None
    text = read_text(f)
    # Treat empty / whitespace-only as no content.
    if not text.strip():
        return None
    return text


def lookup_general_info(query):
    for info_dir in gar_info_dirs(detect_platform()):
        for base in _sorted_listdir(info_dir):
            f = os.path.join(info_dir, base)
            if os.path.isfile(f) and gar_name_eq(query, base):
                return read_text(f)
    return None


def gar_print_general_info(info):
    out("\nInfo:")
    out(info.rstrip("\n"))


def gar_hint_is_multiline(hint):
    return "\\n" in hint


def gar_print_install_hint(label, hint):
    if gar_hint_is_multiline(hint):
        out(label[:-1] if label.endswith(" ") else label)
        out(printf_b(hint))
    else:
        out(label + hint)


# --- Apps -------------------------------------------------------------------

# Split a manifest path field on '|' into candidate paths. An app entry may list
# several paths (name|path|path...); any existing one counts as installed.
def gar_app_candidate_paths(field):
    return [p for p in field.split("|") if p]


# The first candidate path that exists on disk, or None.
def gar_app_first_existing_path(field):
    for p in gar_app_candidate_paths(field):
        if os.path.exists(p):
            return p
    return None


# Join candidate paths with " or " for display.
def gar_app_format_paths(field):
    return " or ".join(gar_app_candidate_paths(field))


# Basename of an .app path without the .app suffix (e.g. Rancher Desktop).
def gar_app_path_label(path):
    base = os.path.basename(path.rstrip("/")) or path
    for suffix in (".app", ".App"):
        if base.endswith(suffix):
            base = base[:-len(suffix)]
    return base


# True if query matches display name or an alternate install path label (full
# label or its first word), e.g. "rancher" → Rancher Desktop.app.
def gar_app_query_matches(query, display_name, path_field):
    if gar_name_eq(query, display_name):
        return True
    for path in gar_app_candidate_paths(path_field):
        label = gar_app_path_label(path)
        if gar_name_eq(query, label):
            return True
        first = re.split(r"\s", label, maxsplit=1)[0]
        if first and gar_name_eq(query, first):
            return True
    return False


def split_entry(entry):
    """name|rest → (name, rest); rest is the whole entry when there's no '|'."""
    if "|" in entry:
        return tuple(entry.split("|", 1))
    return entry, entry


def lookup_app_entry(query):
    for manifest in gar_all_capability_manifests("mac", "apps"):
        for entry in read_manifest(manifest):
            name, path = split_entry(entry)
            if gar_app_query_matches(query, name, path):
                return name, path
    return None


def cmd_apps(args):
    role = ""
    while args:
        a = args[0]
        if a in ("-r", "--role"):
            if len(args) < 2 or not args[1] or args[1].startswith("-"):
                err("apps: -r requires a role id")
                sys.exit(2)
            role = args[1]
            args = args[2:]
        elif a in ("-h", "--help"):
            usage()
            sys.exit(0)
        else:
            err(f"Unknown option for apps: {a}")
            usage(sys.stderr)
            sys.exit(2)

    if role:
        if not gar_role_is_known(role):
            err(f"Unknown role: {role}")
            sys.exit(1)
        gar_init_workdir()
        text = gar_collect_role_manifest_for_role(role, "apps")
        if not text:
            out(f"No apps for role {role}")
            return
        entries = parse_manifest(text)
        out(f"Tracked apps for role {role}:\n")
    else:
        detect_roles()
        gar_init_workdir()
        entries = gar_combined_lines("mac", "apps")
        out("Tracked apps (installed outside Homebrew):\n")

    for entry in entries:
        name, path = split_entry(entry)
        out(name)
        out(f"  Path: {gar_app_format_paths(path)}")
        hint = lookup_install_hint(name)
        if hint is not None:
            out(f"  Install: {hint}")
        else:
            out("  Install: App Store or vendor site")
        out()


# --- Browser extensions -----------------------------------------------------

def gar_normalize_ext_id(ext_id):
    if ext_id.startswith("{"):
        ext_id = ext_id[1:]
    if ext_id.endswith("}"):
        ext_id = ext_id[:-1]
    return ext_id


def lookup_browser_extension_entry(query):
    query_id = gar_normalize_ext_id(query)
    for line in read_manifest(os.path.join(GAR_DIR, "mac.browser-extensions")):
        browser, ext_id, label = split_fields(line, 3)
        if gar_name_eq(query, label) or gar_name_eq(query, f"{browser}/{label}"):
            return browser, ext_id, label
        if gar_name_eq(query, ext_id) or gar_name_eq(query_id, gar_normalize_ext_id(ext_id)):
            return browser, ext_id, label
    return None


def mac_browser_app_path(browser):
    return {
        "chrome": "/Applications/Google Chrome.app",
        "opera": "/Applications/Opera.app",
        "waterfox": "/Applications/Waterfox.app",
    }.get(browser, "")


def mac_chromium_extension_installed(support_dir, ext_id):
    pattern = os.path.join(glob.escape(support_dir), "*", "Extensions", glob.escape(ext_id))
    return any(os.path.isdir(p) for p in glob.glob(pattern))


def mac_gecko_extension_installed(support_dir, addon_id):
    base = Path(support_dir).expanduser()
    profile_dirs = []
    try:
        profiles_ini = base / "profiles.ini"
        if profiles_ini.exists():
            cp = configparser.RawConfigParser()
            cp.read(str(profiles_ini))
            for section in cp.sections():
                if not cp.has_option(section, "Path"):
                    continue
                rel = cp.get(section, "Path")
                is_relative = cp.get(section, "IsRelative", fallback="1") == "1"
                profile = (base / rel) if is_relative else Path(rel)
                if profile.is_dir():
                    profile_dirs.append(profile)
        else:
            profiles = base / "Profiles"
            if profiles.is_dir():
                profile_dirs = [p for p in profiles.iterdir() if p.is_dir()]

        for profile in profile_dirs:
            ext_json = profile / "extensions.json"
            if not ext_json.exists():
                continue
            data = json.loads(ext_json.read_text())
            for addon in data.get("addons", []):
                if addon.get("id") == addon_id and addon.get("type") == "extension":
                    return True
    except Exception:
        return False
    return False


def mac_browser_extension_installed(browser, ext_id):
    support = os.path.join(HOME, "Library", "Application Support")
    if browser == "chrome":
        return mac_chromium_extension_installed(os.path.join(support, "Google", "Chrome"), ext_id)
    if browser == "opera":
        return mac_chromium_extension_installed(os.path.join(support, "com.operasoftware.Opera"), ext_id)
    if browser == "waterfox":
        return mac_gecko_extension_installed(os.path.join(support, "Waterfox"), ext_id)
    return False


# --- Homebrew ---------------------------------------------------------------

BREW_LINE_RE = re.compile(r'^(brew|cask|tap)\s+"([^"]+)"')


def lookup_brew_hint(query):
    for manifest in gar_all_capability_manifests("mac", "Brewfile"):
        for line in read_manifest(manifest):
            m = BREW_LINE_RE.match(line)
            if not m or m.group(1) == "tap" or not gar_name_eq(query, m.group(2)):
                continue
            if m.group(1) == "brew":
                return f"brew install {m.group(2)}"
            return f"brew install --cask {m.group(2)}"
    return None


# The short names declared in a composed Brewfile (text) for one kind (brew |
# cask). A tapped formula (e.g. gdubw/gng/gng) is reduced to its leaf name
# (gng), which is how Brewfiles name it (brew "gng"). Trailing comments and
# options (e.g. `, link: true`) after the quoted name are ignored.
def gar_brewfile_declared(text, kind):
    names = []
    rx = re.compile(r'^\s*' + re.escape(kind) + r'\s+"([^"]+)"')
    for line in text.split("\n"):
        m = rx.match(line.split("#", 1)[0])
        if m:
            names.append(m.group(1).rsplit("/", 1)[-1])
    return names


# Standalone inverse-audit: list installed Homebrew packages NOT called for by
# any Brewfile (platform base + active roles). The opposite of
# check_mac_homebrew, which reports desired-but-missing.
#   cmd_extra_brew("leaves")     -> baseline is `brew leaves` (all top-level)
#   cmd_extra_brew("requested")  -> baseline is `brew leaves -r` (installed on request)
# Dependencies (formulae installed only as deps of something else) are never
# considered — `brew leaves` already excludes them. Casks are reported in a
# separate sub-section because some are tracked as GUI apps in a .apps manifest
# rather than a `cask "..."` line, so a cask here isn't necessarily unaccounted-for.
def cmd_extra_brew(mode):
    brew_bin = gar_brew_bin()
    if not brew_bin:
        err("Homebrew not installed.")
        sys.exit(2)

    gar_init_workdir()
    brewfile = gar_combined_capability_manifest("mac", "Brewfile")
    declared_brew = set(gar_brewfile_declared(brewfile, "brew"))
    declared_cask = set(gar_brewfile_declared(brewfile, "cask"))

    leaves_args = ["leaves", "-r"] if mode == "requested" else ["leaves"]
    _, leaves = run([brew_bin] + leaves_args)
    _, casks = run([brew_bin, "list", "--cask"])
    installed_brew = {l.rsplit("/", 1)[-1] for l in leaves.split("\n") if l}
    installed_cask = {l for l in casks.split("\n") if l}

    extra_brew = sorted(installed_brew - declared_brew)
    extra_cask = sorted(installed_cask - declared_cask)

    if mode == "requested":
        out("Installed-on-request formulae not called for by any Brewfile (base + active roles):\n")
    else:
        out("Top-level formulae not called for by any Brewfile (base + active roles):\n")
    for name in extra_brew or ["(none)"]:
        out("  " + name)

    out('\nInstalled casks not declared via a cask "..." line')
    out("(some may be tracked as GUI apps in a .apps manifest rather than a cask line):\n")
    for name in extra_cask or ["(none)"]:
        out("  " + name)


# Resolve the Homebrew binary (PATH first, then the standard Apple-silicon and
# Intel prefixes). Returns the path, or "" if brew isn't found.
def gar_brew_bin():
    b = which("brew")
    if b:
        return b
    for p in ("/opt/homebrew/bin/brew", "/usr/local/bin/brew"):
        if os.access(p, os.X_OK):
            return p
    return ""


def _brew_usable(brew_bin):
    return bool(brew_bin) and os.access(brew_bin, os.X_OK)


# True if the named Homebrew package is installed. kind is "cask" or "formula"
# (anything but "cask" is treated as a formula).
def gar_brew_installed(brew_bin, kind, name):
    if not _brew_usable(brew_bin):
        return False
    flag = "--cask" if kind == "cask" else "--formula"
    return run_ok([brew_bin, "list", flag, name])


# True if the named installed Homebrew package has a newer version available.
# `brew outdated <name>` prints the name when outdated, nothing when current
# (exit status is 0 either way), so we test for non-empty output.
def gar_brew_outdated(brew_bin, kind, name):
    if not _brew_usable(brew_bin):
        return False
    flag = "--cask" if kind == "cask" else "--formula"
    return bool(run([brew_bin, "outdated", flag, name])[1])


# Parse a "brew install [--cask] <name>" string into (kind, name) (kind is
# "cask" or "formula"). None if the string isn't a brew install command, so
# callers can tell brew hints from other install hints.
def gar_brew_parse_hint(hint):
    if not hint.startswith("brew install "):
        return None
    if "--cask " in hint:
        return "cask", hint.rsplit("--cask ", 1)[1]
    return "formula", hint.rsplit(" ", 1)[1]


# Print a "Status: ..." line for a Homebrew package, led by gar's OK/WARN/MISS
# vocabulary: OK when installed and current, WARN when an update is available,
# MISS when not installed (or Homebrew itself is missing).
def gar_print_brew_status(kind, name):
    brew_bin = gar_brew_bin()
    if not brew_bin:
        out("Status: MISS - Homebrew not installed")
    elif gar_brew_installed(brew_bin, kind, name):
        if gar_brew_outdated(brew_bin, kind, name):
            out("Status: WARN - installed (update available)")
        else:
            out("Status: OK - installed (up to date)")
    else:
        out("Status: MISS - not installed")


def brew_miss_hint(item):
    if "gdubw/gng" in item or "Formula gng" in item:
        return "https://github.com/gdubw/gng — brew trust --formula gdubw/gng/gng && brew install gng"
    return None


# Collapse a leading $HOME to ~ for display (e.g. /Users/me/.local/bin -> ~/.local/bin).
def gar_tilde_path(path):
    if path == HOME:
        return "~"
    if path.startswith(HOME + "/"):
        return "~" + path[len(HOME):]
    return path


# Command names that install-hints says are provided by a brew formula/cask.
# The hint value is matched as a whole token so cask "claude-code" maps to the
# command "claude" via `claude|brew install --cask claude-code`.
def gar_brew_hint_commands(brew_name):
    cmds = []
    for line in read_manifest(gar_hints_file()):
        name, hint = split_fields(line, 2)
        if name and hint and (f" {brew_name} ") in (f" {hint} "):
            cmds.append(name)
    return cmds


# If a missing brew formula/cask is actually already available on PATH from a
# non-Homebrew location, return (command, path). Candidate command names are
# the brew item name itself plus any command install-hints maps to it.
def gar_brew_item_elsewhere(brew_name, brew_bin):
    _, brew_prefix = run([brew_bin, "--prefix"])
    for cmd in [brew_name] + gar_brew_hint_commands(brew_name):
        if not cmd:
            continue
        cmd_path = which(cmd)
        if not cmd_path:
            continue
        # Ignore the Homebrew-provided copy; we only care about other locations.
        if brew_prefix and cmd_path.startswith(brew_prefix + "/"):
            continue
        return cmd, cmd_path
    return None


# Capitalize the first character (claude -> Claude) for the display name.
def gar_capitalize_first(s):
    return s[:1].upper() + s[1:]


# Extract the formula/cask name from a `brew bundle check` missing-item line
# (e.g. "Cask claude-code needs to be installed" -> "claude-code").
def gar_brew_item_name(item):
    m = re.match(r"^(Formula|Cask)\s+(\S+)\s+needs", item)
    return m.group(2) if m else None


# Classify a `brew bundle check` item into the action that satisfies it:
# link ("needs to be linked"), upgrade ("installed or updated" but already
# installed, i.e. outdated), or install.
def gar_brew_item_action(brew_bin, kind, name, item):
    if "needs to be linked" in item:
        return "link"
    if gar_brew_installed(brew_bin, kind, name):
        return "upgrade"
    return "install"


# Homebrew locates Xcode via /usr/bin/mdfind when it isn't at the standard
# path; with Spotlight disabled on / that query never returns, so any
# brew install/upgrade hangs (after downloading) until interrupted.
def gar_brew_blocked_by_spotlight():
    if os.path.isdir("/Applications/Xcode.app"):
        return False
    if not which("mdutil"):
        return False
    return "disabled" in run(["mdutil", "-s", "/"])[1].lower()


# The brew command that satisfies a `brew bundle check` item.
def gar_brew_item_command(brew_bin, item):
    m = re.match(r"^Tap\s+(\S+)\s+needs", item)
    if m:
        return f"brew tap {m.group(1)}"
    m = re.match(r"^Formula\s+(\S+)\s+needs", item)
    if m:
        name = m.group(1)
        action = gar_brew_item_action(brew_bin, "formula", name, item)
        if action == "link":
            return f"brew link --force {name}"
        if action == "upgrade":
            return f"brew upgrade {name}"
        return f"brew install {name}"
    m = re.match(r"^Cask\s+(\S+)\s+needs", item)
    if m:
        name = m.group(1)
        if gar_brew_item_action(brew_bin, "cask", name, item) == "upgrade":
            return f"brew upgrade --cask {name}"
        return f"brew install --cask {name}"
    return ""


def offer_brew_install_missing(brew_bin, items):
    if not gar_can_prompt():
        return

    def attempt(args, ok_msg, fail_msg):
        if run_tty(args) == 0:
            out(ok_msg)
            gar_note_fixed("issue")
            return True
        report_warn(fail_msg)
        return False

    for item in items:
        m_tap = re.match(r"^Tap\s+(\S+)\s+needs", item)
        m_link = re.match(r"^Formula\s+(\S+)\s+needs\s+to\s+be\s+linked", item)
        m_formula = re.match(r"^Formula\s+(\S+)\s+needs", item)
        m_cask = re.match(r"^Cask\s+(\S+)\s+needs", item)
        if m_tap:
            name = m_tap.group(1)
            if not gar_prompt_yn(f"Tap {name}?", f"brew tap {name}"):
                continue
            attempt([brew_bin, "tap", name], f"Tapped {name}.", f"Homebrew: could not tap {name}")
        elif m_link:
            name = m_link.group(1)
            if not gar_prompt_yn(f"Link {name} (brew)?", f"brew link --overwrite --force {name}"):
                continue
            attempt([brew_bin, "link", "--overwrite", "--force", name],
                    f"Linked {name}.", f"Homebrew: could not link {name}")
        elif m_formula:
            name = m_formula.group(1)
            action = gar_brew_item_action(brew_bin, "formula", name, item)
            if action == "link":
                # Keg-only formulae (the only kind bundle reports as needing a
                # link) refuse a plain `brew link`.
                if not gar_prompt_yn(f"Link {name} (brew)?", f"brew link --force {name}"):
                    continue
                attempt([brew_bin, "link", "--force", name],
                        f"Linked {name}.", f"Homebrew: could not link {name}")
            elif action == "upgrade":
                if not gar_prompt_yn(f"Upgrade {name} (brew)?", f"brew upgrade {name}"):
                    continue
                attempt([brew_bin, "upgrade", name],
                        f"Upgraded {name}.", f"Homebrew: could not upgrade {name}")
            else:
                is_gng = name == "gng" or name.endswith("/gng")
                if is_gng:
                    help_text = "brew trust --formula gdubw/gng/gng\nbrew install " + name
                else:
                    help_text = "brew install " + name
                if not gar_prompt_yn(f"Install {name} (brew)?", help_text):
                    continue
                if is_gng and run_tty([brew_bin, "trust", "--formula", "gdubw/gng/gng"]) != 0:
                    report_warn("Homebrew: could not trust gdubw/gng/gng")
                    continue
                attempt([brew_bin, "install", name],
                        f"Installed {name}.", f"Homebrew: could not install {name}")
        elif m_cask:
            name = m_cask.group(1)
            if gar_brew_item_action(brew_bin, "cask", name, item) == "upgrade":
                if not gar_prompt_yn(f"Upgrade {name} (brew cask)?", f"brew upgrade --cask {name}"):
                    continue
                attempt([brew_bin, "upgrade", "--cask", name],
                        f"Upgraded {name}.", f"Homebrew: could not upgrade cask {name}")
            else:
                if not gar_prompt_yn(f"Install {name} (brew cask)?", f"brew install --cask {name}"):
                    continue
                attempt([brew_bin, "install", "--cask", name],
                        f"Installed {name}.", f"Homebrew: could not install cask {name}")


def check_mac_homebrew():
    brew_bin = gar_brew_bin()
    if not brew_bin:
        report_miss("Homebrew (not installed)")
        return
    report_ok(f"Homebrew ({brew_bin})")

    text = gar_combined_capability_manifest("mac", "Brewfile")
    if not text:
        report_miss("Homebrew manifest (mac.Brewfile missing)")
        return
    brewfile = os.path.join(gar_tmpdir, "combined.Brewfile")
    with open(brewfile, "w") as f:
        f.write(text)

    # `brew bundle check` can repeat a line (e.g. "needs to be linked" once per
    # Brewfile entry that pulls the formula in), so drop exact duplicates.
    missing = []
    _, output = run([brew_bin, "bundle", "check", "--file=" + brewfile, "--verbose"], stderr_to_stdout=True)
    for line in output.split("\n"):
        if not line.startswith("→"):
            continue
        if line.startswith("→ "):
            line = line[2:]
        if line not in missing:
            missing.append(line)

    if not missing:
        report_ok("Homebrew taps/formulae/casks (Brewfile satisfied)")
        return

    still_missing = []
    for item in missing:
        # A "needs to be linked" formula is already brew-installed; another copy
        # on PATH is the conflict that blocks linking, not a reason to skip. So
        # bypass the "exists elsewhere" check and go straight to report + offer.
        if not re.search(r"\sneeds\s+to\s+be\s+linked", item):
            brew_name = gar_brew_item_name(item)
            elsewhere = gar_brew_item_elsewhere(brew_name, brew_bin) if brew_name else None
            if elsewhere:
                cmd, cmd_path = elsewhere
                gar_section_emit_header()
                out(f"{gar_capitalize_first(cmd)} is brew-required but exists in another location ({gar_tilde_path(cmd_path)}), so assuming you don't want it brew-installed")
                continue
        still_missing.append(item)
        hint = brew_miss_hint(item)
        if hint:
            report_miss(f"Homebrew: {item} ({hint})")
        else:
            report_miss(f"Homebrew: {item}")

    if still_missing:
        if gar_brew_blocked_by_spotlight():
            # Offering would just hang; list the fixes to run once it's back on.
            report_warn("Homebrew: not offering fixes — Spotlight is disabled on /, so brew install/upgrade hangs in its Xcode lookup (mdfind). Fix: sudo mdutil -i on /, then run:")
            for item in still_missing:
                out(f"  {gar_brew_item_command(brew_bin, item)}")
        else:
            offer_brew_install_missing(brew_bin, still_missing)


# Audit the brew-forbidden manifest: formulae a role/platform declares must NOT
# be installed (e.g. plain ffmpeg, which keeps the dev-tools role's ffmpeg-full
# unlinked/keg-only). An installed forbidden formula is a MISS, since it defeats
# the intent of whatever conflicting tool the role does want.
def check_mac_brew_forbidden():
    brew_bin = gar_brew_bin()
    if not brew_bin:
        return
    for name in gar_combined_lines("mac", "brew-forbidden"):
        if gar_brew_installed(brew_bin, "formula", name):
            report_miss(f"Homebrew: {name} is installed but conflicts with a role tool (uninstall: brew uninstall {name})")
        else:
            report_ok(f"Homebrew: {name} not installed (no conflict)")


