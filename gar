def check_git_config(config_manifest, hints_file):
    if not which("git"):
        report_miss("Git (not on PATH)")
        return
    for key in read_manifest(config_manifest):
        _, val = run(["git", "config", "--global", "--get", key])
        if val:
            report_ok(f"Git config {key} ({val})")
        else:
            hint = lookup_install_hint(key, hints_file)
            if hint:
                report_miss(f"Git config {key} ({hint})")
            else:
                report_miss(f"Git config {key} (not set; run: git config --global {key} VALUE)")


