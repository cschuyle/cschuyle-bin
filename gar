# --- Process helpers --------------------------------------------------------

def out(s=""):
    sys.stdout.write(s + "\n")


def err(s=""):
    sys.stderr.write(s + "\n")


def run(args, timeout=None, input=None, env=None, stderr_to_stdout=False):
    """Run args, capturing stdout. Returns (status, stdout with trailing newlines
    stripped, like $(...)). A missing binary is status 127; a timeout kills the
    command and returns 137."""
    try:
        p = subprocess.run(
            args,
            input=input,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT if stderr_to_stdout else subprocess.DEVNULL,
            stdin=None if input is not None else subprocess.DEVNULL,
            timeout=timeout,
            env=env,
        )
    except subprocess.TimeoutExpired:
        return 137, ""
    except OSError:
        return 127, ""
    return p.returncode, p.stdout.decode("utf-8", "replace").rstrip("\n")


def run_ok(args, timeout=None):
    return run(args, timeout=timeout)[0] == 0


def run_bytes(args, input=None):
    try:
        p = subprocess.run(args, input=input, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           stdin=None if input is not None else subprocess.DEVNULL)
    except OSError:
        return 127, b""
    return p.returncode, p.stdout


def run_tty(args):
    """Run args attached to the terminal (for brew installs, pulls, rebases)."""
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        return subprocess.run(args).returncode
    except OSError:
        return 127


def which(cmd):
    return shutil.which(cmd)


def read_text(path):
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        return f.read()


def strip_ws(s):
    return s.strip()


def split_fields(line, n):
    """Like `IFS='|' read -r a b c`: n fields, the last taking the remainder."""
    parts = line.split("|", n - 1)
    return parts + [""] * (n - len(parts))


def printf_b(s):
    """Interpret backslash escapes like printf %b."""
    table = {"n": "\n", "t": "\t", "\\": "\\", "a": "\a", "b": "\b",
             "f": "\f", "r": "\r", "v": "\v", "e": "\x1b"}
    return re.sub(r"\\(.)", lambda m: table.get(m.group(1), m.group(0)), s)


_Q_SPECIAL = set(" \t\n'\"\\|&;()<>{}[]*?$`#^")


def shell_q(s):
    """Approximate bash's printf %q."""
    if s == "":
        return "''"
    res = []
    for i, c in enumerate(s):
        if ord(c) < 32 or ord(c) == 127:
            code = {"\t": "t", "\n": "n", "\r": "r"}.get(c, f"{ord(c):03o}")
            res.append(f"$'\\{code}'")
        elif c in _Q_SPECIAL or (c == "~" and i == 0):
            res.append("\\" + c)
        else:
            res.append(c)
    return "".join(res)


def git(repo, *args, timeout=None):
    return run(["git", "-C", repo] + list(args), timeout=timeout)


# --- Timing instrumentation -------------------------------------------------
# Every run writes a timing log to ~/.gar/timings/timings-<timestamp>.txt so a
# slow or hung run can be diagnosed after the fact without reproducing it live.
# START is written before an operation runs and END (with duration) after, so
# a hang shows up as a START with no matching END — the last line in the file
# names the stuck operation. Best-effort: a failure to create the dir/file
# silently disables logging rather than affecting gar's own exit status.
gar_timings_file = ""
_timings_lock = threading.Lock()


def gar_timings_init():
    global gar_timings_file
    d = os.path.join(HOME, ".gar", "timings")
    try:
        os.makedirs(d, exist_ok=True)
        f = os.path.join(d, f"timings-{time.strftime('%Y%m%d-%H%M%S')}.txt")
        open(f, "w").close()
        gar_timings_file = f
    except OSError:
        gar_timings_file = ""


def gar_timings_mark(kind, label, dur=""):
    if not gar_timings_file:
        return
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')}\t{kind}\t{label}\t{dur or '-'}\n"
    with _timings_lock:
        try:
            with open(gar_timings_file, "a") as f:
                f.write(line)
        except OSError:
            pass


def gar_timed(label, fn, *args):
    """Run fn(*args), recording START/END(+duration) lines for label. Returns
    fn's result. Safe to nest and to call from parallel worker threads."""
    start = int(time.time())
    gar_timings_mark("START", label)
    try:
        return fn(*args)
    finally:
        gar_timings_mark("END", label, f"{int(time.time()) - start}s")


# Run a command with a hard wall-clock timeout, killing it (and returning
# failure) if it's still running after secs seconds. ConnectTimeout/BatchMode/
# lowSpeedLimit (above) only guard the network transfer itself; this also
# catches a command stuck on something outside git's control, like a graphical
# Keychain-access prompt for a credential helper that never sends a byte. Only
# ever call this on operations that are safe to kill mid-flight (e.g. a plain
# `git fetch`, never `git pull`/`rebase`, which can be interrupted mid-rewrite
# and leave a repo half-rebased).
def gar_run_with_timeout(secs, args):
    return run(args, timeout=secs)[0]


# --- Config paths -----------------------------------------------------------

def gar_config_base():
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "gar")


# Machine-local manifest overlays (same XDG base as ~/.config/gar/roles).
def gar_local_dir():
    return os.path.join(gar_config_base(), "d")


def gar_roles_file():
    return os.path.join(gar_config_base(), "roles")


# Existing manifest roots in order: repo gar.d, then local ~/.config/gar/d.
def gar_manifest_dirs():
    dirs = [GAR_DIR]
    local = gar_local_dir()
    if os.path.isdir(local):
        dirs.append(local)
    return dirs


def gar_check_config_path(kind, mode, path):
    """True if OK (right type, or optional-and-absent); prints to stderr and
    returns False on: dangling symlink, wrong file type, or unreadable path."""
    if os.path.islink(path) and not os.path.exists(path):
        err(f"gar: config path is a broken symlink: {path} -> {os.readlink(path)}")
        return False
    # Genuinely absent: OK for optional (intentional "no local config"), an
    # error for required (the repo's own gar.d).
    if not os.path.exists(path):
        if mode == "required":
            err(f"gar: required config path is missing: {path}")
            return False
        return True
    if kind == "dir" and not os.path.isdir(path):
        err(f"gar: config path should be a directory but is not: {path}")
        return False
    if kind == "file" and not os.path.isfile(path):
        err(f"gar: config path should be a regular file but is not: {path}")
        return False
    if not os.access(path, os.R_OK) or (kind == "dir" and not os.access(path, os.X_OK)):
        err(f"gar: config path is not readable: {path}")
        return False
    return True


# Fail fast on config paths that are broken rather than simply absent. Absence
# of a local (~/.config/gar) path is intentional and OK; a dangling symlink,
# wrong file type, or unreadable path is an unexpected setup error. Checks every
# path before returning so one run reports all problems.
def gar_preflight_config():
    ok = True
    ok = gar_check_config_path("dir", "required", GAR_DIR) and ok
    ok = gar_check_config_path("dir", "optional", gar_config_base()) and ok
    ok = gar_check_config_path("dir", "optional", gar_local_dir()) and ok
    ok = gar_check_config_path("file", "optional", gar_roles_file()) and ok
    return ok


def gar_init_workdir():
    global gar_tmpdir
    if not gar_tmpdir:
        gar_tmpdir = tempfile.mkdtemp(prefix="gar.")
        import atexit
        atexit.register(shutil.rmtree, gar_tmpdir, True)
    gar_timings_init()


