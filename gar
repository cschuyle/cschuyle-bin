#!/usr/bin/env bash
# gar (garage): check this machine's configuration against desired state.
set -o pipefail

GAR_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/gar.d" && pwd)"
gar_show_all=0
gar_section_name=""
gar_section_header_printed=0
gar_tmpdir=""
gar_active_roles=()

gar_init_workdir() {
    gar_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/gar.XXXXXX")
    trap '[[ -n "$gar_tmpdir" ]] && rm -rf "$gar_tmpdir"' EXIT
}

gar_path_slug() {
    printf '%s' "$1" | shasum | awk '{print $1}'
}

gar_result_get() {
    local file="$1" key="$2"
    [[ -f "$file" ]] || return 1
    awk -F= -v k="$key" '$1 == k { print $2; exit }' "$file"
}

usage() {
    cat <<'EOF'
Usage: gar [-ah]
       gar apps [-r <role>]
       gar info [name]
       gar roles
       gar --man

Check the current machine's configuration against the desired state in gar.d/.
Reports missing or out-of-date elements. Mac, Synology, and WSL checks are
implemented; plain Linux is detected but not yet audited.

Desired state is the platform/shared base plus an additive union of role
overlays enabled for this machine.

Roles
  Enable roles in ~/.config/gar/roles (one role id per line). A missing file
  means no roles are enabled. Blank lines and # comments are ignored.

  Example ~/.config/gar/roles:

    # overlays for this machine
    personal-machine
    my-data-client
    dev-tools

  Known role ids are listed by `gar roles` (those with gar.d/role.<id>.*
  manifests). Unknown ids in the roles file produce a WARN at audit time.

Options and commands
  -a, --all     Show all checks, including OK (default: only MISS and WARN)
  -h, --help, --man
                Show this help
  apps          List GUI apps tracked for this machine (platform base plus active
                role overlays). With -r <role>: only that role's apps overlay
                (gar.d/role.<role>.apps)
  info [name]   With no name: show the platform info page (gar.d/<platform>.info;
                empty by default). With a name: install hints and general info
                for a tracked item (case-insensitive)
  roles         List known role ids (those with gar.d/role.<id>.* manifests);
                enabled roles are prefixed with "✓ " (others with two spaces)

Exit status: 0 if everything looks good, 1 if anything is missing.
EOF
}

cmd_apps() {
    local entry name path hint apps_manifest role="" role_file
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--role)
                if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                    echo "apps: -r requires a role id" >&2
                    exit 2
                fi
                role="$2"
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                echo "Unknown option for apps: $1" >&2
                usage >&2
                exit 2
                ;;
        esac
    done

    if [[ -n "$role" ]]; then
        if ! gar_role_is_known "$role"; then
            echo "Unknown role: $role" >&2
            exit 1
        fi
        role_file="$GAR_DIR/role.$role.apps"
        if [[ ! -f "$role_file" ]]; then
            printf 'No apps for role %s\n' "$role"
            return 0
        fi
        apps_manifest="$role_file"
        printf 'Tracked apps for role %s:\n\n' "$role"
    else
        detect_roles
        gar_init_workdir
        apps_manifest=$(gar_combined_capability_manifest mac apps)
        printf 'Tracked apps (installed outside Homebrew):\n\n'
    fi

    while IFS= read -r entry; do
        name="${entry%%|*}"
        path="${entry#*|}"
        printf '%s\n' "$name"
        printf '  Path: %s\n' "$(gar_app_format_paths "$path")"
        if hint=$(lookup_install_hint "$name" 2>/dev/null); then
            printf '  Install: %s\n' "$hint"
        else
            printf '  Install: App Store or vendor site\n'
        fi
        printf '\n'
    done < <(read_manifest "$apps_manifest")
}

gar_name_eq() {
    [[ "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" == \
       "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" ]]
}

lookup_install_hint() {
    local query="$1" hints_file="${2:-$(gar_hints_file)}" name hint
    while IFS='|' read -r name hint; do
        if gar_name_eq "$query" "$name"; then
            printf '%s\n' "$hint"
            return 0
        fi
    done < <(read_manifest "$hints_file")
    return 1
}

gar_resolve_manifest() {
    local platform="$1" name="$2"
    if [[ -f "$GAR_DIR/$platform.$name" ]]; then
        printf '%s\n' "$GAR_DIR/$platform.$name"
    elif [[ -f "$GAR_DIR/shared.$name" ]]; then
        printf '%s\n' "$GAR_DIR/shared.$name"
    fi
}

gar_hints_file() {
    local platform manifest
    platform=$(detect_platform)
    manifest=$(gar_resolve_manifest "$platform" install-hints)
    if [[ -n "$manifest" && -f "$manifest" ]]; then
        printf '%s\n' "$manifest"
    else
        printf '%s\n' "$GAR_DIR/mac.install-hints"
    fi
}

gar_info_dirs() {
    # Platform-specific info first, then shared info (inherited). A
    # platform file with the same name shadows the shared one.
    local platform="$1"
    [[ -d "$GAR_DIR/$platform.info.d" ]] && printf '%s\n' "$GAR_DIR/$platform.info.d"
    [[ -d "$GAR_DIR/shared.info.d" ]] && printf '%s\n' "$GAR_DIR/shared.info.d"
}

# Platform default page for `gar info` with no name: gar.d/<platform>.info
# (missing or empty = no content).
gar_platform_info_file() {
    local platform="${1:-$(detect_platform)}"
    printf '%s\n' "$GAR_DIR/$platform.info"
}

lookup_platform_info() {
    local file
    file=$(gar_platform_info_file)
    [[ -f "$file" ]] || return 1
    # Treat empty / whitespace-only as no content.
    grep -q '[^[:space:]]' "$file" 2>/dev/null || return 1
    cat "$file"
}

lookup_general_info() {
    local query="$1" info_dir file base
    while IFS= read -r info_dir; do
        [[ -n "$info_dir" ]] || continue
        for file in "$info_dir"/*; do
            [[ -f "$file" ]] || continue
            base=$(basename "$file")
            if gar_name_eq "$query" "$base"; then
                cat "$file"
                return 0
            fi
        done
    done < <(gar_info_dirs "$(detect_platform)")
    return 1
}

gar_print_general_info() {
    local info="$1"
    printf '\nInfo:\n'
    printf '%s\n' "$info"
}

gar_hint_is_multiline() {
    [[ "$1" == *'\n'* ]]
}

gar_print_install_hint() {
    local label="$1" hint="$2"
    if gar_hint_is_multiline "$hint"; then
        printf '%s\n' "${label% }"
        printf '%b\n' "$hint"
    else
        printf '%s%s\n' "$label" "$hint"
    fi
}

# List platform + all role.* manifests for a capability (for lookups / info).
gar_all_capability_manifests() {
    local platform="$1" capability="$2" f
    if [[ -f "$GAR_DIR/$platform.$capability" ]]; then
        printf '%s\n' "$GAR_DIR/$platform.$capability"
    elif [[ -f "$GAR_DIR/shared.$capability" ]]; then
        printf '%s\n' "$GAR_DIR/shared.$capability"
    fi
    for f in "$GAR_DIR"/role.*."$capability"; do
        [[ -f "$f" ]] || continue
        printf '%s\n' "$f"
    done
}

# Split a manifest path field on '|' into candidate paths, one per line. An app
# entry may list several paths (name|path|path...); any existing one counts as
# installed.
gar_app_candidate_paths() {
    local field="$1" path
    while IFS= read -r path || [[ -n "$path" ]]; do
        [[ -n "$path" ]] && printf '%s\n' "$path"
    done < <(printf '%s' "$field" | tr '|' '\n')
}

# Print the first candidate path that exists on disk; return 1 if none do.
gar_app_first_existing_path() {
    local field="$1" path
    while IFS= read -r path; do
        [[ -e "$path" ]] && { printf '%s\n' "$path"; return 0; }
    done < <(gar_app_candidate_paths "$field")
    return 1
}

# Join candidate paths with " or " for display.
gar_app_format_paths() {
    local field="$1" path out=""
    while IFS= read -r path; do
        if [[ -z "$out" ]]; then
            out="$path"
        else
            out="$out or $path"
        fi
    done < <(gar_app_candidate_paths "$field")
    printf '%s\n' "$out"
}

lookup_app_entry() {
    local query="$1" entry name path manifest
    while IFS= read -r manifest; do
        while IFS= read -r entry; do
            name="${entry%%|*}"
            path="${entry#*|}"
            if gar_name_eq "$query" "$name"; then
                printf '%s|%s\n' "$name" "$path"
                return 0
            fi
        done < <(read_manifest "$manifest")
    done < <(gar_all_capability_manifests mac apps)
    return 1
}

gar_normalize_ext_id() {
    local id="$1"
    id="${id#\{}"
    id="${id%\}}"
    printf '%s\n' "$id"
}

lookup_browser_extension_entry() {
    local query="$1" browser ext_id label query_id ext_id_norm
    query_id=$(gar_normalize_ext_id "$query")
    while IFS='|' read -r browser ext_id label; do
        if gar_name_eq "$query" "$label" || gar_name_eq "$query" "$browser/$label"; then
            printf '%s|%s|%s\n' "$browser" "$ext_id" "$label"
            return 0
        fi
        ext_id_norm=$(gar_normalize_ext_id "$ext_id")
        if gar_name_eq "$query" "$ext_id" || gar_name_eq "$query_id" "$ext_id_norm"; then
            printf '%s|%s|%s\n' "$browser" "$ext_id" "$label"
            return 0
        fi
    done < <(read_manifest "$GAR_DIR/mac.browser-extensions")
    return 1
}

lookup_brew_hint() {
    local query="$1" line name manifest
    while IFS= read -r manifest; do
        while IFS= read -r line; do
            if [[ "$line" =~ ^brew[[:space:]]+\"([^\"]+)\" ]]; then
                name="${BASH_REMATCH[1]}"
                if gar_name_eq "$query" "$name"; then
                    printf 'brew install %s\n' "$name"
                    return 0
                fi
            elif [[ "$line" =~ ^cask[[:space:]]+\"([^\"]+)\" ]]; then
                name="${BASH_REMATCH[1]}"
                if gar_name_eq "$query" "$name"; then
                    printf 'brew install --cask %s\n' "$name"
                    return 0
                fi
            fi
        done < <(read_manifest "$manifest")
    done < <(gar_all_capability_manifests mac Brewfile)
    return 1
}

brew_miss_hint() {
    local item="$1"
    if [[ "$item" == *gdubw/gng* || "$item" == *"Formula gng"* ]]; then
        printf 'https://github.com/gdubw/gng — brew trust --formula gdubw/gng/gng && brew install gng\n'
        return 0
    fi
    return 1
}

cmd_info() {
    local query="$1" app_entry canonical path hint ext_entry browser ext_id label app_path app_found info

    if [[ -z "$query" ]]; then
        if info=$(lookup_platform_info); then
            printf '%s\n' "$info"
        fi
        exit 0
    fi

    if app_entry=$(lookup_app_entry "$query"); then
        canonical="${app_entry%%|*}"
        path="${app_entry#*|}"
        printf '%s (app)\n' "$canonical"
        printf 'Expected path: %s\n' "$(gar_app_format_paths "$path")"
        if app_found=$(gar_app_first_existing_path "$path"); then
            printf 'Status: installed (%s)\n' "$app_found"
        else
            printf 'Status: not installed\n'
        fi
        if hint=$(lookup_install_hint "$query"); then
            gar_print_install_hint 'Install: ' "$hint"
        else
            printf 'Install: download from the vendor or App Store\n'
        fi
        if info=$(lookup_general_info "$query"); then
            gar_print_general_info "$info"
        fi
        exit 0
    fi

    if ext_entry=$(lookup_browser_extension_entry "$query"); then
        browser="${ext_entry%%|*}"
        ext_id="${ext_entry#*|}"
        ext_id="${ext_id%%|*}"
        label="${ext_entry##*|}"
        printf '%s (%s extension)\n' "$label" "$browser"
        printf 'Extension ID: %s\n' "$ext_id"
        app_path=$(mac_browser_app_path "$browser")
        if [[ -z "$app_path" || ! -e "$app_path" ]]; then
            printf 'Status: browser not installed'
            [[ -n "$app_path" ]] && printf ' (%s)' "$app_path"
            printf '\n'
        elif mac_browser_extension_installed "$browser" "$ext_id"; then
            printf 'Status: installed\n'
        else
            printf 'Status: not installed\n'
        fi
        if hint=$(lookup_install_hint "$label"); then
            gar_print_install_hint 'Install: ' "$hint"
        else
            printf 'Install: install from the browser extension store\n'
        fi
        if info=$(lookup_general_info "$query"); then
            gar_print_general_info "$info"
        fi
        exit 0
    fi

    if hint=$(lookup_install_hint "$query"); then
        printf '%s\n' "$query"
        gar_print_install_hint 'Install: ' "$hint"
        if info=$(lookup_general_info "$query"); then
            gar_print_general_info "$info"
        fi
        exit 0
    fi

    if hint=$(lookup_brew_hint "$query"); then
        printf '%s (brew)\n' "$query"
        printf 'Install: %s\n' "$hint"
        if info=$(lookup_general_info "$query"); then
            gar_print_general_info "$info"
        fi
        exit 0
    fi

    if info=$(lookup_general_info "$query"); then
        printf '%s\n' "$query"
        gar_print_general_info "$info"
        exit 0
    fi

    echo "No gar entry for: $query" >&2
    exit 1
}

detect_platform() {
    if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
        printf '%s\n' wsl
    elif [[ "$(uname -s)" == "Darwin" ]]; then
        printf '%s\n' mac
    elif [[ "$(uname -a)" == *[Ss]ynology* ]]; then
        printf '%s\n' synology
    elif [[ "$(uname -s)" == "Linux" ]]; then
        printf '%s\n' linux
    else
        printf '%s\n' unknown
    fi
}

gar_roles_file() {
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/gar/roles"
}

gar_role_is_known() {
    local role="$1" f
    for f in "$GAR_DIR"/role."$role".*; do
        [[ -e "$f" ]] || continue
        [[ -f "$f" ]] && return 0
    done
    return 1
}

# Emit known role ids (unique, sorted) from gar.d/role.<id>.* manifests.
gar_known_roles() {
    local f base rest role
    for f in "$GAR_DIR"/role.*; do
        [[ -f "$f" ]] || continue
        base=$(basename "$f")
        rest="${base#role.}"
        role="${rest%.*}"
        [[ -n "$role" && "$role" != "$rest" ]] || continue
        printf '%s\n' "$role"
    done | sort -u
}

gar_role_is_active() {
    local role="$1" r
    for r in "${gar_active_roles[@]}"; do
        [[ "$r" == "$role" ]] && return 0
    done
    return 1
}

cmd_roles() {
    local role
    detect_roles
    while IFS= read -r role; do
        [[ -n "$role" ]] || continue
        if gar_role_is_active "$role"; then
            printf '✓ %s\n' "$role"
        else
            printf '  %s\n' "$role"
        fi
    done < <(gar_known_roles)
}

detect_roles() {
    local file line
    gar_active_roles=()
    file=$(gar_roles_file)
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -n "$line" ]] || continue
        gar_active_roles+=("$line")
    done <"$file"
}

gar_format_roles() {
    if (( ${#gar_active_roles[@]} == 0 )); then
        printf '(none)'
        return
    fi
    local IFS=,
    printf '%s' "${gar_active_roles[*]}"
}

gar_warn_unknown_roles() {
    local role
    for role in "${gar_active_roles[@]}"; do
        if ! gar_role_is_known "$role"; then
            printf 'WARN Unknown role: %s (no gar.d/role.%s.* manifests)\n' "$role" "$role"
        fi
    done
}

# Concatenate role.<role>.<capability> for each active role into a temp file.
# Writes under gar_tmpdir; call gar_init_workdir first.
gar_collect_role_manifest() {
    local capability="$1" out role f
    out="$gar_tmpdir/role.$capability"
    : >"$out"
    for role in "${gar_active_roles[@]}"; do
        f="$GAR_DIR/role.$role.$capability"
        if [[ -f "$f" ]]; then
            cat "$f" >>"$out"
            printf '\n' >>"$out"
        fi
    done
    printf '%s\n' "$out"
}

# Platform/shared base plus active role overlays for one capability name.
gar_combined_capability_manifest() {
    local platform="$1" capability="$2" base role_file out
    out="$gar_tmpdir/combined.$capability"
    : >"$out"
    base=$(gar_resolve_manifest "$platform" "$capability")
    if [[ -n "$base" && -f "$base" ]]; then
        cat "$base" >>"$out"
        printf '\n' >>"$out"
    fi
    role_file=$(gar_collect_role_manifest "$capability")
    if [[ -n "$role_file" && -f "$role_file" && -s "$role_file" ]]; then
        cat "$role_file" >>"$out"
    fi
    printf '%s\n' "$out"
}

read_manifest() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -n "$line" ]] || continue
        printf '%s\n' "$line"
    done <"$file"
}

gar_section_begin() {
    gar_section_name="$1"
    gar_section_header_printed=0
}

gar_section_emit_header() {
    if (( gar_section_header_printed == 0 )); then
        printf '\n%s\n' "$gar_section_name"
        gar_section_header_printed=1
    fi
}

report_ok() {
    if (( gar_show_all )); then
        gar_section_emit_header
        printf 'OK   %s\n' "$1"
    fi
}

report_miss() {
    gar_section_emit_header
    printf 'MISS %s\n' "$1"
    issues=$((issues + 1))
}

report_warn() {
    gar_section_emit_header
    printf 'WARN %s\n' "$1"
}

gar_expand_home() {
    local path="$1"
    path="${path//\$HOME/$HOME}"
    printf '%s\n' "$path"
}

gar_path_seen() {
    local needle="$1" seen
    for seen in "${@:2}"; do
        [[ "$seen" == "$needle" ]] && return 0
    done
    return 1
}

gar_repo_dirty() {
    local repo="$1"
    [[ -d "$repo/.git" ]] || return 1
    [[ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]]
}

gar_repo_current_branch() {
    local repo="$1"
    [[ -d "$repo/.git" ]] || return 1
    git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null
}

gar_repo_pull_main() {
    local repo="$1"
    git -C "$repo" pull -r origin main
}

gar_can_prompt() {
    [[ -r /dev/tty ]] || [[ -t 0 ]]
}

# Prompt Y/n (default Y). Optional second arg: help text printed when the user
# answers "?"; when set, the prompt suffix is [Y/n/?-Print install command].
gar_prompt_yn() {
    local prompt="$1" help="${2:-}" reply input suffix
    if [[ -r /dev/tty ]]; then
        input=/dev/tty
    elif [[ -t 0 ]]; then
        input=/dev/stdin
    else
        return 1
    fi

    if [[ -n "$help" ]]; then
        suffix='[Y/n/?-Print install command]'
    else
        suffix='[Y/n]'
    fi

    while true; do
        printf '%s %s ' "$prompt" "$suffix" >&2
        if ! IFS= read -r reply <"$input"; then
            return 1
        fi
        reply="${reply//$'\r'/}"
        reply="${reply#"${reply%%[![:space:]]*}"}"
        reply="${reply%"${reply##*[![:space:]]}"}"
        [[ -n "$reply" ]] || reply=Y
        case "$reply" in
            [Yy]|[Yy][Ee][Ss]) return 0 ;;
            [Nn]|[Nn][Oo]) return 1 ;;
            \?)
                if [[ -n "$help" ]]; then
                    printf '%s\n' "$help" >&2
                else
                    printf 'Please answer Y or n.\n' >&2
                fi
                ;;
            *)
                if [[ -n "$help" ]]; then
                    printf 'Please answer Y, n, or ?.\n' >&2
                else
                    printf 'Please answer Y or n.\n' >&2
                fi
                ;;
        esac
    done
}

gar_repo_main_unpushed_count() {
    local repo="$1" ahead
    [[ -d "$repo/.git" ]] || return 1
    git -C "$repo" rev-parse --verify main >/dev/null 2>&1 || return 1
    git -C "$repo" rev-parse --verify origin/main >/dev/null 2>&1 || return 1
    ahead=$(git -C "$repo" rev-list --count origin/main..main 2>/dev/null) || return 1
    (( ahead > 0 )) || return 1
    printf '%s\n' "$ahead"
}

gar_repo_main_behind_count() {
    local repo="$1" behind
    [[ -d "$repo/.git" ]] || return 1
    git -C "$repo" rev-parse --verify main >/dev/null 2>&1 || return 1
    git -C "$repo" rev-parse --verify origin/main >/dev/null 2>&1 || return 1
    behind=$(git -C "$repo" rev-list --count main..origin/main 2>/dev/null) || return 1
    (( behind > 0 )) || return 1
    printf '%s\n' "$behind"
}

gar_repo_try_fetch_main() {
    local repo="$1"
    [[ -d "$repo/.git" ]] || return 1
    git -C "$repo" rev-parse --verify main >/dev/null 2>&1 || return 1
    git -C "$repo" remote get-url origin >/dev/null 2>&1 || return 1
    git -C "$repo" fetch --quiet origin main 2>/dev/null || return 1
    git -C "$repo" rev-parse --verify origin/main >/dev/null 2>&1
}

gar_machine_env_skip_name() {
    local skip_manifest="$1" want="$2" name
    [[ -n "$skip_manifest" && -f "$skip_manifest" ]] || return 1
    while IFS= read -r name; do
        [[ "$name" == "$want" ]] && return 0
    done < <(read_manifest "$skip_manifest")
    return 1
}

gar_machine_env_list_repos() {
    local repos_manifest="$1" skip_manifest="${2:-}" entry name path setup_dir setup_name seen=()
    while IFS='|' read -r name path; do
        if gar_machine_env_skip_name "$skip_manifest" "$name"; then
            continue
        fi
        path=$(gar_expand_home "$path")
        if gar_path_seen "$path" "${seen[@]}"; then
            continue
        fi
        seen+=("$path")
        printf '%s|%s\n' "$name" "$path"
    done < <(read_manifest "$repos_manifest")

    for setup_dir in "$HOME"/Yew/*-setup; do
        [[ -d "$setup_dir" ]] || continue
        [[ -d "$setup_dir/.git" ]] || continue
        setup_name=$(basename "$setup_dir")
        if gar_machine_env_skip_name "$skip_manifest" "$setup_name"; then
            continue
        fi
        if gar_path_seen "$setup_dir" "${seen[@]}"; then
            continue
        fi
        seen+=("$setup_dir")
        printf '%s|%s\n' "$setup_name" "$setup_dir"
    done
}

gar_machine_env_prefetch_repo() {
    local name="$1" path="$2" result_file="$3" ahead behind fetched=0
    {
        printf 'name=%s\npath=%s\n' "$name" "$path"
        if [[ ! -d "$path" ]]; then
            printf 'status=missing\n'
            exit 0
        fi
        if [[ ! -d "$path/.git" ]]; then
            printf 'status=not-git\n'
            exit 0
        fi
        printf 'status=ok\n'
        branch=$(gar_repo_current_branch "$path" 2>/dev/null) || branch=""
        printf 'branch=%s\n' "$branch"
        if gar_repo_dirty "$path"; then
            printf 'dirty=1\n'
        else
            printf 'dirty=0\n'
        fi
        if gar_repo_try_fetch_main "$path"; then
            fetched=1
            printf 'fetched=1\n'
        else
            printf 'fetched=0\n'
        fi
        if ahead=$(gar_repo_main_unpushed_count "$path" 2>/dev/null); then
            printf 'ahead=%s\n' "$ahead"
        else
            printf 'ahead=0\n'
        fi
        behind=0
        if (( fetched )) && behind=$(gar_repo_main_behind_count "$path" 2>/dev/null); then
            printf 'behind=%s\n' "$behind"
        else
            printf 'behind=0\n'
        fi
    } >"$result_file"
}

gar_machine_env_prefetch_all() {
    local repos_manifest="$1" skip_manifest="${2:-}" name path slug result_file
    mkdir -p "$gar_tmpdir/repos"
    while IFS='|' read -r name path; do
        slug=$(gar_path_slug "$path")
        result_file="$gar_tmpdir/repos/$slug"
        gar_machine_env_prefetch_repo "$name" "$path" "$result_file" &
    done < <(gar_machine_env_list_repos "$repos_manifest" "$skip_manifest")
    wait
}

report_machine_env_repo() {
    local name="$1" path="$2" result_file="$3"
    local status dirty ahead behind fetched issues_found=0
    status=$(gar_result_get "$result_file" status)
    case "$status" in
        missing)
            report_miss "Machine env repo $name ($path — missing)"
            return
            ;;
        not-git)
            report_miss "Machine env repo $name ($path — not a git repo)"
            return
            ;;
    esac
    dirty=$(gar_result_get "$result_file" dirty)
    if [[ "$dirty" == 1 ]]; then
        report_warn "Machine env repo $name ($path — uncommitted changes)"
        issues_found=1
    fi
    ahead=$(gar_result_get "$result_file" ahead)
    if [[ "$ahead" =~ ^[0-9]+$ && "$ahead" -gt 0 ]]; then
        if (( ahead == 1 )); then
            report_warn "Machine env repo $name ($path — 1 unpushed commit on main)"
        else
            report_warn "Machine env repo $name ($path — $ahead unpushed commits on main)"
        fi
        issues_found=1
    fi
    fetched=$(gar_result_get "$result_file" fetched)
    behind=$(gar_result_get "$result_file" behind)
    if [[ "$fetched" == 1 && "$behind" =~ ^[0-9]+$ && "$behind" -gt 0 ]]; then
        if (( behind == 1 )); then
            report_warn "Machine env repo $name ($path — pull would update main; 1 commit behind origin/main)"
        else
            report_warn "Machine env repo $name ($path — pull would update main; $behind commits behind origin/main)"
        fi
        issues_found=1
    fi
    if (( issues_found == 0 )); then
        report_ok "Machine env repo $name ($path)"
    fi
}

offer_machine_env_repo_pull() {
    local name="$1" path="$2" result_file="$3"
    local status dirty branch fetched behind ahead prompt

    gar_can_prompt || return 0

    status=$(gar_result_get "$result_file" status)
    [[ "$status" == ok ]] || return 0

    dirty=$(gar_result_get "$result_file" dirty)
    [[ "$dirty" == 0 ]] || return 0

    branch=$(gar_result_get "$result_file" branch)
    [[ "$branch" == main ]] || return 0

    fetched=$(gar_result_get "$result_file" fetched)
    behind=$(gar_result_get "$result_file" behind)
    if [[ "$fetched" != 1 ]]; then
        if ! gar_repo_try_fetch_main "$path"; then
            return 0
        fi
        behind=0
        behind=$(gar_repo_main_behind_count "$path" 2>/dev/null) || behind=0
    fi
    [[ "$behind" =~ ^[0-9]+$ && "$behind" -gt 0 ]] || return 0

    ahead=$(gar_result_get "$result_file" ahead)
    [[ "$ahead" =~ ^[0-9]+$ ]] || ahead=0

    if (( behind == 1 )); then
        prompt="Pull $name ($path; 1 commit behind origin/main"
    else
        prompt="Pull $name ($path; $behind commits behind origin/main"
    fi
    if (( ahead > 0 )); then
        if (( ahead == 1 )); then
            prompt+=", 1 unpushed commit"
        else
            prompt+=", $ahead unpushed commits"
        fi
    fi
    prompt+=")?"

    if gar_prompt_yn "$prompt"; then
        if gar_repo_pull_main "$path"; then
            printf 'Updated %s (%s)\n' "$name" "$path"
        else
            report_warn "Machine env repo $name ($path — pull failed)"
        fi
    fi
}

check_machine_env_repos() {
    local repos_manifest="$1" skip_manifest="${2:-}" name path slug result_file
    gar_machine_env_prefetch_all "$repos_manifest" "$skip_manifest"
    while IFS='|' read -r name path; do
        slug=$(gar_path_slug "$path")
        result_file="$gar_tmpdir/repos/$slug"
        report_machine_env_repo "$name" "$path" "$result_file"
        offer_machine_env_repo_pull "$name" "$path" "$result_file"
    done < <(gar_machine_env_list_repos "$repos_manifest" "$skip_manifest")
}

check_git_config() {
    local config_manifest="$1" hints_file="$2" key val hint
    if ! command -v git >/dev/null 2>&1; then
        report_miss "Git (not on PATH)"
        return
    fi
    while IFS= read -r key; do
        val=$(git config --global --get "$key" 2>/dev/null || true)
        if [[ -n "$val" ]]; then
            report_ok "Git config $key ($val)"
        else
            hint=$(lookup_install_hint "$key" "$hints_file" 2>/dev/null || true)
            if [[ -n "$hint" ]]; then
                report_miss "Git config $key ($hint)"
            else
                report_miss "Git config $key (not set; run: git config --global $key VALUE)"
            fi
        fi
    done < <(read_manifest "$config_manifest")
}

