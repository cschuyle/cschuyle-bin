# Classify a docker endpoint/context name as Docker Desktop, Rancher Desktop, or other.
def gar_docker_classify(text):
    path = text[len("unix://"):] if text.startswith("unix://") else text
    if path.startswith("~"):
        path = HOME + path[1:]
    if "rancher-desktop" in text or path == HOME + "/.rd/docker.sock" or path.endswith("/.rd/docker.sock"):
        return "Rancher Desktop"
    if ("desktop-linux" in text or path == HOME + "/.docker/run/docker.sock"
            or path.endswith("/.docker/run/docker.sock")):
        return "Docker Desktop"
    if path == "/var/run/docker.sock":
        if os.path.islink("/var/run/docker.sock"):
            try:
                target = os.readlink("/var/run/docker.sock")
            except OSError:
                target = ""
            return gar_docker_classify(target)
        return "default socket"
    return "other"


# Print which Docker engine the CLI currently targets (context / DOCKER_HOST).
def gar_print_docker_configured():
    out("\nConfigured:")
    docker_host = os.environ.get("DOCKER_HOST")
    if docker_host is not None and docker_host != "":
        out(f"  DOCKER_HOST: {docker_host} ({gar_docker_classify(docker_host)}) — overrides docker context")
    else:
        out("  DOCKER_HOST: (unset)")

    saved_ctx = ""
    cfg = os.path.join(HOME, ".docker", "config.json")
    if os.path.isfile(cfg):
        try:
            with open(cfg) as f:
                saved_ctx = json.load(f).get("currentContext") or ""
        except Exception:
            saved_ctx = ""

    docker_bin = which("docker")
    if docker_bin:
        _, ctx = run([docker_bin, "context", "show"])
        _, endpoint = run([docker_bin, "context", "inspect", ctx, "-f", "{{.Endpoints.docker.Host}}"])
        if ctx:
            ctx_engine = gar_docker_classify(endpoint or ctx)
            if endpoint:
                out(f"  active context: {ctx} → {endpoint} ({ctx_engine})")
            else:
                out(f"  active context: {ctx} ({ctx_engine})")
        else:
            out("  active context: (could not read)")
        if saved_ctx and saved_ctx != ctx:
            out(f"  saved context: {saved_ctx} (in ~/.docker/config.json)")
        out("  contexts:")
        _, ls = run([docker_bin, "context", "ls", "--format", "{{.Name}}|{{.Current}}|{{.DockerEndpoint}}"])
        for line in ls.split("\n"):
            name, current, ep = split_fields(line, 3)
            if not name:
                continue
            ctx_engine = gar_docker_classify(ep or name)
            mark = "    * " if current == "true" else "      "
            out(f"{mark}{name} → {ep or '?'} ({ctx_engine})")
    else:
        out("  docker: not on PATH (cannot read context)")
        if saved_ctx:
            out(f"  saved context: {saved_ctx} ({gar_docker_classify(saved_ctx)})")

    installed = []
    if os.path.exists("/Applications/Docker.app"):
        installed.append("Docker Desktop")
    if os.path.exists("/Applications/Rancher Desktop.app"):
        installed.append("Rancher Desktop")
    out(f"  engines installed: {', '.join(installed) or '(none)'}")


