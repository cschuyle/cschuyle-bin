def mac_iterm_installed():
    return os.path.isdir("/Applications/iTerm.app")


def mac_iterm_dynamic_profiles_dir():
    return os.path.join(HOME, "Library", "Application Support", "iTerm2", "DynamicProfiles")


# The Dynamic Profiles file gar itself writes to when creating a profile (see
# offer_fix_iterm_profiles). iTerm watches its DynamicProfiles directory and
# reloads it live — no restart needed, and unlike "New Bookmarks" (which iTerm
# may rewrite wholesale on quit) it can't be clobbered by a running iTerm.
def mac_iterm_gar_profiles_file():
    return os.path.join(mac_iterm_dynamic_profiles_dir(), "gar.json")


# The "New Bookmarks" array: old-style NeXTSTEP plist text from `defaults read`,
# converted to XML so it can hold arbitrary <data> fields that plutil's JSON
# converter rejects. None if it can't be read.
def _mac_iterm_bookmarks():
    rc, raw = run_bytes(["defaults", "read", "com.googlecode.iterm2", "New Bookmarks"])
    if rc != 0:
        return None
    rc, xml = run_bytes(["plutil", "-convert", "xml1", "-o", "-", "-"], input=raw)
    if rc != 0:
        return None
    try:
        return plistlib.loads(xml)
    except Exception:
        return None


# iTerm profile names: the "New Bookmarks" array plus every *.json file under
# the DynamicProfiles directory.
def mac_iterm_profile_names():
    names = []
    for bookmark in _mac_iterm_bookmarks() or []:
        if isinstance(bookmark, dict) and bookmark.get("Name"):
            names.append(bookmark["Name"])
    dyn_dir = mac_iterm_dynamic_profiles_dir()
    for fname in _sorted_listdir(dyn_dir):
        if not fname.endswith(".json"):
            continue
        try:
            with open(os.path.join(dyn_dir, fname)) as f:
                data = json.load(f)
            for profile in data.get("Profiles", []) or []:
                if isinstance(profile, dict) and profile.get("Name"):
                    names.append(profile["Name"])
        except Exception:
            continue
    return names


# Clone iTerm profile source_name (by Name, looked up in "New Bookmarks") into
# the gar-managed Dynamic Profiles file under new_name, upserting by a
# deterministic Guid so re-running is idempotent rather than piling up
# duplicates. False if the source profile doesn't exist or a profile value
# can't round-trip through JSON.
def mac_iterm_create_profile(source_name, new_name):
    out_path = Path(mac_iterm_gar_profiles_file())
    profiles = _mac_iterm_bookmarks()
    if profiles is None:
        return False
    source = next((p for p in profiles if isinstance(p, dict) and p.get("Name") == source_name), None)
    if source is None:
        return False
    clone = dict(source)
    clone["Name"] = new_name
    clone["Guid"] = "gar-" + new_name.lower()

    existing = {"Profiles": []}
    if out_path.is_file():
        try:
            existing = json.loads(out_path.read_text())
        except Exception:
            existing = {"Profiles": []}
    existing.setdefault("Profiles", [])
    existing["Profiles"] = [p for p in existing["Profiles"]
                            if isinstance(p, dict) and p.get("Guid") != clone["Guid"]]
    existing["Profiles"].append(clone)
    try:
        out_path.parent.mkdir(parents=True, exist_ok=True)
        text = json.dumps(existing, indent=2, sort_keys=True) + "\n"
    except TypeError as exc:
        err(f"could not serialize profile: {exc}")
        return False
    except OSError:
        return False
    try:
        out_path.write_text(text)
    except OSError:
        return False
    return True


def mac_czech_qwerty_enabled():
    return "Czech-QWERTY" in run(["defaults", "read", "com.apple.HIToolbox", "AppleEnabledInputSources"])[1]


# (char, keycode, modifier, enabled) for a com.apple.symbolichotkeys entry: char
# is parameter 1 (typed character, or 65535 for a keycode-only binding), keycode
# is parameter 2 (virtual key code), and modifier is parameter 3 (mask; Command
# is 1048576). None when the hotkey has no entry or can't be read.
def mac_read_symbolic_hotkey(hk):
    fd, tmp = tempfile.mkstemp()
    os.close(fd)
    try:
        if run(["defaults", "export", "com.apple.symbolichotkeys", tmp])[0] != 0:
            return None
        try:
            with open(tmp, "rb") as f:
                data = plistlib.load(f)
        except Exception:
            return None
    finally:
        os.remove(tmp)
    hotkeys = data.get("AppleSymbolicHotKeys") or {}
    entry = hotkeys.get(hk)
    if entry is None and hk.isdigit():
        entry = hotkeys.get(int(hk))
    if not isinstance(entry, dict):
        return None
    params = (entry.get("value") or {}).get("parameters") or []
    get = lambda i: params[i] if len(params) > i else -1
    return get(0), get(1), get(2), 1 if entry.get("enabled") else 0


def mac_name_strip_local_suffix(name):
    return name[:-len(".local")] if name.endswith(".local") else name


def mac_name_looks_system_assigned(name):
    if not name:
        return False
    name = mac_name_strip_local_suffix(name)
    models = "MacBook-Air|MacBook-Pro|Mac-mini|Mac-Studio|Mac-Pro|iMac|MacBook"
    if re.match(rf"^[A-Za-z0-9][A-Za-z0-9-]*s-({models})$", name):
        return True
    if re.match(rf"^({models})$", name):
        return True
    name = name.replace("\u2019", "'")
    for model in ("'s MacBook Air", "'s MacBook Pro", "'s Mac mini", "'s Mac Studio",
                  "'s Mac Pro", "'s iMac", "'s MacBook"):
        if name.endswith(model):
            return True
    return False


def _scutil_get(key):
    rc, v = run(["scutil", "--get", key])
    return v if rc == 0 else ""


def _hostname():
    rc, v = run(["hostname"])
    return v if rc == 0 else ""


def mac_machine_name_primary():
    lh = _scutil_get("LocalHostName")
    cn = _scutil_get("ComputerName")
    host = _hostname()
    if lh:
        return lh
    if cn:
        return cn
    if host:
        return mac_name_strip_local_suffix(host)
    return ""


def mac_machine_name_is_system_assigned():
    vals = [_scutil_get("ComputerName"), _scutil_get("LocalHostName"), _scutil_get("HostName"), _hostname()]
    return any(mac_name_looks_system_assigned(v) for v in vals)


def gar_setting_matches(actual, expected, compare="eq"):
    if compare == "eq":
        return actual == expected
    if compare == "at_most":
        return (re.fullmatch(r"[0-9]+", actual) is not None and re.fullmatch(r"[0-9]+", expected) is not None
                and int(actual) <= int(expected))
    return False


def gar_defaults_write(location, key, value):
    if re.fullmatch(r"-?[0-9]+", value):
        flag = "-int"
    elif value in ("true", "false"):
        flag = "-bool"
    else:
        flag = "-string"
    if location == "global":
        return run_ok(["defaults", "write", "-g", key, flag, value])
    return run_ok(["defaults", "write", gar_expand_home(location), key, flag, value])


# Tracks defaults keys whose fix is written immediately but doesn't take
# visible/live effect until a restart (currently just fnState). One key per
# line; self-heals by dropping the whole file once a restart is detected.
def gar_pending_restart_file():
    return os.path.join(gar_config_base(), "pending-restart")


def _file_lines(path):
    try:
        return read_text(path).split("\n")
    except OSError:
        return []


def gar_mark_pending_restart(key):
    f = gar_pending_restart_file()
    try:
        os.makedirs(os.path.dirname(f), exist_ok=True)
        if key in _file_lines(f):
            return True
        with open(f, "a") as fh:
            fh.write(key + "\n")
    except OSError:
        return False
    return True


def gar_pending_restart_active(key):
    f = gar_pending_restart_file()
    if not os.path.isfile(f):
        return False
    _, boottime = run(["sysctl", "-n", "kern.boottime"])
    m = re.match(r"^\{ sec = ([0-9]+)", boottime)
    try:
        file_epoch = int(os.stat(f).st_mtime)
    except OSError:
        file_epoch = None
    if not m or file_epoch is None or file_epoch < int(m.group(1)):
        try:
            os.remove(f)
        except OSError:
            pass
        return False
    return key in _file_lines(f)


def mac_write_json_setting(path, key, raw):
    try:
        p = Path(path)
        if raw in ("true", "false") or re.fullmatch(r"-?\d+", raw):
            literal = raw
        else:
            literal = json.dumps(raw)

        text = p.read_text() if p.exists() else ""

        if text.strip() == "" or re.fullmatch(r"\s*\{\s*\}\s*", text):
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(f"{{\n    {json.dumps(key)}: {literal}\n}}\n")
            return True

        # Replace the existing value in place, preserving comments/formatting.
        pattern = re.compile(
            r'("' + re.escape(key) + r'"\s*:\s*)'
            r'("(?:[^"\\]|\\.)*"|true|false|null|-?\d+(?:\.\d+)?)'
        )
        new_text, n = pattern.subn(lambda m: m.group(1) + literal, text, count=1)
        if n:
            p.write_text(new_text)
            return True

        # Key absent: insert it right after the opening brace.
        idx = text.find("{")
        if idx == -1:
            return False
        p.write_text(f"{text[:idx + 1]}\n    {json.dumps(key)}: {literal},{text[idx + 1:]}")
        return True
    except OSError:
        return False


