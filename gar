# osascript blocks indefinitely if macOS is showing an Automation permission
# prompt (e.g. "Terminal wants to control System Events") that never gets
# answered, so bound the wait rather than hang gar. None on failure.
def mac_login_items_raw():
    rc, items = run(["osascript", "-e", 'tell application "System Events" to get the name of every login item'],
                    timeout=5)
    return items if rc == 0 else None


def check_mac_login_items(login_lines):
    items_raw = mac_login_items_raw()
    if items_raw is None:
        report_warn("Login items (could not read; allow Terminal or gar to control System Events)")
        return
    listed = {i.strip() for i in items_raw.split(",")} - {""}

    for entry in login_lines:
        label, names_field = split_entry(entry)
        candidates = gar_app_candidate_paths(names_field)
        if not label or not names_field or label == entry or not candidates:
            report_miss(f"Login item manifest line (expected label|name[|name...]): {entry}")
            continue
        matched = [n for n in candidates if n in listed]

        if len(candidates) == 1:
            if matched:
                report_ok(f"Login item {label}")
            else:
                report_miss(f"Login item {label} (add {names_field} in System Settings → General → Login Items)")
            continue

        fmt = gar_app_format_paths(names_field)
        if len(matched) == 1:
            report_ok(f"Login item {label} ({matched[0]})")
        elif not matched:
            report_miss(f"Login item {label} (add exactly one of: {fmt} in System Settings → General → Login Items)")
        else:
            report_miss(f"Login item {label} (exactly one of: {fmt}; found: {', '.join(matched)})")


