    ((${#dyn_files[@]} > 0)) || return 0

    python3 -c '
import json
import sys

for path in sys.argv[1:]:
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        continue
    for profile in data.get("Profiles", []) or []:
        if isinstance(profile, dict):
            name = profile.get("Name")
            if name:
