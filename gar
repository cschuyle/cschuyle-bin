gar_pending_restart_active() {
    local key="$1" file boot_epoch file_epoch
    file=$(gar_pending_restart_file)
    [[ -f "$file" ]] || return 1
    boot_epoch=$(sysctl -n kern.boottime 2>/dev/null | sed -E 's/^\{ sec = ([0-9]+).*/\1/')
    file_epoch=$(stat -f %m "$file" 2>/dev/null)
    if [[ -z "$boot_epoch" || -z "$file_epoch" || "$file_epoch" -lt "$boot_epoch" ]]; then
        rm -f "$file"
        return 1
    fi
    grep -qxF "$key" "$file" 2>/dev/null
}

mac_write_json_setting() {
    local file="$1" key="$2" value="$3"
    python3 - "$file" "$key" "$value" <<'PY'
import json
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
key = sys.argv[2]
raw = sys.argv[3]

if raw in ("true", "false") or re.fullmatch(r"-?\d+", raw):
    literal = raw
else:
    literal = json.dumps(raw)

text = path.read_text() if path.exists() else ""

if text.strip() == "" or re.fullmatch(r"\s*\{\s*\}\s*", text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("{\n    %s: %s\n}\n" % (json.dumps(key), literal))
    raise SystemExit(0)

# Replace the existing value in place, preserving comments/formatting.
pattern = re.compile(
    r'("' + re.escape(key) + r'"\s*:\s*)'
    r'("(?:[^"\\]|\\.)*"|true|false|null|-?\d+(?:\.\d+)?)'
)
new_text, n = pattern.subn(lambda m: m.group(1) + literal, text, count=1)
if n:
    path.write_text(new_text)
    raise SystemExit(0)

# Key absent: insert it right after the opening brace.
idx = text.find("{")
if idx == -1:
    raise SystemExit(1)
path.write_text(
    "%s\n    %s: %s,%s" % (text[:idx + 1], json.dumps(key), literal, text[idx + 1:])
)
raise SystemExit(0)
PY
}

