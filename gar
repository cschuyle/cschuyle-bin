}

gar_mark_pending_restart() {
    local key="$1" file
    file=$(gar_pending_restart_file)
    mkdir -p "$(dirname "$file")" 2>/dev/null || return 1
    grep -qxF "$key" "$file" 2>/dev/null && return 0
    printf '%s\n' "$key" >>"$file"
