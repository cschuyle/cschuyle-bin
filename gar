def main(argv):
    global gar_show_all, issues
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except AttributeError:
        pass
    orig_args = list(argv)

    if argv[:1] == ["info"]:
        cmd_info(argv[1] if len(argv) > 1 else "")
        return 0
    if argv[:1] == ["apps"]:
        cmd_apps(argv[1:])
        return 0
    if argv[:1] == ["roles"]:
        cmd_roles(argv[1:])
        return 0

    for a in argv:
        if a in ("-h", "--help", "--man"):
            usage()
            return 0
        elif a in ("-a", "--all"):
            gar_show_all = True
        elif a in ("--extra-brew-leaves", "--extra-brew-requested"):
            detect_roles()
            cmd_extra_brew("leaves" if a == "--extra-brew-leaves" else "requested")
            return 0
        else:
            err(f"Unknown option: {a}")
            usage(sys.stderr)
            return 2

    platform = detect_platform()
    if not gar_preflight_config():
        return 2
    detect_roles()
    if not gar_recheck:
        out(f"gar: platform {platform}; roles {gar_format_roles()}")
        gar_warn_unknown_roles()

    gar_init_workdir()

    if platform == "mac":
        run_mac_checks()
    elif platform == "synology":
        run_synology_checks()
    elif platform == "wsl":
        run_wsl_checks()
    elif platform == "linux":
        out("\nOnly mac, synology, and wsl checks are implemented so far.")
        issues += 1
    else:
        report_miss("Unknown platform")

    out()

    # Fixes were applied: the findings above are stale, so re-run (no prompts)
    # and let that run's report and exit status stand as the result.
    if gar_fixed_issues + gar_fixed_warnings > 0:
        if gar_fixed_issues > 0:
            fixed = gar_plural(gar_fixed_issues, "issue")
        else:
            fixed = gar_plural(gar_fixed_warnings, "warning")
        out(f"Gar: Fixed {fixed}.\n\nAfter fixes:")
        sys.stdout.flush()
        env = dict(os.environ, GAR_RECHECK="1")
        return subprocess.run([sys.executable, SCRIPT] + orig_args, env=env).returncode

    warn_suffix = f". {gar_plural(warnings, 'warning')}." if warnings > 0 else ""
    if issues > 0:
        out(f"{issues} issue(s){warn_suffix}")
        return 1
    out(f"All checks passed{warn_suffix}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
