def offer_fix_mac_setting(kind, location, key, expected, label):
    if not gar_can_prompt():
        return

    if kind == "defaults":
        if not gar_prompt_yn(f"Fix {label}: set {key} to {expected}?"):
            return
        if gar_defaults_write(location, key, expected):
            if key == "com.apple.keyboard.fnState":
                gar_mark_pending_restart(key)
                out(f"Set {key} to {expected} (requires a full RESTART — not just logout — to take effect in System Settings and actual key behavior).")
            else:
                out(f"Set {key} to {expected} (may take effect after logout).")
            gar_note_fixed("warning")
        else:
            report_warn(f"Setting {label} (could not write {key})")
    elif kind == "json-editor":
        settings_path = mac_editor_settings_path(location)
        if not settings_path:
            return
        if not gar_prompt_yn(f"Fix {label}: set {key} to {expected} in {settings_path}?"):
            return
        if mac_write_json_setting(settings_path, key, expected):
