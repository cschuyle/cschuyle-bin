#!/usr/bin/env bash
# gar (garage): check this machine's configuration against desired state.
set -o pipefail

GAR_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/gar.d" && pwd)"
if [[ -z "$GAR_DIR" || ! -d "$GAR_DIR" || ! -r "$GAR_DIR" || ! -x "$GAR_DIR" ]]; then
    echo "gar: cannot access config dir gar.d next to the script (missing, broken, or unreadable)" >&2
    exit 2
fi
gar_show_all=0
gar_section_name=""
gar_section_header_printed=0
gar_tmpdir=""
gar_active_roles=()
warnings=0
# Interactive fixes applied this run, split by the severity of the finding they
# fixed (a MISS is an issue; a WARN is a warning). Any fix triggers a re-run in
# recheck mode (GAR_RECHECK=1: no prompts, no banner) to show what remains.
gar_fixed_issues=0
gar_fixed_warnings=0
gar_recheck="${GAR_RECHECK:-0}"
gar_section_lead=$'\n'
(( gar_recheck )) && gar_section_lead=""

# Bound network git operations (fetch/pull) so a stalled connection or an
# unanswered host-key/passphrase prompt fails within seconds instead of
# hanging gar indefinitely. Scoped to this process only (never touches the
# user's global git/ssh config); respects a caller-supplied GIT_SSH_COMMAND.
: "${GIT_SSH_COMMAND:=ssh -o ConnectTimeout=10 -o BatchMode=yes}"
export GIT_SSH_COMMAND
gar_git_net_opts=(-c http.lowSpeedLimit=1000 -c http.lowSpeedTime=15)

# --- Timing instrumentation -------------------------------------------------
# Every run writes a timing log to ~/.gar/timings/timings-<timestamp>.txt so a
# slow or hung run can be diagnosed after the fact without reproducing it live.
# START is written before an operation runs and END (with duration) after, so
# a hang shows up as a START with no matching END — the last line in the file
# names the stuck operation. Best-effort: a failure to create the dir/file
# silently disables logging rather than affecting gar's own exit status.
gar_timings_file=""

gar_timings_init() {
    local dir="$HOME/.gar/timings"
    mkdir -p "$dir" 2>/dev/null || return 0
    gar_timings_file="$dir/timings-$(date +%Y%m%d-%H%M%S).txt"
    : >"$gar_timings_file" 2>/dev/null || gar_timings_file=""
}

gar_timings_mark() {
    [[ -n "$gar_timings_file" ]] || return 0
    printf '%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1" "$2" "${3:--}" \
        >>"$gar_timings_file" 2>/dev/null
}

# gar_timed <label> <cmd...>: run cmd, recording START/END(+duration) lines
# for <label>. Preserves cmd's exit status. Safe to nest and to call from
# parallel background jobs (each mark is one small, effectively-atomic append).
gar_timed() {
    local label="$1"
    shift
    local start end dur status
    start=$(date +%s)
    gar_timings_mark START "$label"
    "$@"
    status=$?
    end=$(date +%s)
    dur=$((end - start))
    gar_timings_mark END "$label" "${dur}s"
    return "$status"
}

# Run a command with a hard wall-clock timeout, killing it (and returning its
# would-be exit status as failure) if it's still running after $1 seconds.
# ConnectTimeout/BatchMode/lowSpeedLimit (above) only guard the network
# transfer itself; this also catches a command stuck on something outside
# git's control, like a graphical Keychain-access prompt for a credential
# helper that never sends a byte. Only ever call this on operations that are
# safe to kill mid-flight (e.g. a plain `git fetch`, never `git pull`/`rebase`,
# which can be interrupted mid-rewrite and leave a repo half-rebased).
gar_run_with_timeout() {
    local secs="$1"
    shift
    "$@" &
    local pid=$!
    ( sleep "$secs"; kill -9 "$pid" 2>/dev/null ) >/dev/null 2>&1 &
    local watcher=$!
    wait "$pid" 2>/dev/null
    local status=$?
    kill "$watcher" 2>/dev/null
    wait "$watcher" 2>/dev/null
    return "$status"
}

# Machine-local manifest overlays (same XDG base as ~/.config/gar/roles).
gar_local_dir() {
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/gar/d"
}

# Emit existing manifest roots in order: repo gar.d, then local ~/.config/gar/d.
gar_manifest_dirs() {
    local local_dir
    printf '%s\n' "$GAR_DIR"
    local_dir=$(gar_local_dir)
    [[ -d "$local_dir" ]] && printf '%s\n' "$local_dir"
}

# gar_check_config_path <dir|file> <required|optional> <path>
# Returns 0 if OK (right type, or optional-and-absent); prints to stderr and
# returns 1 on: dangling symlink, wrong file type, or unreadable path. The
# -e/-d/-f guards below all follow symlinks and read false for a dangling
# symlink, so that case must be tested first to distinguish it from absence.
gar_check_config_path() {
    local kind="$1" mode="$2" path="$3"

    if [[ -L "$path" && ! -e "$path" ]]; then
        echo "gar: config path is a broken symlink: $path -> $(readlink "$path")" >&2
        return 1
    fi

    # Genuinely absent: OK for optional (intentional "no local config"),
    # an error for required (the repo's own gar.d).
    if [[ ! -e "$path" ]]; then
        if [[ "$mode" == required ]]; then
            echo "gar: required config path is missing: $path" >&2
            return 1
        fi
        return 0
    fi

    # Present: enforce the expected type.
    if [[ "$kind" == dir && ! -d "$path" ]]; then
        echo "gar: config path should be a directory but is not: $path" >&2
        return 1
    fi
    if [[ "$kind" == file && ! -f "$path" ]]; then
        echo "gar: config path should be a regular file but is not: $path" >&2
        return 1
    fi

    # Present and right type: require readability (dirs must also be searchable).
    if [[ ! -r "$path" ]] || { [[ "$kind" == dir ]] && [[ ! -x "$path" ]]; }; then
        echo "gar: config path is not readable: $path" >&2
        return 1
    fi

    return 0
}

# Fail fast on config paths that are broken rather than simply absent. Absence
# of a local (~/.config/gar) path is intentional and OK; a dangling symlink,
# wrong file type, or unreadable path is an unexpected setup error. Checks every
# path before returning so one run reports all problems.
gar_preflight_config() {
    local rc=0 local_base
    local_base="${XDG_CONFIG_HOME:-$HOME/.config}/gar"

    gar_check_config_path dir  required "$GAR_DIR"          || rc=1
    gar_check_config_path dir  optional "$local_base"       || rc=1
    gar_check_config_path dir  optional "$(gar_local_dir)"  || rc=1
    gar_check_config_path file optional "$(gar_roles_file)" || rc=1

    return $rc
}

gar_init_workdir() {
    gar_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/gar.XXXXXX")
    trap '[[ -n "$gar_tmpdir" ]] && rm -rf "$gar_tmpdir"' EXIT
    gar_timings_init
}

gar_path_slug() {
    printf '%s' "$1" | shasum | awk '{print $1}'
}

gar_result_get() {
    local file="$1" key="$2"
    [[ -f "$file" ]] || return 1
    awk -F= -v k="$key" '$1 == k { print $2; exit }' "$file"
}

usage() {
    cat <<'EOF'
Usage: gar [-ah]
       gar apps [-r <role>]
       gar info [name]
       gar roles [-a|--all]
       gar --man

Check the current machine's configuration against the desired state in gar.d/
and optional machine-local overlays in ~/.config/gar/d/.
Reports missing or out-of-date elements. Mac, Synology, and WSL checks are
implemented; plain Linux is detected but not yet audited.

Desired state is the platform/shared base plus an additive union of role
overlays enabled for this machine. Manifest roots are the repo gar.d/ then
~/.config/gar/d/ (if present); platform/shared files use first match (repo
preferred), role overlays from both roots are concatenated.

Roles
  Enable roles in ~/.config/gar/roles (one role id per line). A missing file
  means no roles are enabled. Blank lines and # comments are ignored.

  Example ~/.config/gar/roles:

    # overlays for this machine
    personal-machine
    my-data-client
    dev-tools

  Known role ids are listed by `gar roles` (those with role.<id>.* manifests
  in gar.d/ or ~/.config/gar/d/). Unknown ids in the roles file produce a WARN
  at audit time.

Options and commands
  -a, --all     Show all checks, including OK (default: only MISS and WARN)
  -h, --help, --man
                Show this help
  apps          List GUI apps tracked for this machine (platform base plus active
                role overlays). With -r <role>: only that role's apps overlay
                (role.<role>.apps under gar.d/ or ~/.config/gar/d/)
  info [name]   With no name: show the platform info page (<platform>.info under
                a manifest root; empty by default). With a name (case-insensitive):
                "brew" shows the full Homebrew audit section (like gar -a); a
                machine-env repo shows its git status (and, if not OK, why —
                local-mod count, branch/ahead/behind, plus any expected
                skip-worktree'd mods listed by file); a Homebrew formula/cask
                shows install status (OK installed up to date / WARN update
                available / MISS not installed); otherwise install hints and
                general info
  roles         List known role ids (role.<id>.* under gar.d/ or ~/.config/gar/d/);
                enabled roles are prefixed with "✓ " (others with two spaces).
                With -a/--all: also list each role's overlay contents (apps,
                Homebrew, commands, login items, env, secrets, repos, etc.)

Exit status: 0 if everything looks good, 1 if anything is missing.
EOF
}

cmd_apps() {
    local entry name path hint apps_manifest role="" role_file
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--role)
                if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                    echo "apps: -r requires a role id" >&2
                    exit 2
                fi
                role="$2"
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                echo "Unknown option for apps: $1" >&2
                usage >&2
                exit 2
                ;;
        esac
    done

    if [[ -n "$role" ]]; then
        if ! gar_role_is_known "$role"; then
            echo "Unknown role: $role" >&2
            exit 1
        fi
        gar_init_workdir
        role_file=$(gar_collect_role_manifest_for_role "$role" apps)
        if [[ ! -f "$role_file" || ! -s "$role_file" ]]; then
            printf 'No apps for role %s\n' "$role"
            return 0
        fi
        apps_manifest="$role_file"
        printf 'Tracked apps for role %s:\n\n' "$role"
    else
        detect_roles
        gar_init_workdir
        apps_manifest=$(gar_combined_capability_manifest mac apps)
        printf 'Tracked apps (installed outside Homebrew):\n\n'
    fi

    while IFS= read -r entry; do
        name="${entry%%|*}"
        path="${entry#*|}"
        printf '%s\n' "$name"
        printf '  Path: %s\n' "$(gar_app_format_paths "$path")"
        if hint=$(lookup_install_hint "$name" 2>/dev/null); then
            printf '  Install: %s\n' "$hint"
        else
            printf '  Install: App Store or vendor site\n'
        fi
        printf '\n'
    done < <(read_manifest "$apps_manifest")
}

gar_name_eq() {
    [[ "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" == \
       "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" ]]
}

lookup_install_hint() {
    local query="$1" hints_file="${2:-$(gar_hints_file)}" name hint
    while IFS='|' read -r name hint; do
        if gar_name_eq "$query" "$name"; then
            printf '%s\n' "$hint"
            return 0
        fi
    done < <(read_manifest "$hints_file")
    return 1
}

gar_resolve_manifest() {
    local platform="$1" name="$2" dir
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        if [[ -f "$dir/$platform.$name" ]]; then
            printf '%s\n' "$dir/$platform.$name"
            return 0
        fi
    done < <(gar_manifest_dirs)
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        if [[ -f "$dir/shared.$name" ]]; then
            printf '%s\n' "$dir/shared.$name"
            return 0
        fi
    done < <(gar_manifest_dirs)
}

gar_hints_file() {
    local platform manifest
    platform=$(detect_platform)
    manifest=$(gar_resolve_manifest "$platform" install-hints)
    if [[ -n "$manifest" && -f "$manifest" ]]; then
        printf '%s\n' "$manifest"
    else
        printf '%s\n' "$GAR_DIR/mac.install-hints"
    fi
}

gar_info_dirs() {
    # Platform-specific info first, then shared info (inherited), per manifest
    # root (repo then local). A platform file with the same name shadows shared.
    local platform="$1" dir
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        [[ -d "$dir/$platform.info.d" ]] && printf '%s\n' "$dir/$platform.info.d"
    done < <(gar_manifest_dirs)
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        [[ -d "$dir/shared.info.d" ]] && printf '%s\n' "$dir/shared.info.d"
    done < <(gar_manifest_dirs)
}

# Platform default page for `gar info` with no name: <platform>.info under a
# manifest root (first match; missing or empty = no content).
gar_platform_info_file() {
    local platform="${1:-$(detect_platform)}" dir
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        if [[ -f "$dir/$platform.info" ]]; then
            printf '%s\n' "$dir/$platform.info"
            return 0
        fi
    done < <(gar_manifest_dirs)
    printf '%s\n' "$GAR_DIR/$platform.info"
}

lookup_platform_info() {
    local file
    file=$(gar_platform_info_file)
    [[ -f "$file" ]] || return 1
    # Treat empty / whitespace-only as no content.
    grep -q '[^[:space:]]' "$file" 2>/dev/null || return 1
    cat "$file"
}

lookup_general_info() {
    local query="$1" info_dir file base
    while IFS= read -r info_dir; do
        [[ -n "$info_dir" ]] || continue
        for file in "$info_dir"/*; do
            [[ -f "$file" ]] || continue
            base=$(basename "$file")
            if gar_name_eq "$query" "$base"; then
                cat "$file"
                return 0
            fi
        done
    done < <(gar_info_dirs "$(detect_platform)")
    return 1
}

gar_print_general_info() {
    local info="$1"
    printf '\nInfo:\n'
    printf '%s\n' "$info"
}

gar_hint_is_multiline() {
    [[ "$1" == *'\n'* ]]
}

gar_print_install_hint() {
    local label="$1" hint="$2"
    if gar_hint_is_multiline "$hint"; then
        printf '%s\n' "${label% }"
        printf '%b\n' "$hint"
    else
        printf '%s%s\n' "$label" "$hint"
    fi
}

# List platform + all role.* manifests for a capability (for lookups / info).
gar_all_capability_manifests() {
    local platform="$1" capability="$2" dir f base
    base=$(gar_resolve_manifest "$platform" "$capability")
    [[ -n "$base" && -f "$base" ]] && printf '%s\n' "$base"
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        for f in "$dir"/role.*."$capability"; do
            [[ -f "$f" ]] || continue
            printf '%s\n' "$f"
        done
    done < <(gar_manifest_dirs)
}

# Split a manifest path field on '|' into candidate paths, one per line. An app
# entry may list several paths (name|path|path...); any existing one counts as
# installed.
gar_app_candidate_paths() {
    local field="$1" path
    while IFS= read -r path || [[ -n "$path" ]]; do
        [[ -n "$path" ]] && printf '%s\n' "$path"
    done < <(printf '%s' "$field" | tr '|' '\n')
}

# Print the first candidate path that exists on disk; return 1 if none do.
gar_app_first_existing_path() {
    local field="$1" path
    while IFS= read -r path; do
        [[ -e "$path" ]] && { printf '%s\n' "$path"; return 0; }
    done < <(gar_app_candidate_paths "$field")
    return 1
}

# Join candidate paths with " or " for display.
gar_app_format_paths() {
    local field="$1" path out=""
    while IFS= read -r path; do
        if [[ -z "$out" ]]; then
            out="$path"
        else
            out="$out or $path"
        fi
    done < <(gar_app_candidate_paths "$field")
    printf '%s\n' "$out"
}

# Basename of an .app path without the .app suffix (e.g. Rancher Desktop).
gar_app_path_label() {
    local path="$1" base
    base=$(basename "$path")
    base="${base%.app}"
    base="${base%.App}"
    printf '%s\n' "$base"
}

# True if query matches display name or an alternate install path label
# (full label or its first word), e.g. "rancher" → Rancher Desktop.app.
gar_app_query_matches() {
    local query="$1" display_name="$2" path_field="$3" path label first
    gar_name_eq "$query" "$display_name" && return 0
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        label=$(gar_app_path_label "$path")
        gar_name_eq "$query" "$label" && return 0
        first="${label%%[[:space:]]*}"
        [[ -n "$first" ]] && gar_name_eq "$query" "$first" && return 0
    done < <(gar_app_candidate_paths "$path_field")
    return 1
}

lookup_app_entry() {
    local query="$1" entry name path manifest
    while IFS= read -r manifest; do
        while IFS= read -r entry; do
            name="${entry%%|*}"
            path="${entry#*|}"
            if gar_app_query_matches "$query" "$name" "$path"; then
                printf '%s|%s\n' "$name" "$path"
                return 0
            fi
        done < <(read_manifest "$manifest")
    done < <(gar_all_capability_manifests mac apps)
    return 1
}

gar_normalize_ext_id() {
    local id="$1"
    id="${id#\{}"
    id="${id%\}}"
    printf '%s\n' "$id"
}

lookup_browser_extension_entry() {
    local query="$1" browser ext_id label query_id ext_id_norm
    query_id=$(gar_normalize_ext_id "$query")
    while IFS='|' read -r browser ext_id label; do
        if gar_name_eq "$query" "$label" || gar_name_eq "$query" "$browser/$label"; then
            printf '%s|%s|%s\n' "$browser" "$ext_id" "$label"
            return 0
        fi
        ext_id_norm=$(gar_normalize_ext_id "$ext_id")
        if gar_name_eq "$query" "$ext_id" || gar_name_eq "$query_id" "$ext_id_norm"; then
            printf '%s|%s|%s\n' "$browser" "$ext_id" "$label"
            return 0
        fi
    done < <(read_manifest "$GAR_DIR/mac.browser-extensions")
    return 1
}

lookup_brew_hint() {
    local query="$1" line name manifest
    while IFS= read -r manifest; do
        while IFS= read -r line; do
            if [[ "$line" =~ ^brew[[:space:]]+\"([^\"]+)\" ]]; then
                name="${BASH_REMATCH[1]}"
                if gar_name_eq "$query" "$name"; then
                    printf 'brew install %s\n' "$name"
                    return 0
                fi
            elif [[ "$line" =~ ^cask[[:space:]]+\"([^\"]+)\" ]]; then
                name="${BASH_REMATCH[1]}"
                if gar_name_eq "$query" "$name"; then
                    printf 'brew install --cask %s\n' "$name"
                    return 0
                fi
            fi
        done < <(read_manifest "$manifest")
    done < <(gar_all_capability_manifests mac Brewfile)
    return 1
}

# Resolve the Homebrew binary (PATH first, then the standard Apple-silicon and
# Intel prefixes). Prints the path, or nothing if brew isn't found.
gar_brew_bin() {
    if command -v brew >/dev/null 2>&1; then
        command -v brew
    elif [[ -x /opt/homebrew/bin/brew ]]; then
        printf '%s\n' /opt/homebrew/bin/brew
    elif [[ -x /usr/local/bin/brew ]]; then
        printf '%s\n' /usr/local/bin/brew
    fi
}

# True if the named Homebrew package is installed. kind is "cask" or "formula"
# (anything but "cask" is treated as a formula). Requires a brew binary path.
gar_brew_installed() {
    local brew_bin="$1" kind="$2" name="$3"
    [[ -n "$brew_bin" && -x "$brew_bin" ]] || return 1
    if [[ "$kind" == cask ]]; then
        "$brew_bin" list --cask "$name" >/dev/null 2>&1
    else
        "$brew_bin" list --formula "$name" >/dev/null 2>&1
    fi
}

# True if the named installed Homebrew package has a newer version available.
# `brew outdated <name>` prints the name when outdated, nothing when current
# (exit status is 0 either way), so we test for non-empty output.
gar_brew_outdated() {
    local brew_bin="$1" kind="$2" name="$3" out
    [[ -n "$brew_bin" && -x "$brew_bin" ]] || return 1
    if [[ "$kind" == cask ]]; then
        out=$("$brew_bin" outdated --cask "$name" 2>/dev/null)
    else
        out=$("$brew_bin" outdated --formula "$name" 2>/dev/null)
    fi
    [[ -n "$out" ]]
}

# Parse a "brew install [--cask] <name>" string into "kind|name" (kind is
# "cask" or "formula"). Returns 1 if the string isn't a brew install command,
# so callers can tell brew hints from other install hints.
gar_brew_parse_hint() {
    local hint="$1"
    [[ "$hint" == brew\ install\ * ]] || return 1
    if [[ "$hint" == *"--cask "* ]]; then
        printf 'cask|%s\n' "${hint##*--cask }"
    else
        printf 'formula|%s\n' "${hint##* }"
    fi
}

# Print a "Status: ..." line for a Homebrew package, led by gar's OK/WARN/MISS
# vocabulary: OK when installed and current, WARN when an update is available,
# MISS when not installed (or Homebrew itself is missing).
gar_print_brew_status() {
    local kind="$1" name="$2" brew_bin
    brew_bin=$(gar_brew_bin)
    if [[ -z "$brew_bin" ]]; then
        printf 'Status: MISS - Homebrew not installed\n'
    elif gar_brew_installed "$brew_bin" "$kind" "$name"; then
        if gar_brew_outdated "$brew_bin" "$kind" "$name"; then
            printf 'Status: WARN - installed (update available)\n'
        else
            printf 'Status: OK - installed (up to date)\n'
        fi
    else
        printf 'Status: MISS - not installed\n'
    fi
}

brew_miss_hint() {
    local item="$1"
    if [[ "$item" == *gdubw/gng* || "$item" == *"Formula gng"* ]]; then
        printf 'https://github.com/gdubw/gng — brew trust --formula gdubw/gng/gng && brew install gng\n'
        return 0
    fi
    return 1
}

# Collapse a leading $HOME to ~ for display (e.g. /Users/me/.local/bin -> ~/.local/bin).
gar_tilde_path() {
    local path="$1"
    if [[ "$path" == "$HOME" ]]; then
        printf '~\n'
    elif [[ "$path" == "$HOME"/* ]]; then
        printf '~%s\n' "${path#"$HOME"}"
    else
        printf '%s\n' "$path"
    fi
}

# Emit command names that install-hints says are provided by a brew formula/cask.
# The hint value is matched as a whole token so cask "claude-code" maps to the
# command "claude" via `claude|brew install --cask claude-code`.
gar_brew_hint_commands() {
    local brew_name="$1" hints_file name hint
    hints_file=$(gar_hints_file)
    while IFS='|' read -r name hint; do
        [[ -n "$name" && -n "$hint" ]] || continue
        if [[ " $hint " == *" $brew_name "* ]]; then
            printf '%s\n' "$name"
        fi
    done < <(read_manifest "$hints_file")
}

# If a missing brew formula/cask is actually already available on PATH from a
# non-Homebrew location, print "command|path". Candidate command names are the
# brew item name itself plus any command install-hints maps to it.
gar_brew_item_elsewhere() {
    local brew_name="$1" brew_bin="$2" brew_prefix cmd cmd_path
    brew_prefix=$("$brew_bin" --prefix 2>/dev/null || true)
    while IFS= read -r cmd; do
        [[ -n "$cmd" ]] || continue
        command -v "$cmd" >/dev/null 2>&1 || continue
        cmd_path=$(command -v "$cmd")
        # Ignore the Homebrew-provided copy; we only care about other locations.
        [[ -n "$brew_prefix" && "$cmd_path" == "$brew_prefix"/* ]] && continue
        printf '%s|%s\n' "$cmd" "$cmd_path"
        return 0
    done < <(printf '%s\n' "$brew_name"; gar_brew_hint_commands "$brew_name")
    return 1
}

# Capitalize the first character (claude -> Claude) for the display name.
gar_capitalize_first() {
    local s="$1"
    [[ -n "$s" ]] || return 0
    printf '%s%s\n' "$(printf '%s' "${s:0:1}" | tr '[:lower:]' '[:upper:]')" "${s:1}"
}

# Extract the formula/cask name from a `brew bundle check` missing-item line
# (e.g. "Cask claude-code needs to be installed" -> "claude-code").
gar_brew_item_name() {
    local item="$1"
    if [[ "$item" =~ ^(Formula|Cask)[[:space:]]+([^[:space:]]+)[[:space:]]+needs ]]; then
        printf '%s\n' "${BASH_REMATCH[2]}"
        return 0
    fi
    return 1
}

# Classify a docker endpoint/context name as Docker Desktop, Rancher Desktop, or other.
gar_docker_classify() {
    local text="$1" path
    path="${text#unix://}"
    path="${path/#\~/$HOME}"
    if [[ "$text" == *rancher-desktop* || "$path" == "$HOME/.rd/docker.sock" || "$path" == *"/.rd/docker.sock" ]]; then
        printf 'Rancher Desktop\n'
        return 0
    fi
    if [[ "$text" == *desktop-linux* || "$path" == "$HOME/.docker/run/docker.sock" || "$path" == *"/.docker/run/docker.sock" ]]; then
        printf 'Docker Desktop\n'
        return 0
    fi
    if [[ "$path" == /var/run/docker.sock ]]; then
        if [[ -L /var/run/docker.sock ]]; then
            gar_docker_classify "$(readlink /var/run/docker.sock 2>/dev/null || true)"
            return
        fi
        printf 'default socket\n'
        return 0
    fi
    printf 'other\n'
}

# Print which Docker engine the CLI currently targets (context / DOCKER_HOST).
gar_print_docker_configured() {
    local host_engine ctx endpoint ctx_engine name current ep
    local docker_bin="" saved_ctx installed=""

    printf '\nConfigured:\n'
    if [[ -n "${DOCKER_HOST-}" ]]; then
        host_engine=$(gar_docker_classify "$DOCKER_HOST")
        printf '  DOCKER_HOST: %s (%s) — overrides docker context\n' "$DOCKER_HOST" "$host_engine"
    else
        printf '  DOCKER_HOST: (unset)\n'
    fi

    if [[ -f "$HOME/.docker/config.json" ]]; then
        saved_ctx=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("currentContext") or "")' \
            "$HOME/.docker/config.json" 2>/dev/null || true)
    fi

    if command -v docker >/dev/null 2>&1; then
        docker_bin=$(command -v docker)
    fi

    if [[ -n "$docker_bin" ]]; then
        ctx=$("$docker_bin" context show 2>/dev/null || true)
        endpoint=$("$docker_bin" context inspect "$ctx" -f '{{.Endpoints.docker.Host}}' 2>/dev/null || true)
        if [[ -n "$ctx" ]]; then
            ctx_engine=$(gar_docker_classify "${endpoint:-$ctx}")
            if [[ -n "$endpoint" ]]; then
                printf '  active context: %s → %s (%s)\n' "$ctx" "$endpoint" "$ctx_engine"
            else
                printf '  active context: %s (%s)\n' "$ctx" "$ctx_engine"
            fi
        else
            printf '  active context: (could not read)\n'
        fi
        if [[ -n "$saved_ctx" && "$saved_ctx" != "$ctx" ]]; then
            printf '  saved context: %s (in ~/.docker/config.json)\n' "$saved_ctx"
        fi
        printf '  contexts:\n'
        while IFS='|' read -r name current ep; do
            [[ -n "$name" ]] || continue
            ctx_engine=$(gar_docker_classify "${ep:-$name}")
            if [[ "$current" == "true" ]]; then
                printf '    * %s → %s (%s)\n' "$name" "${ep:-?}" "$ctx_engine"
            else
                printf '      %s → %s (%s)\n' "$name" "${ep:-?}" "$ctx_engine"
            fi
        done < <("$docker_bin" context ls --format '{{.Name}}|{{.Current}}|{{.DockerEndpoint}}' 2>/dev/null || true)
    else
        printf '  docker: not on PATH (cannot read context)\n'
        if [[ -n "$saved_ctx" ]]; then
            ctx_engine=$(gar_docker_classify "$saved_ctx")
            printf '  saved context: %s (%s)\n' "$saved_ctx" "$ctx_engine"
        fi
    fi

    if [[ -e /Applications/Docker.app ]]; then
        installed="${installed:+$installed, }Docker Desktop"
    fi
    if [[ -e "/Applications/Rancher Desktop.app" ]]; then
        installed="${installed:+$installed, }Rancher Desktop"
    fi
    printf '  engines installed: %s\n' "${installed:-(none)}"
}

# Render `gar info <repo>` for a machine-env repo entry ("name|path|branch").
# Reports status; when not OK, says why. Local (tracked, non-skip-worktree) mods
# are reported as a count only; expected (skip-worktree'd) mods are listed one
# file per line, indented and shell-quoted.
cmd_info_repo() {
    local entry="$1" name path config_branch current_branch remote_default
    local mod_count ahead behind reason f catchup=0 configured="" mainline="" catchup_manifest
    name="${entry%%|*}"
    path="${entry#*|}"; config_branch="${path##*|}"; path="${path%%|*}"
    [[ -n "$config_branch" ]] || config_branch=main

    catchup_manifest=$(gar_resolve_manifest "$(detect_platform)" machine-env-catchup)
    if configured=$(gar_machine_env_catchup_mainline "$catchup_manifest" "$name"); then
        catchup=1
    fi

    printf '%s (machine-env repo)\n' "$name"
    printf 'Path: %s\n' "$path"
    printf 'Tracks: %s\n' "$config_branch"

    if [[ ! -d "$path" ]]; then
        (( catchup )) && printf 'Catch-up: yes (rebase onto %s)\n' "${configured:-origin default}"
        printf 'Status: MISSING (no checkout at %s)\n' "$path"
        exit 0
    fi
    if [[ ! -d "$path/.git" ]]; then
        (( catchup )) && printf 'Catch-up: yes (rebase onto %s)\n' "${configured:-origin default}"
        printf 'Status: NOT A GIT REPO\n'
        exit 0
    fi

    current_branch=$(gar_repo_current_branch "$path" 2>/dev/null) || current_branch=""
    if (( catchup )); then
        mainline=$(gar_repo_catchup_mainline_ref "$path" "$configured" 2>/dev/null) || mainline=""
        if [[ -n "$mainline" ]]; then
            printf 'Catch-up: yes (rebase onto %s)\n' "$mainline"
        else
            printf 'Catch-up: yes (rebase mainline could not be resolved — no origin default)\n'
        fi
    fi

    # Collect reasons in report order; if none, status is OK.
    reason=()
    mod_count=$(gar_repo_local_mod_count "$path")
    if [[ "$mod_count" =~ ^[0-9]+$ && "$mod_count" -gt 0 ]]; then
        if (( mod_count == 1 )); then
            reason+=("1 file with uncommitted local changes")
        else
            reason+=("$mod_count files with uncommitted local changes")
        fi
    fi
    # For catch-up repos, sitting on a feature branch is expected — don't flag the
    # branch mismatch, and report behind/action against the mainline ref.
    if (( catchup )); then
        if [[ -z "$mainline" ]]; then
            reason+=("catch-up repo but rebase mainline could not be resolved (no origin default)")
        else
            if ahead=$(gar_repo_unpushed_count "$path" "$config_branch" 2>/dev/null); then
                if (( ahead == 1 )); then
                    reason+=("1 unpushed commit on $config_branch")
                else
                    reason+=("$ahead unpushed commits on $config_branch")
                fi
            fi
            if gar_repo_catchup_fetch "$path" "$mainline" >/dev/null 2>&1 && \
               behind=$(gar_repo_catchup_behind_count "$path" "$mainline" 2>/dev/null); then
                if (( behind == 1 )); then
                    reason+=("1 commit behind $mainline (rebase would catch up)")
                else
                    reason+=("$behind commits behind $mainline (rebase would catch up)")
                fi
            fi
        fi
    else
        if [[ -n "$current_branch" && "$current_branch" != "$config_branch" ]]; then
            reason+=("on branch $current_branch, not tracked branch $config_branch")
        fi
        if ahead=$(gar_repo_unpushed_count "$path" "$config_branch" 2>/dev/null); then
            if (( ahead == 1 )); then
                reason+=("1 unpushed commit on $config_branch")
            else
                reason+=("$ahead unpushed commits on $config_branch")
            fi
        fi
        if gar_repo_try_fetch "$path" "$config_branch" >/dev/null 2>&1 && \
           behind=$(gar_repo_behind_count "$path" "$config_branch" 2>/dev/null); then
            if (( behind == 1 )); then
                reason+=("1 commit behind origin/$config_branch (pull would update)")
            else
                reason+=("$behind commits behind origin/$config_branch (pull would update)")
            fi
        fi
        remote_default=$(gar_repo_remote_default_branch "$path" 2>/dev/null) || remote_default=""
        if [[ -n "$remote_default" && "$remote_default" != "$config_branch" ]]; then
            reason+=("configured to track $config_branch but origin default is $remote_default")
        fi
    fi

    if (( ${#reason[@]} == 0 )); then
        printf 'Status: OK\n'
    else
        printf 'Status: not OK\n'
        for f in "${reason[@]}"; do
            printf '  - %s\n' "$f"
        done
    fi

    # Expected (skip-worktree'd) mods: list each differing file, indented and
    # shell-quoted (printf %q uses '', "", or \ as appropriate).
    local -a expected=()
    while IFS= read -r f; do
        [[ -n "$f" ]] && expected+=("$f")
    done < <(gar_repo_skip_worktree_modified_files "$path")
    if (( ${#expected[@]} > 0 )); then
        if (( ${#expected[@]} == 1 )); then
            printf 'Expected local mods (skip-worktree), 1 file:\n'
        else
            printf 'Expected local mods (skip-worktree), %s files:\n' "${#expected[@]}"
        fi
        for f in "${expected[@]}"; do
            printf '  %q\n' "$f"
        done
    fi
    exit 0
}

cmd_info() {
    local query="$1" app_entry canonical path hint ext_entry browser ext_id label app_path app_found info repo_entry brew_kn

    if [[ -z "$query" ]]; then
        if info=$(lookup_platform_info); then
            printf '%s\n' "$info"
        fi
        exit 0
    fi

    detect_roles
    gar_init_workdir

    # `gar info brew` (literal) shows the full Homebrew audit section — the same
    # output as `gar -a`'s Homebrew section — so you can see what's installed and
    # what's out of date.
    if gar_name_eq "$query" brew || gar_name_eq "$query" homebrew; then
        if [[ "$(detect_platform)" != mac ]]; then
            printf 'Homebrew checks are only implemented on mac.\n' >&2
            exit 1
        fi
        gar_show_all=1
        gar_section_begin "Homebrew"
        check_mac_homebrew
        exit 0
    fi

    if repo_entry=$(lookup_machine_env_repo_entry "$query"); then
        cmd_info_repo "$repo_entry"
    fi

    if app_entry=$(lookup_app_entry "$query"); then
        canonical="${app_entry%%|*}"
        path="${app_entry#*|}"
        printf '%s (app)\n' "$canonical"
        printf 'Expected path: %s\n' "$(gar_app_format_paths "$path")"
        if app_found=$(gar_app_first_existing_path "$path"); then
            printf 'Status: installed (%s)\n' "$app_found"
        else
            printf 'Status: not installed\n'
        fi
        if hint=$(lookup_install_hint "$query" 2>/dev/null) || \
           hint=$(lookup_install_hint "$canonical" 2>/dev/null); then
            gar_print_install_hint 'Install: ' "$hint"
        else
            printf 'Install: download from the vendor or App Store\n'
        fi
        if info=$(lookup_general_info "$query" 2>/dev/null) || \
           info=$(lookup_general_info "$canonical" 2>/dev/null); then
            gar_print_general_info "$info"
        fi
        if gar_name_eq "$canonical" Docker; then
            gar_print_docker_configured
        fi
        exit 0
    fi

    if ext_entry=$(lookup_browser_extension_entry "$query"); then
        browser="${ext_entry%%|*}"
        ext_id="${ext_entry#*|}"
        ext_id="${ext_id%%|*}"
        label="${ext_entry##*|}"
        printf '%s (%s extension)\n' "$label" "$browser"
        printf 'Extension ID: %s\n' "$ext_id"
        app_path=$(mac_browser_app_path "$browser")
        if [[ -z "$app_path" || ! -e "$app_path" ]]; then
            printf 'Status: browser not installed'
            [[ -n "$app_path" ]] && printf ' (%s)' "$app_path"
            printf '\n'
        elif mac_browser_extension_installed "$browser" "$ext_id"; then
            printf 'Status: installed\n'
        else
            printf 'Status: not installed\n'
        fi
        if hint=$(lookup_install_hint "$label"); then
            gar_print_install_hint 'Install: ' "$hint"
        else
            printf 'Install: install from the browser extension store\n'
        fi
        if info=$(lookup_general_info "$query"); then
            gar_print_general_info "$info"
        fi
        exit 0
    fi

    if hint=$(lookup_install_hint "$query"); then
        # If the install hint is itself a Homebrew command, report brew status —
        # many tracked CLIs (gh, awscli, …) install via "brew install <name>".
        if brew_kn=$(gar_brew_parse_hint "$hint"); then
            printf '%s (brew %s)\n' "$query" "${brew_kn%%|*}"
            gar_print_brew_status "${brew_kn%%|*}" "${brew_kn#*|}"
        else
            printf '%s\n' "$query"
        fi
        gar_print_install_hint 'Install: ' "$hint"
        if info=$(lookup_general_info "$query"); then
            gar_print_general_info "$info"
        fi
        exit 0
    fi

    if hint=$(lookup_brew_hint "$query"); then
        # hint is "brew install <name>" or "brew install --cask <name>".
        brew_kn=$(gar_brew_parse_hint "$hint")
        printf '%s (brew %s)\n' "$query" "${brew_kn%%|*}"
        gar_print_brew_status "${brew_kn%%|*}" "${brew_kn#*|}"
        printf 'Install: %s\n' "$hint"
        if info=$(lookup_general_info "$query"); then
            gar_print_general_info "$info"
        fi
        exit 0
    fi

    if info=$(lookup_general_info "$query"); then
        printf '%s\n' "$query"
        gar_print_general_info "$info"
        exit 0
    fi

    echo "No gar entry for: $query" >&2
    exit 1
}

detect_platform() {
    if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
        printf '%s\n' wsl
    elif [[ "$(uname -s)" == "Darwin" ]]; then
        printf '%s\n' mac
    elif [[ "$(uname -a)" == *[Ss]ynology* ]]; then
        printf '%s\n' synology
    elif [[ "$(uname -s)" == "Linux" ]]; then
        printf '%s\n' linux
    else
        printf '%s\n' unknown
    fi
}

gar_roles_file() {
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/gar/roles"
}

gar_role_is_known() {
    local role="$1" dir f
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        for f in "$dir"/role."$role".*; do
            [[ -e "$f" ]] || continue
            [[ -f "$f" ]] && return 0
        done
    done < <(gar_manifest_dirs)
    return 1
}

# Emit known role ids (unique, sorted) from role.<id>.* under all manifest roots.
gar_known_roles() {
    local dir f base rest role
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        for f in "$dir"/role.*; do
            [[ -f "$f" ]] || continue
            base=$(basename "$f")
            rest="${base#role.}"
            role="${rest%.*}"
            [[ -n "$role" && "$role" != "$rest" ]] || continue
            printf '%s\n' "$role"
        done
    done < <(gar_manifest_dirs) | sort -u
}

gar_role_is_active() {
    local role="$1" r
    for r in "${gar_active_roles[@]}"; do
        [[ "$r" == "$role" ]] && return 0
    done
    return 1
}

# Emit capability suffixes for role.<role>.* under all manifest roots (unique).
gar_role_capabilities() {
    local role="$1" dir f base cap
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        for f in "$dir"/role."$role".*; do
            [[ -f "$f" ]] || continue
            base=$(basename "$f")
            cap="${base#role.$role.}"
            [[ -n "$cap" && "$cap" != "$base" ]] || continue
            printf '%s\n' "$cap"
        done
    done < <(gar_manifest_dirs) | sort -u
}

# Preferred display order for role capability sections; unknown caps follow A–Z.
gar_role_capabilities_ordered() {
    local role="$1" caps cap
    caps=$(gar_role_capabilities "$role")
    [[ -n "$caps" ]] || return 0
    for cap in apps Brewfile commands login-items env secrets machine-env-repos; do
        if printf '%s\n' "$caps" | grep -qxF "$cap"; then
            printf '%s\n' "$cap"
        fi
    done
    printf '%s\n' "$caps" | grep -vxF \
        -e apps -e Brewfile -e commands -e login-items \
        -e env -e secrets -e machine-env-repos | sort -u || true
}

gar_role_capability_label() {
    case "$1" in
        apps) printf 'Apps' ;;
        Brewfile) printf 'Homebrew' ;;
        commands) printf 'Commands' ;;
        login-items) printf 'Login items' ;;
        env) printf 'Env' ;;
        secrets) printf 'Secrets' ;;
        machine-env-repos) printf 'Machine env repos' ;;
        *) printf '%s' "$1" ;;
    esac
}

gar_role_manifest_has_items() {
    local manifest="$1" line
    [[ -f "$manifest" ]] || return 1
    while IFS= read -r line; do
        return 0
    done < <(read_manifest "$manifest")
    return 1
}

# Print human-readable items for one role capability manifest.
gar_print_role_capability_items() {
    local capability="$1" manifest="$2" line label names name
    case "$capability" in
        apps)
            while IFS= read -r line; do
                printf '    %s\n' "${line%%|*}"
            done < <(read_manifest "$manifest")
            ;;
        Brewfile)
            while IFS= read -r line; do
                if [[ "$line" =~ ^brew[[:space:]]+\"([^\"]+)\" ]]; then
                    printf '    %s\n' "${BASH_REMATCH[1]}"
                elif [[ "$line" =~ ^cask[[:space:]]+\"([^\"]+)\" ]]; then
                    printf '    cask %s\n' "${BASH_REMATCH[1]}"
                elif [[ "$line" =~ ^tap[[:space:]]+\"([^\"]+)\" ]]; then
                    printf '    tap %s\n' "${BASH_REMATCH[1]}"
                else
                    printf '    %s\n' "$line"
                fi
            done < <(read_manifest "$manifest")
            ;;
        login-items)
            while IFS= read -r line; do
                label="${line%%|*}"
                names="${line#*|}"
                if [[ "$names" == *'|'* ]]; then
                    printf '    %s (exactly one of: %s)\n' "$label" "$(gar_app_format_paths "$names")"
                else
                    printf '    %s\n' "$label"
                fi
            done < <(read_manifest "$manifest")
            ;;
        machine-env-repos)
            while IFS= read -r line; do
                name="${line%%|*}"
                printf '    %s\n' "$name"
            done < <(read_manifest "$manifest")
            ;;
        *)
            while IFS= read -r line; do
                printf '    %s\n' "$line"
            done < <(read_manifest "$manifest")
            ;;
    esac
}

gar_print_role_details() {
    local role="$1" cap manifest
    while IFS= read -r cap; do
        [[ -n "$cap" ]] || continue
        manifest=$(gar_collect_role_manifest_for_role "$role" "$cap")
        gar_role_manifest_has_items "$manifest" || continue
        printf '  %s\n' "$(gar_role_capability_label "$cap")"
        gar_print_role_capability_items "$cap" "$manifest"
    done < <(gar_role_capabilities_ordered "$role")
}

cmd_roles() {
    local role show_all=0 first=1
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a|--all)
                show_all=1
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                echo "Unknown option for roles: $1" >&2
                usage >&2
                exit 2
                ;;
        esac
    done

    detect_roles
    if (( show_all )); then
        gar_init_workdir
    fi
    while IFS= read -r role; do
        [[ -n "$role" ]] || continue
        if (( show_all && first == 0 )); then
            printf '\n'
        fi
        first=0
        if gar_role_is_active "$role"; then
            printf '✓ %s\n' "$role"
        else
            printf '  %s\n' "$role"
        fi
        if (( show_all )); then
            gar_print_role_details "$role"
        fi
    done < <(gar_known_roles)
}

detect_roles() {
    local file line
    gar_active_roles=()
    file=$(gar_roles_file)
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -n "$line" ]] || continue
        gar_active_roles+=("$line")
    done <"$file"
}

gar_format_roles() {
    if (( ${#gar_active_roles[@]} == 0 )); then
        printf '(none)'
        return
    fi
    local IFS=,
    printf '%s' "${gar_active_roles[*]}"
}

gar_warn_unknown_roles() {
    local role
    for role in "${gar_active_roles[@]}"; do
        if ! gar_role_is_known "$role"; then
            printf 'WARN Unknown role: %s (no role.%s.* in gar.d/ or ~/.config/gar/d/)\n' "$role" "$role"
        fi
    done
}

# Concatenate role.<role>.<capability> from all manifest roots into a temp file.
# Writes under gar_tmpdir; call gar_init_workdir first.
gar_collect_role_manifest_for_role() {
    local role="$1" capability="$2" out dir f
    out="$gar_tmpdir/role.$role.$capability"
    : >"$out"
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        f="$dir/role.$role.$capability"
        if [[ -f "$f" ]]; then
            cat "$f" >>"$out"
            printf '\n' >>"$out"
        fi
    done < <(gar_manifest_dirs)
    printf '%s\n' "$out"
}

# Concatenate role.<role>.<capability> for each active role into a temp file.
# Writes under gar_tmpdir; call gar_init_workdir first.
gar_collect_role_manifest() {
    local capability="$1" out role role_file
    out="$gar_tmpdir/role.$capability"
    : >"$out"
    for role in "${gar_active_roles[@]}"; do
        role_file=$(gar_collect_role_manifest_for_role "$role" "$capability")
        if [[ -n "$role_file" && -f "$role_file" && -s "$role_file" ]]; then
            cat "$role_file" >>"$out"
        fi
    done
    printf '%s\n' "$out"
}

# Platform/shared base plus active role overlays for one capability name.
gar_combined_capability_manifest() {
    local platform="$1" capability="$2" base role_file out
    out="$gar_tmpdir/combined.$capability"
    : >"$out"
    base=$(gar_resolve_manifest "$platform" "$capability")
    if [[ -n "$base" && -f "$base" ]]; then
        cat "$base" >>"$out"
        printf '\n' >>"$out"
    fi
    role_file=$(gar_collect_role_manifest "$capability")
    if [[ -n "$role_file" && -f "$role_file" && -s "$role_file" ]]; then
        cat "$role_file" >>"$out"
    fi
    printf '%s\n' "$out"
}

read_manifest() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -n "$line" ]] || continue
        printf '%s\n' "$line"
    done <"$file"
}

gar_section_begin() {
    gar_section_name="$1"
    gar_section_header_printed=0
}

gar_section_emit_header() {
    if (( gar_section_header_printed == 0 )); then
        printf '%s%s\n' "$gar_section_lead" "$gar_section_name"
        gar_section_lead=$'\n'
        gar_section_header_printed=1
    fi
}

report_ok() {
    if (( gar_show_all )); then
        gar_section_emit_header
        printf 'OK   %s\n' "$1"
    fi
}

report_miss() {
    gar_section_emit_header
    printf 'MISS %s\n' "$1"
    issues=$((issues + 1))
}

report_warn() {
    gar_section_emit_header
    printf 'WARN %s\n' "$1"
    warnings=$((warnings + 1))
}

# gar_note_fixed issue|warning — record a successfully applied interactive fix.
gar_note_fixed() {
    if [[ "$1" == issue ]]; then
        gar_fixed_issues=$((gar_fixed_issues + 1))
    else
        gar_fixed_warnings=$((gar_fixed_warnings + 1))
    fi
}

# "N thing" / "N things"
gar_plural() {
    if (( $1 == 1 )); then
        printf '%s %s' "$1" "$2"
    else
        printf '%s %ss' "$1" "$2"
    fi
}

# Advisory, like report_warn: does NOT bump issues / affect exit status. Used
# for intentional skip-worktree'd local edits that are expected, not problems.
report_expected_mods() {
    gar_section_emit_header
    printf 'EXPECTED MODS %s\n' "$1"
}

# Emit a single line with the status prefix padded to a common column width, so
# WARN / MISS / EXPECTED MODS / OK all align. Used by the machine-env-repo
# section (which pre-aligns the rest of the line into columns of its own); the
# plain report_* helpers above are unchanged and still used everywhere else.
# report_line does NOT touch `issues` — callers that need the exit-status bump
# (MISS) must do it themselves.
GAR_STATUS_WIDTH=13   # width of the longest prefix, "EXPECTED MODS"

report_line() {
    gar_section_emit_header
    printf '%-*s  %s\n' "$GAR_STATUS_WIDTH" "$1" "$2"
    [[ "$1" == WARN ]] && warnings=$((warnings + 1))
    return 0
}

report_ok_preformatted() {
    (( gar_show_all )) || return 0
    report_line OK "$1"
}

gar_expand_home() {
    local path="$1"
    path="${path//\$HOME/$HOME}"
    printf '%s\n' "$path"
}

gar_path_seen() {
    local needle="$1" seen
    for seen in "${@:2}"; do
        [[ "$seen" == "$needle" ]] && return 0
    done
    return 1
}

gar_repo_dirty() {
    # "Dirty" = tracked files with genuine local edits. Untracked files are
    # ignored (--untracked-files=no) so a stray untracked file doesn't warn, and
    # skip-worktree'd files are already excluded by git status by design (their
    # expected mods are surfaced separately via gar_repo_skip_worktree_modified).
    local repo="$1"
    [[ -d "$repo/.git" ]] || return 1
    [[ -n "$(git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null)" ]]
}

# Prints the skip-worktree'd tracked files whose working-tree content differs
# from their committed (HEAD) blob, one path per line. These are intentional
# local edits hidden from `git status` via the skip-worktree bit (e.g.
# log4j2.properties tweaks); they are "expected mods", not a problem. git's diff
# plumbing honors the skip bit at every level (status/diff/diff-files/diff-index
# all ignore these files), so we compare the working-tree content hash to the
# HEAD blob directly, per file. Same technique as the `git-better-worktree`
# (gbw) CLI's `skip` subcommand, but by repo path (git -C) since gar audits
# arbitrary repos.
gar_repo_skip_worktree_modified_files() {
    local repo="$1" f wt head
    [[ -d "$repo/.git" ]] || return 0
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        wt=$(git -C "$repo" hash-object -- "$f" 2>/dev/null) || continue
        head=$(git -C "$repo" rev-parse "HEAD:$f" 2>/dev/null) || continue
        [[ "$wt" != "$head" ]] && printf '%s\n' "$f"
    done < <(git -C "$repo" ls-files -v 2>/dev/null | grep '^S' | cut -c3-)
}

# Returns 0 if the repo has any expected (skip-worktree'd) mods.
gar_repo_skip_worktree_modified() {
    local repo="$1"
    [[ -d "$repo/.git" ]] || return 1
    [[ -n "$(gar_repo_skip_worktree_modified_files "$repo")" ]]
}

# Count of tracked files with genuine (non-skip-worktree, non-untracked) local
# edits — the same set gar_repo_dirty tests for, but counted.
gar_repo_local_mod_count() {
    local repo="$1"
    [[ -d "$repo/.git" ]] || { printf '0\n'; return; }
    git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null | grep -c .
}

gar_repo_current_branch() {
    local repo="$1"
    [[ -d "$repo/.git" ]] || return 1
    git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null
}

# Remote's default branch (origin/HEAD), with the "origin/" prefix stripped.
# Returns non-zero (empty) when origin/HEAD is unset locally — callers treat
# that as "unknown" and skip the configured-vs-default warning.
gar_repo_remote_default_branch() {
    local repo="$1" ref
    [[ -d "$repo/.git" ]] || return 1
    ref=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || return 1
    [[ -n "$ref" ]] || return 1
    printf '%s\n' "${ref#origin/}"
}

gar_repo_pull() {
    local repo="$1" branch="${2:-main}"
    git "${gar_git_net_opts[@]}" -C "$repo" pull -r origin "$branch"
}

# --- Catch-up repos --------------------------------------------------------
# A "catch-up" repo (named in a machine-env-catchup manifest) is updated by
# rebasing the *current* branch onto a configured "mainline" ref — `git fetch
# <remote>` + `git rebase <mainline>` — rather than pulling config_branch from
# origin. This suits repos where you sit on a feature branch and periodically
# rebase it onto mainline (e.g. origin/main). The mainline is deliberately NOT
# the branch's own upstream @{u}: the feature branch keeps its own upstream
# (e.g. origin/FEATURE) so `git push` still goes to the feature branch, while
# catch-up rebases from a different branch. These helpers take the resolved
# mainline ref as an argument and never read @{u}.

# Resolve a catch-up repo's mainline ref (the branch to rebase onto). An
# explicit manifest value wins; otherwise default to origin/<repo's remote
# default branch>. Non-zero (empty) when no mainline is configured and the
# remote default can't be determined.
gar_repo_catchup_mainline_ref() {
    local repo="$1" configured="$2" default
    if [[ -n "$configured" ]]; then
        printf '%s\n' "$configured"
        return 0
    fi
    default=$(gar_repo_remote_default_branch "$repo" 2>/dev/null) || default=""
    [[ -n "$default" ]] || return 1
    printf 'origin/%s\n' "$default"
}

# How many commits the current branch is behind the mainline ref
# (HEAD..<mainline>). Non-zero (empty) when the mainline doesn't resolve or the
# count is 0.
gar_repo_catchup_behind_count() {
    local repo="$1" mainline="$2" behind
    [[ -d "$repo/.git" ]] || return 1
    [[ -n "$mainline" ]] || return 1
    git -C "$repo" rev-parse --verify --quiet "$mainline" >/dev/null 2>&1 || return 1
    behind=$(git -C "$repo" rev-list --count "HEAD..$mainline" 2>/dev/null) || return 1
    (( behind > 0 )) || return 1
    printf '%s\n' "$behind"
}

# Fetch the mainline ref's remote (so the mainline is current). The mainline is
# a remote-tracking ref like "origin/main"; the remote is the part before the
# first "/". Non-zero when there's no mainline, the fetch fails, or the mainline
# still doesn't resolve afterward.
gar_repo_catchup_fetch() {
    local repo="$1" mainline="$2" remote
    [[ -d "$repo/.git" ]] || return 1
    [[ -n "$mainline" ]] || return 1
    remote="${mainline%%/*}"
    [[ -n "$remote" ]] || return 1
    gar_run_with_timeout 15 git "${gar_git_net_opts[@]}" -C "$repo" fetch --quiet "$remote" 2>/dev/null || return 1
    git -C "$repo" rev-parse --verify --quiet "$mainline" >/dev/null 2>&1
}

# Catch up the current branch: rebase it onto the mainline ref. This does not
# touch the branch's own upstream (@{u}), so the push target is preserved.
gar_repo_rebase_onto_mainline() {
    local repo="$1" mainline="$2"
    git -C "$repo" rebase "$mainline"
}

gar_can_prompt() {
    (( gar_recheck )) && return 1
    [[ -r /dev/tty ]] || [[ -t 0 ]]
}

# Prompt Y/n (default Y) or y/N (default N). Optional second arg: help text
# printed when the user answers "?"; when set, the prompt suffix includes
# ?-Print install command. Optional third arg: default reply Y or N (default Y).
gar_prompt_yn() {
    local prompt="$1" help="${2:-}" default="${3:-Y}" reply input suffix
    if (( gar_recheck )); then
        return 1
    elif [[ -r /dev/tty ]]; then
        input=/dev/tty
    elif [[ -t 0 ]]; then
        input=/dev/stdin
    else
        return 1
    fi

    case "$default" in
        [Nn]|[Nn][Oo]) default=N ;;
        *) default=Y ;;
    esac

    if [[ "$default" == N ]]; then
        if [[ -n "$help" ]]; then
            suffix='[y/N/?-Print install command]'
        else
            suffix='[y/N]'
        fi
    else
        if [[ -n "$help" ]]; then
            suffix='[Y/n/?-Print install command]'
        else
            suffix='[Y/n]'
        fi
    fi

    while true; do
        printf '%s %s ' "$prompt" "$suffix" >&2
        if ! IFS= read -r reply <"$input"; then
            return 1
        fi
        reply="${reply//$'\r'/}"
        reply="${reply#"${reply%%[![:space:]]*}"}"
        reply="${reply%"${reply##*[![:space:]]}"}"
        [[ -n "$reply" ]] || reply=$default
        case "$reply" in
            [Yy]|[Yy][Ee][Ss]) return 0 ;;
            [Nn]|[Nn][Oo]) return 1 ;;
            \?)
                if [[ -n "$help" ]]; then
                    printf '%s\n' "$help" >&2
                else
                    printf 'Please answer Y or n.\n' >&2
                fi
                ;;
            *)
                if [[ -n "$help" ]]; then
                    printf 'Please answer Y, n, or ?.\n' >&2
                else
                    printf 'Please answer Y or n.\n' >&2
                fi
                ;;
        esac
    done
}

gar_repo_unpushed_count() {
    local repo="$1" branch="${2:-main}" ahead
    [[ -d "$repo/.git" ]] || return 1
    git -C "$repo" rev-parse --verify "$branch" >/dev/null 2>&1 || return 1
    git -C "$repo" rev-parse --verify "origin/$branch" >/dev/null 2>&1 || return 1
    ahead=$(git -C "$repo" rev-list --count "origin/$branch..$branch" 2>/dev/null) || return 1
    (( ahead > 0 )) || return 1
    printf '%s\n' "$ahead"
}

gar_repo_behind_count() {
    local repo="$1" branch="${2:-main}" behind
    [[ -d "$repo/.git" ]] || return 1
    git -C "$repo" rev-parse --verify "$branch" >/dev/null 2>&1 || return 1
    git -C "$repo" rev-parse --verify "origin/$branch" >/dev/null 2>&1 || return 1
    behind=$(git -C "$repo" rev-list --count "$branch..origin/$branch" 2>/dev/null) || return 1
    (( behind > 0 )) || return 1
    printf '%s\n' "$behind"
}

gar_repo_try_fetch() {
    local repo="$1" branch="${2:-main}"
    [[ -d "$repo/.git" ]] || return 1
    git -C "$repo" rev-parse --verify "$branch" >/dev/null 2>&1 || return 1
    git -C "$repo" remote get-url origin >/dev/null 2>&1 || return 1
    gar_run_with_timeout 15 git "${gar_git_net_opts[@]}" -C "$repo" fetch --quiet origin "$branch" 2>/dev/null || return 1
    git -C "$repo" rev-parse --verify "origin/$branch" >/dev/null 2>&1
}

gar_machine_env_skip_name() {
    local skip_manifest="$1" want="$2" name
    [[ -n "$skip_manifest" && -f "$skip_manifest" ]] || return 1
    while IFS= read -r name; do
        [[ "$name" == "$want" ]] && return 0
    done < <(read_manifest "$skip_manifest")
    return 1
}

# Is <name> in the catch-up manifest? Manifest lines are `name|mainline`
# (pipe-delimited, like machine-env-repos); a bare `name` is also valid. Being
# listed switches the repo to catch-up mode (rebase current branch onto the
# mainline ref) instead of the config_branch pull. On a name match this prints
# the configured mainline (the 2nd field, whitespace-trimmed; empty for a bare
# name — the caller then defaults it via gar_repo_catchup_mainline_ref) and
# returns 0; returns 1 (empty) when the name isn't listed.
gar_machine_env_catchup_mainline() {
    local catchup_manifest="$1" want="$2" name mainline
    [[ -n "$catchup_manifest" && -f "$catchup_manifest" ]] || return 1
    while IFS='|' read -r name mainline; do
        if [[ "$name" == "$want" ]]; then
            # Trim whitespace around the optional mainline (same idiom as the
            # repos manifest's optional branch field).
            mainline="${mainline#"${mainline%%[![:space:]]*}"}"
            mainline="${mainline%"${mainline##*[![:space:]]}"}"
            printf '%s\n' "$mainline"
            return 0
        fi
    done < <(read_manifest "$catchup_manifest")
    return 1
}

gar_machine_env_list_repos() {
    local repos_manifest="$1" skip_manifest="${2:-}" name path branch setup_dir setup_name seen=()
    while IFS='|' read -r name path branch; do
        if gar_machine_env_skip_name "$skip_manifest" "$name"; then
            continue
        fi
        path=$(gar_expand_home "$path")
        # Optional 3rd field is the branch to track; trim whitespace and default to main.
        branch="${branch#"${branch%%[![:space:]]*}"}"
        branch="${branch%"${branch##*[![:space:]]}"}"
        branch="${branch:-main}"
        if gar_path_seen "$path" "${seen[@]}"; then
            continue
        fi
        seen+=("$path")
        printf '%s|%s|%s\n' "$name" "$path" "$branch"
    done < <(read_manifest "$repos_manifest")

    for setup_dir in "$HOME"/Yew/*-setup; do
        [[ -d "$setup_dir" ]] || continue
        [[ -d "$setup_dir/.git" ]] || continue
        setup_name=$(basename "$setup_dir")
        if gar_machine_env_skip_name "$skip_manifest" "$setup_name"; then
            continue
        fi
        if gar_path_seen "$setup_dir" "${seen[@]}"; then
            continue
        fi
        seen+=("$setup_dir")
        printf '%s|%s|%s\n' "$setup_name" "$setup_dir" main
    done
}

# Find a machine-env repo by name for the current platform/roles. Echoes the
# resolved "name|path|branch" entry (as gar_machine_env_list_repos would emit)
# and returns 0, or returns 1 if no repo matches. Requires gar_init_workdir.
lookup_machine_env_repo_entry() {
    local query="$1" platform repos_manifest skip_manifest name path branch
    platform=$(detect_platform)
    repos_manifest=$(gar_combined_capability_manifest "$platform" machine-env-repos)
    skip_manifest=$(gar_resolve_manifest "$platform" machine-env-skip)
    while IFS='|' read -r name path branch; do
        if gar_name_eq "$query" "$name"; then
            printf '%s|%s|%s\n' "$name" "$path" "$branch"
            return 0
        fi
    done < <(gar_machine_env_list_repos "$repos_manifest" "$skip_manifest")
    return 1
}

gar_machine_env_prefetch_repo() {
    local name="$1" path="$2" branch="${3:-main}" result_file="$4" catchup_manifest="${5:-}"
    local ahead behind fetched=0 current_branch remote_default catchup=0 configured="" mainline=""
    # Membership + configured mainline are resolved outside the subshell so the
    # remote-default default (below) can reuse the remote_default we already read.
    if configured=$(gar_machine_env_catchup_mainline "$catchup_manifest" "$name"); then
        catchup=1
    fi
    {
        # config_branch is the branch this repo is configured to track (manifest
        # 3rd field, default main); branch= (below) is the current checked-out branch.
        printf 'name=%s\npath=%s\nconfig_branch=%s\n' "$name" "$path" "$branch"
        # catchup=1 when the repo is named in the catch-up manifest: behind/fetch
        # are measured against the mainline ref (mainline= below), and the update
        # action is a rebase onto that mainline rather than a config_branch pull.
        printf 'catchup=%s\n' "$catchup"
        if [[ ! -d "$path" ]]; then
            printf 'status=missing\n'
            exit 0
        fi
        if [[ ! -d "$path/.git" ]]; then
            printf 'status=not-git\n'
            exit 0
        fi
        printf 'status=ok\n'
        current_branch=$(gar_repo_current_branch "$path" 2>/dev/null) || current_branch=""
        printf 'branch=%s\n' "$current_branch"
        if remote_default=$(gar_repo_remote_default_branch "$path" 2>/dev/null); then
            printf 'remote_default=%s\n' "$remote_default"
        else
            remote_default=""
            printf 'remote_default=\n'
        fi
        # mainline= is the catch-up rebase-onto ref: the manifest's explicit
        # value, else origin/<remote_default>. Empty when catch-up but no mainline
        # could be resolved (no explicit value and no remote default). Only
        # meaningful for catch-up repos, but harmless to record either way.
        if (( catchup )); then
            if [[ -n "$configured" ]]; then
                mainline="$configured"
            elif [[ -n "$remote_default" ]]; then
                mainline="origin/$remote_default"
            fi
        fi
        printf 'mainline=%s\n' "$mainline"
        if gar_repo_dirty "$path"; then
            printf 'dirty=1\n'
        else
            printf 'dirty=0\n'
        fi
        if gar_repo_skip_worktree_modified "$path"; then
            printf 'expected_mods=1\n'
        else
            printf 'expected_mods=0\n'
        fi
        if (( catchup )); then
            # Catch-up: fetch/behind keyed off the mainline ref (e.g. origin/main).
            if [[ -n "$mainline" ]] && gar_repo_catchup_fetch "$path" "$mainline"; then
                fetched=1
                printf 'fetched=1\n'
            else
                printf 'fetched=0\n'
            fi
            # ahead stays measured against origin/config_branch (unpushed work is
            # still worth flagging); behind switches to HEAD..<mainline>.
            if ahead=$(gar_repo_unpushed_count "$path" "$branch" 2>/dev/null); then
                printf 'ahead=%s\n' "$ahead"
            else
                printf 'ahead=0\n'
            fi
            behind=0
            if (( fetched )) && behind=$(gar_repo_catchup_behind_count "$path" "$mainline" 2>/dev/null); then
                printf 'behind=%s\n' "$behind"
            else
                printf 'behind=0\n'
            fi
        else
            if gar_repo_try_fetch "$path" "$branch"; then
                fetched=1
                printf 'fetched=1\n'
            else
                printf 'fetched=0\n'
            fi
            if ahead=$(gar_repo_unpushed_count "$path" "$branch" 2>/dev/null); then
                printf 'ahead=%s\n' "$ahead"
            else
                printf 'ahead=0\n'
            fi
            behind=0
            if (( fetched )) && behind=$(gar_repo_behind_count "$path" "$branch" 2>/dev/null); then
                printf 'behind=%s\n' "$behind"
            else
                printf 'behind=0\n'
            fi
        fi
    } >"$result_file"
}

gar_machine_env_prefetch_all() {
    local repos_manifest="$1" skip_manifest="${2:-}" catchup_manifest="${3:-}" name path branch slug result_file
    mkdir -p "$gar_tmpdir/repos"
    while IFS='|' read -r name path branch; do
        branch="${branch:-main}"
        slug=$(gar_path_slug "$path")
        result_file="$gar_tmpdir/repos/$slug"
        gar_timed "repo prefetch: $name" \
            gar_machine_env_prefetch_repo "$name" "$path" "$branch" "$result_file" "$catchup_manifest" &
    done < <(gar_machine_env_list_repos "$repos_manifest" "$skip_manifest")
    wait
}

# Machine-env-repo report rows are buffered rather than printed immediately, so
# the section can measure name / (path) column widths across every row before
# emitting an aligned table. Four parallel arrays hold one entry per line.
gar_mer_status=()   # OK | MISS | WARN | EXPECTED MODS
gar_mer_name=()
gar_mer_path=()     # bare path; the surrounding "(...)" is added at emit time
gar_mer_msg=()      # reason text only (no em-dash); "" for an OK row

gar_mer_reset() {
    gar_mer_status=(); gar_mer_name=(); gar_mer_path=(); gar_mer_msg=()
}

# gar_mer_row <status> <name> <path> <message>
# Buffer one report line. A MISS still bumps the global issues counter here (the
# emit pass uses report_line, which does not), preserving exit-status semantics.
gar_mer_row() {
    [[ "$1" == MISS ]] && issues=$((issues + 1))
    gar_mer_status+=("$1"); gar_mer_name+=("$2")
    gar_mer_path+=("$3");   gar_mer_msg+=("$4")
}

# Sort rank for grouping the emitted rows best-to-worst: OK, then the advisory
# EXPECTED MODS, then WARN, then the real problems (MISS) at the bottom, so the
# eye travels down toward what needs attention.
gar_mer_rank() {
    case "$1" in
        OK)              echo 0 ;;
        "EXPECTED MODS") echo 1 ;;
        WARN)            echo 2 ;;
        MISS)            echo 3 ;;
        *)               echo 9 ;;
    esac
}

# Measure column widths across the buffered rows, then emit each as an aligned
# "STATUS  name  (path)  message" line, grouped by status (see gar_mer_rank) and
# alphabetical by repo name within a group. OK rows only count/print under --all.
gar_mer_flush() {
    local i wname=0 wpath=0 nlen plen line key
    for i in "${!gar_mer_status[@]}"; do
        [[ "${gar_mer_status[i]}" == OK && $gar_show_all -eq 0 ]] && continue
        nlen=${#gar_mer_name[i]}
        (( nlen > wname )) && wname=$nlen
        plen=$(( ${#gar_mer_path[i]} + 2 ))   # +2 for the surrounding ()
        (( plen > wpath )) && wpath=$plen
    done
    # Build "<rank>\t<lower-name>\t<index>" keys and sort: rank groups the rows,
    # lowercased name orders alphabetically within a group, and the original index
    # is a stable tiebreaker (keeps a repo's multiple rows in emission order).
    local -a order=()
    for i in "${!gar_mer_status[@]}"; do
        printf -v key '%d\t%s\t%d' \
            "$(gar_mer_rank "${gar_mer_status[i]}")" \
            "${gar_mer_name[i],,}" "$i"
        order+=("$key")
    done
    IFS=$'\n' order=($(sort <<<"${order[*]}"))
    unset IFS
    for key in "${order[@]}"; do
        i=${key##*$'\t'}
        printf -v line '%-*s  %-*s  %s' \
            "$wname" "${gar_mer_name[i]}" \
            "$wpath" "(${gar_mer_path[i]})" \
            "${gar_mer_msg[i]}"
        line="${line%"${line##*[![:space:]]}"}"   # rstrip trailing pad (OK rows)
        case "${gar_mer_status[i]}" in
            OK)              report_ok_preformatted "$line" ;;
            MISS)            report_line MISS "$line" ;;
            WARN)            report_line WARN "$line" ;;
            "EXPECTED MODS") report_line "EXPECTED MODS" "$line" ;;
        esac
    done
}

report_machine_env_repo() {
    local name="$1" path="$2" result_file="$3"
    # reported tracks whether any line was printed for this repo (WARN or the
    # EXPECTED MODS / default-mismatch advisories) so the trailing OK is emitted
    # only when the repo was otherwise silent. Exit status is driven separately by
    # report_miss (missing / not-git), which increments the global issues counter.
    local status dirty expected_mods ahead behind fetched config_branch remote_default reported=0
    local catchup mainline branch
    status=$(gar_result_get "$result_file" status)
    case "$status" in
        missing)
            gar_mer_row MISS "$name" "$path" "missing"
            return
            ;;
        not-git)
            gar_mer_row MISS "$name" "$path" "not a git repo"
            return
            ;;
    esac
    config_branch=$(gar_result_get "$result_file" config_branch)
    [[ -n "$config_branch" ]] || config_branch=main
    catchup=$(gar_result_get "$result_file" catchup)
    mainline=$(gar_result_get "$result_file" mainline)
    branch=$(gar_result_get "$result_file" branch)
    remote_default=$(gar_result_get "$result_file" remote_default)
    dirty=$(gar_result_get "$result_file" dirty)
    expected_mods=$(gar_result_get "$result_file" expected_mods)
    if [[ "$dirty" == 1 ]]; then
        # Genuine tracked edits win over expected mods: still an issue.
        gar_mer_row WARN "$name" "$path" "uncommitted changes"
        reported=1
    elif [[ "$expected_mods" == 1 ]]; then
        # Only skip-worktree'd edits present — expected, advisory, not an issue.
        gar_mer_row "EXPECTED MODS" "$name" "$path" "expected local mods (skip-worktree)"
        reported=1
    fi
    ahead=$(gar_result_get "$result_file" ahead)
    if [[ "$ahead" =~ ^[0-9]+$ && "$ahead" -gt 0 ]]; then
        if (( ahead == 1 )); then
            gar_mer_row WARN "$name" "$path" "1 unpushed commit on $config_branch"
        else
            gar_mer_row WARN "$name" "$path" "$ahead unpushed commits on $config_branch"
        fi
        reported=1
    fi
    fetched=$(gar_result_get "$result_file" fetched)
    behind=$(gar_result_get "$result_file" behind)
    if [[ "$catchup" == 1 ]]; then
        # Catch-up repo: behind is measured against the mainline ref (mainline=),
        # and the fix is a rebase onto that mainline, not a pull. A catch-up repo
        # whose mainline couldn't be resolved is flagged so it isn't silently
        # ignored.
        if [[ -z "$mainline" ]]; then
            gar_mer_row WARN "$name" "$path" "catch-up repo but rebase mainline could not be resolved (no origin default)"
            reported=1
        elif [[ "$fetched" == 1 && "$behind" =~ ^[0-9]+$ && "$behind" -gt 0 ]]; then
            if (( behind == 1 )); then
                gar_mer_row WARN "$name" "$path" "catch-up: rebase ${branch:-HEAD} onto $mainline; 1 commit behind"
            else
                gar_mer_row WARN "$name" "$path" "catch-up: rebase ${branch:-HEAD} onto $mainline; $behind commits behind"
            fi
            reported=1
        fi
    elif [[ "$fetched" == 1 && "$behind" =~ ^[0-9]+$ && "$behind" -gt 0 ]]; then
        if (( behind == 1 )); then
            gar_mer_row WARN "$name" "$path" "pull would update $config_branch; 1 commit behind origin/$config_branch"
        else
            gar_mer_row WARN "$name" "$path" "pull would update $config_branch; $behind commits behind origin/$config_branch"
        fi
        reported=1
    fi
    # Advisory only (does not count as an issue): the configured branch isn't the
    # repo's remote default. Skipped when the remote default is unknown, and for
    # catch-up repos (which don't track config_branch — they rebase onto a mainline ref).
    if [[ "$catchup" != 1 && -n "$remote_default" && "$remote_default" != "$config_branch" ]]; then
        gar_mer_row WARN "$name" "$path" "configured to track $config_branch but origin default is $remote_default"
        reported=1
    fi
    if (( reported == 0 )); then
        gar_mer_row OK "$name" "$path" ""
    fi
}

offer_machine_env_repo_pull() {
    local name="$1" path="$2" result_file="$3"
    local status dirty branch config_branch catchup mainline fetched behind ahead prompt

    gar_can_prompt || return 0

    status=$(gar_result_get "$result_file" status)
    [[ "$status" == ok ]] || return 0

    # dirty excludes skip-worktree'd edits, so a repo with only expected mods
    # passes this guard and is offered a pull/rebase — safe, since both `git pull
    # -r` and `git rebase <mainline>` leave skip-worktree'd files untouched.
    dirty=$(gar_result_get "$result_file" dirty)
    [[ "$dirty" == 0 ]] || return 0

    config_branch=$(gar_result_get "$result_file" config_branch)
    [[ -n "$config_branch" ]] || config_branch=main
    branch=$(gar_result_get "$result_file" branch)
    catchup=$(gar_result_get "$result_file" catchup)
    mainline=$(gar_result_get "$result_file" mainline)

    if [[ "$catchup" == 1 ]]; then
        # Catch-up: rebase the *current* branch onto the mainline ref, regardless
        # of which branch is checked out (that's the point). The branch's own
        # upstream (@{u}, the push target) is left untouched. Requires a resolved
        # mainline.
        [[ -n "$mainline" ]] || return 0

        fetched=$(gar_result_get "$result_file" fetched)
        behind=$(gar_result_get "$result_file" behind)
        if [[ "$fetched" != 1 ]]; then
            if ! gar_timed "repo fetch (retry): $name" gar_repo_catchup_fetch "$path" "$mainline"; then
                return 0
            fi
            behind=0
            behind=$(gar_repo_catchup_behind_count "$path" "$mainline" 2>/dev/null) || behind=0
        fi
        [[ "$behind" =~ ^[0-9]+$ && "$behind" -gt 0 ]] || return 0

        if (( behind == 1 )); then
            prompt="Catch up $name ($path; rebase ${branch:-HEAD} onto $mainline, 1 commit behind)?"
        else
            prompt="Catch up $name ($path; rebase ${branch:-HEAD} onto $mainline, $behind commits behind)?"
        fi

        if gar_prompt_yn "$prompt"; then
            if gar_timed "repo rebase: $name" gar_repo_rebase_onto_mainline "$path" "$mainline"; then
                printf 'Updated %s (%s)\n' "$name" "$path"
                gar_note_fixed warning
            else
                report_warn "Machine env repo $name ($path — rebase failed)"
            fi
        fi
        return 0
    fi

    # Only offer a pull when the repo is currently checked out on the branch we
    # track — don't pull it while the user sits on a feature branch.
    [[ "$branch" == "$config_branch" ]] || return 0

    fetched=$(gar_result_get "$result_file" fetched)
    behind=$(gar_result_get "$result_file" behind)
    if [[ "$fetched" != 1 ]]; then
        if ! gar_timed "repo fetch (retry): $name" gar_repo_try_fetch "$path" "$config_branch"; then
            return 0
        fi
        behind=0
        behind=$(gar_repo_behind_count "$path" "$config_branch" 2>/dev/null) || behind=0
    fi
    [[ "$behind" =~ ^[0-9]+$ && "$behind" -gt 0 ]] || return 0

    ahead=$(gar_result_get "$result_file" ahead)
    [[ "$ahead" =~ ^[0-9]+$ ]] || ahead=0

    if (( behind == 1 )); then
        prompt="Pull $name ($path; 1 commit behind origin/$config_branch"
    else
        prompt="Pull $name ($path; $behind commits behind origin/$config_branch"
    fi
    if (( ahead > 0 )); then
        if (( ahead == 1 )); then
            prompt+=", 1 unpushed commit"
        else
            prompt+=", $ahead unpushed commits"
        fi
    fi
    prompt+=")?"

    if gar_prompt_yn "$prompt"; then
        if gar_timed "repo pull: $name" gar_repo_pull "$path" "$config_branch"; then
            printf 'Updated %s (%s)\n' "$name" "$path"
            gar_note_fixed warning
        else
            report_warn "Machine env repo $name ($path — pull failed)"
        fi
    fi
}

check_machine_env_repos() {
    local repos_manifest="$1" skip_manifest="${2:-}" catchup_manifest="${3:-}" name path branch slug result_file
    gar_machine_env_prefetch_all "$repos_manifest" "$skip_manifest" "$catchup_manifest"
    gar_mer_reset

    # Pass 1: buffer every repo's report rows so column widths can be measured.
    while IFS='|' read -r name path branch; do
        slug=$(gar_path_slug "$path")
        result_file="$gar_tmpdir/repos/$slug"
        report_machine_env_repo "$name" "$path" "$result_file"
    done < <(gar_machine_env_list_repos "$repos_manifest" "$skip_manifest")

    gar_mer_flush   # measure widths + emit the aligned table

    # Pass 2: interactive pull offers, printed after the table (wording unchanged).
    while IFS='|' read -r name path branch; do
        slug=$(gar_path_slug "$path")
        result_file="$gar_tmpdir/repos/$slug"
        offer_machine_env_repo_pull "$name" "$path" "$result_file"
    done < <(gar_machine_env_list_repos "$repos_manifest" "$skip_manifest")
}

check_git_config() {
    local config_manifest="$1" hints_file="$2" key val hint
    if ! command -v git >/dev/null 2>&1; then
        report_miss "Git (not on PATH)"
        return
    fi
    while IFS= read -r key; do
        val=$(git config --global --get "$key" 2>/dev/null || true)
        if [[ -n "$val" ]]; then
            report_ok "Git config $key ($val)"
        else
            hint=$(lookup_install_hint "$key" "$hints_file" 2>/dev/null || true)
            if [[ -n "$hint" ]]; then
                report_miss "Git config $key ($hint)"
            else
                report_miss "Git config $key (not set; run: git config --global $key VALUE)"
            fi
        fi
    done < <(read_manifest "$config_manifest")
}

