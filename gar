# Print "profile|value" for each selected profile; exit 2 if key absent.
# Reads Secure Preferences first, then Preferences (dotted nested keys).
# location: "*", "@last", or "" → last-used profile; "@all" → every user
# profile; otherwise a profile directory name or display name / email.
mac_chrome_read_pref() {
    local location="$1" key="$2" root
    root=$(mac_chrome_user_data_dir)
    python3 - "$root" "$location" "$key" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
location = sys.argv[2]
key = sys.argv[3]
parts = key.split(".")

skip = {
    "System Profile", "Guest Profile", "Snap", "Snapshot", "Crashpad",
    "GrShaderCache", "GraphiteDawnCache", "ShaderCache", "Safe Browsing",
    "component_crx_cache", "extensions_crx_cache", "optimization_guide_model_store",
}

def load_json(path):
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        return None

def info_cache():
    data = load_json(root / "Local State") or {}
    cache = (data.get("profile") or {}).get("info_cache") or {}
    return data, cache if isinstance(cache, dict) else {}

def last_used_profile():
    data, _ = info_cache()
    name = (data.get("profile") or {}).get("last_used")
    if isinstance(name, str) and name:
        return name
    return "Default"

def all_user_profiles():
    if not root.is_dir():
        return
    for p in sorted(root.iterdir()):
        if not p.is_dir() or p.name in skip:
            continue
        if (p / "Preferences").is_file() or (p / "Secure Preferences").is_file():
            yield p.name

def profiles():
    if location in ("*", "@last", ""):
        yield last_used_profile()
        return
    if location == "@all":
        yield from all_user_profiles()
        return
    # Exact profile directory name.
    if (root / location).is_dir():
        yield location
        return
    # Match Local State display name or signed-in email (case-insensitive).
    _, cache = info_cache()
    needle = location.casefold()
    for dirname, info in cache.items():
        if not isinstance(info, dict):
            continue
        for field in ("name", "user_name", "gaia_name", "gaia_id"):
            val = info.get(field)
            if isinstance(val, str) and val.casefold() == needle:
                yield dirname
                return
    # Fall back to treating location as a directory name even if missing.
    yield location

def nested_get(data, parts):
    cur = data
    for part in parts:
        if not isinstance(cur, dict) or part not in cur:
            return None, False
        cur = cur[part]
    return cur, True

def profile_label(name):
    _, cache = info_cache()
    info = cache.get(name) or {}
    label = info.get("name") or info.get("user_name")
    if isinstance(label, str) and label and label != name:
        return "%s (%s)" % (name, label)
    return name

def read_profile(name):
    for fname in ("Secure Preferences", "Preferences"):
        path = root / name / fname
        data = load_json(path)
        if not isinstance(data, dict):
            continue
        value, found = nested_get(data, parts)
        if found:
            return value
    return None

any_profile = False
missing = False
for name in profiles():
    any_profile = True
    value = read_profile(name)
    label = profile_label(name)
    if value is None:
        print("%s|" % label)
        missing = True
        continue
    if isinstance(value, bool):
        text = "true" if value else "false"
    else:
        text = str(value)
    print("%s|%s" % (label, text))

if not any_profile:
    raise SystemExit(1)
if missing:
    raise SystemExit(2)
raise SystemExit(0)
PY
}

# Set a dotted nested key in Chrome Preferences and/or Secure Preferences for
# each selected profile. Clears integrity MACs for that key so Chrome re-seals.
# location semantics match mac_chrome_read_pref.
mac_chrome_write_pref() {
    local location="$1" key="$2" value="$3" root
    root=$(mac_chrome_user_data_dir)
    python3 - "$root" "$location" "$key" "$value" <<'PY'
import json
import re
import sys
from pathlib import Path

root = Path(sys.argv[1])
location = sys.argv[2]
key = sys.argv[3]
raw = sys.argv[4]
parts = key.split(".")

if raw in ("true", "false"):
    value = raw == "true"
elif re.fullmatch(r"-?\d+", raw):
    value = int(raw)
else:
    value = raw

skip = {
    "System Profile", "Guest Profile", "Snap", "Snapshot", "Crashpad",
    "GrShaderCache", "GraphiteDawnCache", "ShaderCache", "Safe Browsing",
    "component_crx_cache", "extensions_crx_cache", "optimization_guide_model_store",
}

def load(path):
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        return None

def info_cache():
    data = load(root / "Local State") or {}
    cache = (data.get("profile") or {}).get("info_cache") or {}
    return data, cache if isinstance(cache, dict) else {}

def last_used_profile():
    data, _ = info_cache()
    name = (data.get("profile") or {}).get("last_used")
    if isinstance(name, str) and name:
        return name
    return "Default"

def all_user_profiles():
    if not root.is_dir():
        return
    for p in sorted(root.iterdir()):
        if not p.is_dir() or p.name in skip:
            continue
        if (p / "Preferences").is_file() or (p / "Secure Preferences").is_file():
            yield p.name

def profiles():
    if location in ("*", "@last", ""):
        yield last_used_profile()
        return
    if location == "@all":
        yield from all_user_profiles()
        return
    if (root / location).is_dir():
        yield location
        return
    _, cache = info_cache()
    needle = location.casefold()
    for dirname, info in cache.items():
        if not isinstance(info, dict):
            continue
        for field in ("name", "user_name", "gaia_name", "gaia_id"):
            val = info.get(field)
            if isinstance(val, str) and val.casefold() == needle:
                yield dirname
                return
    yield location

def nested_get(data, parts):
    cur = data
    for part in parts:
        if not isinstance(cur, dict) or part not in cur:
            return None, False
        cur = cur[part]
    return cur, True

def current_value(name):
    for fname in ("Secure Preferences", "Preferences"):
        path = root / name / fname
        data = load(path)
        if not isinstance(data, dict):
            continue
        cur, found = nested_get(data, parts)
        if found:
            return cur, True
    return None, False

def nested_set(data, parts, value):
    cur = data
    for part in parts[:-1]:
        nxt = cur.get(part)
        if not isinstance(nxt, dict):
            nxt = {}
            cur[part] = nxt
        cur = nxt
    cur[parts[-1]] = value

def clear_macs(data, parts):
    prot = data.get("protection")
    if not isinstance(prot, dict):
        return
    macs = prot.get("macs")
    if not isinstance(macs, dict):
        return
    leaf = parts[-1]
    candidates = []
    if len(parts) >= 2:
        candidates.append(parts[0])
        candidates.append("account_values." + parts[0])
        candidates.append(".".join(parts[:-1]))
        candidates.append("account_values." + ".".join(parts[:-1]))
    for section in candidates:
        node = macs
        ok = True
        for part in section.split("."):
            if not isinstance(node, dict) or part not in node:
                ok = False
                break
            node = node[part]
        if not ok or not isinstance(node, dict):
            continue
        node.pop(leaf, None)
        node.pop(leaf + "_encrypted_hash", None)

for name in profiles():
    cur, found = current_value(name)
    if found and cur == value:
        continue
    # Resolve write target using the directory name (not a display label).
    prof = root / name
    secure_path = prof / "Secure Preferences"
    prefs_path = prof / "Preferences"
    secure = load(secure_path)
    prefs = load(prefs_path)
    in_secure = False
    if isinstance(secure, dict):
        _, in_secure = nested_get(secure, parts)
    targets = []
    if in_secure:
        targets.append((secure_path, secure))
    if isinstance(prefs, dict):
        targets.append((prefs_path, prefs))
    elif not targets:
        prefs = {}
        targets.append((prefs_path, prefs))
    for path, data in targets:
        nested_set(data, parts, value)
        if path.name == "Secure Preferences":
            clear_macs(data, parts)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(data, separators=(",", ":"), ensure_ascii=False))

raise SystemExit(0)
PY
}

mac_chrome_is_running() {
    pgrep -xq "Google Chrome" 2>/dev/null
}

# Offer to create each still-missing iTerm profile named in $1 (comma/space
# separated, as produced by the iterm-profiles check) by cloning the current
# Default profile's settings under the new name — see
# mac_iterm_create_profile. Skipped entirely if Default itself doesn't exist,
# since there is nothing to clone from.
offer_fix_iterm_profiles() {
    local missing_csv="$1" label="$2" source=Default name
    local -a missing

    IFS=', ' read -r -a missing <<<"$missing_csv"
    if ! grep -qxF "$source" <<<"$(mac_iterm_profile_names)"; then
        report_warn "Setting $label (no $source profile to clone from)"
        return 0
    fi

    for name in "${missing[@]}"; do
        [[ -n "$name" && "$name" != "$source" ]] || continue
        gar_prompt_yn "Fix $label: create iTerm profile \"$name\" (clone of $source)?" || continue
        if mac_iterm_create_profile "$source" "$name"; then
            printf 'Created iTerm profile "%s" (clone of %s; iTerm reloads Dynamic Profiles automatically).\n' "$name" "$source"
            gar_note_fixed warning
        else
            report_warn "Setting $label (could not create profile \"$name\")"
        fi
    done
}

offer_fix_mac_setting() {
    local kind="$1" location="$2" key="$3" expected="$4" label="$5" settings_path

    gar_can_prompt || return 0

    case "$kind" in
        defaults)
            gar_prompt_yn "Fix $label: set $key to $expected?" || return 0
            if gar_defaults_write "$location" "$key" "$expected" >/dev/null 2>&1; then
                if [[ "$key" == com.apple.keyboard.fnState ]]; then
                    gar_mark_pending_restart "$key"
                    printf 'Set %s to %s (requires a full RESTART — not just logout — to take effect in System Settings and actual key behavior).\n' "$key" "$expected"
                    gar_note_fixed warning
                else
                    printf 'Set %s to %s (may take effect after logout).\n' "$key" "$expected"
                    gar_note_fixed warning
                fi
            else
                report_warn "Setting $label (could not write $key)"
            fi
            ;;
        json-editor)
            settings_path=$(mac_editor_settings_path "$location")
            [[ -n "$settings_path" ]] || return 0
            gar_prompt_yn "Fix $label: set $key to $expected in $settings_path?" || return 0
            if mac_write_json_setting "$settings_path" "$key" "$expected"; then
                printf 'Set %s to %s in %s.\n' "$key" "$expected" "$settings_path"
                gar_note_fixed warning
            else
                report_warn "Setting $label (could not update $settings_path)"
            fi
            ;;
        chrome-json)
            if mac_chrome_is_running; then
                printf 'Quit Google Chrome before applying this fix (prefs are overwritten while it runs).\n'
                gar_prompt_yn "Chrome still running — fix $label anyway (set $key to $expected)?" "" N || return 0
            else
                gar_prompt_yn "Fix $label: set $key to $expected in Chrome profile prefs?" || return 0
            fi
            if mac_chrome_write_pref "$location" "$key" "$expected"; then
                printf 'Set Chrome %s to %s (restart Chrome if it was running).\n' "$key" "$expected"
                gar_note_fixed warning
            else
                report_warn "Setting $label (could not update Chrome preferences)"
            fi
            ;;
        iterm-profiles)
            offer_fix_iterm_profiles "$expected" "$label"
            ;;
        sound-menu-bar-always)
            gar_prompt_yn "Fix $label: always show volume in the menu bar?" || return 0
            if mac_fix_sound_menu_bar; then
                printf 'Enabled always-on volume in the menu bar.\n'
                gar_note_fixed warning
            else
                report_warn "Setting $label (could not update Control Center)"
            fi
            ;;
        next-window-switch-key)
            gar_prompt_yn "Fix $label: map \"Move focus to next window\" to Command-<?" || return 0
            if mac_fix_next_window_angle; then
                printf 'Mapped Move focus to next window to Command-< (log out/in if it does not take effect right away).\n'
                gar_note_fixed warning
            else
                report_warn "Setting $label (could not update symbolic hotkey)"
            fi
            ;;
    esac
}

# Path to qBittorrent's INI config (its actual settings store on this
# machine — not ~/Library/Preferences, which for qBittorrent only holds a
# couple of NSNavPanel keys; and not ~/Library/Application Support, which
# only holds runtime state like logs/BT_backup).
mac_qbittorrent_ini_path() {
    printf '%s\n' "$HOME/.config/qBittorrent/qBittorrent.ini"
}

# Reads Session\Interface from the [BitTorrent] section (plain key=value
# lines, no INI section-awareness needed since the key name is unique).
# Returns 1 if the file or key is missing.
mac_qbittorrent_interface() {
    local ini key line value
    ini=$(mac_qbittorrent_ini_path)
    [[ -f "$ini" ]] || return 1
    while IFS= read -r line; do
        key="${line%%=*}"
        if [[ "$key" == 'Session\Interface' ]]; then
            value="${line#*=}"
            printf '%s\n' "$value"
            return 0
        fi
    done <"$ini"
    return 1
}

check_mac_settings() {
    local label kind location key expected compare actual settings_path app_path read_status=0
    local hk_char hk_key hk_mod hk_enabled hk_read
    local chrome_line chrome_profile chrome_value chrome_bad chrome_detail chrome_out
    local iterm_missing iterm_want
    while IFS='|' read -r label kind location key expected compare; do
        compare="${compare:-eq}"
        actual=""

        case "$kind" in
            next-window-switch-key)
                # Only relevant with Karabiner Elements installed and the
                # Czech-QWERTY input source enabled; otherwise skip silently.
                if ! mac_karabiner_installed || ! mac_czech_qwerty_enabled; then
                    continue
                fi
                if mac_next_window_is_switch_key_binding; then
                    report_ok "Setting $label"
                else
                    report_warn "Setting $label (map to Command-<; toggle-switch-key toggles with Command-\`)"
                    offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
                fi
                continue
                ;;
            sound-menu-bar-always)
                if mac_controlcenter_sound_always; then
                    report_ok "Setting $label"
                else
                    report_warn "Setting $label (enable in System Settings → Control Center → Sound → Show in Menu Bar → Always)"
                    offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
                fi
                continue
                ;;
            machine-name-not-default)
                actual=$(mac_machine_name_primary 2>/dev/null || true)
                if mac_machine_name_is_system_assigned; then
                    if [[ -n "$actual" ]]; then
                        report_warn "Setting $label (is $actual; rename in System Settings → General → About → Name)"
                    else
                        report_warn "Setting $label (rename in System Settings → General → About → Name)"
                    fi
                else
                    report_ok "Setting $label${actual:+ ($actual)}"
                fi
                continue
                ;;
            qbittorrent-vpn-interface)
                gar_app_first_existing_path /Applications/qbittorrent.app >/dev/null || continue
                if ! actual=$(mac_qbittorrent_interface); then
                    report_warn "Setting $label (not set; open qBittorrent → Settings → Advanced → Network Interface and pick a VPN interface, utun*)"
                    continue
                fi
                if [[ "$actual" =~ ^utun[0-9]+$ ]]; then
                    report_ok "Setting $label ($actual)"
                else
                    report_warn "Setting $label (is ${actual:-all interfaces}; want a VPN interface, utun*)"
                fi
                continue
                ;;
            iterm-profiles)
                mac_iterm_installed || continue
                actual=$(mac_iterm_profile_names)
                iterm_missing=""
                for iterm_want in Default Caution Midcaution; do
                    if ! grep -qxF "$iterm_want" <<<"$actual"; then
                        iterm_missing+="${iterm_missing:+, }${iterm_want}"
                    fi
                done
                if [[ -z "$iterm_missing" ]]; then
                    report_ok "Setting $label"
                else
                    report_warn "Setting $label (missing: $iterm_missing)"
                    offer_fix_mac_setting "$kind" "$location" "$key" "$iterm_missing" "$label"
                fi
                continue
                ;;
            chrome-json)
                app_path=$(mac_browser_app_path chrome)
                if [[ -z "$app_path" || ! -e "$app_path" ]]; then
                    continue
                fi
                read_status=0
                chrome_bad=""
                chrome_detail=""
                chrome_out=$(mac_chrome_read_pref "$location" "$key" 2>/dev/null) || read_status=$?
                if [[ -z "$chrome_out" ]]; then
                    report_warn "Setting $label (no Chrome profiles found; want $key=$expected)"
                    offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
                    continue
                fi
                while IFS= read -r chrome_line; do
                    [[ -n "$chrome_line" ]] || continue
                    chrome_profile="${chrome_line%%|*}"
                    chrome_value="${chrome_line#*|}"
                    if [[ -z "$chrome_value" ]]; then
                        chrome_bad+="${chrome_bad:+, }${chrome_profile}=not set"
                        continue
                    fi
                    if gar_setting_matches "$chrome_value" "$expected" "$compare"; then
                        chrome_detail+="${chrome_detail:+, }${chrome_profile}=$chrome_value"
                    else
                        chrome_bad+="${chrome_bad:+, }${chrome_profile}=$chrome_value"
                    fi
                done <<<"$chrome_out"
                if [[ -n "$chrome_bad" ]]; then
                    report_warn "Setting $label (want $expected; ${chrome_bad})"
                    offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
                else
                    report_ok "Setting $label ($chrome_detail)"
                fi
                continue
                ;;
            json-editor)
                app_path=$(mac_editor_app_path "$location")
                if [[ -z "$app_path" || ! -e "$app_path" ]]; then
                    continue
                fi
                settings_path=$(mac_editor_settings_path "$location")
                if [[ ! -f "$settings_path" ]]; then
                    report_warn "Setting $label (not set; want $expected)"
                    offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
                    continue
                fi
                read_status=0
                actual=$(mac_read_json_setting "$settings_path" "$key" 2>/dev/null) || read_status=$?
                if (( read_status != 0 )); then
                    if (( read_status == 2 )); then
                        report_warn "Setting $label (not set; want $expected)"
                        offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
                    elif (( read_status == 3 )); then
                        report_warn "Setting $label (could not parse $settings_path)"
                    else
                        report_warn "Setting $label (could not read $settings_path)"
                    fi
                    continue
                fi
                ;;
            defaults)
                if ! actual=$(mac_read_defaults_setting "$location" "$key" 2>/dev/null); then
                    report_warn "Setting $label (could not read $location $key)"
                    offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
                    continue
                fi
                ;;
            *)
                report_warn "Setting $label (unknown kind: $kind)"
                continue
                ;;
        esac

        if gar_setting_matches "$actual" "$expected" "$compare"; then
            if [[ "$key" == com.apple.keyboard.fnState ]] && gar_pending_restart_active "$key"; then
                report_warn "Setting $label ($actual; RESTART needed — not yet visible in System Settings or in actual key behavior)"
            else
                report_ok "Setting $label ($actual)"
            fi
        else
            report_warn "Setting $label (is $actual; want $expected)"
            offer_fix_mac_setting "$kind" "$location" "$key" "$expected" "$label"
        fi
    done < <(read_manifest "$GAR_DIR/mac.settings")
}

