offer_brew_install_missing() {
    local brew_bin="$1"
    shift
    local item name prompt help

    gar_can_prompt || return 0

    for item in "$@"; do
        if [[ "$item" =~ ^Tap[[:space:]]+([^[:space:]]+)[[:space:]]+needs ]]; then
            name="${BASH_REMATCH[1]}"
            prompt="Tap $name?"
            help="brew tap $name"
            gar_prompt_yn "$prompt" "$help" || continue
            if "$brew_bin" tap "$name"; then
                printf 'Tapped %s.\n' "$name"
                gar_note_fixed issue
            else
                report_warn "Homebrew: could not tap $name"
            fi
        elif [[ "$item" =~ ^Formula[[:space:]]+([^[:space:]]+)[[:space:]]+needs[[:space:]]+to[[:space:]]+be[[:space:]]+linked ]]; then
            name="${BASH_REMATCH[1]}"
            prompt="Link $name (brew)?"
            help="brew link --overwrite --force $name"
            gar_prompt_yn "$prompt" "$help" || continue
            if "$brew_bin" link --overwrite --force "$name"; then
                printf 'Linked %s.\n' "$name"
                gar_note_fixed issue
            else
                report_warn "Homebrew: could not link $name"
            fi
        elif [[ "$item" =~ ^Formula[[:space:]]+([^[:space:]]+)[[:space:]]+needs ]]; then
            name="${BASH_REMATCH[1]}"
            case "$(gar_brew_item_action "$brew_bin" formula "$name" "$item")" in
                link)
                    # Keg-only formulae (the only kind bundle reports as
                    # needing a link) refuse a plain `brew link`.
                    gar_prompt_yn "Link $name (brew)?" "brew link --force $name" || continue
                    if "$brew_bin" link --force "$name"; then
                        printf 'Linked %s.\n' "$name"
                        gar_note_fixed issue
                    else
                        report_warn "Homebrew: could not link $name"
                    fi
                    ;;
                upgrade)
                    gar_prompt_yn "Upgrade $name (brew)?" "brew upgrade $name" || continue
                    if "$brew_bin" upgrade "$name"; then
                        printf 'Upgraded %s.\n' "$name"
                        gar_note_fixed issue
                    else
                        report_warn "Homebrew: could not upgrade $name"
                    fi
                    ;;
                *)
                    prompt="Install $name (brew)?"
                    if [[ "$name" == gng || "$name" == */gng ]]; then
                        help=$'brew trust --formula gdubw/gng/gng\nbrew install '"$name"
                    else
                        help="brew install $name"
                    fi
                    gar_prompt_yn "$prompt" "$help" || continue
                    if [[ "$name" == gng || "$name" == */gng ]]; then
                        if ! "$brew_bin" trust --formula gdubw/gng/gng; then
                            report_warn "Homebrew: could not trust gdubw/gng/gng"
                            continue
                        fi
                    fi
                    if "$brew_bin" install "$name"; then
                        printf 'Installed %s.\n' "$name"
                        gar_note_fixed issue
                    else
                        report_warn "Homebrew: could not install $name"
                    fi
                    ;;
            esac
        elif [[ "$item" =~ ^Cask[[:space:]]+([^[:space:]]+)[[:space:]]+needs ]]; then
            name="${BASH_REMATCH[1]}"
            if [[ "$(gar_brew_item_action "$brew_bin" cask "$name" "$item")" == upgrade ]]; then
                gar_prompt_yn "Upgrade $name (brew cask)?" "brew upgrade --cask $name" || continue
                if "$brew_bin" upgrade --cask "$name"; then
                    printf 'Upgraded %s.\n' "$name"
                    gar_note_fixed issue
                else
                    report_warn "Homebrew: could not upgrade cask $name"
                fi
            else
                gar_prompt_yn "Install $name (brew cask)?" "brew install --cask $name" || continue
                if "$brew_bin" install --cask "$name"; then
                    printf 'Installed %s.\n' "$name"
                    gar_note_fixed issue
                else
                    report_warn "Homebrew: could not install cask $name"
                fi
            fi
        fi
    done
}

# Classify a `brew bundle check` item into the action that satisfies it:
# link ("needs to be linked"), upgrade ("installed or updated" but already
# installed, i.e. outdated), or install.
gar_brew_item_action() {
    local brew_bin="$1" kind="$2" name="$3" item="$4"
    if [[ "$item" == *"needs to be linked"* ]]; then
        printf 'link\n'
    elif gar_brew_installed "$brew_bin" "$kind" "$name"; then
        printf 'upgrade\n'
    else
        printf 'install\n'
    fi
}

# Homebrew locates Xcode via /usr/bin/mdfind when it isn't at the standard
# path; with Spotlight disabled on / that query never returns, so any
# brew install/upgrade hangs (after downloading) until interrupted.
gar_brew_blocked_by_spotlight() {
    [[ -d /Applications/Xcode.app ]] && return 1
    command -v mdutil >/dev/null 2>&1 || return 1
    mdutil -s / 2>/dev/null | grep -qi 'disabled'
}

# Print the brew command that satisfies a `brew bundle check` item.
gar_brew_item_command() {
    local brew_bin="$1" item="$2" name
    if [[ "$item" =~ ^Tap[[:space:]]+([^[:space:]]+)[[:space:]]+needs ]]; then
        printf 'brew tap %s\n' "${BASH_REMATCH[1]}"
    elif [[ "$item" =~ ^Formula[[:space:]]+([^[:space:]]+)[[:space:]]+needs ]]; then
        name="${BASH_REMATCH[1]}"
        case "$(gar_brew_item_action "$brew_bin" formula "$name" "$item")" in
            link) printf 'brew link --force %s\n' "$name" ;;
            upgrade) printf 'brew upgrade %s\n' "$name" ;;
            *) printf 'brew install %s\n' "$name" ;;
        esac
    elif [[ "$item" =~ ^Cask[[:space:]]+([^[:space:]]+)[[:space:]]+needs ]]; then
        name="${BASH_REMATCH[1]}"
        if [[ "$(gar_brew_item_action "$brew_bin" cask "$name" "$item")" == upgrade ]]; then
            printf 'brew upgrade --cask %s\n' "$name"
        else
            printf 'brew install --cask %s\n' "$name"
        fi
    fi
}

check_mac_homebrew() {
    local brew_bin
    brew_bin=$(gar_brew_bin)

    if [[ -z "$brew_bin" ]]; then
        report_miss "Homebrew (not installed)"
        return
    fi
    report_ok "Homebrew ($brew_bin)"

    local brewfile
    brewfile=$(gar_combined_capability_manifest mac Brewfile)
    if [[ ! -f "$brewfile" || ! -s "$brewfile" ]]; then
        report_miss "Homebrew manifest (mac.Brewfile missing)"
        return
    fi

    # `brew bundle check` can repeat a line (e.g. "needs to be linked" once per
    # Brewfile entry that pulls the formula in), so drop exact duplicates.
    local missing=() seen=$'\n'
    while IFS= read -r line; do
        [[ "$line" == →* ]] || continue
        line="${line#→ }"
        [[ "$seen" == *$'\n'"$line"$'\n'* ]] && continue
        seen+="$line"$'\n'
        missing+=("$line")
    done < <("$brew_bin" bundle check --file="$brewfile" --verbose 2>&1 || true)

    if ((${#missing[@]} == 0)); then
        report_ok "Homebrew taps/formulae/casks (Brewfile satisfied)"
        return
    fi

    local item hint brew_name elsewhere cmd cmd_path
    local still_missing=()
    for item in "${missing[@]}"; do
        # A "needs to be linked" formula is already brew-installed; another copy
        # on PATH is the conflict that blocks linking, not a reason to skip. So
        # bypass the "exists elsewhere" check and go straight to report + offer.
        if [[ ! "$item" =~ [[:space:]]needs[[:space:]]+to[[:space:]]+be[[:space:]]+linked ]] \
            && brew_name=$(gar_brew_item_name "$item") \
            && elsewhere=$(gar_brew_item_elsewhere "$brew_name" "$brew_bin"); then
            cmd="${elsewhere%%|*}"
            cmd_path="${elsewhere#*|}"
            gar_section_emit_header
            printf '%s is brew-required but exists in another location (%s), so assuming you don'\''t want it brew-installed\n' \
                "$(gar_capitalize_first "$cmd")" "$(gar_tilde_path "$cmd_path")"
            continue
        fi
        still_missing+=("$item")
        if hint=$(brew_miss_hint "$item"); then
            report_miss "Homebrew: $item ($hint)"
        else
            report_miss "Homebrew: $item"
        fi
    done

    if ((${#still_missing[@]} > 0)); then
        if gar_brew_blocked_by_spotlight; then
            # Offering would just hang; list the fixes to run once it's back on.
            report_warn "Homebrew: not offering fixes — Spotlight is disabled on /, so brew install/upgrade hangs in its Xcode lookup (mdfind). Fix: sudo mdutil -i on /, then run:"
            for item in "${still_missing[@]}"; do
                printf '  %s\n' "$(gar_brew_item_command "$brew_bin" "$item")"
            done
        else
            offer_brew_install_missing "$brew_bin" "${still_missing[@]}"
        fi
    fi
}

# Audit the brew-forbidden manifest: formulae a role/platform declares must NOT
# be installed (e.g. plain ffmpeg, which keeps the dev-tools role's ffmpeg-full
# unlinked/keg-only). An installed forbidden formula is a MISS, since it defeats
# the intent of whatever conflicting tool the role does want.
check_mac_brew_forbidden() {
    local brew_bin manifest name
    brew_bin=$(gar_brew_bin)
    [[ -n "$brew_bin" ]] || return
    manifest=$(gar_combined_capability_manifest mac brew-forbidden)
    [[ -f "$manifest" && -s "$manifest" ]] || return
    while IFS= read -r name; do
        if gar_brew_installed "$brew_bin" formula "$name"; then
            report_miss "Homebrew: $name is installed but conflicts with a role tool (uninstall: brew uninstall $name)"
        else
            report_ok "Homebrew: $name not installed (no conflict)"
        fi
    done < <(read_manifest "$manifest")
}

check_mac_secrets() {
    local secrets_manifest="${1:-}" key keys=() i=0 result status
    [[ -n "$secrets_manifest" ]] || secrets_manifest=$(gar_combined_capability_manifest mac secrets)
    mkdir -p "$gar_tmpdir/secrets"
    while IFS= read -r key; do
        keys+=("$key")
        (
            if mac_secret_exists "$key"; then
                printf 'ok\n' >"$gar_tmpdir/secrets/$i"
            else
                printf 'miss\n' >"$gar_tmpdir/secrets/$i"
            fi
        ) &
        i=$((i + 1))
    done < <(read_manifest "$secrets_manifest")
    wait
    for i in "${!keys[@]}"; do
        key="${keys[$i]}"
        status=$(<"$gar_tmpdir/secrets/$i")
        if [[ "$status" == ok ]]; then
            report_ok "Secret $key"
        else
            report_miss "Secret $key (set with: set-secret $key VALUE)"
        fi
    done
}

check_env() {
    local env_manifest="$1" name val
    while IFS= read -r name; do
        val="${!name-}"
        if [[ -n "$val" ]]; then
            report_ok "Env $name"
        else
            report_miss "Env $name (not set in this shell)"
        fi
    done < <(read_manifest "$env_manifest")
}

check_mac_env() {
    local env_manifest="${1:-}"
    [[ -n "$env_manifest" ]] || env_manifest=$(gar_combined_capability_manifest mac env)
    check_env "$env_manifest"
}

check_mac_java() {
    local sdkman_init="$HOME/.sdkman/bin/sdkman-init.sh"
    local has_sdkman=0
    local has_java=0

    if [[ -s "$sdkman_init" ]]; then
        has_sdkman=1
        report_ok "SDKMAN"
        # shellcheck disable=SC1090
        source "$sdkman_init"
        if sdk current java >/dev/null 2>&1; then
            has_java=1
            report_ok "Java ($(sdk current java 2>/dev/null | tr -d '\r'))"
        fi
    else
        report_miss "SDKMAN (install from https://sdkman.io, then: sdk install java)"
    fi

    if java -version >/dev/null 2>&1; then
        has_java=1
        if (( has_sdkman == 0 )); then
            report_ok "Java ($(java -version 2>&1 | head -n1))"
        fi
    elif (( has_java == 0 )); then
        if (( has_sdkman == 1 )); then
            report_miss "Java (no SDKMAN candidate; run: sdk install java)"
        else
            report_miss "Java (no runtime; prefer SDKMAN: sdk install java)"
        fi
    fi
}

# Print each distinct copy of a command on PATH, in PATH order (first one wins).
# Copies resolving to the same file are collapsed, and macOS system copies
# (/usr/bin etc.) are skipped: those are routinely shadowed by Homebrew on purpose.
gar_command_path_copies() {
    local cmd="$1" path real seen=$'\n'
    while IFS= read -r path; do
        case "$path" in /bin/* | /sbin/* | /usr/bin/* | /usr/sbin/*) continue ;; esac
        real=$(realpath "$path" 2>/dev/null || printf '%s' "$path")
        [[ "$seen" == *$'\n'"$real"$'\n'* ]] && continue
        seen+="$real"$'\n'
        printf '%s\n' "$path"
    done < <(type -aP "$cmd")
}

# WARN when more than one distinct copy of a command is on PATH (e.g. Homebrew's
# kubectl vs the one Docker Desktop links into /usr/local/bin), since which one
# runs then depends on PATH order.
gar_warn_command_shadowed() {
    local cmd="$1" copies=() path label real
    while IFS= read -r path; do
        copies+=("$path")
    done < <(gar_command_path_copies "$cmd")
    ((${#copies[@]} > 1)) || return 0
    local desc="" i
    for i in "${!copies[@]}"; do
        path="${copies[$i]}"
        label=$(gar_tilde_path "$path")
        if [[ -L "$path" ]]; then
            real=$(realpath "$path" 2>/dev/null || true)
            [[ -n "$real" ]] && label+=" -> $(gar_tilde_path "$real")"
        fi
        if ((i == 0)); then
            desc="using $label; shadowed: "
        else
            ((i > 1)) && desc+=", "
            desc+="$label"
        fi
    done
    report_warn "Command $cmd: ${#copies[@]} copies on PATH ($desc)"
}

check_commands() {
    local commands_manifest="$1" hints_file="$2" cmd hint
    while IFS= read -r cmd; do
        if command -v "$cmd" >/dev/null 2>&1; then
            report_ok "Command $cmd"
            gar_warn_command_shadowed "$cmd"
        else
            hint=$(lookup_install_hint "$cmd" "$hints_file" 2>/dev/null || true)
            if [[ -n "$hint" ]]; then
                report_miss "Command $cmd ($hint)"
            else
                report_miss "Command $cmd (not on PATH)"
            fi
        fi
    done < <(read_manifest "$commands_manifest")
}

mac_perl_module_installed() {
    perl -M"$1" -e1 2>/dev/null
}

check_mac_perl_modules() {
    local module hint
    while IFS= read -r module; do
        if mac_perl_module_installed "$module"; then
            report_ok "Perl module $module"
        else
            hint=$(lookup_install_hint "$module" 2>/dev/null || true)
            if [[ -n "$hint" ]]; then
                if gar_hint_is_multiline "$hint"; then
                    report_miss "Perl module $module:"
                    printf '%b\n' "$hint"
                else
                    report_miss "Perl module $module ($hint)"
                fi
            else
                report_miss "Perl module $module (not installed)"
            fi
        fi
    done < <(read_manifest "$GAR_DIR/mac.perl-modules")
}

check_mac_apps() {
    local apps_manifest="${1:-}" entry name path
    [[ -n "$apps_manifest" ]] || apps_manifest=$(gar_combined_capability_manifest mac apps)
    while IFS= read -r entry; do
        name="${entry%%|*}"
        path="${entry#*|}"
        if [[ "$name" == "$entry" || -z "$path" ]]; then
            report_miss "App manifest line (expected name|path): $entry"
            continue
        fi
        if gar_app_first_existing_path "$path" >/dev/null; then
            report_ok "App $name"
        else
            report_miss "App $name ($(gar_app_format_paths "$path"))"
        fi
    done < <(read_manifest "$apps_manifest")
}

mac_login_items_raw() {
    # osascript blocks indefinitely if macOS is showing an Automation
    # permission prompt (e.g. "Terminal wants to control System Events")
    # that never gets answered, so bound the wait rather than hang gar.
    local out_file pid watcher status
    out_file="$gar_tmpdir/login-items-raw"
    osascript -e 'tell application "System Events" to get the name of every login item' \
        >"$out_file" 2>/dev/null &
    pid=$!
    ( sleep 5; kill -9 "$pid" 2>/dev/null ) >/dev/null 2>&1 &
    watcher=$!
    wait "$pid" 2>/dev/null
    status=$?
    kill "$watcher" 2>/dev/null
    wait "$watcher" 2>/dev/null
    cat "$out_file" 2>/dev/null
    rm -f "$out_file"
    return "$status"
}

mac_login_item_listed() {
    local want="$1" items_raw="$2" item
    while IFS= read -r item || [[ -n "${item:-}" ]]; do
        item="${item#"${item%%[![:space:]]*}"}"
        item="${item%"${item##*[![:space:]]}"}"
        [[ -n "$item" && "$item" == "$want" ]] && return 0
    done < <(printf '%s' "$items_raw" | tr ',' '\n')
    return 1
}

check_mac_login_items() {
    local entry label names_field items_raw read_status=0
    local name candidates matched matched_list format
    local login_manifest="${1:-}"
    [[ -n "$login_manifest" ]] || login_manifest=$(gar_combined_capability_manifest mac login-items)
    read_status=0
    items_raw=$(mac_login_items_raw) || read_status=$?
    if (( read_status != 0 )); then
        report_warn "Login items (could not read; allow Terminal or gar to control System Events)"
        return
    fi

    while IFS= read -r entry; do
        label="${entry%%|*}"
        names_field="${entry#*|}"
        if [[ -z "$label" || -z "$names_field" || "$label" == "$entry" ]]; then
            report_miss "Login item manifest line (expected label|name[|name...]): $entry"
            continue
        fi

        candidates=0
        matched=0
        matched_list=""
        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            candidates=$((candidates + 1))
            if mac_login_item_listed "$name" "$items_raw"; then
                matched=$((matched + 1))
                if [[ -z "$matched_list" ]]; then
                    matched_list="$name"
                else
                    matched_list="$matched_list, $name"
                fi
            fi
        done < <(gar_app_candidate_paths "$names_field")

        if (( candidates == 0 )); then
            report_miss "Login item manifest line (expected label|name[|name...]): $entry"
            continue
        fi

        if (( candidates == 1 )); then
            if (( matched == 1 )); then
                report_ok "Login item $label"
            else
                report_miss "Login item $label (add $names_field in System Settings → General → Login Items)"
            fi
            continue
        fi

        format=$(gar_app_format_paths "$names_field")
        if (( matched == 1 )); then
            report_ok "Login item $label ($matched_list)"
        elif (( matched == 0 )); then
            report_miss "Login item $label (add exactly one of: $format in System Settings → General → Login Items)"
        else
            report_miss "Login item $label (exactly one of: $format; found: $matched_list)"
        fi
    done < <(read_manifest "$login_manifest")
}

mac_browser_app_path() {
    case "$1" in
        chrome) printf '%s\n' "/Applications/Google Chrome.app" ;;
        opera) printf '%s\n' /Applications/Opera.app ;;
        waterfox) printf '%s\n' /Applications/Waterfox.app ;;
    esac
}

mac_chromium_extension_installed() {
    local support_dir="$1" ext_id="$2" profile_dir
    for profile_dir in "$support_dir"/*/Extensions/"$ext_id"; do
        [[ -d "$profile_dir" ]] && return 0
    done
    return 1
}

mac_gecko_extension_installed() {
    local support_dir="$1" ext_id="$2"
    python3 - "$support_dir" "$ext_id" <<'PY'
import configparser
import json
import sys
from pathlib import Path

base = Path(sys.argv[1]).expanduser()
addon_id = sys.argv[2]
profile_dirs = []

profiles_ini = base / "profiles.ini"
if profiles_ini.exists():
    cp = configparser.RawConfigParser()
    cp.read(profiles_ini)
    for section in cp.sections():
        if not cp.has_option(section, "Path"):
            continue
        rel = cp.get(section, "Path")
        is_relative = cp.get(section, "IsRelative", fallback="1") == "1"
        profile = (base / rel) if is_relative else Path(rel)
        if profile.is_dir():
            profile_dirs.append(profile)
else:
    profiles = base / "Profiles"
    if profiles.is_dir():
        profile_dirs = [p for p in profiles.iterdir() if p.is_dir()]

for profile in profile_dirs:
    ext_json = profile / "extensions.json"
    if not ext_json.exists():
        continue
    data = json.loads(ext_json.read_text())
    for addon in data.get("addons", []):
        if addon.get("id") == addon_id and addon.get("type") == "extension":
            raise SystemExit(0)

raise SystemExit(1)
PY
}

mac_browser_extension_installed() {
    local browser="$1" ext_id="$2"
    case "$browser" in
        chrome)
            mac_chromium_extension_installed \
                "$HOME/Library/Application Support/Google/Chrome" \
                "$ext_id"
            ;;
        opera)
            mac_chromium_extension_installed \
                "$HOME/Library/Application Support/com.operasoftware.Opera" \
                "$ext_id"
            ;;
        waterfox)
            mac_gecko_extension_installed \
                "$HOME/Library/Application Support/Waterfox" \
                "$ext_id"
            ;;
        *)
            return 1
            ;;
    esac
}

check_mac_browser_extensions() {
    local entry browser ext_id label app_path i=0 status hint
    local browsers=() ext_ids=() labels=()
    mkdir -p "$gar_tmpdir/extensions"
    while IFS='|' read -r browser ext_id label; do
        if [[ -z "$browser" || -z "$ext_id" || -z "$label" ]]; then
            browsers+=("$browser")
            ext_ids+=("$ext_id")
            labels+=("$label")
            printf 'bad\n' >"$gar_tmpdir/extensions/$i"
            i=$((i + 1))
            continue
        fi

        app_path=$(mac_browser_app_path "$browser")
        if [[ -z "$app_path" || ! -e "$app_path" ]]; then
            browsers+=("$browser")
            ext_ids+=("$ext_id")
            labels+=("$label")
            printf 'skip\n' >"$gar_tmpdir/extensions/$i"
            i=$((i + 1))
            continue
        fi

        browsers+=("$browser")
        ext_ids+=("$ext_id")
        labels+=("$label")
        (
            if mac_browser_extension_installed "$browser" "$ext_id"; then
                printf 'ok\n' >"$gar_tmpdir/extensions/$i"
            else
                printf 'miss\n' >"$gar_tmpdir/extensions/$i"
            fi
        ) &
        i=$((i + 1))
    done < <(read_manifest "$GAR_DIR/mac.browser-extensions")
    wait
    for i in "${!browsers[@]}"; do
        browser="${browsers[$i]}"
        ext_id="${ext_ids[$i]}"
        label="${labels[$i]}"
        status=$(<"$gar_tmpdir/extensions/$i")
        case "$status" in
            skip) continue ;;
            bad)
                report_miss "Browser extension manifest line (expected browser|id|name): $browser|$ext_id|$label"
                ;;
            ok)
                report_ok "Extension $browser/$label"
                ;;
            miss)
                hint=$(lookup_install_hint "$label" 2>/dev/null || true)
                if [[ -n "$hint" ]]; then
                    report_miss "Extension $browser/$label ($hint)"
                else
                    report_miss "Extension $browser/$label ($ext_id)"
                fi
                ;;
        esac
    done
}

