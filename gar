# Each distinct copy of a command on PATH, in PATH order (first one wins).
# Copies resolving to the same file are collapsed, and macOS system copies
# (/usr/bin etc.) are skipped: those are routinely shadowed by Homebrew on purpose.
def gar_command_path_copies(cmd):
    copies = []
    seen = set()
    for d in os.environ.get("PATH", "").split(os.pathsep):
        if not d:
            continue
        path = os.path.join(d, cmd)
        if not (os.path.isfile(path) and os.access(path, os.X_OK)):
            continue
        if path.startswith(("/bin/", "/sbin/", "/usr/bin/", "/usr/sbin/")):
            continue
        real = os.path.realpath(path)
        if real in seen:
            continue
        seen.add(real)
        copies.append(path)
    return copies


# WARN when more than one distinct copy of a command is on PATH (e.g.
# Homebrew's kubectl vs the one Docker Desktop links into /usr/local/bin), since
# which one runs then depends on PATH order.
def gar_warn_command_shadowed(cmd):
    copies = gar_command_path_copies(cmd)
    if len(copies) <= 1:
        return
    labels = []
    for path in copies:
        label = gar_tilde_path(path)
        if os.path.islink(path):
            label += " -> " + gar_tilde_path(os.path.realpath(path))
        labels.append(label)
    shadowed = ", ".join(labels[1:])
    report_warn(f"Command {cmd}: {len(copies)} copies on PATH (using {labels[0]}; shadowed: {shadowed})")


def check_commands(commands_lines, hints_file):
