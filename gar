# Print one iTerm profile name per line: the "New Bookmarks" array (old-style
# NeXTSTEP plist text from `defaults read`, converted to XML so it can hold
# arbitrary <data> fields that plutil's JSON converter rejects) plus every
# *.json file under the DynamicProfiles directory.
mac_iterm_profile_names() {
    local dyn_dir dyn_file
    local -a dyn_files=()

    defaults read com.googlecode.iterm2 "New Bookmarks" 2>/dev/null \
        | plutil -convert xml1 -o - - 2>/dev/null \
        | python3 -c '
import plistlib
import sys

try:
    data = plistlib.loads(sys.stdin.buffer.read())
except Exception:
    sys.exit(0)
for bookmark in data:
    if isinstance(bookmark, dict):
        name = bookmark.get("Name")
        if name:
            print(name)
'

    dyn_dir=$(mac_iterm_dynamic_profiles_dir)
