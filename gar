main() {
    local platform fixed rc
    local orig_args=("$@")
    issues=0

    if [[ "${1:-}" == "info" ]]; then
        shift
        cmd_info "${1:-}"
        return
    fi

    if [[ "${1:-}" == "apps" ]]; then
        shift
        cmd_apps "$@"
        return
    fi

    if [[ "${1:-}" == "roles" ]]; then
        shift
        cmd_roles "$@"
        return
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help|--man)
                usage
                exit 0
                ;;
            -a|--all)
                gar_show_all=1
                shift
                ;;
            *)
                echo "Unknown option: $1" >&2
                usage >&2
                exit 2
                ;;
        esac
    done

    platform=$(detect_platform)
    gar_preflight_config || exit 2
    detect_roles
    if (( ! gar_recheck )); then
        printf 'gar: platform %s; roles %s\n' "$platform" "$(gar_format_roles)"
        gar_warn_unknown_roles
    fi

    gar_init_workdir

    case "$platform" in
        mac)
            run_mac_checks
            ;;
        synology)
            run_synology_checks
            ;;
        wsl)
            run_wsl_checks
            ;;
        linux)
            printf '\nOnly mac, synology, and wsl checks are implemented so far.\n'
            issues=$((issues + 1))
            ;;
        *)
            report_miss "Unknown platform"
            ;;
    esac

    printf '\n'

    # Fixes were applied: the findings above are stale, so re-run (no prompts)
    # and let that run's report and exit status stand as the result.
    if (( gar_fixed_issues + gar_fixed_warnings > 0 )); then
        if (( gar_fixed_issues > 0 )); then
            fixed=$(gar_plural "$gar_fixed_issues" issue)
        else
            fixed=$(gar_plural "$gar_fixed_warnings" warning)
        fi
        printf 'Gar: Fixed %s.\n\nAfter fixes:\n' "$fixed"
        GAR_RECHECK=1 "${BASH_SOURCE[0]}" ${orig_args[@]+"${orig_args[@]}"}
        rc=$?
        exit "$rc"
    fi

    local warn_suffix=""
    (( warnings > 0 )) && warn_suffix=". $(gar_plural "$warnings" warning)."
    if (( issues > 0 )); then
        printf '%s issue(s)%s\n' "$issues" "$warn_suffix"
        exit 1
    fi
    printf 'All checks passed%s\n' "$warn_suffix"
}

main "$@"
