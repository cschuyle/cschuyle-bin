                    bad.append(f"{profile}={value}")
            if bad:
                report_warn(f"Setting {label} (want {expected}; {', '.join(bad)})")
                offer()
            else:
                report_ok(f"Setting {label} ({', '.join(detail)})")
            continue
        if kind == "json-editor":
            app_path = mac_editor_app_path(location)
            if not app_path or not os.path.exists(app_path):
                continue
            settings_path = mac_editor_settings_path(location)
            if not os.path.isfile(settings_path):
                report_warn(f"Setting {label} (not set; want {expected})")
                offer()
                continue
            status, actual = mac_read_json_setting(settings_path, key)
            if status != 0:
                if status == 2:
                    report_warn(f"Setting {label} (not set; want {expected})")
                    offer()
                elif status == 3:
                    report_warn(f"Setting {label} (could not parse {settings_path})")
                else:
                    report_warn(f"Setting {label} (could not read {settings_path})")
                continue
        elif kind == "defaults":
            actual = mac_read_defaults_setting(location, key)
            if actual is None:
                report_warn(f"Setting {label} (could not read {location} {key})")
                offer()
                continue
        else:
            report_warn(f"Setting {label} (unknown kind: {kind})")
            continue

        if gar_setting_matches(actual, expected, compare):
            if key == "com.apple.keyboard.fnState" and gar_pending_restart_active(key):
                report_warn(f"Setting {label} ({actual}; RESTART needed — not yet visible in System Settings or in actual key behavior)")
            else:
                report_ok(f"Setting {label} ({actual})")
        else:
            report_warn(f"Setting {label} (is {actual}; want {expected})")
            offer()


