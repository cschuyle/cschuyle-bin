SDKMAN_INIT = os.path.join(HOME, ".sdkman", "bin", "sdkman-init.sh")
_ENV_IGNORE = {"_", "SHLVL", "PWD", "OLDPWD"}


# Source SDKMAN's init script in bash and adopt the environment it exports
# (PATH, JAVA_HOME, SDKMAN_*), as a bash gar sourcing it in-process would.
def sdkman_source():
    rc, env = run(["bash", "-c", 'source "$1" >/dev/null 2>&1; env -0', "_", SDKMAN_INIT])
    if rc != 0:
        return
    for item in env.split("\0"):
        k, sep, v = item.partition("=")
        if sep and k not in _ENV_IGNORE and os.environ.get(k) != v:
            os.environ[k] = v


# Run an `sdk` subcommand (a shell function, so it needs SDKMAN sourced).
def sdk(*args):
    return run(["bash", "-c", 'source "$1" >/dev/null 2>&1; shift; sdk "$@"', "_", SDKMAN_INIT] + list(args))


def check_mac_java():
